package term

// AnsiScreen + Session — S8 driver on std/os/term + std/os/signal
// (ADR-0027, supersedes ADR-0005's stty path).
import "std/os"

import "std/os/term" as osterm

import "std/os/signal"

import "std/errors"

// AnsiScreen is an in-memory cell grid flushed with ANSI CSI.
struct AnsiScreen {
    cols: int,
    rows: int,
    chs: []str,
    fgs: []int,
    bgs: []int,
    attrs: []int,
    cx: int,
    cy: int,
    show_cur: bool,
}

fn new_ansi(cols: int, rows: int) -> own AnsiScreen {
    if cols < 1 {
        cols = 80
    }
    if rows < 1 {
        rows = 24
    }
    n := cols * rows
    s := new(AnsiScreen)
    s.cols = cols
    s.rows = rows
    s.chs = mkslice(str, n)
    s.fgs = mkslice(int, n)
    s.bgs = mkslice(int, n)
    s.attrs = mkslice(int, n)
    s.cx = 0
    s.cy = 0
    s.show_cur = true
    s.clear()
    return s
}

// clear resets every cell to a blank — render() calls it at frame
// start so deleted chars / closed overlays leave no stale cells.
fn (s mut AnsiScreen) clear() {
    n := s.cols * s.rows
    i := 0
    for i < n {
        s.chs[i] = " "
        s.fgs[i] = -1
        s.bgs[i] = -1
        s.attrs[i] = 0
        i = i + 1
    }
}

// glyph_len returns the byte length of the UTF-8 glyph starting at
// s[i] — 1 for ASCII and for stray/invalid bytes (continuation
// bytes, truncated tails), else the validated multibyte length.
fn glyph_len(s: str, i: int) -> int {
    c := byteat(s, i)
    need := 1
    if c >= 240 {
        need = 4
    } else if c >= 224 {
        need = 3
    } else if c >= 194 {
        need = 2
    }
    if i + need > len(s) {
        return 1
    }
    k := 1
    for k < need {
        cb := byteat(s, i + k)
        if cb < 128 || cb >= 192 {
            return 1
        }
        k = k + 1
    }
    return need
}

fn (s AnsiScreen) size() -> CellSize {
    return CellSize{cols: s.cols, rows: s.rows}
}

fn (s mut AnsiScreen) set_cell(x: int, y: int, ch: str, fg: int, bg: int, attr: int) {
    if x < 0 || y < 0 || x >= s.cols || y >= s.rows {
        return
    }
    i := y * s.cols + x
    if len(ch) == 0 {
        ch = " "
    }
    // overwriting half of a wide pair must drop the mate too — a stale
    // continuation column makes present() emit the next cell one
    // column early, a stale lead overprints this cell. "" only ever
    // marks a continuation, so both halves are detectable.
    if s.chs[i] == "" && x > 0 {
        // (x,y) was the trailing half of a wide glyph — blank its lead
        s.chs[i - 1] = " "
        s.fgs[i - 1] = 0
        s.bgs[i - 1] = 0
        s.attrs[i - 1] = 0
    }
    if x + 1 < s.cols && s.chs[i + 1] == "" {
        // (x,y) held a wide lead — blank its trailing continuation
        s.chs[i + 1] = " "
        s.fgs[i + 1] = 0
        s.bgs[i + 1] = 0
        s.attrs[i + 1] = 0
    }
    // store the COMPLETE first glyph — a truncated byte run would let
    // present() emit a style escape in the middle of a multibyte
    // character (the terminal then prints mojibake).
    s.chs[i] = substr(ch, 0, glyph_len(ch, 0))
    s.fgs[i] = fg
    s.bgs[i] = bg
    s.attrs[i] = attr
}

// set_wide_cont marks (x, y) as the trailing column a 2-cell glyph
// already occupies — stores an EMPTY glyph so present() emits
// nothing for this column (the terminal advanced past it when it
// drew the wide glyph at x-1).
fn (s mut AnsiScreen) set_wide_cont(x: int, y: int) {
    if x < 0 || y < 0 || x >= s.cols || y >= s.rows {
        return
    }
    i := y * s.cols + x
    // overwriting a wide lead orphans its old continuation at (x+1,y)
    // — a stray "" column would print the next cell a column early.
    if x + 1 < s.cols && s.chs[i + 1] == "" {
        s.chs[i + 1] = " "
        s.fgs[i + 1] = 0
        s.bgs[i + 1] = 0
        s.attrs[i + 1] = 0
    }
    s.chs[i] = ""
    s.fgs[i] = -1
    s.bgs[i] = -1
    s.attrs[i] = 0
}

fn (s mut AnsiScreen) cursor(x: int, y: int, show: bool) {
    s.cx = x
    s.cy = y
    s.show_cur = show
}

fn sgr_attr(attr: int) -> str {
    // No bitwise-& in oxl — peel flag bits high→low.
    out := "0"
    a := attr
    if a >= AttrReverse {
        a = a - AttrReverse
        out = out + ";7"
    }
    if a >= AttrUnderline {
        a = a - AttrUnderline
        out = out + ";4"
    }
    if a >= AttrItalic {
        a = a - AttrItalic
        out = out + ";3"
    }
    if a >= AttrDim {
        a = a - AttrDim
        out = out + ";2"
    }
    if a >= AttrBold {
        out = out + ";1"
    }
    return out
}

fn (s mut AnsiScreen) present() -> err {
    // Alternate-screen home + clear once per flush is expensive but
    // correct for the S8 bootstrap (S9 adds dirty-rect).
    buf := "\x1b[?1049h\x1b[H\x1b[2J\x1b[0m"
    y := 0
    for y < s.rows {
        x := 0
        buf = buf + "\x1b[" + itoa(y + 1) + ";1H"
        for x < s.cols {
            i := y * s.cols + x
            buf = buf + "\x1b[" + sgr_attr(s.attrs[i]) + "m"
            fg := s.fgs[i]
            if fg >= 0 && fg < 8 {
                buf = buf + "\x1b[" + itoa(30 + fg) + "m"
            }
            bg := s.bgs[i]
            if bg >= 0 && bg < 8 {
                buf = buf + "\x1b[" + itoa(40 + bg) + "m"
            }
            buf = buf + s.chs[i]
            x = x + 1
        }
        y = y + 1
    }
    if s.show_cur {
        buf = buf + "\x1b[?25h\x1b[" + itoa(s.cy + 1) + ";" + itoa(s.cx + 1) + "H"
    } else {
        buf = buf + "\x1b[?25l"
    }
    f := os.stdout()
    [_, we] = f.write(buf as []byte)
    return we
}

// Session owns raw mode + signal arming for a TUI process.
struct Session {
    raw: osterm.Raw,
    scr: own AnsiScreen,
    armed: int,
}

// open_seq enables the input modes S9 needs on top of S8's raw mode:
// SGR mouse (button-event tracking 1002 + SGR coords 1006) and the
// kitty keyboard disambiguate flag (`>1u`) so ctrl+shift+{s,v,z} and
// alt-modified keys arrive as distinguishable CSI-u (corpus §9 notes
// the kitty dependency). Returned by open_seq() for tests.
fn open_seq() -> str {
    return "\x1b[?1002h\x1b[?1006h\x1b[>1u"
}

// close_seq reverses open_seq before leaving the alternate screen.
fn close_seq() -> str {
    return "\x1b[?1002l\x1b[?1006l\x1b[<u"
}

// enter_seq joins the alternate screen FIRST — the kitty keyboard
// stack and the mouse modes are per-screen state, so pushing them
// before `?1049h` lands them on the main screen's stack where the
// TUI never runs (and where they'd stay active after exit).
fn enter_seq() -> str {
    return "\x1b[?1049h" + open_seq()
}

// leave_seq pops kitty + mouse modes BEFORE leaving the alternate
// screen — off the same per-screen stack they were pushed onto.
fn leave_seq() -> str {
    return close_seq() + "\x1b[?1049l\x1b[?25h\x1b[0m"
}

// open_session enters raw mode on stdin, arms SIGINT/SIGWINCH, and
// builds an AnsiScreen sized to the tty. Non-tty → err (caller falls
// back to plain stdout).
fn open_session() -> [own Session, err] {
    if !osterm.isatty(osterm.stdin_fd()) {
        return nil, errors.new("stdin is not a tty")
    }
    [raw, re] = osterm.raw(osterm.stdin_fd())
    if re != nil {
        return nil, re
    }
    cols := 80
    rows := 24
    [sz, se] = osterm.size(osterm.stdout_fd())
    if se == nil {
        cols = sz.cols
        rows = sz.rows
    }
    ae1 := signal.arm("SIGINT")
    if ae1 != nil {
        raw.restore()
        return nil, ae1
    }
    ae2 := signal.arm("SIGWINCH")
    if ae2 != nil {
        // Don't leave SIGINT armed after a half-open session.
        de := signal.disarm("SIGINT")
        raw.restore()
        if de != nil {
            return nil, de
        }
        return nil, ae2
    }
    s := new(Session)
    s.raw = raw
    s.scr = new_ansi(cols, rows)
    s.armed = 1
    // Enter the alt screen, THEN enable SGR mouse + kitty
    // disambiguate (ADR-0028) so they land on the right per-screen
    // stack; failure is non-fatal — keys still decode without them,
    // degrade paths cover the rest.
    f := os.stdout()
    [_, _we] = f.write(enter_seq() as []byte)
    return s, nil
}

fn (s mut Session) close() -> err {
    // Pop the per-screen modes before leaving the alternate screen so
    // a disarm/restore failure cannot trap the parent shell on the
    // hidden buffer — and no mode stays pushed on the wrong screen.
    f := os.stdout()
    [nw, we] = f.write(leave_seq() as []byte)
    first := we
    if nw < 0 && first == nil {
        // ignore short write on teardown
    }
    if s.armed != 0 {
        de1 := signal.disarm("SIGINT")
        de2 := signal.disarm("SIGWINCH")
        s.armed = 0
        if first == nil {
            first = de1
        }
        if first == nil {
            first = de2
        }
    }
    re := s.raw.restore()
    if first != nil {
        return first
    }
    return re
}

fn (s mut Session) interrupted() -> bool {
    [hit, e] = signal.take("SIGINT")
    if e != nil {
        return false
    }
    return hit
}

fn (s mut Session) resized() -> bool {
    [hit, e] = signal.take("SIGWINCH")
    if e != nil || !hit {
        return false
    }
    [sz, se] = osterm.size(osterm.stdout_fd())
    if se != nil {
        return true
    }
    s.scr = new_ansi(sz.cols, sz.rows)
    return true
}

fn (s mut Session) screen() -> Screen {
    return s.scr
}
