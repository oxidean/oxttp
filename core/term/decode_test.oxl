package term

// Input decoder tests — corpus §3 key grammar (ctrl/alt/shift/meta/
// super + named keys) + SGR mouse (§4.6 clickables).

import "std/testing"

fn ev_str(e: KeyEvent) -> str {
    s := ""
    if e.ctrl {
        s = s + "ctrl+"
    }
    if e.alt {
        s = s + "alt+"
    }
    if e.shift {
        s = s + "shift+"
    }
    if e.meta {
        s = s + "meta+"
    }
    if e.sup {
        s = s + "super+"
    }
    k := e.key.kind()
    if k == 0 {
        r := e.key as Key.Rune
        s = s + "rune:" + r.ch
    } else if k == 1 {
        n := e.key as Key.Named
        s = s + "named:" + itoa(n.code)
    } else {
        m := e.key as Key.Mouse
        s = s + "mouse:" + itoa(m.kind) + ":" + itoa(m.x) + "," + itoa(m.y) + "b" + itoa(m.button)
    }
    return s
}

fn feed_all(d: mut Decoder, s: str) -> []KeyEvent {
    return d.feed(s as []byte)
}

fn test_decode_runes() {
    d := new_decoder()
    evs := feed_all(d, "abZ")
    testing.expect_eq(len(evs), 3, "3 runes")
    r := evs[0].key as Key.Rune
    testing.expect_streq(r.ch, "a", "a")
    r2 := evs[2].key as Key.Rune
    testing.expect_streq(r2.ch, "Z", "Z")
    testing.expect(evs[2].shift, "upper Z implies shift")
    testing.expect(!evs[0].shift, "lower a no shift")
}

fn test_decode_utf8() {
    d := new_decoder()
    evs := feed_all(d, "héllo")
    testing.expect_eq(len(evs), 5, "5 runes")
    r := evs[1].key as Key.Rune
    testing.expect_streq(r.ch, "é", "é rune")
    // split across feeds
    d2 := new_decoder()
    e1 := feed_all(d2, "h\xc3")
    testing.expect_eq(len(e1), 1, "partial held")
    e2 := feed_all(d2, "\xa9i")
    testing.expect_eq(len(e2), 2, "tail+next")
    r2 := e2[0].key as Key.Rune
    testing.expect_streq(r2.ch, "é", "é across feeds")
}

fn test_decode_c0() {
    d := new_decoder()
    evs := feed_all(d, "\x0d\x0a\x09\x08\x03")
    testing.expect_eq(len(evs), 5, "5 events")
    n := evs[0].key as Key.Named
    testing.expect_eq(n.code, KeyEnter, "0x0d enter")
    testing.expect(!evs[0].ctrl, "enter no ctrl")
    r := evs[1].key as Key.Rune
    testing.expect_streq(r.ch, "j", "0x0a = ctrl+j")
    testing.expect(evs[1].ctrl, "ctrl+j flag")
    n2 := evs[2].key as Key.Named
    testing.expect_eq(n2.code, KeyTab, "0x09 tab")
    n3 := evs[3].key as Key.Named
    testing.expect_eq(n3.code, KeyBackspace, "0x08 backspace")
    r4 := evs[4].key as Key.Rune
    testing.expect_streq(r4.ch, "c", "0x03 = ctrl+c")
    testing.expect(evs[4].ctrl, "ctrl flag")
}

fn test_decode_ctrl_letters() {
    d := new_decoder()
    // 0x10 ctrl+p, 0x13 ctrl+s, 0x0f ctrl+o, 0x1a ctrl+z, 0x00 ctrl+space
    // (0x00 can't ride a str literal — C-string truncation — feed bytes)
    evs := feed_all(d, "\x10\x13\x0f\x1a")
    nb := mkslice(byte, 1)
    nb[0] = 0
    evs2 := d.feed(nb)
    testing.expect_eq(len(evs), 4, "4")
    testing.expect_eq(len(evs2), 1, "nul event")
    r := evs[0].key as Key.Rune
    testing.expect_streq(r.ch, "p", "ctrl+p")
    testing.expect(evs[0].ctrl, "p ctrl")
    r2 := evs[3].key as Key.Rune
    testing.expect_streq(r2.ch, "z", "ctrl+z")
    r3 := evs2[0].key as Key.Rune
    testing.expect_streq(r3.ch, " ", "ctrl+space")
    testing.expect(evs2[0].ctrl, "ctrl flag")
}

fn test_decode_del_backspace() {
    d := new_decoder()
    evs := feed_all(d, "\x7f")
    testing.expect_eq(len(evs), 1, "1")
    n := evs[0].key as Key.Named
    testing.expect_eq(n.code, KeyBackspace, "0x7f backspace")
}

fn test_decode_csi_arrows() {
    d := new_decoder()
    evs := feed_all(d, "\x1b[A\x1b[B\x1b[C\x1b[D")
    testing.expect_eq(len(evs), 4, "4 arrows")
    n := evs[0].key as Key.Named
    testing.expect_eq(n.code, KeyUp, "up")
    n3 := evs[3].key as Key.Named
    testing.expect_eq(n3.code, KeyLeft, "left")
}

fn test_decode_csi_modifiers() {
    d := new_decoder()
    // CSI 1;2A = shift+up, 1;3A alt+up, 1;5A ctrl+up, 1;6A ctrl+shift+up
    evs := feed_all(d, "\x1b[1;2A\x1b[1;3A\x1b[1;5A\x1b[1;6A")
    testing.expect_eq(len(evs), 4, "4")
    testing.expect(evs[0].shift && !evs[0].ctrl && !evs[0].alt, "shift+up")
    testing.expect(evs[1].alt && !evs[1].shift, "alt+up")
    testing.expect(evs[2].ctrl && !evs[2].alt, "ctrl+up")
    testing.expect(evs[3].ctrl && evs[3].shift, "ctrl+shift+up")
    n := evs[3].key as Key.Named
    testing.expect_eq(n.code, KeyUp, "still up")
}

fn test_decode_csi_tilde() {
    d := new_decoder()
    // delete=3~, insert=2~, pgup=5~, pgdown=6~, home=7~ or 1~, end=8~ or 4~
    evs := feed_all(d, "\x1b[3~\x1b[2~\x1b[5~\x1b[6~\x1b[7~\x1b[8~\x1b[4~\x1b[1~\x1b[3;5~")
    testing.expect_eq(len(evs), 9, "9")
    n := evs[0].key as Key.Named
    testing.expect_eq(n.code, KeyDelete, "3~ delete")
    n2 := evs[2].key as Key.Named
    testing.expect_eq(n2.code, KeyPgUp, "5~ pgup")
    n4 := evs[4].key as Key.Named
    testing.expect_eq(n4.code, KeyHome, "7~ home")
    n8 := evs[8].key as Key.Named
    testing.expect_eq(n8.code, KeyDelete, "3;5~ delete")
    testing.expect(evs[8].ctrl, "3;5~ ctrl")
}

fn test_decode_csi_hf_z() {
    d := new_decoder()
    evs := feed_all(d, "\x1b[H\x1b[F\x1b[Z")
    testing.expect_eq(len(evs), 3, "3")
    n := evs[0].key as Key.Named
    testing.expect_eq(n.code, KeyHome, "H home")
    n2 := evs[1].key as Key.Named
    testing.expect_eq(n2.code, KeyEnd, "F end")
    n3 := evs[2].key as Key.Named
    testing.expect_eq(n3.code, KeyTab, "Z shift+tab")
    testing.expect(evs[2].shift, "Z is shift+tab")
}

fn test_decode_csi_fkeys() {
    d := new_decoder()
    // f5=15~ .. f8=18~, f9=20~ f10=21~ f11=23~ f12=24~; f1..f4 = 11~..14~
    evs := feed_all(d, "\x1b[15~\x1b[24~\x1b[11~\x1b[14~")
    testing.expect_eq(len(evs), 4, "4")
    n := evs[0].key as Key.Named
    testing.expect_eq(n.code, KeyF1 + 4, "15~ = f5")
    n2 := evs[1].key as Key.Named
    testing.expect_eq(n2.code, KeyF1 + 11, "24~ = f12")
    n3 := evs[2].key as Key.Named
    testing.expect_eq(n3.code, KeyF1, "11~ = f1")
    n4 := evs[3].key as Key.Named
    testing.expect_eq(n4.code, KeyF1 + 3, "14~ = f4")
}

fn test_decode_ss3() {
    d := new_decoder()
    // SS3 P-S = f1-f4; A-D arrows; H/F home/end
    evs := feed_all(d, "\x1bOP\x1bOS\x1bOA\x1bOH")
    testing.expect_eq(len(evs), 4, "4")
    n := evs[0].key as Key.Named
    testing.expect_eq(n.code, KeyF1, "SS3 P = f1")
    n2 := evs[1].key as Key.Named
    testing.expect_eq(n2.code, KeyF1 + 3, "SS3 S = f4")
    n3 := evs[2].key as Key.Named
    testing.expect_eq(n3.code, KeyUp, "SS3 A = up")
    n4 := evs[3].key as Key.Named
    testing.expect_eq(n4.code, KeyHome, "SS3 H = home")
}

fn test_decode_kitty_u() {
    d := new_decoder()
    // ctrl+shift+v: code 118 mods 6 (1+shift1+ctrl4)
    // ctrl+shift+s: code 115 mods 6
    // ctrl+shift+z: code 122 mods 6
    evs := feed_all(d, "\x1b[118;6u\x1b[115;6u\x1b[122;6u")
    testing.expect_eq(len(evs), 3, "3")
    r := evs[0].key as Key.Rune
    testing.expect_streq(r.ch, "v", "code 118 = v")
    testing.expect(evs[0].ctrl && evs[0].shift && !evs[0].alt, "ctrl+shift")
    r2 := evs[1].key as Key.Rune
    testing.expect_streq(r2.ch, "s", "code 115 = s")
    r3 := evs[2].key as Key.Rune
    testing.expect_streq(r3.ch, "z", "code 122 = z")
    // plain u without mods
    evs2 := feed_all(d, "\x1b[97u")
    testing.expect_eq(len(evs2), 1, "a")
    r4 := evs2[0].key as Key.Rune
    testing.expect_streq(r4.ch, "a", "97u = a")
}

fn test_decode_mouse_sgr() {
    d := new_decoder()
    // ESC [ < 0 ; 10 ; 5 M = left press at col10 row5 (1-based → 0-based)
    evs := feed_all(d, "\x1b[<0;10;5M")
    testing.expect_eq(len(evs), 1, "1 mouse")
    m := evs[0].key as Key.Mouse
    testing.expect_eq(m.kind, MousePress, "press")
    testing.expect_eq(m.button, 0, "left")
    testing.expect_eq(m.x, 9, "x 0-based")
    testing.expect_eq(m.y, 4, "y 0-based")
    // release
    evs2 := feed_all(d, "\x1b[<0;10;5m")
    m2 := evs2[0].key as Key.Mouse
    testing.expect_eq(m2.kind, MouseRelease, "release")
    // scroll up = 64+0, scroll down = 64+1
    evs3 := feed_all(d, "\x1b[<64;3;2M\x1b[<65;3;2M")
    m3 := evs3[0].key as Key.Mouse
    testing.expect_eq(m3.kind, MouseScrollUp, "64 = scroll up")
    m4 := evs3[1].key as Key.Mouse
    testing.expect_eq(m4.kind, MouseScrollDown, "65 = scroll down")
    // ctrl+click: 0+16
    evs4 := feed_all(d, "\x1b[<16;1;1M")
    m5 := evs4[0].key as Key.Mouse
    testing.expect_eq(m5.button, 0, "btn0")
    testing.expect(evs4[0].ctrl, "ctrl held")
}

fn test_decode_alt() {
    d := new_decoder()
    // alt+enter = ESC 0x0d in same chunk; alt+j = ESC j; alt+right = ESC [ 1 ; 3 C
    evs := feed_all(d, "\x1b\x0d")
    testing.expect_eq(len(evs), 1, "alt+enter")
    n := evs[0].key as Key.Named
    testing.expect_eq(n.code, KeyEnter, "enter")
    testing.expect(evs[0].alt, "alt flag")
    evs2 := feed_all(d, "\x1bj")
    testing.expect_eq(len(evs2), 1, "alt+j")
    r := evs2[0].key as Key.Rune
    testing.expect_streq(r.ch, "j", "j")
    testing.expect(evs2[0].alt, "alt")
    evs3 := feed_all(d, "\x1b[1;3C")
    testing.expect_eq(len(evs3), 1, "alt+right via csi")
    n3 := evs3[0].key as Key.Named
    testing.expect_eq(n3.code, KeyRight, "right")
    testing.expect(evs3[0].alt, "alt")
}

fn test_decode_lone_esc() {
    d := new_decoder()
    evs := feed_all(d, "\x1b")
    testing.expect_eq(len(evs), 1, "lone esc")
    n := evs[0].key as Key.Named
    testing.expect_eq(n.code, KeyEscape, "escape")
    testing.expect(!evs[0].alt, "no alt")
    // ESC ESC x = alt+escape then x? same-chunk: ESC ESC → alt+escape
    d2 := new_decoder()
    evs2 := feed_all(d2, "\x1b\x1bx")
    testing.expect_eq(len(evs2), 2, "esc-esc-x")
    n2 := evs2[0].key as Key.Named
    testing.expect_eq(n2.code, KeyEscape, "alt+escape")
    testing.expect(evs2[0].alt, "alt on escape")
    r := evs2[1].key as Key.Rune
    testing.expect_streq(r.ch, "x", "x plain")
}

fn test_decode_partial_tail() {
    d := new_decoder()
    e1 := feed_all(d, "a\x1b[1;")
    testing.expect_eq(len(e1), 1, "only a")
    e2 := feed_all(d, "5A")
    testing.expect_eq(len(e2), 1, "completed csi")
    n := e2[0].key as Key.Named
    testing.expect_eq(n.code, KeyUp, "up")
    testing.expect(e2[0].ctrl, "ctrl")
}

fn test_decode_invalid_skip() {
    d := new_decoder()
    // lone 0x80 continuation byte then 'a'
    evs := feed_all(d, "\x80\x61")
    testing.expect_eq(len(evs), 1, "skip bad byte")
    r := evs[0].key as Key.Rune
    testing.expect_streq(r.ch, "a", "a")
}

fn test_decode_shift_tab_csi() {
    d := new_decoder()
    // some terms send CSI 1;2Z? keep Z handled; also 27;2~? no.
    evs := feed_all(d, "\x1b[1;2D\x1b[1;4D\x1b[1;8D")
    testing.expect_eq(len(evs), 3, "3")
    testing.expect(evs[0].shift && !evs[0].ctrl && !evs[0].alt, "shift+left")
    testing.expect(evs[1].shift && evs[1].alt && !evs[1].ctrl, "mod4 = shift+alt+left")
    testing.expect(evs[2].shift && evs[2].alt && evs[2].ctrl, "mod8 = shift+alt+ctrl+left")
}

fn test_session_seqs() {
    // mouse 1002+1006 on / kitty disambiguate on
    testing.expect_streq(open_seq(), "\x1b[?1002h\x1b[?1006h\x1b[>1u", "open seq")
    testing.expect_streq(close_seq(), "\x1b[?1002l\x1b[?1006l\x1b[<u", "close seq")
}
