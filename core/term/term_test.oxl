package term

// Screen/Key surface — key vocabulary, modifier bitset, and a
// headless Screen implementation proving the port is implementable.

import "std/testing"

struct MockScreen {
    w: int,
    h: int,
    cells: int,
    cx: int,
    cy: int,
    cur_show: bool,
    presents: int,
}

fn (s MockScreen) size() -> CellSize {
    return CellSize{cols: s.w, rows: s.h}
}

fn (s mut MockScreen) set_cell(x: int, y: int, ch: str, fg: int, bg: int, attr: int) {
    s.cells = s.cells + 1
}

fn (s mut MockScreen) present() -> err {
    s.presents = s.presents + 1
    return nil
}

fn (s mut MockScreen) cursor(x: int, y: int, show: bool) {
    s.cx = x
    s.cy = y
    s.cur_show = show
}

fn test_key_surface() {
    e := KeyEvent{key: Key.Named{code: KeyEnter}, ctrl: true,
        alt: false, shift: false, meta: false, sup: false}
    n := e.key as Key.Named
    testing.expect_eq(n.code, 1, "enter code")
    testing.expect(e.ctrl && !e.alt, "ctrl flag")

    e = KeyEvent{key: Key.Rune{ch: "g"}, ctrl: false,
        alt: false, shift: false, meta: false, sup: false}
    r := e.key as Key.Rune
    testing.expect_streq(r.ch, "g", "rune")

    e = KeyEvent{key: Key.Mouse{kind: MouseScrollUp, x: 4, y: 9, button: 0},
        ctrl: false, alt: false, shift: false, meta: false, sup: false}
    m := e.key as Key.Mouse
    testing.expect_eq(m.kind, 3, "scroll up kind")
    testing.expect_eq(m.y, 9, "mouse y")
}

fn test_named_key_coverage() {
    // every corpus named key has a distinct code; f1..f12 contiguous
    testing.expect_eq(KeyF1 + 11, 111, "f12 = f1+11")
    testing.expect(KeyEnter != KeyEscape, "enter != esc")
    testing.expect(KeyPgUp != KeyPgDown, "pgup != pgdown")
}

fn test_screen_port() {
    s := MockScreen{w: 80, h: 24, cells: 0, cx: 0, cy: 0, cur_show: false, presents: 0}
    let scr: Screen = s
    sz := scr.size()
    testing.expect_eq(sz.cols, 80, "size w")
    testing.expect_eq(sz.rows, 24, "size h")
    scr.set_cell(0, 0, "x", 0, 0, AttrBold)
    scr.cursor(1, 1, true)
    e := scr.present()
    testing.expect(e == nil, "present ok")
}

fn test_ansi_grid() {
    a := new_ansi(4, 2)
    testing.expect_eq(a.cols, 4, "cols")
    testing.expect_eq(a.rows, 2, "rows")
    a.set_cell(1, 0, "Z", 1, 2, AttrBold)
    testing.expect_streq(a.chs[1], "Z", "cell ch")
    testing.expect_eq(a.fgs[1], 1, "fg")
    testing.expect_streq(sgr_attr(AttrBold + AttrUnderline), "0;4;1", "sgr bits")
    let scr: Screen = a
    sz := scr.size()
    testing.expect_eq(sz.cols, 4, "iface size")
}

fn test_sgr_attr_plain() {
    testing.expect_streq(sgr_attr(0), "0", "plain")
}

fn test_wide_overwrite_drops_mate() {
    // overwriting EITHER half of a wide pair must drop the mate —
    // a stale "" continuation prints the next cell one column
    // early, a stale lead overprints the new cell.
    a := new_ansi(10, 2)
    a.set_cell(0, 0, "界", 7, -1, 0)
    a.set_wide_cont(1, 0)
    a.set_cell(2, 0, "b", 7, -1, 0)
    // replace the lead
    a.set_cell(0, 0, "A", 7, -1, 0)
    testing.expect_streq(a.chs[0], "A", "lead replaced")
    testing.expect_streq(a.chs[1], " ", "stale cont blanked")
    testing.expect_streq(a.chs[2], "b", "next cell unmoved")
    // replace the continuation
    b := new_ansi(10, 2)
    b.set_cell(0, 0, "界", 7, -1, 0)
    b.set_wide_cont(1, 0)
    b.set_cell(1, 0, "B", 7, -1, 0)
    testing.expect_streq(b.chs[0], " ", "stale lead blanked")
    testing.expect_streq(b.chs[1], "B", "cont replaced")
    // untouched pairs survive unrelated writes
    c := new_ansi(10, 2)
    c.set_cell(0, 0, "界", 7, -1, 0)
    c.set_wide_cont(1, 0)
    c.set_cell(3, 0, "z", 7, -1, 0)
    testing.expect_streq(c.chs[0], "界", "lead intact")
    testing.expect_streq(c.chs[1], "", "cont intact")
    testing.expect_streq(c.chs[3], "z", "far cell")
    // and a cont-over-write keeps column accounting for present()
    d := new_ansi(10, 2)
    d.set_cell(0, 0, "界", 7, -1, 0)
    d.set_wide_cont(1, 0)
    d.set_cell(0, 0, "界", 7, -1, 0)   // rewrite same lead
    d.set_wide_cont(1, 0)              // re-mark cont — still paired
    testing.expect_streq(d.chs[0], "界", "lead rewritten")
    testing.expect_streq(d.chs[1], "", "cont remarked")
    testing.expect_streq(d.chs[2], " ", "no orphan")
}
