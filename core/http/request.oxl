package http

// Domain model for an outgoing HTTP request. Transport details live
// behind this package: the h1 implementation sits on std/net today,
// HTTPS/TLS joins when oxl std gains it — apps never open sockets.
struct Req {
    method: str,
    url: str,
}

fn new(method: str, url: str) -> Req {
    return Req{method: method, url: url}
}
