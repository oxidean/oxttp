package http

// Scripted fixture server for the live-transport matrix. A plain
// net.Listener accepts connections serially; each connection's raw
// request (head + Content-Length body) is captured, then the i-th
// script entry is written back. Script tokens: "<ECHO>" synthesizes
// a 200 response whose body IS the captured request (correct
// Content-Length computed here) — request-side assertions read the
// echo; "<SLEEP:n>" prefix delays the reply n ms (timeout coverage).
// std/net/http serve() can't emit chunked, trailer, or redirect
// responses, hence the hand-rolled socket loop
// (context/references/std-net-transport-surface.md).
import "std/net"

import "std/net/http2"

import "std/strconv"

import "std/testing"

// Fx is a running fixture: the listener, its port, and a hit counter.
struct Fx {
    l: net.Listener,
    port: int,
    hits: shared,
}

// fx_start binds an ephemeral port and serves len(script)
// connections serially, then closes the listener. The loop runs
// detached; tests call fx_stop (accept also self-limits to 30s).
fn fx_start(script: []str) -> own Fx {
    [l, e] = net.listen(0)
    testing.expect(e == nil, "fx listen")
    f := new(Fx)
    f.l = l
    f.port = l.port()
    f.hits = mkshared(0)
    spawnBlocking fx_serve(l, new(script), f.hits)
    return f
}

fn (f ref Fx) url() -> str {
    return "http://127.0.0.1:" + itoa(f.port)
}

fn (f mut Fx) stop() {
    f.l.close()
}

fn fx_serve(l: net.Listener, script: own []str, hits: shared) {
    set_rcvtimo(l.rawfd(), 30) // a dead client can't hang the test
    i := 0
    for i < len(script) {
        [c, e] = l.accept()
        if e != nil {
            l.close()
            return
        }
        fx_conn(c, script[i], hits)
        i = i + 1
    }
    l.close()
}

// fx_conn captures the request, then writes the scripted response.
fn fx_conn(c: net.Conn, resp: str, hits: shared) {
    defer c.close()
    set_rcvtimo(c.rawfd(), 20)
    req := fx_read_req(c)
    sadd(hits, 1)
    delay := 0
    if len(resp) >= 7 && substr(resp, 0, 7) == "<SLEEP:" {
        end := find(resp, ">")
        [ms, _e] = strconv.atoi(substr(resp, 7, end))
        delay = ms
        resp = substr(resp, end + 1, len(resp))
    }
    if resp == "<ECHO>" {
        resp = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: " + itoa(len(req)) + "\r\nConnection: close\r\n\r\n" + req
    }
    if delay > 0 {
        msleep(delay)
    }
    fx_write_all(c, resp as []byte)
}

// fx_read_req accumulates a request head through \r\n\r\n, then
// drains the Content-Length body, returning head+body verbatim.
fn fx_read_req(c: net.Conn) -> str {
    req := ""
    scratch := mkslice(byte, 4096)
    for find(req, "\r\n\r\n") < 0 {
        [n, e] = c.read(scratch)
        if n > 0 {
            req = req + scratch[0:n] as str
        }
        if e != nil || n <= 0 {
            return req
        }
        if len(req) > 65536 {
            return req
        }
    }
    he := find(req, "\r\n\r\n")
    cl := fx_req_len(req, he)
    have := len(req) - (he + 4)
    for have < cl {
        [n, e] = c.read(scratch)
        if n > 0 {
            req = req + scratch[0:n] as str
            have = have + n
        }
        if e != nil || n <= 0 {
            return req
        }
    }
    return req
}

// fx_req_len extracts Content-Length from a request head (0 absent).
fn fx_req_len(req: str, he: int) -> int {
    low := fx_lwr(substr(req, 0, he))
    i := find(low, "\r\ncontent-length:")
    if i < 0 {
        return 0
    }
    j := i + 17
    for j < len(low) && (byteat(low, j) == 32 || byteat(low, j) == 9) {
        j = j + 1
    }
    n := 0
    for j < len(low) && byteat(low, j) >= 48 && byteat(low, j) <= 57 {
        n = n * 10 + (byteat(low, j) - 48)
        j = j + 1
    }
    return n
}

fn fx_lwr(s: str) -> str {
    b := s as []byte
    out := mkslice(byte, len(s))
    i := 0
    for i < len(s) {
        c := b[i]
        if c >= 65 && c <= 90 {
            c = c + 32
        }
        out[i] = c
        i = i + 1
    }
    return out as str
}

fn fx_write_all(c: net.Conn, b: []byte) {
    off := 0
    for off < len(b) {
        [n, e] = c.write(b[off:])
        if e != nil || n <= 0 {
            return
        }
        off = off + n
    }
}

// --- h2 fixture (WI-0013 P3) --------------------------------------
// A minimal server-side h2 peer built on the exported frame/hpack
// surface: reads the client preface + SETTINGS, answers SETTINGS,
// reads HEADERS/CONTINUATION/DATA on the client's stream, then sends
// a scripted response. Script entry "<H2ECHO>" returns a body that
// dumps the decoded request pseudo-headers + request body — the
// h2 twin of <ECHO>.

fn h2_start(script: []str) -> own Fx {
    [l, e] = net.listen(0)
    testing.expect(e == nil, "h2fx listen")
    f := new(Fx)
    f.l = l
    f.port = l.port()
    f.hits = mkshared(0)
    spawnBlocking h2fx_serve(l, new(script), f.hits)
    return f
}

fn h2fx_serve(l: net.Listener, script: own []str, hits: shared) {
    set_rcvtimo(l.rawfd(), 30)
    i := 0
    for i < len(script) {
        [c, e] = l.accept()
        if e != nil {
            l.close()
            return
        }
        h2fx_conn(c, script[i], hits)
        i = i + 1
    }
    l.close()
}

fn h2fx_conn(c: net.Conn, resp: str, hits: shared) {
    defer c.close()
    set_rcvtimo(c.rawfd(), 20)
    rw := c.asreadwriter()
    scratch := mkslice(byte, 24)
    [_pre, _re] = http2.read_exact(rw, 24)
    // client SETTINGS (ignored) then server SETTINGS then its ack
    [_sf, _se] = http2.read_frame(rw, 16384)
    http2.write_frame(rw, http2.FrameHeader{length: 0, kind: 4, flags: 0, stream_id: 0}, mkslice(byte, 0))
    [dec, _de] = http2.new_decoder(4096, 65536)
    dump := ""
    body := ""
    sid := 0
    end_stream := false
    end_headers := false
    read_err := false
    frames := 0
    for !(end_stream && end_headers) && frames < 32 {
        frames = frames + 1
        [f, fe] = http2.read_frame(rw, 16384)
        if fe != nil {
            read_err = true
            break
        }
        k := f.header.kind
        if k == 4 || k == 8 || k == 6 {
            continue // SETTINGS ack / WINDOW_UPDATE / PING
        }
        if k == 1 || k == 9 { // HEADERS / CONTINUATION
            [hs2, he] = http2.decode_headers(dec, f.payload)
            if he == nil {
                j := 0
                for j < len(hs2) {
                    dump = dump + hs2[j].name + ": " + hs2[j].value + "\n"
                    j = j + 1
                }
            }
            if k == 1 {
                sid = f.header.stream_id
            }
            // END_HEADERS (0x4) may land on a later CONTINUATION even
            // when END_STREAM (0x1) already closed the stream — the
            // request is complete only when both are seen (F5/F6).
            if (f.header.flags & 4) != 0 {
                end_headers = true
            }
            if (f.header.flags & 1) != 0 {
                end_stream = true
            }
            continue
        }
        if k == 0 { // DATA
            sid = f.header.stream_id
            body = body + f.payload as str
            if (f.header.flags & 1) != 0 {
                end_stream = true
            }
            continue
        }
    }
    complete := end_stream && end_headers && !read_err
    if sid == 0 {
        sid = 1
    }
    if !complete {
        // an incomplete request (read error, frame limit, missing
        // END_STREAM/END_HEADERS) fails loudly instead of echoing a
        // partial request as success.
        let brh: []http2.Header = nil
        brh = push(brh, http2.Header{name: ":status", value: "500"})
        [bblk, _bbe] = http2.encode_headers(brh)
        http2.write_frame(rw, http2.FrameHeader{length: len(bblk), kind: 1, flags: 4, stream_id: sid}, bblk)
        bmsg := "fx-incomplete-request"
        http2.write_frame(rw, http2.FrameHeader{length: len(bmsg), kind: 0, flags: 1, stream_id: sid}, bmsg as []byte)
        return
    }
    sadd(hits, 1)
    let rh: []http2.Header = nil
    rh = push(rh, http2.Header{name: ":status", value: "200"})
    rh = push(rh, http2.Header{name: "content-type", value: "text/plain"})
    [blk, _be] = http2.encode_headers(rh)
    http2.write_frame(rw, http2.FrameHeader{length: len(blk), kind: 1, flags: 4, stream_id: sid}, blk)
    out := dump + body
    if resp != "<H2ECHO>" {
        out = resp
    }
    http2.write_frame(rw, http2.FrameHeader{length: len(out), kind: 0, flags: 1, stream_id: sid}, out as []byte)
}

// --- CONNECT-capture fixture (WI-0013 P4) --------------------------
// One conn: read the CONNECT head through \r\n\r\n, stash it in the
// shared cell for assertions, reply 200, then drain whatever the
// client sends next (TLS ClientHello) briefly before closing.
struct CapFx {
    l: net.Listener,
    port: int,
    cap: own []str,
}

fn capfx_start() -> own CapFx {
    return capfx_start_reply("HTTP/1.1 200 Connection established\r\n\r\n")
}

// capfx_start_reply with a custom CONNECT reply head (2xx variants,
// framing headers — RFC 9110 reply-shape coverage, review F12/F13).
fn capfx_start_reply(reply: str) -> own CapFx {
    [l, e] = net.listen(0)
    testing.expect(e == nil, "capfx listen")
    f := new(CapFx)
    f.l = l
    f.port = l.port()
    f.cap = new(mkslice(str, 1))
    spawnBlocking capfx_serve(l, f.cap, reply)
    return f
}

fn capfx_serve(l: net.Listener, cap: own []str, reply: str) {
    set_rcvtimo(l.rawfd(), 30)
    [c, e] = l.accept()
    if e != nil {
        l.close()
        return
    }
    set_rcvtimo(c.rawfd(), 10)
    req := ""
    scratch := mkslice(byte, 2048)
    for find(req, "\r\n\r\n") < 0 && len(req) < 32768 {
        [n, e2] = c.read(scratch)
        if n > 0 {
            req = req + scratch[0:n] as str
        }
        if e2 != nil || n <= 0 {
            break
        }
    }
    cap[0] = req
    fx_write_all(c, reply as []byte)
    // drain briefly — the client now speaks TLS ClientHello we can't
    // answer; read-and-discard until it gives up or socket dies
    [_r2, _e3] = c.read(scratch)
    c.close()
    l.close()
}
