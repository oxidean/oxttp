package http

// Live-transport matrix — real sockets against the scripted fixture
// (spec AC4/AC5). Request-side assertions ride the fixture's <ECHO>
// mode (response body = the request it received); response-side
// assertions read model.Resp fields.
import "std/errors"

import "std/testing"

import "std/encoding/base64"

import "github.com/oxidean/oxttp/core/model"

fn rq(method: str, u: str) -> own model.Req {
    return new(model.Req{method: method, url: u, headers: nil, body: model.Body.Empty, timeout_ms: 0, follow: false, max_redirects: 10, httpver: "", synth: nil, verify: "", h2: "", ssl_min: 0, ssl_max: 0, cert_pem: "", key_pem: "", proxies: nil, proxy_env: nil, no_proxy: ""})
}

fn hs1(n: str, v: str) -> []model.Header {
    let h: []model.Header = nil
    h = push(h, model.Header{name: n, value: v})
    return h
}

fn one(s: str) -> []str {
    sc := mkslice(str, 1)
    sc[0] = s
    return sc
}

fn test_port_satisfaction() {
    f := fx_start(one("<ECHO>"))
    defer f.stop()
    let tr: Transport = H1{}
    testing.expect(tr != nil, "H1 satisfies Transport")
    r := rq("GET", f.url() + "/")
    [resp, e] = tr.send(r)
    testing.expect(e == nil, "send through port")
    if e == nil {
        testing.expect_eq(resp.status, 200, "iface dispatch round-trip")
    }
}

fn test_get_request_line_and_headers() {
    f := fx_start(one("<ECHO>"))
    defer f.stop()
    r := rq("GET", f.url() + "/p?q=1")
    [resp, e] = request(r)
    testing.expect(e == nil, "echo get send")
    if e != nil {
        return
    }
    b := resp.body as str
    testing.expect_eq(resp.status, 200, "status 200")
    testing.expect_eq(find(b, "GET /p?q=1 HTTP/1.1\r\n"), 0, "request line first")
    testing.expect(find(b, "\r\nHost: 127.0.0.1:") >= 0, "host header")
    testing.expect(find(b, "Accept-Encoding: gzip, deflate") >= 0, "ae default")
    testing.expect(find(b, "Connection: close") >= 0, "conn close")
    testing.expect(find(b, "Content-Length") < 0, "no CL on empty GET")
    testing.expect(find(b, "\r\n\r\n") >= 0, "head terminated")
    testing.expect_streq(hdr_get(resp.headers, "content-type"), "text/plain", "resp ctype")
    testing.expect(resp.elapsed_ms >= 0.0, "elapsed set")
    testing.expect_eq(find(resp.remote, "127.0.0.1:"), 0, "remote addr")
    testing.expect(resp.trace != nil, "trace filled")
    testing.expect(resp.trace.connect_ms >= 0.0, "connect phase")
}

fn test_post_body_and_cl() {
    f := fx_start(one("<ECHO>"))
    defer f.stop()
    r := rq("POST", f.url() + "/submit")
    r.body = model.Body.Raw{ctype: "application/json", text: "{\"k\":1}"}
    r.headers = hs1("Content-Type", "application/json")
    [resp, e] = request(r)
    testing.expect(e == nil, "post send")
    if e != nil {
        return
    }
    b := resp.body as str
    testing.expect_eq(find(b, "POST /submit HTTP/1.1"), 0, "post line")
    testing.expect(find(b, "Content-Length: 7\r\n") >= 0, "cl synthesized")
    testing.expect(strings_ends(b, "{\"k\":1}"), "body verbatim")
}

fn test_custom_headers_order() {
    f := fx_start(one("<ECHO>"))
    defer f.stop()
    r := rq("GET", f.url() + "/")
    let hs: []model.Header = nil
    hs = push(hs, model.Header{name: "X-One", value: "1"})
    hs = push(hs, model.Header{name: "X-Two", value: "2"})
    r.headers = hs
    [resp, e] = request(r)
    testing.expect(e == nil, "headers send")
    if e != nil {
        return
    }
    b := resp.body as str
    i1 := find(b, "X-One: 1")
    i2 := find(b, "X-Two: 2")
    testing.expect(i1 > 0 && i2 > i1, "caller order preserved")
}

fn test_userinfo_basic_auth() {
    f := fx_start(one("<ECHO>"))
    defer f.stop()
    r := rq("GET", "http://user:pass@127.0.0.1:" + itoa(f.port) + "/")
    [resp, e] = request(r)
    testing.expect(e == nil, "userinfo send")
    if e != nil {
        return
    }
    b := resp.body as str
    // base64("user:pass") = dXNlcjpwYXNz
    exp := "Authorization: " + "Basic " + base64.encode("user:pass" as []byte)
    testing.expect(find(b, exp) >= 0, "userinfo->basic")
}

fn test_multipart_live() {
    f := fx_start(one("<ECHO>"))
    defer f.stop()
    r := rq("POST", f.url() + "/up")
    let psv: []model.Part = nil
    psv = push(psv, model.Part{name: "field", value: "val", file: "", filename: "", content_type: "", enabled: true, is_file: false})
    ps := new(psv)
    r.body = model.Body.Multipart{parts: ps}
    [resp, e] = request(r)
    testing.expect(e == nil, "multipart send")
    if e != nil {
        return
    }
    b := resp.body as str
    testing.expect(find(b, "Content-Type: multipart/form-data; boundary=") >= 0, "mp ctype on wire")
    testing.expect(find(b, "name=\"field\"") >= 0, "mp disposition")
    testing.expect(strings_ends(b, "--\r\n"), "mp closing boundary")
}

fn test_chunked_and_trailers() {
    s := "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nContent-Type: text/plain\r\n\r\n9\r\nchunk one\r\nC\r\n + chunk two\r\n0\r\nX-Checksum: abc123\r\n\r\n"
    f := fx_start(one(s))
    defer f.stop()
    r := rq("GET", f.url() + "/")
    [resp, e] = request(r)
    testing.expect(e == nil, "chunked send")
    if e != nil {
        return
    }
    testing.expect_eq(resp.status, 200, "chunked status")
    testing.expect_streq(resp.body as str, "chunk one + chunk two", "dechunked")
    testing.expect_streq(hdr_get(resp.headers, "x-checksum"), "abc123", "trailer appended")
    testing.expect_streq(hdr_get(resp.headers, "transfer-encoding"), "chunked", "te kept")
}

fn test_gzip_and_deflate() {
    gz := "HTTP/1.1 200 OK\r\nContent-Encoding: gzip\r\nContent-Length: 31\r\n\r\n" + hx_b("1f8b08000000000002ffcb48cdc9c957c8af28292900007692580c0b000000")
    zl := "HTTP/1.1 200 OK\r\nContent-Encoding: deflate\r\nContent-Length: 18\r\n\r\n" + hx_b("789c4b494dcb492c4955c84d0500156003c8")
    sc := mkslice(str, 2)
    sc[0] = gz
    sc[1] = zl
    f := fx_start(sc)
    defer f.stop()
    r := rq("GET", f.url() + "/gz")
    [resp, e] = request(r)
    testing.expect(e == nil, "gzip send")
    if e == nil {
        testing.expect_streq(resp.body as str, "hello oxttp", "gzip decoded")
    }
    r2 := rq("GET", f.url() + "/zl")
    [resp2, e2] = request(r2)
    testing.expect(e2 == nil, "deflate send")
    if e2 == nil {
        testing.expect_streq(resp2.body as str, "deflate me", "deflate decoded")
    }
}

fn test_head_and_204() {
    s1 := "HTTP/1.1 200 OK\r\nContent-Length: 100\r\nContent-Type: text/plain\r\n\r\n"
    s2 := "HTTP/1.1 204 No Content\r\nContent-Length: 9\r\n\r\n"
    sc := mkslice(str, 2)
    sc[0] = s1
    sc[1] = s2
    f := fx_start(sc)
    defer f.stop()
    r := rq("HEAD", f.url() + "/")
    [resp, e] = request(r)
    testing.expect(e == nil, "head send")
    if e == nil {
        testing.expect_eq(len(resp.body), 0, "HEAD body empty despite CL")
    }
    r2 := rq("GET", f.url() + "/none")
    [resp2, e2] = request(r2)
    testing.expect(e2 == nil, "204 send")
    if e2 == nil {
        testing.expect_eq(resp2.status, 204, "204 status")
        testing.expect_eq(len(resp2.body), 0, "204 no body read")
    }
}

fn test_informational_skip() {
    s := "HTTP/1.1 100 Continue\r\nX-Interim: y\r\n\r\nHTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nfinal"
    f := fx_start(one(s))
    defer f.stop()
    r := rq("GET", f.url() + "/")
    [resp, e] = request(r)
    testing.expect(e == nil, "1xx send")
    if e == nil {
        testing.expect_eq(resp.status, 200, "skips 100")
        testing.expect_streq(resp.body as str, "final", "post-1xx body")
        testing.expect(hdr_get(resp.headers, "x-interim") == "", "interim headers dropped")
    }
}

fn test_http10_and_eof_body() {
    s := "HTTP/1.0 200 OK\r\n\r\nno-length eof body"
    f := fx_start(one(s))
    defer f.stop()
    r := rq("GET", f.url() + "/")
    [resp, e] = request(r)
    testing.expect(e == nil, "1.0 send")
    if e == nil {
        testing.expect_eq(resp.status, 200, "1.0 status")
        testing.expect_streq(resp.body as str, "no-length eof body", "eof body")
    }
}

fn test_truncated_body() {
    s := "HTTP/1.1 200 OK\r\nContent-Length: 100\r\n\r\nshort"
    f := fx_start(one(s))
    defer f.stop()
    r := rq("GET", f.url() + "/")
    [_resp, e] = request(r)
    testing.expect(e != nil, "truncated CL errors")
    if e != nil {
        testing.expect(find(errors.msg(e), "truncated") >= 0, "truncation message")
    }
}

fn test_redirect_relative() {
    sc := mkslice(str, 2)
    sc[0] = "HTTP/1.1 301 Moved Permanently\r\nLocation: /b\r\nContent-Length: 0\r\n\r\n"
    sc[1] = "<ECHO>"
    f := fx_start(sc)
    defer f.stop()
    r := rq("GET", f.url() + "/a")
    r.follow = true
    [resp, e] = request(r)
    testing.expect(e == nil, "redirect send")
    if e != nil {
        return
    }
    testing.expect_eq(resp.status, 200, "final status")
    testing.expect_eq(sget(f.hits), 2, "two hops")
    testing.expect_eq(find(resp.body as str, "GET /b HTTP/1.1"), 0, "hit /b")
}

fn test_redirect_301_rewrites_post() {
    sc := mkslice(str, 2)
    sc[0] = "HTTP/1.1 302 Found\r\nLocation: /b\r\nContent-Length: 0\r\n\r\n"
    sc[1] = "<ECHO>"
    f := fx_start(sc)
    defer f.stop()
    r := rq("POST", f.url() + "/a")
    r.follow = true
    r.body = model.Body.Raw{ctype: "text/plain", text: "payload"}
    r.headers = hs1("Content-Type", "text/plain")
    [resp, e] = request(r)
    testing.expect(e == nil, "302 send")
    if e != nil {
        return
    }
    b := resp.body as str
    testing.expect_eq(find(b, "GET /b HTTP/1.1"), 0, "POST->GET rewrite")
    testing.expect(find(b, "payload") < 0, "body dropped")
    testing.expect(find(b, "Content-Type:") < 0, "content headers dropped")
}

fn test_redirect_307_preserves() {
    sc := mkslice(str, 2)
    sc[0] = "HTTP/1.1 307 Temporary Redirect\r\nLocation: /b\r\nContent-Length: 0\r\n\r\n"
    sc[1] = "<ECHO>"
    f := fx_start(sc)
    defer f.stop()
    r := rq("POST", f.url() + "/a")
    r.follow = true
    r.body = model.Body.Raw{ctype: "text/plain", text: "keepme"}
    r.headers = hs1("Content-Type", "text/plain")
    [resp, e] = request(r)
    testing.expect(e == nil, "307 send")
    if e != nil {
        return
    }
    b := resp.body as str
    testing.expect_eq(find(b, "POST /b HTTP/1.1"), 0, "307 keeps POST")
    testing.expect(strings_ends(b, "keepme"), "307 keeps body")
    testing.expect(find(b, "Content-Type: text/plain") >= 0, "307 keeps ctype")
}

fn test_redirect_strips_headers() {
    sc := mkslice(str, 2)
    sc[0] = "HTTP/1.1 303 See Other\r\nLocation: /b\r\nContent-Length: 0\r\n\r\n"
    sc[1] = "<ECHO>"
    f := fx_start(sc)
    defer f.stop()
    r := rq("GET", f.url() + "/a")
    r.follow = true
    let hs: []model.Header = nil
    hs = push(hs, model.Header{name: "Authorization", value: "Basic x"})
    hs = push(hs, model.Header{name: "Signature", value: "sig"})
    hs = push(hs, model.Header{name: "X-Keep", value: "k"})
    r.headers = hs
    [resp, e] = request(r)
    testing.expect(e == nil, "strip send")
    if e != nil {
        return
    }
    b := resp.body as str
    testing.expect(find(b, "Signature:") < 0, "signature always stripped")
    testing.expect(find(b, "Authorization:") >= 0, "auth kept same-origin")
    testing.expect(find(b, "X-Keep:") >= 0, "custom kept")
}

fn test_redirect_cross_origin() {
    // second listener is the redirect target; its <ECHO> reveals
    // which headers survived the origin change
    f2 := fx_start(one("<ECHO>"))
    defer f2.stop()
    sc := mkslice(str, 1)
    sc[0] = "HTTP/1.1 301 Moved Permanently\r\nLocation: " + f2.url() + "/x\r\nContent-Length: 0\r\n\r\n"
    f1 := fx_start(sc)
    defer f1.stop()
    r := rq("GET", f1.url() + "/a")
    r.follow = true
    let hs: []model.Header = nil
    hs = push(hs, model.Header{name: "Authorization", value: "Basic x"})
    hs = push(hs, model.Header{name: "Cookie", value: "c=1"})
    r.headers = hs
    [resp, e] = request(r)
    testing.expect(e == nil, "cross send")
    if e != nil {
        return
    }
    b := resp.body as str
    testing.expect(find(b, "Authorization:") < 0, "auth stripped cross-origin")
    testing.expect(find(b, "Cookie:") < 0, "cookie stripped cross-origin")
    testing.expect_eq(sget(f2.hits), 1, "landed on f2")
}

fn test_redirect_no_follow() {
    sc := mkslice(str, 2)
    sc[0] = "HTTP/1.1 301 Moved Permanently\r\nLocation: /b\r\nContent-Length: 0\r\n\r\n"
    sc[1] = "<ECHO>"
    f := fx_start(sc)
    defer f.stop()
    r := rq("GET", f.url() + "/a")
    [resp, e] = request(r)
    testing.expect(e == nil, "no-follow send")
    if e == nil {
        testing.expect_eq(resp.status, 301, "3xx returned untouched")
        testing.expect_eq(sget(f.hits), 1, "one hop only")
    }
}

fn test_redirect_max() {
    sc := mkslice(str, 4)
    sc[0] = "HTTP/1.1 302 Found\r\nLocation: /n1\r\nContent-Length: 0\r\n\r\n"
    sc[1] = "HTTP/1.1 302 Found\r\nLocation: /n2\r\nContent-Length: 0\r\n\r\n"
    sc[2] = "HTTP/1.1 302 Found\r\nLocation: /n3\r\nContent-Length: 0\r\n\r\n"
    sc[3] = "<ECHO>"
    f := fx_start(sc)
    defer f.stop()
    r := rq("GET", f.url() + "/a")
    r.follow = true
    r.max_redirects = 2
    [_resp, e] = request(r)
    testing.expect(e != nil, "max redirects errors")
    if e != nil {
        testing.expect(find(errors.msg(e), "Too many redirects") >= 0, "corpus error shape")
        testing.expect(find(errors.msg(e), "--max-redirects=2") >= 0, "names the limit")
    }
}

fn test_redirect_bad_location() {
    f := fx_start(one("HTTP/1.1 302 Found\r\nLocation: http://[::1\r\nContent-Length: 0\r\n\r\n"))
    defer f.stop()
    r := rq("GET", f.url() + "/")
    r.follow = true
    [_resp, e] = request(r)
    testing.expect(e != nil, "bad location errors")
    if e != nil {
        testing.expect(find(errors.msg(e), "invalid URL") >= 0, "location error")
    }
}

fn test_redirect_https_target() {
    f := fx_start(one("HTTP/1.1 302 Found\r\nLocation: https://example.com/\r\nContent-Length: 0\r\n\r\n"))
    defer f.stop()
    r := rq("GET", f.url() + "/")
    r.follow = true
    [resp, e] = request(r)
    testing.expect(e == nil, "https redirect follow")
    if e == nil {
        testing.expect_eq(resp.status, 200, "example.com 200")
    }
}

fn test_timeout() {
    f := fx_start(one("<SLEEP:6000>HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n"))
    defer f.stop()
    r := rq("GET", f.url() + "/slow")
    r.timeout_ms = 1500
    t0 := now_ms()
    [_resp, e] = request(r)
    testing.expect(e != nil, "silent server times out")
    testing.expect(now_ms() - t0 < 5000, "timeout bounded")
}

fn test_bad_and_https_urls() {
    r := rq("GET", "https://example.com/")
    [resp, e] = request(r)
    testing.expect(e == nil, "https example.com")
    if e == nil {
        testing.expect_eq(resp.status, 200, "https 200")
        testing.expect(len(resp.body) > 0, "https body")
        // WI-0013 P2: negotiated version exposed (ADR-0032 default
        // range is [V12,V13]; example.com negotiates 1.3 = 772)
        testing.expect(resp.tls_ver == 771 || resp.tls_ver == 772, "tls_ver set")
    }
    // --ssl pin: tls1.3-only still connects
    rp := rq("GET", "https://example.com/")
    rp.ssl_min = 772
    rp.ssl_max = 772
    [respp, ep] = request(rp)
    testing.expect(ep == nil, "tls1.3 pin")
    if ep == nil {
        testing.expect_eq(respp.tls_ver, 772, "pinned 1.3 negotiated")
    }
    // --verify=no still connects (accept-all Verifier)
    r0 := rq("GET", "https://example.com/")
    r0.verify = "no"
    [resp0, e0] = request(r0)
    testing.expect(e0 == nil, "verify=no")
    if e0 == nil {
        testing.expect_eq(resp0.status, 200, "verify=no 200")
    }
    r2 := rq("GET", "http://")
    [_r2, e2] = request(r2)
    testing.expect(e2 != nil, "empty host errors")
    r3 := rq("GET", "notaurl")
    [_r3, e3] = request(r3)
    testing.expect(e3 != nil, "schemeless errors")
    r4 := rq("GET", "ftp://example.com/")
    [_r4, e4] = request(r4)
    testing.expect(e4 != nil, "ftp rejected")
}

fn test_conn_refused() {
    r := rq("GET", "http://127.0.0.1:1/")
    [_resp, e] = request(r)
    testing.expect(e != nil, "refused errors")
}

// S5 spec additions: hop recording, version exposure, jar-lite
// cookie carry across redirects, Host-last wire ordering.
fn test_redirect_hops_recorded() {
    sc := mkslice(str, 2)
    sc[0] = "HTTP/1.1 301 Moved Permanently\r\nLocation: /b\r\nContent-Length: 0\r\n\r\n"
    sc[1] = "<ECHO>"
    f := fx_start(sc)
    defer f.stop()
    r := rq("GET", f.url() + "/a")
    r.follow = true
    [resp, e] = request(r)
    testing.expect(e == nil, "send")
    if e != nil {
        return
    }
    testing.expect_eq(len(resp.hops), 1, "one hop recorded")
    testing.expect_eq(resp.hops[0].status, 301, "hop status")
    testing.expect_eq(find(resp.hops[0].req_head, "GET /a HTTP/1.1"), 0, "hop req head")
    testing.expect_eq(find(resp.req_head, "GET /b HTTP/1.1"), 0, "final req head recorded")
}

fn test_version_exposed() {
    sc := mkslice(str, 1)
    sc[0] = "HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n"
    f := fx_start(sc)
    defer f.stop()
    [resp, e] = request(rq("GET", f.url() + "/x"))
    testing.expect(e == nil, "send")
    if e != nil {
        return
    }
    testing.expect_streq(resp.version, "1.1", "wire version token")
}

fn test_cookie_carry_across_redirect() {
    sc := mkslice(str, 2)
    sc[0] = "HTTP/1.1 302 Found\r\nLocation: /b\r\nSet-Cookie: s=1; Path=/\r\nContent-Length: 0\r\n\r\n"
    sc[1] = "<ECHO>"
    f := fx_start(sc)
    defer f.stop()
    r := rq("GET", f.url() + "/a")
    r.follow = true
    [resp, e] = request(r)
    testing.expect(e == nil, "send")
    if e != nil {
        return
    }
    b := resp.body as str
    testing.expect(find(b, "Cookie: s=1") >= 0, "set-cookie carried to hop 2: " + b)
}

fn test_host_last() {
    sc := mkslice(str, 1)
    sc[0] = "<ECHO>"
    f := fx_start(sc)
    defer f.stop()
    [resp, e] = request(rq("GET", f.url() + "/x"))
    testing.expect(e == nil, "send")
    if e != nil {
        return
    }
    b := resp.body as str
    tail := "Host: 127.0.0.1:" + itoa(f.port) + "\r\n\r\n"
    testing.expect(len(b) >= len(tail) && substr(b, len(b) - len(tail), len(b)) == tail, "host is last header: " + b)
}

// --- WI-0013 P3: h2/h2c over the owned transport (ADR-0030) --------
fn test_h2c_prior_knowledge() {
    f := h2_start(one("<H2ECHO>"))
    defer f.stop()
    r := rq("GET", f.url() + "/p?q=1")
    r.h2 = "prior"
    [resp, e] = request(r)
    testing.expect(e == nil, "h2c send")
    if e != nil {
        return
    }
    testing.expect_eq(resp.status, 200, "h2 200")
    testing.expect_streq(resp.version, "2.0", "h2 version token")
    b := resp.body as str
    testing.expect(find(b, ":method: GET") >= 0, "h2 :method: " + b)
    testing.expect(find(b, ":scheme: http") >= 0, "h2 :scheme")
    testing.expect(find(b, ":path: /p?q=1") >= 0, "h2 :path")
    testing.expect(find(b, ":authority: 127.0.0.1:") >= 0, "h2 :authority")
    // connection-specific headers must not cross into h2 frames
    testing.expect(find(b, "connection:") < 0, "no connection header")
    testing.expect_eq(sget(f.hits), 1, "one exchange")
}

fn test_h2c_post_body() {
    f := h2_start(one("<H2ECHO>"))
    defer f.stop()
    r := rq("POST", f.url() + "/up")
    r.h2 = "prior"
    r.body = model.Body.Raw{ctype: "text/plain", text: "h2body!"}
    r.headers = hs1("Content-Type", "text/plain")
    [resp, e] = request(r)
    testing.expect(e == nil, "h2 post")
    if e != nil {
        return
    }
    b := resp.body as str
    testing.expect(find(b, "content-length: 7") >= 0, "h2 CL sent: " + b)
    testing.expect(strings_ends(b, "h2body!"), "h2 body bytes: " + b)
}

fn test_h2c_scripted_body() {
    f := h2_start(one("scripted-h2"))
    defer f.stop()
    r := rq("GET", f.url() + "/")
    r.h2 = "prior"
    [resp, e] = request(r)
    testing.expect(e == nil, "send")
    if e == nil {
        testing.expect_streq(resp.body as str, "scripted-h2", "script body")
        testing.expect_eq(resp.status, 200, "status")
        testing.expect_streq(hdr_get(resp.headers, "content-type"), "text/plain", "resp hdrs decoded")
    }
}

fn test_h2c_req_head_synth() {
    // h2 has no wire head — the captured head is the synthesized
    // HTTP/2.0 approximation (spec D1).
    f := h2_start(one("<H2ECHO>"))
    defer f.stop()
    r := rq("GET", f.url() + "/x")
    r.h2 = "prior"
    [resp, e] = request(r)
    testing.expect(e == nil, "send")
    if e == nil {
        testing.expect_eq(find(resp.req_head, "GET /x HTTP/2.0"), 0, "synth head: " + resp.req_head)
    }
}

// --- WI-0013 P4: proxies (spec sem-S5) -----------------------------
// Fixture is the proxy: for http targets it captures the forwarded
// request (<ECHO> body = wire bytes); for https it captures CONNECT.
fn test_proxy_http_absolute_form() {
    f := fx_start(one("<ECHO>"))
    defer f.stop()
    r := rq("GET", "http://example.org/x?q=1")
    r.proxies = one("http:" + f.url())
    [resp, e] = request(r)
    testing.expect(e == nil, "proxied http send")
    if e != nil {
        return
    }
    b := resp.body as str
    testing.expect_eq(find(b, "GET http://example.org/x?q=1 HTTP/1.1"), 0, "absolute-form: " + b)
    testing.expect(find(b, "Host: example.org") >= 0, "origin host hdr")
    testing.expect_eq(sget(f.hits), 1, "proxy hit once")
}

fn test_proxy_http_auth_header() {
    f := fx_start(one("<ECHO>"))
    defer f.stop()
    r := rq("GET", "http://example.org/")
    r.proxies = one("http:http://user:pw@127.0.0.1:" + itoa(f.port))
    [resp, e] = request(r)
    testing.expect(e == nil, "proxied send")
    if e != nil {
        return
    }
    // base64("user:pw") = dXNlcjpwdw==
    bb := resp.body as str
    testing.expect(find(bb, "Proxy-Authorization: Basic dXNlcjpwdw==") >= 0, "proxy-auth hdr: " + bb)
}

fn test_proxy_all_and_scheme_match() {
    f := fx_start(one("<ECHO>"))
    defer f.stop()
    // all: applies to http too; a https: entry must not
    r := rq("GET", "http://example.org/")
    r.proxies = one("all:" + f.url())
    [resp, e] = request(r)
    testing.expect(e == nil, "all: send")
    if e == nil {
        testing.expect_eq(find(resp.body as str, "GET http://example.org/ HTTP/1.1"), 0, "all: absolute-form")
    }
    // scheme mismatch → direct to a second loopback origin (never
    // public DNS): it must see an origin-form request, proxy untouched.
    o2 := fx_start(one("<ECHO>"))
    defer o2.stop()
    r2 := rq("GET", "http://127.0.0.1:" + itoa(o2.port) + "/y")
    r2.proxies = one("https:" + f.url())
    [resp2, e2] = request(r2)
    testing.expect(e2 == nil, "direct send after scheme mismatch")
    if e2 == nil {
        testing.expect_eq(find(resp2.body as str, "GET /y HTTP/1.1"), 0, "origin-form at real origin: " + resp2.body as str)
    }
    testing.expect_eq(sget(f.hits), 1, "no second proxy hit (https: skipped for http)")
}

fn test_proxy_env_selection() {
    f := fx_start(one("<ECHO>"))
    defer f.stop()
    r := rq("GET", "http://example.org/")
    r.proxy_env = one("HTTP_PROXY=" + f.url())
    [resp, e] = request(r)
    testing.expect(e == nil, "env proxy send")
    if e == nil {
        testing.expect_eq(find(resp.body as str, "GET http://example.org/ HTTP/1.1"), 0, "env absolute-form")
    }
}

fn test_proxy_no_proxy_and_loopback() {
    f := fx_start(one("<ECHO>"))
    defer f.stop()
    // NO_PROXY match → direct dial of an unresolvable host errors,
    // fixture stays untouched
    r := rq("GET", "http://nx.invalid/")
    r.proxy_env = one("HTTP_PROXY=" + f.url())
    r.no_proxy = "nx.invalid"
    [_r1, e1] = request(r)
    testing.expect(e1 != nil, "no_proxy bypasses (direct dial fails)")
    testing.expect_eq(sget(f.hits), 0, "proxy untouched under NO_PROXY")
    // loopback carve-out: 127.0.0.1 never rides the env proxy
    r2 := rq("GET", "http://127.0.0.1:1/")
    r2.proxy_env = one("HTTP_PROXY=" + f.url())
    [_r2, e2] = request(r2)
    testing.expect(e2 != nil, "loopback direct dial fails")
    testing.expect_eq(sget(f.hits), 0, "loopback carve-out")
}

fn test_proxy_scheme_degrades() {
    // non-http proxy URLs degrade explicitly (spec sem-S5)
    r := rq("GET", "https://example.org/")
    r.proxies = one("https:https://proxy.invalid:1")
    [_r1, e1] = request(r)
    testing.expect(e1 != nil, "https proxy URL errors")
    if e1 != nil {
        testing.expect(find(errors.msg(e1), "proxy URL scheme \"https\" is unsupported") >= 0, "https-scheme degrade: " + errors.msg(e1))
    }
    r2 := rq("GET", "http://example.org/")
    r2.proxies = one("all:socks5://proxy.invalid:1")
    [_r2, e2] = request(r2)
    testing.expect(e2 != nil, "socks5 errors")
    if e2 != nil {
        testing.expect(find(errors.msg(e2), "proxy URL scheme \"socks5\" is unsupported") >= 0, "socks5 degrade: " + errors.msg(e2))
    }
}

fn test_proxy_h2c_rejected() {
    f := fx_start(one("<ECHO>"))
    defer f.stop()
    r := rq("GET", "http://example.org/")
    r.h2 = "prior"
    r.proxies = one("http:" + f.url())
    [_r1, e1] = request(r)
    testing.expect(e1 != nil, "h2c+proxy errors")
    if e1 != nil {
        testing.expect(find(errors.msg(e1), "h2c through a proxy is not supported") >= 0, "h2c+proxy text: " + errors.msg(e1))
    }
    testing.expect_eq(sget(f.hits), 0, "no dial attempted")
}

fn test_proxy_connect_https() {
    f := capfx_start()
    defer f.l.close()
    r := rq("GET", "https://example.org/secure")
    r.proxies = one("all:http://user:pw@127.0.0.1:" + itoa(f.port))
    [_resp, e] = request(r)
    // the 200'd tunnel then fails TLS (fixture can't handshake) —
    // the assertion is the CONNECT wire shape
    testing.expect(e != nil, "post-CONNECT TLS fails on fake server")
    cap := f.cap[0]
    testing.expect_eq(find(cap, "CONNECT example.org:443 HTTP/1.1"), 0, "CONNECT line: " + cap)
    testing.expect(find(cap, "host: example.org:443") >= 0, "CONNECT host: " + cap)
    testing.expect(find(cap, "proxy-authorization: Basic dXNlcjpwdw==") >= 0, "CONNECT auth: " + cap)
    testing.expect(find(cap, "proxy-connection: keep-alive") >= 0, "keep-alive: " + cap)
}

fn test_proxy_connect_any_2xx() {
    // RFC 9110: any 2xx establishes the tunnel — a 204 must not fail
    // the CONNECT status check (review F13).
    f := capfx_start_reply("HTTP/1.1 204 No Content\r\n\r\n")
    defer f.l.close()
    r := rq("GET", "https://example.org/")
    r.proxies = one("all:http://127.0.0.1:" + itoa(f.port))
    [_resp, e] = request(r)
    testing.expect(e != nil, "post-tunnel TLS fails on fake server")
    if e != nil {
        testing.expect(find(errors.msg(e), "returned status") < 0, "204 not rejected: " + errors.msg(e))
    }
    testing.expect(find(f.cap[0], "CONNECT example.org:443") >= 0, "CONNECT sent: " + f.cap[0])
}

fn test_proxy_connect_framing_ignored() {
    // body-framing headers on a 2xx CONNECT reply are ignored — the
    // tunnel starts at the header terminator (review F12).
    f := capfx_start_reply("HTTP/1.1 200 OK\r\nContent-Length: 12\r\n\r\n")
    defer f.l.close()
    r := rq("GET", "https://example.org/")
    r.proxies = one("all:http://127.0.0.1:" + itoa(f.port))
    [_resp, e] = request(r)
    testing.expect(e != nil, "post-tunnel TLS fails on fake server")
    if e != nil {
        testing.expect(find(errors.msg(e), "content length") < 0, "CL not rejected: " + errors.msg(e))
        testing.expect(find(errors.msg(e), "returned status") < 0, "200 accepted: " + errors.msg(e))
    }
    testing.expect(find(f.cap[0], "CONNECT example.org:443") >= 0, "CONNECT sent: " + f.cap[0])
}

fn test_proxy_connect_caller_auth() {
    // a caller Proxy-Authorization rides the CONNECT instead of the
    // URL creds, and must not reach the origin (RFC 9110 §11.7.2,
    // review F9).
    f := capfx_start()
    defer f.l.close()
    r := rq("GET", "https://example.org/")
    r.proxies = one("all:http://user:pw@127.0.0.1:" + itoa(f.port))
    r.headers = hs1("Proxy-Authorization", "Bearer caller-token")
    [_resp, e] = request(r)
    testing.expect(e != nil, "post-tunnel TLS fails on fake server")
    cap := f.cap[0]
    testing.expect(find(cap, "proxy-authorization: Bearer caller-token") >= 0, "caller auth on CONNECT: " + cap)
    urlcreds := "Basic " + base64.encode("user:pw" as []byte)
    testing.expect(find(cap, urlcreds) < 0, "url creds not used: " + cap)
}

fn test_h2_authority_from_host_header() {
    // caller Host: becomes :authority — never a separate host field
    // (RFC 9113 §8.3.1, review F10).
    f := h2_start(one("<H2ECHO>"))
    defer f.stop()
    r := rq("GET", f.url() + "/")
    r.h2 = "prior"
    r.headers = hs1("Host", "vhost.example")
    [resp, e] = request(r)
    testing.expect(e == nil, "h2 send")
    if e != nil {
        return
    }
    b := resp.body as str
    testing.expect(find(b, ":authority: vhost.example") >= 0, ":authority override: " + b)
    testing.expect(find(b, "host:") < 0, "no host field on h2: " + b)
}

fn test_proxy_error_hides_password() {
    // proxy URL validation errors must not echo the raw URL — it can
    // carry a userinfo password (review F8).
    r := rq("GET", "http://example.org/")
    r.proxies = one("all:http://user:sekretpw@127.0.0.1:0/")
    [_resp, e] = request(r)
    testing.expect(e != nil, "bad proxy port errors")
    if e != nil {
        testing.expect(find(errors.msg(e), "sekretpw") < 0, "no password in error: " + errors.msg(e))
    }
}
