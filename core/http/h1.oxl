package http

// H1 is the S2 Transport port's HTTP/1.1 implementation on std/net
// sockets (decisions 0003/0014/0015/0016). Stateless: a zero value
// is a complete client; v0.1 opens one connection per request and
// closes it (Connection: close on the wire). TLS is out of scope —
// https URLs are rejected with an explicit error rather than
// silently downgraded (oxidean/oxl#128).
//
// Concurrency note: Transport.send dispatches through a vtable —
// "vtable calls carry no task frame", so send can never suspend.
// std's dial path suspends (lookup_ipv4 parks on msleep), hence the
// socket/DNS work below runs on the raw rt_* externs with usleep
// backoff — blocking the calling thread, which is exactly right for
// a sequential request/response exchange.
import "std/bufio"

import "std/io"

import "std/net"

import "std/errors"

import "std/strconv"

import "std/encoding/base64"

import "std/net/url"

import "github.com/oxidean/oxttp/core/model"

// a client that resets mid-write must not kill the process — same
// extern the std server uses (rt_sigpipe_ignore).
extern fn rt_sigpipe_ignore()

// socket + resolver externs std/net wraps — redeclared here because
// net.dial_timeout is suspend-capable (its resolver backoff parks on
// msleep) and interface methods may not suspend at all.
extern fn rt_sock_open(domain: int, ty: int, proto: int) -> int
extern fn rt_sock_connect_ipv4(fd: int, ip_h32: int, port: int, tmo_ms: int) -> int
extern fn rt_sock_close(fd: int) -> int
extern fn rt_errstr(code: int) -> str
extern fn rt_lookup_start(host: str) -> shared
extern fn rt_lookup_release(h: shared)

// pending word for the lookup cell — same sentinel std uses: one
// past every legal h32 result.
let lkp_pending = 4294967296

// H1 implements Transport — one std/net socket per request.
struct H1 { }

// TmoReader wraps a Conn with a whole-request deadline: every read
// re-arms SO_RCVTIMEO to the remaining budget, and an expired
// deadline surfaces as a request timeout rather than a socket error.
struct TmoReader {
    c: net.Conn,
    deadline: int,
    tmo: int,
}

fn (t mut TmoReader) read(b: []byte) -> [int, err] {
    if t.deadline > 0 {
        rem := t.deadline - now_ms()
        if rem <= 0 {
            return 0, errors.new("http: request timed out after " + itoa(t.tmo) + "ms")
        }
        set_rcvtimo_ms(t.c.rawfd(), rem)
    }
    [n, e] = t.c.read(b)
    if e != nil && e != io.eof() && t.deadline > 0 && now_ms() >= t.deadline {
        return 0, errors.new("http: request timed out after " + itoa(t.tmo) + "ms")
    }
    return n, e
}

fn (t mut TmoReader) asreader() -> io.Reader {
    return t
}

// send satisfies Transport: one request (plus redirect hops when
// req.follow) through roundtrip; the final Resp is returned.
fn (t H1) send(req: ref model.Req) -> [model.Resp, err] {
    rt_sigpipe_ignore()
    cur := new(model.Req{method: req.method, url: req.url, headers: req.headers, body: req.body, timeout_ms: req.timeout_ms, follow: req.follow, max_redirects: req.max_redirects})
    hops := 0
    for true {
        [resp, e] = t.roundtrip(cur)
        if e != nil {
            return resp, e
        }
        if !cur.follow || !is_redirect(resp.status) {
            return resp, nil
        }
        loc := hdr_get(resp.headers, "location")
        if len(loc) == 0 {
            return resp, nil
        }
        eff := cur.max_redirects
        if eff < 0 {
            eff = 0
        }
        if hops >= eff {
            return resp, errors.new("http: Too many redirects (--max-redirects=" + itoa(eff) + ")")
        }
        hops = hops + 1
        [bu, be] = url.parse(cur.url)
        if be != nil {
            return resp, be
        }
        [nu, ne] = resolve_location(bu, loc)
        if ne != nil {
            return resp, ne
        }
        if lwr(nu.scheme) != "http" {
            return resp, errors.new("http: unsupported scheme \"" + nu.scheme + "\" (TLS is not supported in this build)")
        }
        cross := !same_origin(bu, nu)
        drop := false
        if resp.status == 301 || resp.status == 302 || resp.status == 303 {
            if lwr(cur.method) != "head" {
                cur.method = "GET"
                drop = true
            }
        }
        if drop {
            cur.body = model.Body.Empty
        }
        cur.headers = redirect_headers(cur.headers, cross, drop)
        cur.url = nu.string()
    }
    return model.Resp{status: 0, reason: "", headers: nil, body: nil, elapsed_ms: 0.0, remote: "", trace: nil}, nil
}

// request is the package-level convenience on a shared zero-value
// H1, mirroring std's get/post shape (send is a channel builtin).
fn request(req: ref model.Req) -> [model.Resp, err] {
    h := H1{}
    return h.send(req)
}

// lookup_nosusp is lookup_ipv4's resolve-and-wait, minus the msleep
// — usleep blocks the calling thread in bounded slices instead of
// parking a task, keeping the whole send path suspend-free for the
// Transport vtable.
fn lookup_nosusp(host: str, tmo_ms: int) -> [int, err] {
    [ip, pe] = net.parse_ipv4(host)
    if pe == nil {
        return ip, nil
    }
    h := rt_lookup_start(host)
    defer rt_lookup_release(h)
    v := sget(h)
    deadline := now_ms() + tmo_ms
    for v == lkp_pending {
        rem := deadline - now_ms()
        if rem <= 0 {
            break
        }
        if rem > 50 {
            rem = 50
        }
        usleep(rem * 1000)
        v = sget(h)
    }
    if v == lkp_pending || now_ms() > deadline {
        return 0, errors.new("net: lookup " + host + ": timed out")
    }
    if v < 0 {
        return 0, errors.new("net: lookup " + host + ": " + rt_errstr(0 - v))
    }
    return v, nil
}

// dial_h1 is net.dial_timeout's non-suspending twin: dotted IPv4 or
// resolver -> socket -> connect, all through raw externs so the call
// blocks the thread instead of suspending a task frame it doesn't
// have.
fn dial_h1(host: str, port: int, tmo_ms: int) -> [net.Conn, err] {
    [ip, le] = lookup_nosusp(host, tmo_ms)
    if le != nil {
        return net.Conn{fd: -1, st: nil, g: 0}, le
    }
    fd := rt_sock_open(2, 1, 0) // AF_INET, SOCK_STREAM
    if fd < 0 {
        return net.Conn{fd: -1, st: nil, g: 0}, errors.new("net: dial: socket failed")
    }
    rc := rt_sock_connect_ipv4(fd, ip, port, tmo_ms)
    if rc != 0 {
        rt_sock_close(fd)
        return net.Conn{fd: -1, st: nil, g: 0}, errors.new("net: dial: connect " + host + ":" + itoa(port) + ": " + rt_errstr(0 - rc))
    }
    return net.mkconn(fd), nil
}

// roundtrip performs one request/response exchange on a fresh
// connection and fills the stage timings on the way out.
fn (t H1) roundtrip(req: ref model.Req) -> [model.Resp, err] {
    bad := model.Resp{status: 0, reason: "", headers: nil, body: nil, elapsed_ms: 0.0, remote: "", trace: nil}
    t0 := now_ms()
    tr := new(model.Trace)
    [u, ue] = check_url(req.url)
    if ue != nil {
        return bad, ue
    }
    host := u.hostname()
    if len(host) == 0 {
        return bad, errors.new("http: empty host in " + req.url)
    }
    if find(host, ":") >= 0 {
        return bad, errors.new("http: IPv6 addresses not supported")
    }
    port := 80
    ps := u.port()
    if len(ps) > 0 {
        [p, pe] = strconv.atoi(ps)
        if pe != nil || p <= 0 || p > 65535 {
            return bad, errors.new("http: bad port in " + req.url)
        }
        port = p
    }
    // userinfo becomes a Basic Authorization header unless the caller
    // already supplied one (reqwest's behavior).
    hdrs := req.headers
    if u.hasuser && !hdr_has(hdrs, "authorization") {
        let nh: []model.Header = nil
        cred := u.user + ":" + u.password
        nh = push(nh, model.Header{name: "Authorization", value: "Basic " + base64.encode(cred as []byte)})
        i := 0
        for i < len(hdrs) {
            nh = push(nh, hdrs[i])
            i = i + 1
        }
        hdrs = nh
    }
    [rb, rbe] = render_body(req.body)
    if rbe != nil {
        return bad, rbe
    }
    has_body := req.body.kind() != 0
    // a body kind that fixes a content-type emits it when the caller
    // did not (Json/Form/Multipart; Raw/FileBody carry their own).
    if has_body && len(rb.ctype) > 0 && !hdr_has(hdrs, "content-type") {
        hdrs = push(hdrs, model.Header{name: "Content-Type", value: rb.ctype})
    }
    head := serialize_head(OutHead{method: req.method, uri: u.request_uri(), host: u.host, hdrs: hdrs, body_len: len(rb.data), has_body: has_body})
    // connect — timeout<=0 gets the same 30s safety cap std uses.
    c0 := now_ms()
    dtmo := req.timeout_ms
    if dtmo <= 0 {
        dtmo = 30000
    }
    [conn, de] = dial_h1(host, port, dtmo)
    if de != nil {
        return bad, de
    }
    defer conn.close()
    tr.connect_ms = itof(now_ms() - c0)
    // the send phase bounds itself: a peer that accepts but never
    // reads can't hold the write open past the request budget.
    if req.timeout_ms > 0 {
        set_sndtimo(conn.rawfd(), (req.timeout_ms + 999) / 1000)
    }
    we := write_all(conn, head as []byte)
    if we != nil {
        return bad, we
    }
    tr.send_headers_ms = itof(now_ms() - c0)
    if len(rb.data) > 0 {
        we = write_all(conn, rb.data)
        if we != nil {
            return bad, we
        }
    }
    tr.send_body_ms = itof(now_ms() - c0)
    // response — every read re-arms the remaining budget through
    // TmoReader so a silent peer can't stretch the deadline.
    deadline := 0
    if req.timeout_ms > 0 {
        deadline = t0 + req.timeout_ms
    }
    trr := TmoReader{c: conn, deadline: deadline, tmo: req.timeout_ms}
    br := new(bufio.newreadersize(trr.asreader(), 16384))
    h := Head{status: 0, reason: "", headers: nil}
    for true {
        [raw, rhe] = read_head(br)
        if rhe != nil {
            return bad, rhe
        }
        [ph, pe2] = parse_head(raw)
        if pe2 != nil {
            return bad, pe2
        }
        h = ph
        // 1xx blocks (except 101, which is a protocol switch, not a
        // prelude) precede the real response — loop until a final one.
        if h.status < 100 || h.status >= 200 || h.status == 101 {
            break
        }
    }
    tr.recv_headers_ms = itof(now_ms() - c0)
    // body framing: HEAD/1xx/204/304 have none by definition; chunked
    // wins over Content-Length; no framing at all reads to EOF.
    body := mkslice(byte, 0)
    if !bodyless(req.method, h.status) {
        te := lwr(hdr_get(h.headers, "transfer-encoding"))
        [cl, cle] = content_length(h.headers)
        if cle != nil {
            return bad, cle
        }
        if find(te, "chunked") >= 0 {
            [cb, ce] = read_chunked(br)
            if ce != nil {
                return bad, ce
            }
            body = cb.data
            i := 0
            for i < len(cb.trailers) {
                h.headers = push(h.headers, cb.trailers[i])
                i = i + 1
            }
        } else if len(te) > 0 {
            [b2, e2] = read_eof(br)
            if e2 != nil {
                return bad, e2
            }
            body = b2
        } else if cl >= 0 {
            [b3, e3] = read_exact(br, cl)
            if e3 != nil {
                return bad, e3
            }
            body = b3
        } else {
            [b4, e4] = read_eof(br)
            if e4 != nil {
                return bad, e4
            }
            body = b4
        }
    }
    tr.recv_body_ms = itof(now_ms() - c0)
    [db, dbe] = decode_body(body, hdr_get(h.headers, "content-encoding"))
    if dbe != nil {
        return bad, dbe
    }
    conn.close()
    tr.closed_ms = itof(now_ms() - c0)
    let bodyb: []byte = db
    return model.Resp{status: h.status, reason: h.reason, headers: h.headers, body: bodyb, elapsed_ms: itof(now_ms() - t0), remote: host + ":" + itoa(port), trace: tr}, nil
}

// check_url gates the scheme surface: http only. https errors name
// the scheme (TLS is parked on oxidean/oxl#128); anything else —
// schemeless, empty host — is an explicit error too.
fn check_url(raw: str) -> [own url.URL, err] {
    [u, e] = url.parse(raw)
    if e != nil {
        return nil, e
    }
    s := lwr(u.scheme)
    if len(s) == 0 {
        return nil, errors.new("http: unsupported scheme \"\" in " + raw)
    }
    if s != "http" {
        return nil, errors.new("http: unsupported scheme \"" + s + "\" (TLS is not supported in this build)")
    }
    return u, nil
}

// bodyless reports whether the method/status combination forbids a
// response body per RFC 7230 — HEAD replies, 1xx, 204, 304.
fn bodyless(method: str, status: int) -> bool {
    if lwr(method) == "head" {
        return true
    }
    if status >= 100 && status < 200 {
        return true
    }
    return status == 204 || status == 304
}

// write_all loops Conn.write until the buffer is flushed — a socket
// may write short; partial failure surfaces as the write error.
fn write_all(c: net.Conn, b: []byte) -> err {
    off := 0
    for off < len(b) {
        [n, e] = c.write(b[off:])
        if e != nil {
            return e
        }
        if n <= 0 {
            return errors.new("http: connection closed during write")
        }
        off = off + n
    }
    return nil
}
