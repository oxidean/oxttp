package http

// H1 is the Transport port's HTTP/1.1 implementation on std/net
// sockets (decisions 0003/0014/0015/0016). Stateless: a zero value
// is a complete client; v0.1 opens one connection per request and
// closes it (Connection: close on the wire). HTTPS dials TCP via the
// non-suspending path then wraps with std/net/tls.client (oxidean/oxl
// #128, #221-#224 shipped in 0.26.0 — mTLS/CONNECT/TLS1.2 live).
//
// Concurrency note: Transport.send dispatches through a vtable —
// "vtable calls carry no task frame", so send can never suspend.
// std's dial path suspends (lookup_ipv4 parks on msleep), hence the
// socket/DNS work below runs on the raw rt_* externs with usleep
// backoff — blocking the calling thread, which is exactly right for
// a sequential request/response exchange. TLS handshake uses the
// already-connected socket (tls.client) so it does not call
// net.dial_timeout.
import "std/bufio"

import "std/io"

import "std/net"

import "std/net/http2"

import "std/net/tls"

import "std/crypto/x509"

import "std/os"

import "std/errors"

import "std/strconv"

import "std/encoding/base64"

import "std/net/url"

import "github.com/oxidean/oxttp/core/model"

import "github.com/oxidean/oxttp/shared/version"

// a client that resets mid-write must not kill the process — same
// extern the std server uses (rt_sigpipe_ignore).
extern fn rt_sigpipe_ignore()

// socket + resolver externs std/net wraps — redeclared here because
// net.dial_timeout is suspend-capable (its resolver backoff parks on
// msleep) and interface methods may not suspend at all.
extern fn rt_sock_open(domain: int, ty: int, proto: int) -> int
extern fn rt_sock_connect_ipv4(fd: int, ip_h32: int, port: int, tmo_ms: int) -> int
extern fn rt_sock_close(fd: int) -> int
extern fn rt_errstr(code: int) -> str
extern fn rt_lookup_start(host: str) -> shared
extern fn rt_lookup_release(h: shared)

// pending word for the lookup cell — same sentinel std uses: one
// past every legal h32 result.
let lkp_pending = 4294967296

// H1 implements Transport — one std/net socket per request.
struct H1 { }

// TmoReader wraps a plain Conn with a whole-request deadline.
struct TmoReader {
    c: net.Conn,
    deadline: int,
    tmo: int,
}

fn (t mut TmoReader) read(b: []byte) -> [int, err] {
    if t.deadline > 0 {
        rem := t.deadline - now_ms()
        if rem <= 0 {
            return 0, errors.new("http: request timed out after " + itoa(t.tmo) + "ms")
        }
        set_rcvtimo_ms(t.c.rawfd(), rem)
    }
    [n, e] = t.c.read(b)
    if e != nil && e != io.eof() && t.deadline > 0 && now_ms() >= t.deadline {
        return 0, errors.new("http: request timed out after " + itoa(t.tmo) + "ms")
    }
    return n, e
}

fn (t mut TmoReader) asreader() -> io.Reader {
    return t
}

// TmoTlsReader is TmoReader for a TLS conn (rawfd still works).
struct TmoTlsReader {
    c: tls.Conn,
    deadline: int,
    tmo: int,
}

fn (t mut TmoTlsReader) read(b: []byte) -> [int, err] {
    if t.deadline > 0 {
        rem := t.deadline - now_ms()
        if rem <= 0 {
            return 0, errors.new("http: request timed out after " + itoa(t.tmo) + "ms")
        }
        set_rcvtimo_ms(t.c.rawfd(), rem)
    }
    [n, e] = t.c.read(b)
    if e != nil && e != io.eof() && t.deadline > 0 && now_ms() >= t.deadline {
        return 0, errors.new("http: request timed out after " + itoa(t.tmo) + "ms")
    }
    return n, e
}

fn (t mut TmoTlsReader) asreader() -> io.Reader {
    return t
}

// send satisfies Transport: one request (plus redirect hops when
// req.follow) through roundtrip; the final Resp is returned.
fn (t H1) send(req: ref model.Req) -> [model.Resp, err] {
    rt_sigpipe_ignore()
    cur := new(model.Req{method: req.method, url: req.url, headers: req.headers, body: req.body, timeout_ms: req.timeout_ms, follow: req.follow, max_redirects: req.max_redirects, httpver: req.httpver, synth: req.synth, verify: req.verify, jar_off: req.jar_off, h2: req.h2, ssl_min: req.ssl_min, ssl_max: req.ssl_max, cert_pem: req.cert_pem, key_pem: req.key_pem, proxies: req.proxies, proxy_env: req.proxy_env, no_proxy: req.no_proxy, proxy_go: req.proxy_go, cgi: req.cgi})
    hops := 0
    let jar: []model.Header = nil // jar-lite: set-cookie pairs across hops (ADR 0023)
    let hs: []model.Hop = nil
    // corpus §7.1: the timeout bounds the WHOLE exchange — connect +
    // upload + redirects + body — not each hop separately.
    deadline := 0
    if req.timeout_ms > 0 {
        deadline = now_ms() + req.timeout_ms
    }
    bad := model.Resp{status: 0, reason: "", headers: nil, body: nil, elapsed_ms: 0.0, remote: "", version: "", hops: nil, req_head: "", trace: nil, tls_ver: 0}
    last := bad
    for true {
        if deadline > 0 {
            rem := deadline - now_ms()
            if rem <= 0 {
                return last, errors.new("http: request timed out after " + itoa(req.timeout_ms) + "ms")
            }
            cur.timeout_ms = rem
        }
        cap := new(model.Hop)
        [resp, e] = t.roundtrip(cur, cap)
        if e != nil {
            return resp, e
        }
        last = resp
        // collect Set-Cookie name=value pairs into jar-lite — a same-
        // named cookie replaces (upstream jar semantics); req.jar_off
        // (posting attach_cookies=false) skips the jar entirely.
        if !cur.jar_off {
            i := 0
            for i < len(resp.headers) {
                sc := resp.headers[i]
                i = i + 1
                if lwr(sc.name) != "set-cookie" {
                    continue
                }
                pair := sc.value
                semi := find(pair, ";")
                if semi >= 0 {
                    pair = substr(pair, 0, semi)
                }
                if len(pair) > 0 && find(pair, "=") > 0 {
                    cname := substr(pair, 0, find(pair, "="))
                    seen := false
                    k := 0
                    for k < len(jar) {
                        if jar[k].name == cname {
                            jar[k].value = pair
                            seen = true
                        }
                        k = k + 1
                    }
                    if !seen {
                        jar = push(jar, model.Header{name: cname, value: pair})
                    }
                }
            }
        }
        if !cur.follow || !is_redirect(resp.status) {
            resp.hops = new(hs)
            resp.req_head = cap.req_head
            return resp, nil
        }
        loc := hdr_get(resp.headers, "location")
        if len(loc) == 0 {
            // redirect status without a target ends the chain — keep
            // the Resp contract uniform: hops non-nil (len() on a nil
            // own handle traps) and req_head installed.
            resp.hops = new(hs)
            resp.req_head = cap.req_head
            return resp, nil
        }
        eff := cur.max_redirects
        if eff < 0 {
            eff = 0
        }
        if hops >= eff {
            return resp, errors.new("http: Too many redirects (--max-redirects=" + itoa(eff) + ")")
        }
        hops = hops + 1
        hs = push(hs, model.Hop{req_head: cap.req_head, status: cap.status, reason: cap.reason, version: cap.version, headers: cap.headers, body: cap.body, elapsed_ms: cap.elapsed_ms, remote: cap.remote, url: cur.url})
        [bu, be] = url.parse(cur.url)
        if be != nil {
            return resp, be
        }
        [nu, ne] = resolve_location(bu, loc)
        if ne != nil {
            return resp, ne
        }
        sch := lwr(nu.scheme)
        if sch != "http" && sch != "https" {
            return resp, errors.new("http: unsupported scheme \"" + nu.scheme + "\"")
        }
        cross := !same_origin(bu, nu)
        drop := false
        if resp.status == 301 || resp.status == 302 || resp.status == 303 {
            if lwr(cur.method) != "head" {
                cur.method = "GET"
                drop = true
            }
        }
        if drop {
            cur.body = model.Body.Empty
        }
        cur.headers = redirect_headers(cur.headers, cross, drop)
        // jarred cookies re-attach same-origin only — forwarding them
        // cross-origin would undo the redirect_headers strip.
        if len(jar) > 0 && !cross {
            cv := ""
            k := 0
            for k < len(jar) {
                if k > 0 {
                    cv = cv + "; "
                }
                cv = cv + jar[k].value
                k = k + 1
            }
            if hdr_has(cur.headers, "cookie") {
                k = 0
                for k < len(cur.headers) {
                    if lwr(cur.headers[k].name) == "cookie" {
                        cur.headers[k].value = cur.headers[k].value + "; " + cv
                    }
                    k = k + 1
                }
            } else {
                cur.headers = push(cur.headers, model.Header{name: "Cookie", value: cv})
            }
        }
        cur.url = nu.string()
    }
    return bad, nil
}

// request is the package-level convenience on a shared zero-value
// H1, mirroring std's get/post shape (send is a channel builtin).
fn request(req: ref model.Req) -> [model.Resp, err] {
    h := H1{}
    return h.send(req)
}

// lookup_nosusp is lookup_ipv4's resolve-and-wait, minus the msleep
// — usleep blocks the calling thread in bounded slices instead of
// parking a task, keeping the whole send path suspend-free for the
// Transport vtable.
fn lookup_nosusp(host: str, tmo_ms: int) -> [int, err] {
    [ip, pe] = net.parse_ipv4(host)
    if pe == nil {
        return ip, nil
    }
    h := rt_lookup_start(host)
    defer rt_lookup_release(h)
    v := sget(h)
    deadline := now_ms() + tmo_ms
    for v == lkp_pending {
        rem := deadline - now_ms()
        if rem <= 0 {
            break
        }
        if rem > 50 {
            rem = 50
        }
        usleep(rem * 1000)
        v = sget(h)
    }
    if v == lkp_pending || now_ms() > deadline {
        return 0, errors.new("net: lookup " + host + ": timed out")
    }
    if v < 0 {
        return 0, errors.new("net: lookup " + host + ": " + rt_errstr(0 - v))
    }
    return v, nil
}

// dial_h1 is net.dial_timeout's non-suspending twin: dotted IPv4 or
// resolver -> socket -> connect, all through raw externs so the call
// blocks the thread instead of suspending a task frame it doesn't
// have.
fn dial_h1(host: str, port: int, tmo_ms: int) -> [net.Conn, err] {
    [ip, le] = lookup_nosusp(host, tmo_ms)
    if le != nil {
        return net.Conn{fd: -1, st: nil, g: 0}, le
    }
    fd := rt_sock_open(2, 1, 0) // AF_INET, SOCK_STREAM
    if fd < 0 {
        return net.Conn{fd: -1, st: nil, g: 0}, errors.new("net: dial: socket failed")
    }
    rc := rt_sock_connect_ipv4(fd, ip, port, tmo_ms)
    if rc != 0 {
        rt_sock_close(fd)
        return net.Conn{fd: -1, st: nil, g: 0}, errors.new("net: dial: connect " + host + ":" + itoa(port) + ": " + rt_errstr(0 - rc))
    }
    return net.mkconn(fd), nil
}

// roundtrip performs one request/response exchange on a fresh
// connection and fills the stage timings on the way out.
fn (t H1) roundtrip(req: ref model.Req, cap: mut model.Hop) -> [model.Resp, err] {
    bad := model.Resp{status: 0, reason: "", headers: nil, body: nil, elapsed_ms: 0.0, remote: "", version: "", hops: nil, req_head: "", trace: nil, tls_ver: 0}
    t0 := now_ms()
    tr := new(model.Trace)
    [u, ue] = check_url(req.url)
    if ue != nil {
        return bad, ue
    }
    host := u.hostname()
    if len(host) == 0 {
        return bad, errors.new("http: empty host in " + req.url)
    }
    if find(host, ":") >= 0 {
        return bad, errors.new("http: IPv6 addresses not supported")
    }
    https := lwr(u.scheme) == "https"
    port := 80
    if https {
        port = 443
    }
    ps := u.port()
    canon_port := ps
    if len(ps) > 0 {
        [p, pe] = strconv.atoi(ps)
        if pe != nil || p <= 0 || p > 65535 {
            return bad, errors.new("http: bad port in " + req.url)
        }
        port = p
    }
    if len(canon_port) == 0 {
        canon_port = "80"
        if https {
            canon_port = "443"
        }
    }
    // userinfo becomes a Basic Authorization header unless the caller
    // already supplied one (reqwest's behavior).
    hdrs := req.headers
    if u.hasuser && !hdr_has(hdrs, "authorization") {
        let nh: []model.Header = nil
        cred := u.user + ":" + u.password
        nh = push(nh, model.Header{name: "Authorization", value: "Basic " + base64.encode(cred as []byte)})
        i := 0
        for i < len(hdrs) {
            nh = push(nh, hdrs[i])
            i = i + 1
        }
        hdrs = nh
    }
    // WI-0013 P4 (spec sem-S5): per-hop proxy resolution. proxies is
    // the verbatim --proxy list; proxy_env the captured env vars —
    // last scheme/all: match wins, NO_PROXY domain match cancels.
    purl := ""
    if req.proxy_go {
        // WI-0017 review fix: posting/TUI env proxies follow Go's
        // httpproxy (x/net/http/httpproxy) — scheme-only selection,
        // CGI error, Go NO_PROXY matchers, per-hop re-eval.
        [gp, gpe] = pick_proxy_go(req, lwr(u.scheme), host, canon_port)
        if gpe != nil {
            return bad, gpe
        }
        purl = gp
    } else if len(req.proxies[:]) > 0 || len(req.proxy_env[:]) > 0 {
        purl = pick_proxy(req, lwr(u.scheme), host)
    }
    via_proxy := false
    phost := ""
    pport := 0
    pauth := ""
    if len(purl) > 0 {
        [pu, pue] = url.parse(purl)
        if pue != nil {
            // errors name the invalid part only — the raw URL can
            // carry a userinfo password (review F8).
            return bad, errors.new("http: invalid proxy URL")
        }
        if lwr(pu.scheme) != "http" {
            return bad, errors.new("http: proxy URL scheme \"" + pu.scheme + "\" is unsupported in this build")
        }
        phost = pu.hostname()
        if len(phost) == 0 {
            return bad, errors.new("http: proxy URL has no host")
        }
        if find(phost, ":") >= 0 {
            return bad, errors.new("http: IPv6 addresses not supported")
        }
        pport = 80
        pps := pu.port()
        if len(pps) > 0 {
            [pv2, pve] = strconv.atoi(pps)
            if pve != nil || pv2 <= 0 || pv2 > 65535 {
                return bad, errors.new("http: invalid proxy port")
            }
            pport = pv2
        }
        via_proxy = true
        if pu.hasuser {
            pauth = "Basic " + base64.encode((pu.user + ":" + pu.password) as []byte)
        }
    }
    // h2c through a CONNECT proxy is meaningless (cleartext preface
    // inside a tunnel nobody asked for) — std rejects it outright.
    if via_proxy && !https && req.h2 == "prior" {
        return bad, errors.new("http: h2c through a proxy is not supported")
    }
    [rb, rbe] = RenderBody(req.body)
    if rbe != nil {
        return bad, rbe
    }
    has_body := req.body.kind() != 0
    // a body kind that fixes a content-type emits it when the caller
    // did not (Json/Form/Multipart; Raw/FileBody carry their own).
    if has_body && len(rb.ctype) > 0 && !hdr_has(hdrs, "content-type") {
        hdrs = push(hdrs, model.Header{name: "Content-Type", value: rb.ctype})
    }
    // http target through a proxy → absolute-form request target, and
    // Proxy-Authorization when the proxy URL carries creds (reqwest
    // semantics — std's client sends neither, spec D4).
    uri := u.request_uri()
    if via_proxy && !https {
        uri = lwr(u.scheme) + "://" + u.host + u.request_uri()
        if len(pauth) > 0 && !hdr_has(hdrs, "proxy-authorization") {
            hdrs = push(hdrs, model.Header{name: "Proxy-Authorization", value: pauth})
        }
    }
    // CONNECT auth derives from the proxy URL's userinfo only — a
    // caller-set proxy-authorization rides the tunnel to the origin
    // untouched (upstream reqwest passes user headers through).
    connect_auth := pauth
    head := serialize_head(OutHead{method: req.method, uri: uri, ver: req.httpver, host: u.host, hdrs: hdrs, body_len: len(rb.data), has_body: has_body, synth: req.synth})
    cap.req_head = head
    // connect — to the proxy when one applies, else the origin.
    // timeout<=0 gets the same 30s safety cap std uses.
    c0 := now_ms()
    dtmo := req.timeout_ms
    if dtmo <= 0 {
        dtmo = 30000
    }
    dhost := host
    dport := port
    if via_proxy {
        dhost = phost
        dport = pport
    }
    remote := dhost + ":" + itoa(dport)
    [raw, de] = dial_h1(dhost, dport, dtmo)
    if de != nil {
        return bad, de
    }
    tr.connect_ms = itof(now_ms() - c0)
    deadline := 0
    if req.timeout_ms > 0 {
        deadline = t0 + req.timeout_ms
    }
    // HTTPS via proxy: CONNECT the origin authority over the fresh
    // socket, bounded by the remaining request budget — then the
    // normal TLS+protocol branch runs on the tunnel.
    if https && via_proxy {
        ctmo := 30000
        if deadline > 0 {
            ctmo = deadline - now_ms()
            if ctmo <= 0 {
                raw.close()
                return bad, errors.new("http: proxy CONNECT timed out")
            }
        }
        ce := proxy_connect(raw, host + ":" + itoa(port), connect_auth, ctmo)
        if ce != nil {
            raw.close()
            return bad, ce
        }
    }
    // HTTPS: tls.client takes ownership of the TCP socket. Plain: keep
    // raw for the whole exchange.
    if https {
        t0tls := now_ms()
        // Remaining budget after TCP dial — tls.client_tmo bounds the
        // handshake; plain tls.client hard-codes 30s and ignores us.
        htmo := dtmo
        if deadline > 0 {
            htmo = deadline - now_ms()
            if htmo <= 0 {
                htmo = 1
            }
        }
        [tc, te] = tls_wrap(raw, host, req, htmo)
        if te != nil {
            return bad, te
        }
        tr.tls_ms = itof(now_ms() - t0tls)
        // WI-0013 P3 (ADR-0030): negotiated h2 → the frame exchange
        // on this conn; prior-knowledge requires it (spec D3).
        alpn := tc.negotiated_alpn()
        if req.h2 == "prior" && alpn != "h2" {
            tc.close()
            return bad, errors.new("http: prior-knowledge HTTP/2 requires h2 negotiation")
        }
        if alpn == "h2" {
            cap.req_head = h2_head_synth(req, u, hdrs, has_body, len(rb.data))
            [resp2, re2] = h2_exchange(req, tc.asreadwriter(), tc.rawfd(), hdrs, rb, u, cap, remote, t0, c0, tr, deadline, bad, tc.s.ver)
            tc.close()
            return resp2, re2
        }
        if req.timeout_ms > 0 {
            set_sndtimo(tc.rawfd(), (req.timeout_ms + 999) / 1000)
        }
        we := write_all_tls(tc, head as []byte)
        if we != nil {
            tc.close()
            return bad, we
        }
        tr.send_headers_ms = itof(now_ms() - c0)
        if len(rb.data) > 0 {
            we = write_all_tls(tc, rb.data)
            if we != nil {
                tc.close()
                return bad, we
            }
        }
        tr.send_body_ms = itof(now_ms() - c0)
        trr := TmoTlsReader{c: tc, deadline: deadline, tmo: req.timeout_ms}
        br := new(bufio.newreadersize(trr.asreader(), 16384))
        [resp, re] = finish_roundtrip(req, br, cap, remote, t0, c0, tr, bad, tc.s.ver)
        tc.close()
        return resp, re
    }
    // h2c prior-knowledge: no TLS — run the h2 exchange straight on
    // the socket (--http-version 2-prior-knowledge, spec sem-S1).
    if req.h2 == "prior" {
        cap.req_head = h2_head_synth(req, u, hdrs, has_body, len(rb.data))
        [resp3, re3] = h2_exchange(req, raw.asreadwriter(), raw.rawfd(), hdrs, rb, u, cap, remote, t0, c0, tr, deadline, bad, 0)
        raw.close()
        return resp3, re3
    }
    if req.timeout_ms > 0 {
        set_sndtimo(raw.rawfd(), (req.timeout_ms + 999) / 1000)
    }
    we := write_all(raw, head as []byte)
    if we != nil {
        raw.close()
        return bad, we
    }
    tr.send_headers_ms = itof(now_ms() - c0)
    if len(rb.data) > 0 {
        we = write_all(raw, rb.data)
        if we != nil {
            raw.close()
            return bad, we
        }
    }
    tr.send_body_ms = itof(now_ms() - c0)
    trr := TmoReader{c: raw, deadline: deadline, tmo: req.timeout_ms}
    br := new(bufio.newreadersize(trr.asreader(), 16384))
    [resp, re] = finish_roundtrip(req, br, cap, remote, t0, c0, tr, bad, 0)
    raw.close()
    return resp, re
}

// finish_roundtrip reads the HTTP response from br, fills hop cap, and
// builds Resp (shared by cleartext and TLS paths).
fn finish_roundtrip(req: ref model.Req, br: own bufio.Reader, cap: mut model.Hop, remote: str, t0: int, c0: int, tr: own model.Trace, bad: model.Resp, tls_ver: int) -> [model.Resp, err] {
    h := Head{status: 0, reason: "", headers: nil, version: ""}
    for true {
        [raw, rhe] = read_head(br)
        if rhe != nil {
            return bad, rhe
        }
        [ph, pe2] = parse_head(raw)
        if pe2 != nil {
            return bad, pe2
        }
        h = ph
        cap.headers = h.headers
        // 1xx blocks (except 101, which is a protocol switch, not a
        // prelude) precede the real response — loop until a final one.
        if h.status < 100 || h.status >= 200 || h.status == 101 {
            break
        }
    }
    tr.recv_headers_ms = itof(now_ms() - c0)
    cap.status = h.status
    cap.reason = h.reason
    cap.version = h.version
    cap.remote = remote
    // body framing: HEAD/1xx/204/304 have none by definition; chunked
    // wins over Content-Length; no framing at all reads to EOF.
    body := mkslice(byte, 0)
    if !bodyless(req.method, h.status) {
        te := lwr(hdr_get(h.headers, "transfer-encoding"))
        [cl, cle] = content_length(h.headers)
        if cle != nil {
            return bad, cle
        }
        if find(te, "chunked") >= 0 {
            [cb, ce] = read_chunked(br)
            if ce != nil {
                return bad, ce
            }
            body = cb.data
            i := 0
            for i < len(cb.trailers) {
                h.headers = push(h.headers, cb.trailers[i])
                i = i + 1
            }
        } else if len(te) > 0 {
            [b2, e2] = read_eof(br)
            if e2 != nil {
                return bad, e2
            }
            body = b2
        } else if cl >= 0 {
            [b3, e3] = read_exact(br, cl)
            if e3 != nil {
                return bad, e3
            }
            body = b3
        } else {
            [b4, e4] = read_eof(br)
            if e4 != nil {
                return bad, e4
            }
            body = b4
        }
    }
    cap.body = body
    cap.elapsed_ms = itof(now_ms() - t0)
    tr.recv_body_ms = itof(now_ms() - c0)
    [db, dbe] = decode_body(body, hdr_get(h.headers, "content-encoding"))
    if dbe != nil {
        return bad, dbe
    }
    tr.closed_ms = itof(now_ms() - c0)
    let bodyb: []byte = db
    return model.Resp{status: h.status, reason: h.reason, headers: h.headers, body: bodyb, elapsed_ms: itof(now_ms() - t0), remote: remote, version: h.version, hops: nil, req_head: "", trace: tr, tls_ver: tls_ver}, nil
}

// --- h2 exchange (WI-0013 P3, ADR-0030) ----------------------------
// One request/response pair over http2.Conn: pseudo-headers plus the
// caller/synth headers minus connection-specific names the frame
// layer rejects, DATA body with flow-control acks, trailers folded
// into the header list. cap gets the same fields finish_roundtrip
// fills on the h1 path.

// h2_forbidden: hop-by-hop names illegal inside h2 frames.
fn h2_forbidden(n: str) -> bool {
    return n == "connection" || n == "keep-alive" || n == "proxy-connection" || n == "transfer-encoding" || n == "upgrade"
}

// h2_push appends model headers as lowercase h2 headers, dropping
// h2-illegal names and any "te" value but "trailers".
fn h2_push(hh: []http2.Header, hs: []model.Header) -> []http2.Header {
    i := 0
    for i < len(hs) {
        n := lwr(hs[i].name)
        if len(n) == 0 || h2_forbidden(n) {
            i = i + 1
            continue
        }
        // host rides :authority on h2 — a separate host field would
        // conflict with it (RFC 9113 §8.3.1).
        if n == "host" {
            i = i + 1
            continue
        }
        if n == "te" {
            if lwr(hs[i].value) != "trailers" {
                i = i + 1
                continue
            }
            // std's h2 validator requires the exact token — emit the
            // canonical form regardless of the caller's casing.
            hh = push(hh, http2.Header{name: n, value: "trailers"})
            i = i + 1
            continue
        }
        hh = push(hh, http2.Header{name: n, value: hs[i].value})
        i = i + 1
    }
    return hh
}

fn h2_has(hh: []http2.Header, name: str) -> bool {
    i := 0
    for i < len(hh) {
        if hh[i].name == name {
            return true
        }
        i = i + 1
    }
    return false
}

// h2_status pulls :status out of a response HEADERS event (0 absent).
fn h2_status(hs: []http2.Header) -> int {
    i := 0
    for i < len(hs) {
        if hs[i].name == ":status" {
            [n, _e] = strconv.atoi(hs[i].value)
            return n
        }
        i = i + 1
    }
    return 0
}

// h2_safe is h2_push for model lists — used by the synthesized head.
fn h2_safe(hs: []model.Header) -> []model.Header {
    let out: []model.Header = nil
    i := 0
    for i < len(hs) {
        n := lwr(hs[i].name)
        if len(n) == 0 || h2_forbidden(n) {
            i = i + 1
            continue
        }
        if n == "host" {
            i = i + 1
            continue
        }
        if n == "te" {
            if lwr(hs[i].value) != "trailers" {
                i = i + 1
                continue
            }
            out = push(out, model.Header{name: n, value: "trailers"})
            i = i + 1
            continue
        }
        out = push(out, hs[i])
        i = i + 1
    }
    return out
}

// h2_head_synth renders the h2 request head as an HTTP/2.0 status
// line plus the h1-shaped header block — there is no wire text; this
// is the display approximation spec D1 calls out.
fn h2_head_synth(req: ref model.Req, u: ref url.URL, hdrs: []model.Header, has_body: bool, body_len: int) -> str {
    authority := u.host
    chv := hdr_get(hdrs, "host")
    if len(chv) > 0 {
        authority = chv
    }
    return serialize_head(OutHead{method: req.method, uri: u.request_uri(), ver: "HTTP/2.0", host: authority, hdrs: h2_safe(hdrs), body_len: body_len, has_body: has_body, synth: h2_safe(req.synth)})
}

// h2_exchange runs the request on a fresh http2.Conn and builds the
// Resp — the h2 twin of finish_roundtrip. rw/fd are the transport
// (raw socket for h2c, TLS conn for negotiated h2); deadline carries
// the whole-request budget (0 = 30s cap like h1).
fn h2_exchange(req: ref model.Req, rw: io.ReadWriter, fd: int, hdrs: []model.Header, rb: RenderedBody, u: ref url.URL, cap: mut model.Hop, remote: str, t0: int, c0: int, tr: own model.Trace, deadline: int, bad: model.Resp, tls_ver: int) -> [model.Resp, err] {
    tmo := 30000
    if deadline > 0 {
        tmo = deadline - now_ms()
        if tmo <= 0 {
            tmo = 1
        }
    }
    [c2, e2] = http2.new_conn_timeout(rw, fd, tmo)
    if e2 != nil {
        return bad, errors.wrap("http: h2 preface", e2)
    }
    defer c2.close()
    let hh: []http2.Header = nil
    hh = push(hh, http2.Header{name: ":method", value: req.method})
    hh = push(hh, http2.Header{name: ":scheme", value: lwr(u.scheme)})
    // caller Host: wins — h2 carries it as :authority and never as a
    // separate host field (RFC 9113 §8.3.1, review F10).
    authority := u.host
    chv := hdr_get(hdrs, "host")
    if len(chv) > 0 {
        authority = chv
    }
    hh = push(hh, http2.Header{name: ":authority", value: authority})
    hh = push(hh, http2.Header{name: ":path", value: u.request_uri()})
    hh = h2_push(hh, hdrs)
    hh = h2_push(hh, req.synth)
    if !h2_has(hh, "accept-encoding") {
        // h1's serialize_head defaults this for bare Req callers —
        // keep the h2 wire identical (decode_body handles the gzip).
        hh = push(hh, http2.Header{name: "accept-encoding", value: "gzip, deflate"})
    }
    has_body := req.body.kind() != 0
    if has_body && !h2_has(hh, "content-length") {
        hh = push(hh, http2.Header{name: "content-length", value: itoa(len(rb.data))})
    }
    [sid, oe] = c2.open_stream(hh, !has_body || len(rb.data) == 0)
    if oe != nil {
        return bad, oe
    }
    tr.send_headers_ms = itof(now_ms() - c0)
    if len(rb.data) > 0 {
        be := c2.send_body(sid, rb.data)
        if be != nil {
            return bad, be
        }
    }
    tr.send_body_ms = itof(now_ms() - c0)
    status := 0
    let rh: []model.Header = nil
    n_rh_head := -1
    body := mkslice(byte, 0)
    got_final := false
    done := false
    for !done {
        [ev, ee] = c2.next_event()
        if ee != nil {
            return bad, ee
        }
        if ev.kind == 7 { // GOAWAY
            if ev.last_stream_id < sid {
                return bad, errors.new("http: connection closed by GOAWAY before response")
            }
            continue
        }
        if ev.stream_id != sid {
            continue
        }
        if ev.kind == 3 { // RST_STREAM
            return bad, errors.new("http: stream reset by peer")
        }
        if ev.kind == 1 { // HEADERS
            if ev.trailers {
                if n_rh_head < 0 {
                    n_rh_head = len(rh)
                }
                i := 0
                for i < len(ev.headers) {
                    rh = push(rh, model.Header{name: ev.headers[i].name, value: ev.headers[i].value})
                    i = i + 1
                }
            } else {
                st := h2_status(ev.headers)
                if st >= 100 && st < 200 {
                    continue // interim 1xx — final HEADERS follows
                }
                status = st
                i := 0
                for i < len(ev.headers) {
                    n := ev.headers[i].name
                    if len(n) > 0 && byteat(n, 0) != 58 {
                        rh = push(rh, model.Header{name: n, value: ev.headers[i].value})
                    }
                    i = i + 1
                }
                got_final = true
                tr.recv_headers_ms = itof(now_ms() - c0)
            }
            if (ev.flags & 1) != 0 {
                done = true
            }
            continue
        }
        if ev.kind == 0 { // DATA
            i := 0
            for i < len(ev.payload) {
                body = push(body, ev.payload[i])
                i = i + 1
            }
            if ev.flow_bytes > 0 {
                c2.ack_data(ev.stream_id, ev.flow_bytes)
            }
            if (ev.flags & 1) != 0 {
                done = true
            }
            continue
        }
    }
    if !got_final {
        return bad, errors.new("http: h2 stream ended without response headers")
    }
    cap.status = status
    cap.reason = ""
    cap.version = "2.0"
    cap.remote = remote
    cap.headers = rh
    cap.body = body
    cap.elapsed_ms = itof(now_ms() - t0)
    tr.recv_body_ms = itof(now_ms() - c0)
    // content-length applies to response headers only — a content-length
    // trailer field is legal and must not trip the check.
    hdr_scope := rh
    if n_rh_head >= 0 {
        hdr_scope = rh[:n_rh_head]
    }
    le := h2_check_length(req.method, status, hdr_scope, len(body))
    if le != nil {
        return bad, le
    }
    [db, dbe] = decode_body(body, hdr_get(rh, "content-encoding"))
    if dbe != nil {
        return bad, dbe
    }
    tr.closed_ms = itof(now_ms() - c0)
    let bodyb: []byte = db
    return model.Resp{status: status, reason: "", headers: rh, body: bodyb, elapsed_ms: itof(now_ms() - t0), remote: remote, version: "2.0", hops: nil, req_head: "", trace: tr, tls_ver: tls_ver}, nil
}

// h2_check_length enforces RFC 9113 §8.1.1: received DATA content
// bytes must match the declared content-length, and duplicated fields
// must agree. HEAD/204/304 are exempt — their content-length describes
// a hypothetical body, not the received one.
fn h2_check_length(method: str, status: int, rh: []model.Header, nbytes: int) -> err {
    if lwr(method) == "head" || status == 204 || status == 304 {
        return nil
    }
    declared := -1
    i := 0
    for i < len(rh) {
        if lwr(rh[i].name) != "content-length" {
            i = i + 1
            continue
        }
        [n, ae] = strconv.atoi(rh[i].value)
        if ae != nil || n < 0 {
            return errors.new("http: h2 malformed content-length")
        }
        if declared >= 0 && n != declared {
            return errors.new("http: h2 conflicting content-length values")
        }
        declared = n
        i = i + 1
    }
    if declared >= 0 && declared != nbytes {
        return errors.new("http: h2 content-length " + itoa(declared) + " declared, " + itoa(nbytes) + " content bytes received")
    }
    return nil
}

// check_url gates the scheme surface: http and https. Other schemes
// (and empty) are explicit errors.
fn check_url(raw: str) -> [own url.URL, err] {
    [u, e] = url.parse(raw)
    if e != nil {
        return nil, e
    }
    s := lwr(u.scheme)
    if len(s) == 0 {
        return nil, errors.new("http: unsupported scheme \"\" in " + raw)
    }
    if s != "http" && s != "https" {
        return nil, errors.new("http: unsupported scheme \"" + s + "\"")
    }
    return u, nil
}

// tls_wrap handshakes over an already-connected TCP socket. verify:
// ""/"yes" → system roots; "no" → AcceptAll; else PEM path.
// ssl_min/ssl_max pin the negotiated range (0 = build default
// [V12,V13], ADR-0032); h2 modes set ALPN; cert_pem (combined PEM,
// corpus convention) becomes Config.client_cert.
fn tls_wrap(c: net.Conn, host: str, req: ref model.Req, tmo_ms: int) -> [tls.Conn, err] {
    if tmo_ms < 0 {
        tmo_ms = 0
    }
    cfg := tls.default_cfg()
    cfg.server_name = host
    v := lwr(req.verify)
    if v == "no" {
        let a: tls.Verifier = AcceptAll{}
        cfg.verify = a
    } else if len(v) > 0 && v != "yes" {
        if !os.exists(req.verify) {
            c.close()
            let z: tls.Conn
            return z, errors.new("http: verify CA file not found: " + req.verify)
        }
        text := os.readfile_(req.verify)
        roots := x509.Roots{cas: new(mkslice(x509.Cert, 0))}
        [_, le] = roots.load_pem(text)
        if le != nil {
            c.close()
            let z: tls.Conn
            return z, le
        }
        cfg.roots = roots
    }
    cfg.min_ver = req.ssl_min
    cfg.max_ver = req.ssl_max
    if cfg.min_ver == 0 {
        cfg.min_ver = tls.V12
    }
    if cfg.max_ver == 0 {
        cfg.max_ver = tls.V13
    }
    if req.h2 == "hint" {
        al := mkslice(str, 2)
        al[0] = "h2"
        al[1] = "http/1.1"
        cfg.alpn = al
    } else if req.h2 == "prior" {
        al2 := mkslice(str, 1)
        al2[0] = "h2"
        cfg.alpn = al2
    }
    if len(req.cert_pem) > 0 {
        kp := req.key_pem
        if len(kp) == 0 {
            kp = req.cert_pem
        }
        [cc, cce] = tls.load_cert_pem(req.cert_pem, kp)
        if cce != nil {
            c.close()
            let z: tls.Conn
            return z, cce
        }
        cfg.client_cert = cc
    }
    if tmo_ms <= 0 {
        tmo_ms = 30000
    }
    return tls.client_tmo(c, cfg, tmo_ms)
}

// bodyless reports whether the method/status combination forbids a
// response body per RFC 7230 — HEAD replies, 1xx, 204, 304.
fn bodyless(method: str, status: int) -> bool {
    if lwr(method) == "head" {
        return true
    }
    if status >= 100 && status < 200 {
        return true
    }
    return status == 204 || status == 304
}

// write_all loops Conn.write until the buffer is flushed.
fn write_all(c: net.Conn, b: []byte) -> err {
    off := 0
    for off < len(b) {
        [n, e] = c.write(b[off:])
        if e != nil {
            return e
        }
        if n <= 0 {
            return errors.new("http: connection closed during write")
        }
        off = off + n
    }
    return nil
}

// write_all_tls is write_all for a TLS conn (record writes may short).
fn write_all_tls(c: tls.Conn, b: []byte) -> err {
    off := 0
    for off < len(b) {
        [n, e] = c.write(b[off:])
        if e != nil {
            return e
        }
        if n <= 0 {
            return errors.new("http: connection closed during write")
        }
        off = off + n
    }
    return nil
}

// --- proxy resolution + CONNECT (WI-0013 P4, spec sem-S5) ----------
// Semantics mirror std's net/http client (proxy_from_env, connect_*
// verbatim ports) plus the reqwest Proxy-Authorization std lacks (D4).

// pick_proxy resolves the proxy URL for one hop. --proxy entries
// ("PROTO:URL") match the hop scheme — last matching entry wins
// (upstream intercept order); env vars select by scheme name then
// ALL_PROXY; NO_PROXY domain match cancels.
fn pick_proxy(req: ref model.Req, scheme: str, host: str) -> str {
    // upstream: reqwest intercepts run last-CLI-entry-first, so the
    // LAST entry matching this scheme wins — an all: entry placed
    // after a scheme entry shadows it for that scheme.
    i := len(req.proxies) - 1
    for i >= 0 {
        ent := req.proxies[i]
        i = i - 1
        ci := find(ent, ":")
        if ci <= 0 {
            continue
        }
        proto := lwr(substr(ent, 0, ci))
        if proto == scheme || proto == "all" {
            return substr(ent, ci + 1, len(ent))
        }
    }
    if len(req.proxies) > 0 {
        return ""
    }
    want := ""
    i = 0
    for i < len(req.proxy_env) {
        eq := find(req.proxy_env[i], "=")
        if eq <= 0 {
            i = i + 1
            continue
        }
        nm := lwr(substr(req.proxy_env[i], 0, eq))
        val := trim_ows(substr(req.proxy_env[i], eq + 1, len(req.proxy_env[i])))
        // an explicitly-empty *_proxy value is "unset" upstream — keep
        // scanning so ALL_PROXY can still apply.
        if nm == scheme + "_proxy" && len(val) > 0 {
            want = val
            break
        }
        if nm == "all_proxy" && len(want) == 0 {
            want = val
        }
        i = i + 1
    }
    if len(want) == 0 {
        return ""
    }
    if len(req.no_proxy) > 0 && no_proxy_match(req.no_proxy, host) {
        return ""
    }
    return want
}

// no_proxy_match — std port: comma list, entries match the host or
// any subdomain; "*" disables proxying outright (curl convention).
fn no_proxy_match(list: str, host: str) -> bool {
    hl := lwr(host)
    i := 0
    for i <= len(list) {
        j := find_from(list, ",", i)
        if j < 0 {
            j = len(list)
        }
        ent := lwr(substr(list, i, j))
        lo := 0
        for lo < len(ent) && (byteat(ent, lo) == 32 || byteat(ent, lo) == 9) {
            lo = lo + 1
        }
        hi := len(ent)
        for hi > lo && (byteat(ent, hi - 1) == 32 || byteat(ent, hi - 1) == 9) {
            hi = hi - 1
        }
        ent = substr(ent, lo, hi)
        if ent == "*" {
            return true
        }
        cidr := go_cidr_parse(ent)
        if cidr.ok {
            [ip, ie] = parse_ipv4_strict(hl)
            if ie == nil && go_cidr_has(cidr.base, cidr.bits, ip) {
                return true
            }
        }
        if !cidr.ok {
            ci := find(ent, ":")
            if ci > 0 {
                pd := true
                k := ci + 1
                for k < len(ent) {
                    if byteat(ent, k) < 48 || byteat(ent, k) > 57 {
                        pd = false
                    }
                    k = k + 1
                }
                if pd {
                    ent = substr(ent, 0, ci)
                }
            }
            if len(ent) > 0 && byteat(ent, 0) == 46 {
                ent = substr(ent, 1, len(ent))
            }
            if len(ent) > 0 && (hl == ent || len(hl) > len(ent) && byteat(hl, len(hl) - len(ent) - 1) == 46 && substr(hl, len(hl) - len(ent), len(hl)) == ent) {
                return true
            }
        }
        if j >= len(list) {
            return false
        }
        i = j + 1
    }
    return false
}

// --- Go httpproxy mode (WI-0017 review fix, Req.proxy_go) ---------
// Port of golang.org/x/net/http/httpproxy semantics for the
// posting/TUI env-proxy path; pick_proxy/no_proxy_match above stay
// the reqwest/std port the xh CLI feeds. Env pairs arrive
// pre-resolved to canonical lowercase names by collection.proxy_pick
// (uppercase-first getEnvAny, no ALL_PROXY, schemeless→http://).

// go_parse_proxy mirrors httpproxy.parseProxy + config.init's
// drop-on-error: a value that doesn't parse — even after the
// "http://" retry — is treated as unset, NOT an error. Returns the
// URL text to hand downstream (original or http://-prefixed).
fn go_parse_proxy(v: str) -> str {
    t := trim_ows(v)
    if len(t) == 0 {
        return ""
    }
    [u, e] = url.parse(t)
    if e == nil && len(u.scheme) > 0 && len(u.hostname()) > 0 {
        return t
    }
    p := "http://" + t
    [u2, e2] = url.parse(p)
    if e2 == nil && len(u2.hostname()) > 0 {
        return p
    }
    return ""
}

// pick_proxy_go resolves the proxy URL for one hop under Go
// httpproxy rules. Explicit proxies entries behave exactly like the
// reqwest path (last scheme/all: match wins; a non-empty list with
// no match disables env entirely — posting's proxy_url is a
// transport-level override, not env). Env selection is scheme-only —
// Go has no ALL_PROXY. A usable http_proxy value under CGI
// (req.cgi, raw REQUEST_METHOD) is a send-time error, checked BEFORE
// NO_PROXY like proxyForURL. NO_PROXY re-evaluates per hop against
// host:port so redirect chains see fresh canonical addrs.
fn pick_proxy_go(req: ref model.Req, scheme: str, host: str, port: str) -> [str, err] {
    i := len(req.proxies) - 1
    for i >= 0 {
        ent := req.proxies[i]
        i = i - 1
        ci := find(ent, ":")
        if ci <= 0 {
            continue
        }
        proto := lwr(substr(ent, 0, ci))
        if proto == scheme || proto == "all" {
            return substr(ent, ci + 1, len(ent)), nil
        }
    }
    if len(req.proxies) > 0 {
        return "", nil
    }
    want := ""
    i = 0
    for i < len(req.proxy_env) {
        eq := find(req.proxy_env[i], "=")
        if eq <= 0 {
            i = i + 1
            continue
        }
        nm := lwr(substr(req.proxy_env[i], 0, eq))
        val := trim_ows(substr(req.proxy_env[i], eq + 1, len(req.proxy_env[i])))
        // canonical lowercase names only (collection.proxy_pick
        // already applied getEnvAny uppercase-first); an explicit
        // empty value is unset.
        if nm == scheme + "_proxy" && len(val) > 0 {
            want = val
            break
        }
        i = i + 1
    }
    if len(want) == 0 {
        return "", nil
    }
    purl := go_parse_proxy(want)
    if len(purl) == 0 {
        // config.init drops unparseable env proxies — direct dial.
        return "", nil
    }
    if scheme == "http" && req.cgi {
        return "", errors.new("http: refusing to use HTTP_PROXY value in CGI environment")
    }
    // useProxy runs whenever a proxy was selected — localhost and
    // loopback bypass even with an empty NO_PROXY list.
    if no_proxy_match_go(req.no_proxy, host, port) {
        return "", nil
    }
    return purl, nil
}

// parse_ipv4_strict is the proxy-matching form of Go's modern IP
// parsers: dotted quads with leading-zero octets are hostnames for
// matching purposes, not IP literals. parse_ipv4 stays available for
// dialing, where std intentionally accepts the legacy notation.
fn parse_ipv4_strict(host: str) -> [int, err] {
    if !net.isip4(host) {
        return 0, errors.new("not a strict IPv4 literal: " + host)
    }
    return net.parse_ipv4(host)
}

// GoCidr is a parsed "a.b.c.d/bits" NO_PROXY entry (ok=false when
// either half fails — caller falls through to the domain path, same
// as Go treating the entry as a hostname that matches nothing).
struct GoCidr { base: int, bits: int, ok: bool }

fn go_cidr_parse(ent: str) -> GoCidr {
    sl := find(ent, "/")
    if sl <= 0 {
        return GoCidr{base: 0, bits: 0, ok: false}
    }
    [b, be] = parse_ipv4_strict(substr(ent, 0, sl))
    if be != nil {
        return GoCidr{base: 0, bits: 0, ok: false}
    }
    [bits, bite] = strconv.atoi(substr(ent, sl + 1, len(ent)))
    if bite != nil || bits < 0 || bits > 32 {
        return GoCidr{base: 0, bits: 0, ok: false}
    }
    return GoCidr{base: b, bits: bits, ok: true}
}

// go_cidr_has — cidrMatch.match for IPv4: quotient compare on the
// network prefix (unmasked bases compare identically, matching
// Go's ParseCIDR which masks the network).
fn go_cidr_has(base: int, bits: int, ip: int) -> bool {
    if bits <= 0 {
        return true
    }
    div := 1
    k := 0
    for k < 32 - bits {
        div = div * 2
        k = k + 1
    }
    return ip / div == base / div
}

// GoHostPort is a NO_PROXY entry split into host + optional port
// ("" port = any port; empty host = malformed, entry ignored).
struct GoHostPort { host: str, port: str }

// go_split_host_port splits a NO_PROXY entry's optional ":port"
// suffix (Go net.SplitHostPort shape for the forms we support:
// host:port and [v6]:port — bare IPv6 without brackets falls to the
// domain path and simply never matches, documented approximation).
fn go_split_host_port(ent: str) -> GoHostPort {
    ci := find(ent, ":")
    if ci <= 0 {
        return GoHostPort{host: ent, port: ""}
    }
    // last ':' must sit after any ']' (bracketed v6 keeps colons
    // inside the host part)
    lb := find(ent, "]")
    if lb >= 0 && ci < lb {
        // colon inside brackets — look for one after ']'
        ci = find_from(ent, ":", lb + 1)
        if ci < 0 {
            return GoHostPort{host: ent, port: ""}
        }
    }
    host := substr(ent, 0, ci)
    port := substr(ent, ci + 1, len(ent))
    if len(host) >= 2 && byteat(host, 0) == 91 && byteat(host, len(host) - 1) == 93 {
        host = substr(host, 1, len(host) - 1)
    }
    if len(host) == 0 {
        // ":port" with no host — Go ignores the entry
        return GoHostPort{host: "", port: ""}
    }
    return GoHostPort{host: host, port: port}
}

// no_proxy_match_go — Go httpproxy useProxy/init port. Matching is
// against the canonical lowercased host plus the effective port
// (the URL port text as written, or the 80/443 default when absent).
// localhost and
// loopback IPv4 always bypass regardless of the list. Entries:
// "*" alone bypasses everything; CIDR → prefix match on the host IP;
// IP[:port] → equality + optional port; domain[.com][:port] matches
// the apex and all subdomains, ".y.com"/"*.y.com" subdomains only —
// port-qualified entries match that port only. IDNA/punycode is NOT
// implemented (ASCII hosts only — Go's idnaASCII approximation).
fn no_proxy_match_go(list: str, host: str, port: str) -> bool {
    h := lwr(host)
    if h == "localhost" {
        return true
    }
    [ip, ie] = parse_ipv4_strict(h)
    is_ip := ie == nil
    if is_ip && ip / 16777216 == 127 {
        return true // 127.0.0.0/8 loopback
    }
    ps := port
    i := 0
    for i <= len(list) {
        j := find_from(list, ",", i)
        if j < 0 {
            j = len(list)
        }
        ent := lwr(trim_ows(substr(list, i, j)))
        i = j + 1
        if len(ent) == 0 {
            continue
        }
        if ent == "*" {
            return true
        }
        // CIDR — IPv4 only (the transport has no IPv6; v6 CIDR
        // entries fall through and never match, documented DevD).
        cidr := go_cidr_parse(ent)
        if cidr.ok {
            if is_ip && go_cidr_has(cidr.base, cidr.bits, ip) {
                return true
            }
            continue
        }
        hp := go_split_host_port(ent)
        phost := hp.host
        pport := hp.port
        if len(phost) == 0 {
            continue
        }
        // IP[:port] — IPv4 literal equality
        [pip, pie] = parse_ipv4_strict(phost)
        if pie == nil {
            if is_ip && pip == ip && (len(pport) == 0 || pport == ps) {
                return true
            }
            continue
        }
        // domain[.com][:port] — ".x"/"*.x" subdomains-only,
        // "x.com" apex+subdomains; optional :port scopes the entry.
        if len(pport) > 0 && pport != ps {
            continue
        }
        if is_ip {
            continue // domain matchers never apply to IP hosts
        }
        dh := phost
        match_host := false
        if len(dh) >= 2 && byteat(dh, 0) == 42 && byteat(dh, 1) == 46 {
            dh = substr(dh, 1, len(dh)) // "*.y.com" → ".y.com"
        }
        if byteat(dh, 0) != 46 {
            match_host = true
            dh = "." + dh
        }
        // HasSuffix(h, dh): dh always starts with '.', so a plain
        // suffix compare can't false-positive ("noty.com" vs ".y.com").
        if len(dh) > 0 && len(h) >= len(dh) && substr(h, len(h) - len(dh), len(h)) == dh {
            return true
        }
        if match_host && h == substr(dh, 1, len(dh)) {
            return true
        }
        if j >= len(list) {
            return false
        }
    }
    return false
}

// proxy_connect runs CONNECT host:port on the already-dialed proxy
// socket and requires a 200 (1xx preludes are skipped) — std's
// connect_proxy port with the proxy-authorization line added (D4).
fn proxy_connect(c: net.Conn, authority: str, auth: str, tmo: int) -> err {
    if tmo <= 0 {
        return errors.new("http: proxy CONNECT timed out")
    }
    // upstream wire shape: title-case Host + User-Agent + optional
    // proxy auth; no proxy-connection header.
    wire := "CONNECT " + authority + " HTTP/1.1\r\nHost: " + authority + "\r\nUser-Agent: oxttp/" + version.get() + "\r\n"
    if len(auth) > 0 {
        wire = wire + "Proxy-Authorization: " + auth + "\r\n"
    }
    wire = wire + "\r\n"
    // one absolute deadline for both phases — a slow write must not
    // hand the read a fresh budget (review F11).
    deadline := now_ms() + tmo
    wr := deadline - now_ms()
    if wr <= 0 {
        return errors.new("http: proxy CONNECT timed out")
    }
    set_sndtimo(c.rawfd(), (wr + 999) / 1000)
    we := write_all(c, wire as []byte)
    if we != nil {
        return errors.wrap("http: proxy CONNECT write", we)
    }
    response := ""
    read_bytes := 0
    scan_from := 0
    buf := mkslice(byte, 1)
    for read_bytes < 32768 {
        remaining := deadline - now_ms()
        if remaining <= 0 {
            return errors.new("http: proxy CONNECT timed out")
        }
        set_rcvtimo_ms(c.rawfd(), remaining)
        [n, re] = c.read(buf)
        if n > 0 {
            response = response + buf[0:n] as str
            read_bytes = read_bytes + n
            head_end := find_from(response, "\r\n\r\n", scan_from)
            if head_end >= 0 {
                // validate only the head — a proxy may have already
                // pushed tunnel bytes into this read.
                [status, pe] = connect_response_status(substr(response, 0, head_end + 4))
                if pe != nil {
                    return pe
                }
                if status >= 100 && status < 200 && status != 101 {
                    // keep any bytes the proxy coalesced past the 1xx head —
                    // they may already be tunnel or final-response data.
                    response = substr(response, head_end + 4, len(response))
                    scan_from = 0
                } else {
                    set_rcvtimo_ms(c.rawfd(), 0)
                    return nil
                }
            } else {
                scan_from = len(response) - 3
                if scan_from < 0 {
                    scan_from = 0
                }
            }
        }
        if re != nil {
            return errors.wrap("http: proxy CONNECT read", re)
        }
        if n <= 0 {
            return errors.new("http: proxy CONNECT response ended early")
        }
    }
    return errors.new("http: proxy CONNECT headers too large")
}

// connect_response_status — std port verbatim: strict status-line +
// header validation on the CONNECT reply (TE forbidden, CL must be
// 0); non-200/1xx is an error carrying the status.
fn connect_response_status(head: str) -> [int, err] {
    end := find(head, "\r\n\r\n")
    if end < 0 || end + 4 != len(head) {
        return 0, errors.new("http: malformed CONNECT response")
    }
    line_end := find(head, "\r\n")
    if line_end < 0 {
        return 0, errors.new("http: malformed CONNECT status line")
    }
    line := substr(head, 0, line_end)
    sp := find(line, " ")
    if sp < 0 {
        return 0, errors.new("http: malformed CONNECT status line")
    }
    version := substr(line, 0, sp)
    if version != "HTTP/1.0" && version != "HTTP/1.1" {
        return 0, errors.new("http: malformed CONNECT HTTP version")
    }
    rest := substr(line, sp + 1, len(line))
    sp2 := find(rest, " ")
    code := rest
    if sp2 >= 0 {
        code = substr(rest, 0, sp2)
    }
    if len(code) != 3 {
        return 0, errors.new("http: malformed CONNECT status code")
    }
    i := 0
    for i < 3 {
        b := byteat(code, i)
        if b < 48 || b > 57 {
            return 0, errors.new("http: malformed CONNECT status code")
        }
        i = i + 1
    }
    [status, se] = strconv.atoi(code)
    if se != nil || status < 100 || status > 599 {
        return 0, errors.new("http: malformed CONNECT status code")
    }
    pos := line_end + 2
    for pos < end {
        eol := find_from(head, "\r\n", pos)
        if eol < 0 || eol > end {
            return 0, errors.new("http: malformed CONNECT headers")
        }
        if eol == pos {
            break
        }
        field := substr(head, pos, eol)
        colon := find(field, ":")
        if colon <= 0 {
            return 0, errors.new("http: malformed CONNECT header")
        }
        name := substr(field, 0, colon)
        value := substr(field, colon + 1, len(field))
        lo := 0
        for lo < len(value) && (byteat(value, lo) == 32 || byteat(value, lo) == 9) {
            lo = lo + 1
        }
        hi := len(value)
        for hi > lo && (byteat(value, hi - 1) == 32 || byteat(value, hi - 1) == 9) {
            hi = hi - 1
        }
        value = substr(value, lo, hi)
        name = lwr(name)
        // RFC 9110: body-framing headers on a 200 CONNECT reply mean
        // nothing — the tunnel starts at the header terminator.
        ok2xx := status == 200
        if name == "transfer-encoding" && len(value) > 0 && !ok2xx {
            return 0, errors.new("http: invalid CONNECT transfer encoding")
        }
        if name == "content-length" && !ok2xx {
            [length, le] = strconv.atoi(value)
            if le != nil || length != 0 {
                return 0, errors.new("http: invalid CONNECT content length")
            }
        }
        pos = eol + 2
    }
    // Only 200 establishes the tunnel (upstream requires the literal
    // "HTTP/1.x 200" status line); other informational statuses are
    // preludes the caller skips — 101 and everything >= 300 fail.
    if status == 200 {
        return status, nil
    }
    if status >= 100 && status < 200 && status != 101 {
        return status, nil
    }
    return status, errors.new("http: proxy CONNECT returned status " + itoa(status))
}

// find_from is find() with a start offset — byte-wise scan (-1 absent).
fn find_from(s: str, needle: str, from: int) -> int {
    last := len(s) - len(needle)
    i := from
    for i <= last {
        j := 0
        for j < len(needle) && byteat(s, i + j) == byteat(needle, j) {
            j = j + 1
        }
        if j == len(needle) {
            return i
        }
        i = i + 1
    }
    return -1
}
