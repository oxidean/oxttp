package http

// WI-0020 §7.5 — SSE receive: parse_sse unit matrix + live fixture
// round-trips (raw scripted responses; the fixture writes verbatim
// bytes so event-stream framing is fully controlled).
import "std/testing"

import "github.com/oxidean/oxttp/core/model"

fn sse_rq(method: str, u: str) -> own model.Req {
    return rq(method, u)
}

fn ev_body(evs: own []model.StreamEvent, i: int) -> str {
    return evs[i].body as str
}

fn test_parse_sse_basic() {
    [evs, err] = parse_sse("data: hello\n\n" as []byte)
    testing.expect(err == nil, "clean parse")
    testing.expect_eq(len(evs), 1, "one event")
    e := evs[0]
    testing.expect_eq(e.kind, 1, "received kind")
    testing.expect_streq(e.body as str, "hello", "data body")
    testing.expect_streq(e.event, "message", "default event name")
    testing.expect_streq(e.content_type, "text/plain", "plain ct")
    testing.expect_streq(e.id, "", "no id")
}

fn test_parse_sse_fields() {
    src := "event: tick\nid: 42\ndata: line1\ndata: line2\nretry: 100\n: comment\nunknown: x\n\n"
    [evs, err] = parse_sse(src as []byte)
    testing.expect(err == nil, "parse ok")
    testing.expect_eq(len(evs), 1, "one event")
    e := evs[0]
    testing.expect_streq(e.event, "tick", "event name")
    testing.expect_streq(e.id, "42", "id captured")
    testing.expect_streq(e.body as str, "line1\nline2", "multiline joined")
    // id persists to the next event
    src2 := "id: 7\ndata: a\n\ndata: b\n\n"
    [evs2, _e2] = parse_sse(src2 as []byte)
    testing.expect_eq(len(evs2), 2, "two events")
    testing.expect_streq(evs2[1].id, "7", "id persists")
}

fn test_parse_sse_edge_cases() {
    // CRLF, BOM, empty-data drop, json content type. The BOM bytes
    // are pushed raw — \x escapes encode codepoints, not bytes.
    bom := mkslice(byte, 0)
    bom = push(bom, 239)
    bom = push(bom, 187)
    bom = push(bom, 191)
    bom = push_str(bom, "data: a\r\n\r\nevent: only\n\ndata: {\"k\":1}\n\n")
    [evs, err] = parse_sse(bom)
    testing.expect(err == nil, "parse ok")
    testing.expect_eq(len(evs), 2, "empty-data block dropped")
    testing.expect_streq(evs[0].body as str, "a", "BOM+CRLF stripped")
    testing.expect_streq(evs[1].content_type, "application/json", "json ct")
    // NUL in id rejected (raw byte, not an escape)
    nid := mkslice(byte, 0)
    nid = push_str(nid, "id: a")
    nid = push(nid, 0)
    nid = push_str(nid, "b\ndata: x\n\n")
    [evs2, _e3] = parse_sse(nid)
    testing.expect_streq(evs2[0].id, "", "nul id dropped")
}

fn test_sse_stream_gate() {
    hs := hs1("Content-Type", "text/event-stream")
    testing.expect(sse_is_stream(hs, "GET"), "get stream")
    testing.expect(sse_is_stream(hs, "POST"), "post stream")
    testing.expect(!sse_is_stream(hs, "HEAD"), "head no stream")
    testing.expect(!sse_is_stream(hs1("Content-Type", "text/plain"), "GET"), "plain no stream")
}

fn test_sse_finish_direct() {
    [evs, err] = sse_finish("data: x\n\n" as []byte, false)
    testing.expect(err == nil, "finish clean")
    testing.expect(evs != nil, "finish events")
    if evs != nil {
        testing.expect_eq(len(evs), 3, "seed+data+end")
    }
    [hd, he] = parse_head("HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nContent-Length: 10\r\n\r\n")
    testing.expect(he == nil, "head parses")
    testing.expect(sse_is_stream(hd.headers, "GET"), "parsed ct gate")
}

fn test_parse_sse_caps() {
    // single event over 1 MiB → error (byte accumulator — str += is
    // quadratic at this size)
    big := mkslice(byte, 0)
    big = push_str(big, "data: ")
    i := 0
    for i < 1048577 {
        big = push(big, 120)
        i = i + 1
    }
    [_evs, err] = parse_sse(big)
    testing.expect(err != nil, "oversize event errors")
    // many small events over 10k → error
    many := mkslice(byte, 0)
    j := 0
    for j < 10001 {
        many = push_str(many, "data: x\n\n")
        j = j + 1
    }
    [_evs2, err2] = parse_sse(many)
    testing.expect(err2 != nil, "event cap errors")
}

fn sse_resp(body: str) -> str {
    return "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nContent-Length: " + itoa(len(body)) + "\r\nConnection: close\r\n\r\n" + body
}

fn sse_resp_bytes(body: []byte) -> str {
    head := "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nContent-Length: " + itoa(len(body)) + "\r\nConnection: close\r\n\r\n"
    out := head as []byte
    i := 0
    for i < len(body) {
        out = push(out, body[i])
        i = i + 1
    }
    return out as str
}

fn test_finish_roundtrip_sse_direct() {
    body := "data: x\n\n"
    br := sreader(sse_resp(body))
    dl := mkshared(0)
    cap := new(model.Hop)
    tr := new(model.Trace)
    bad := model.Resp{status: 0, reason: "", headers: nil, body: nil, elapsed_ms: 0.0, remote: "", version: "", hops: nil, req_head: "", trace: nil, tls_ver: 0, events: nil, stream_error: ""}
    [resp, e] = finish_roundtrip(sse_rq("GET", "http://x/sse"), br, dl, cap, "x", 0, 0, tr, bad, 0)
    testing.expect(e == nil, "finish ok")
    if e == nil {
        testing.expect(resp.events != nil, "direct events")
    }
}

fn test_sse_roundtrip() {
    body := "data: first\n\nevent: tick\nid: 9\ndata: {\"n\":2}\n\n"
    f := fx_start(one(sse_resp(body)))
    defer f.stop()
    let tr: Transport = H1{}
    [resp, e] = tr.send(sse_rq("GET", f.url() + "/sse"))
    testing.expect(e == nil, "send ok")
    if e != nil {
        return
    }
    testing.expect(sse_is_stream(resp.headers, "GET"), "resp ct gate")
    testing.expect(resp.events != nil, "events present")
    evs := resp.events
    // seed + 2 data events + terminal
    testing.expect_eq(len(evs), 4, "seed+data+terminal")
    testing.expect_eq(evs[0].kind, 2, "seed is info")
    testing.expect_streq(evs[0].title, "Stream connected", "seed title")
    testing.expect_eq(evs[1].kind, 1, "first received")
    testing.expect_streq(evs[2].event, "tick", "named event")
    testing.expect_streq(evs[2].id, "9", "event id")
    testing.expect_eq(evs[3].kind, 2, "terminal info")
    testing.expect_streq(evs[3].title, "Stream ended", "terminal title")
    testing.expect_streq(resp.stream_error, "", "no stream error")
    testing.expect_streq(resp.body as str, body, "raw body retained")
}

fn test_sse_non_head_only_and_ct() {
    // HEAD on an event-stream response → no events (upstream gate)
    f := fx_start(one(sse_resp("data: x\n\n")))
    defer f.stop()
    let tr: Transport = H1{}
    [resp, e] = tr.send(sse_rq("HEAD", f.url() + "/sse"))
    testing.expect(e == nil, "head send")
    if e == nil {
        testing.expect(resp.events == nil, "head: no events")
    }
    // plain text response → no events
    f2 := fx_start(one("<ECHO>"))
    defer f2.stop()
    [resp2, e2] = tr.send(sse_rq("GET", f2.url() + "/"))
    testing.expect(e2 == nil, "echo send")
    if e2 == nil {
        testing.expect(resp2.events == nil, "non-sse: no events")
    }
}

fn test_sse_stream_error() {
    // >1MiB single event → parse error → stream_error + error event
    big := mkslice(byte, 0)
    big = push_str(big, "data: ")
    i := 0
    for i < 1048577 {
        big = push(big, 120)
        i = i + 1
    }
    big = push_str(big, "\n\n")
    f := fx_start(one(sse_resp_bytes(big)))
    defer f.stop()
    let tr: Transport = H1{}
    [resp, e] = tr.send(sse_rq("GET", f.url() + "/sse"))
    testing.expect(e == nil, "send ok")
    if e == nil {
        testing.expect(len(resp.stream_error) > 0, "stream_error set")
        last := resp.events[len(resp.events) - 1]
        testing.expect_eq(last.kind, 3, "terminal is error")
        testing.expect(str_contains_i(last.title, "interrupted"), "error title")
    }
}

fn str_contains_i(h: str, n: str) -> bool {
    return find(h, n) >= 0
}
