package http

// Transport port — the interface the S3 HTTP/1.1 transport
// implements on std/net sockets (decision 0003). Apps hold a
// Transport, never a socket; TLS/h2 join later behind the same port.
import "github.com/oxidean/oxttp/core/model"

// Transport sends one request and returns the wire-level response.
// Implementations own redirect following, decompression visibility,
// and timing fill-in (Resp.trace) per their feature set.
interface Transport { send(req: ref model.Req) -> [model.Resp, err] }
