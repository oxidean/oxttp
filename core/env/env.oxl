package env

// Dotenv files + layered environments + $VAR substitution —
// ADR-0031, corpus-posting.md §6. Files: posting.env <
// posting.local.env < NAME.env < NAME.local.env < session. Lexical
// strings only; substitution is the single expander for the TUI
// (url/headers/auth/body gated per corpus flags).
import "std/crypto/rand"
import "std/errors"
import "std/os"
import "std/time"
import "github.com/oxidean/oxttp/core/model"

struct LRes { ok: bool, value: str }

struct DParsed { vars: []model.KV, warns: []str }

// EnvLayer is one contributing file (or the session set); source
// is "file" | "session" | "host".
struct EnvLayer {
    name: str,
    source: str,
    vars: []model.KV,
}

// EnvSet layers in load order — later layers override earlier;
// warns aggregate POSTING_* reservations from every parsed file.
struct EnvSet {
    layers: []EnvLayer,
    warns: []str,
}

struct EnvScan {
    base: []str,
    named: []str,
}

// lookup walks layers from last-added (highest precedence) down.
fn (s ref EnvSet) lookup(name: str) -> LRes {
    li := len(s.layers) - 1
    for li >= 0 {
        l := s.layers[li]
        vi := len(l.vars) - 1
        for vi >= 0 {
            v := l.vars[vi]
            if v.enabled && v.name == name {
                return LRes{ok: true, value: v.value}
            }
            vi = vi - 1
        }
        li = li - 1
    }
    return LRes{ok: false, value: ""}
}

fn file_lookup(vars: []model.KV, name: str) -> LRes {
    i := len(vars) - 1
    for i >= 0 {
        v := vars[i]
        if v.enabled && v.name == name {
            return LRes{ok: true, value: v.value}
        }
        i = i - 1
    }
    return LRes{ok: false, value: ""}
}

fn is_name_start(c: int) -> bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
}

fn is_name_char(c: int) -> bool {
    return is_name_start(c) || (c >= 48 && c <= 57)
}

fn starts_with(s: str, i: int, pre: str) -> bool {
    if i + len(pre) > len(s) {
        return false
    }
    return substr(s, i, i + len(pre)) == pre
}

// parse_dotenv parses NAME=value lines; `export ` prefix ok; `'`
// literal, `"` + unquoted expand ${REF} against already-parsed
// same-file vars then prior layers. POSTING_* names warn (§6.1).
fn parse_dotenv(text: str, prior: ref EnvSet) -> [DParsed, err] {
    p := DParsed{vars: nil, warns: nil}
    pos := 0
    line := 0
    total := 0
    for pos <= len(text) {
        eol := pos
        for eol < len(text) && byteat(text, eol) != 10 {
            eol = eol + 1
        }
        raw := substr(text, pos, eol)
        if len(raw) > 0 && byteat(raw, len(raw) - 1) == 13 {
            raw = substr(raw, 0, len(raw) - 1)
        }
        pos = eol + 1
        line = line + 1
        t := raw
        // trim leading spaces
        lo := 0
        for lo < len(t) && (byteat(t, lo) == 32 || byteat(t, lo) == 9) {
            lo = lo + 1
        }
        t = substr(t, lo, len(t))
        if len(t) == 0 || byteat(t, 0) == 35 {
            continue
        }
        if len(t) >= 7 && substr(t, 0, 7) == "export " {
            t = substr(t, 7, len(t))
            lo2 := 0
            for lo2 < len(t) && byteat(t, lo2) == 32 {
                lo2 = lo2 + 1
            }
            t = substr(t, lo2, len(t))
        }
        eq := find(t, "=")
        name := ""
        vraw := ""
        has_eq := eq >= 0
        if has_eq {
            name = trim_ws(substr(t, 0, eq))
            vraw = substr(t, eq + 1, len(t))
        } else {
            name = trim_ws(t)
        }
        if len(name) == 0 {
            p.warns = push(p.warns, "dotenv: line " + itoa(line) + ": empty name ignored")
            continue
        }
        okname := is_name_start(byteat(name, 0))
        ni := 1
        for okname && ni < len(name) {
            okname = is_name_char(byteat(name, ni))
            ni = ni + 1
        }
        if !okname {
            p.warns = push(p.warns, "dotenv: line " + itoa(line) + ": bad name " + name + " ignored")
            continue
        }
        val := ""
        if !has_eq {
            val = ""
        } else if len(vraw) > 0 && byteat(vraw, 0) == 32 {
            vt := trim_ws(vraw)
            [dv, dve] = dotenv_val(vt, p.vars, prior, line)
            if dve != nil {
                return p, dve
            }
            val = dv
        } else {
            [dv, dve] = dotenv_val(vraw, p.vars, prior, line)
            if dve != nil {
                return p, dve
            }
            val = dv
        }
        total = total + len(val)
        if total > 16777216 {
            return p, errors.new("dotenv: line " + itoa(line) + ": expansion exceeds 16 MiB aggregate")
        }
        if len(name) >= 8 && substr(name, 0, 8) == "POSTING_" {
            p.warns = push(p.warns, "dotenv: " + name + " is reserved (POSTING_* prefix)")
        }
        p.vars = push(p.vars, model.KV{name: name, value: val, enabled: true})
    }
    return p, nil
}

fn trim_ws(s: str) -> str {
    lo := 0
    for lo < len(s) && (byteat(s, lo) == 32 || byteat(s, lo) == 9) {
        lo = lo + 1
    }
    hi := len(s)
    for hi > lo && (byteat(s, hi - 1) == 32 || byteat(s, hi - 1) == 9) {
        hi = hi - 1
    }
    return substr(s, lo, hi)
}

fn chr(c: int) -> str {
    b := mkslice(byte, 1)
    b[0] = c
    return b as str
}

// bcat appends s to a byte accumulator — amortized O(1) per byte, so
// expansion stays linear on multi-MiB texts (str += re-copies the
// whole string each step, which is O(n²) at the 16 MiB cap).
fn bcat(b: []byte, s: str) -> []byte {
    sb := s as []byte
    i := 0
    for i < len(sb) {
        b = push(b, sb[i])
        i = i + 1
    }
    return b
}

// dotenv_val decodes a value token: quoted or unquoted+comment-cut,
// then expands ${REF} for non-single-quoted values.
fn dotenv_val(raw: str, sofar: []model.KV, prior: ref EnvSet, line: int) -> [str, err] {
    t := trim_ws(raw)
    if len(t) == 0 {
        return "", nil
    }
    c0 := byteat(t, 0)
    if c0 == 39 { // single-quoted, literal
        end := find(substr(t, 1, len(t)), "'")
        if end < 0 {
            return "", errors.new("dotenv: line " + itoa(line) + ": unterminated single quote")
        }
        return substr(t, 1, 1 + end), nil
    }
    inner := t
    if c0 == 34 { // double-quoted
        end := find(substr(t, 1, len(t)), "\"")
        if end < 0 {
            return "", errors.new("dotenv: line " + itoa(line) + ": unterminated double quote")
        }
        inner = substr(t, 1, 1 + end)
    } else {
        idx := find(inner, " #")
        if idx >= 0 {
            inner = substr(inner, 0, idx)
        }
        inner = trim_ws(inner)
    }
    // expand ${REF} — same-file sofar first, then prior layers
    out := mkslice(byte, 0)
    i := 0
    for i < len(inner) {
        c := byteat(inner, i)
        if c == 92 && i + 1 < len(inner) && byteat(inner, i + 1) == 110 {
            out = push(out, 10)
            i = i + 2
            continue
        }
        if c == 36 && i + 1 < len(inner) && byteat(inner, i + 1) == 123 {
            close := find(substr(inner, i + 2, len(inner)), "}")
            if close < 0 {
                out = push(out, c)
                i = i + 1
                continue
            }
            ref := substr(inner, i + 2, i + 2 + close)
            r := file_lookup(sofar, ref)
            if !r.ok {
                r = prior.lookup(ref)
            }
            if r.ok {
                out = bcat(out, r.value)
            } else {
                out = bcat(out, substr(inner, i, i + 3 + close))
            }
            if len(out) > 16777216 {
                return "", errors.new("dotenv: line " + itoa(line) + ": value expansion exceeds 16 MiB")
            }
            i = i + 3 + close
            continue
        }
        out = push(out, c)
        i = i + 1
    }
    return out as str, nil
}

// scan_envs lists env files in coll_dir: base = posting.env /
// posting.local.env present; named = deduped X from X.env and
// X.local.env (posting excluded, local files fold into the base).
fn scan_envs(coll_dir: str) -> EnvScan {
    sc := EnvScan{base: nil, named: nil}
    if !os.isdir(coll_dir) {
        return sc
    }
    names := os.ls(coll_dir)
    i := 0
    for i < len(names) {
        n := names[i]
        if n == "posting.env" || n == "posting.local.env" {
            sc.base = push(sc.base, n)
        } else if len(n) > 4 && substr(n, len(n) - 4, len(n)) == ".env" {
            stem := substr(n, 0, len(n) - 4)
            if len(stem) > 6 && substr(stem, len(stem) - 6, len(stem)) == ".local" {
                stem = substr(stem, 0, len(stem) - 6)
            }
            seen := false
            j := 0
            for j < len(sc.named) {
                if sc.named[j] == stem {
                    seen = true
                }
                j = j + 1
            }
            if !seen && len(stem) > 0 {
                sc.named = push(sc.named, stem)
            }
        }
        i = i + 1
    }
    return sc
}

// build_set loads layers in precedence order; missing files skip.
fn build_set(coll_dir: str, active: []str, session: []model.KV) -> own EnvSet {
    s := new(EnvSet)
    load_into(s, coll_dir + "/posting.env", "posting.env")
    load_into(s, coll_dir + "/posting.local.env", "posting.local.env")
    i := 0
    for i < len(active) {
        n := active[i]
        load_into(s, coll_dir + "/" + n + ".env", n + ".env")
        load_into(s, coll_dir + "/" + n + ".local.env", n + ".local.env")
        i = i + 1
    }
    if len(session) > 0 {
        s.layers = push(s.layers, EnvLayer{name: "session", source: "session", vars: session})
    }
    return s
}

fn load_into(s: ref EnvSet, path: str, name: str) {
    if !os.exists(path) {
        return
    }
    text := os.readfile_(path)
    [p, e] = parse_dotenv(text, s)
    if e != nil {
        s.warns = push(s.warns, "dotenv: " + name + ": " + errors.msg(e))
        return
    }
    i := 0
    for i < len(p.warns) {
        s.warns = push(s.warns, p.warns[i])
        i = i + 1
    }
    s.layers = push(s.layers, EnvLayer{name: name, source: "file", vars: p.vars})
}

// gen_val renders a ${$name} generated value; ok=false → not a
// known generator.
fn gen_val(name: str) -> LRes {
    if name == "$uuid" {
        return LRes{ok: true, value: gen_uuid()}
    }
    if name == "$timestamp" {
        return LRes{ok: true, value: itoa(time.unix())}
    }
    if name == "$timestampMs" {
        return LRes{ok: true, value: itoa(time.unix_ms())}
    }
    if name == "$isoTimestamp" {
        return LRes{ok: true, value: gen_iso(time.unix())}
    }
    if name == "$randomInt" {
        return LRes{ok: true, value: gen_randint()}
    }
    return LRes{ok: false, value: ""}
}

fn hexd(n: int) -> str {
    t := "0123456789abcdef"
    return substr(t, n, n + 1)
}

// gen_uuid: v4-shaped random UUID (8-4-4-4-12 hex).
fn gen_uuid() -> str {
    [b, e] = rand.bytes(16)
    if e != nil || len(b) < 16 {
        return "00000000-0000-4000-8000-000000000000"
    }
    b[6] = (b[6] & 15) | 64
    b[8] = (b[8] & 63) | 128
    out := ""
    i := 0
    for i < 16 {
        if i == 4 || i == 6 || i == 8 || i == 10 {
            out = out + "-"
        }
        out = out + hexd(b[i] / 16) + hexd(b[i] & 15)
        i = i + 1
    }
    return out
}

fn gen_randint() -> str {
    [b, e] = rand.bytes(4)
    if e != nil || len(b) < 4 {
        return itoa(time.unix() % 2147483647)
    }
    v := b[0] * 16777216 + b[1] * 65536 + b[2] * 256 + b[3]
    return itoa(v)
}

fn pad2(n: int) -> str {
    if n < 10 {
        return "0" + itoa(n)
    }
    return itoa(n)
}

// gen_iso renders unix seconds as RFC3339 UTC (civil-from-days).
fn gen_iso(ts: int) -> str {
    days := ts / 86400
    rem := ts % 86400
    if rem < 0 {
        rem = rem + 86400
        days = days - 1
    }
    hh := rem / 3600
    mm := (rem % 3600) / 60
    ss := rem % 60
    // Howard Hinnant civil_from_days
    z := days + 719468
    era := z / 146097
    if z < 0 {
        era = (z - 146096) / 146097
    }
    doe := z - era * 146097
    yoe := (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    y := yoe + era * 400
    doy := doe - (365 * yoe + yoe / 4 - yoe / 100)
    mp := (5 * doy + 2) / 153
    d := doy - (153 * mp + 2) / 5 + 1
    m := mp + 3
    if mp >= 10 {
        m = mp - 9
    }
    if m <= 2 {
        y = y + 1
    }
    ys := itoa(y)
    for len(ys) < 4 {
        ys = "0" + ys
    }
    return ys + "-" + pad2(m) + "-" + pad2(d) + "T" + pad2(hh) + ":" + pad2(mm) + ":" + pad2(ss) + "Z"
}

// substitute expands $NAME/${NAME}/$$ and ${$gen} forms. Unresolved
// vars: in_url → err; elsewhere passthrough literal. Caps: >10000
// refs or >16 MiB output → err.
fn substitute(text: str, set: ref EnvSet, in_url: bool) -> [str, err] {
    return subst_scan(text, set, in_url, false)
}

// substitute_braced expands ${NAME}/${$gen} and collapses $$ only —
// $NAME stays literal (GraphQL $vars are not Posting vars; upstream
// model.SubstituteBraced). Unresolved refs pass through, never error.
fn substitute_braced(text: str, set: ref EnvSet) -> [str, err] {
    return subst_scan(text, set, false, true)
}

fn subst_scan(text: str, set: ref EnvSet, in_url: bool, braced_only: bool) -> [str, err] {
    out := mkslice(byte, 0)
    refs := 0
    i := 0
    for i < len(text) {
        c := byteat(text, i)
        if c != 36 {
            out = push(out, c)
            i = i + 1
            continue
        }
        if i + 1 >= len(text) {
            out = push(out, c)
            i = i + 1
            continue
        }
        c1 := byteat(text, i + 1)
        if c1 == 36 { // $$
            out = push(out, 36)
            i = i + 2
            refs = refs + 1
            continue
        }
        name := ""
        litlen := 0
        if c1 == 123 { // ${...}
            close := find(substr(text, i + 2, len(text)), "}")
            if close < 0 {
                out = push(out, c)
                i = i + 1
                continue
            }
            name = substr(text, i + 2, i + 2 + close)
            litlen = 3 + close
        } else if braced_only {
            // ${...} handled above; a bare $NAME is literal text
            out = push(out, c)
            i = i + 1
            continue
        } else if is_name_start(c1) {
            j := i + 1
            for j < len(text) && is_name_char(byteat(text, j)) {
                j = j + 1
            }
            name = substr(text, i + 1, j)
            litlen = j - i
        } else {
            out = push(out, c)
            i = i + 1
            continue
        }
        refs = refs + 1
        if refs > 10000 {
            return "", errors.new("env: substitution exceeds 10000 references")
        }
        val := ""
        ok := false
        if len(name) > 0 && byteat(name, 0) == 36 {
            g := gen_val(name)
            if g.ok {
                val = g.value
                ok = true
            }
        }
        if !ok {
            r := set.lookup(name)
            if r.ok {
                val = r.value
                ok = true
            }
        }
        if ok {
            out = bcat(out, val)
        } else if in_url {
            return "", errors.new("env: unresolved variable $" + name)
        } else {
            out = bcat(out, substr(text, i, i + litlen))
        }
        if len(out) > 16777216 {
            return "", errors.new("env: substitution exceeds 16 MiB")
        }
        i = i + litlen
    }
    return out as str, nil
}
