package yaml

// DOM-subset YAML reader/writer — ADR-0030. Grammar is pinned to
// what Posting's .posting.yaml and config.yaml use: indentation
// block maps, "- " block sequences (including inline-map items),
// plain/single/double-quoted scalars, "|"/">" block scalars with
// clip/strip/keep chomping, and comments. Anchors, aliases, tags,
// flow collections, and multi-doc streams are parse errors —
// corpus §5.1 renders malformed files as placeholder rows, so
// unsupported constructs fail corpus-shaped, never crash.
//
// Scalars stay LEXICAL strings in the DOM (no implicit typing) —
// schema decode coerces per field. force_quote marks string nodes
// that must not emit as YAML bool/null/number lookalikes.
import "std/errors"
import "std/strconv"

// YNode kinds: 0 scalar, 1 map, 2 list.
// plain marks scalars that emit bare even when they look like a
// YAML bool/null/number — the collection encoder sets it on real
// bools/numbers (enabled: false, timeout: 5.0) so output stays
// canonical instead of quoting everything typed-looking.
struct YNode {
    kind: int,
    s: str,
    pairs: []YPair,
    items: []own YNode,
    line: int,
    force_quote: bool,
    plain: bool,
}

struct YPair { key: str, val: own YNode }

// YLine is one source line: indent in spaces, content text after
// the indent (kept verbatim — block scalars need raw tails), plus
// blank/comment classification. Comment lines keep their text
// because inside a block scalar they are literal content.
struct YLine {
    indent: int,
    text: str,
    num: int,
    blank: bool,
    comment: bool,
}

// PCur is the parse cursor: pos indexes the line slice. Passing it
// `mut` lets the recursive descent return [T, err] only.
struct PCur { pos: int }

// BSt decodes a block-scalar header token.
struct BSt { ok: bool, style: int, chomp: int }

fn yerr(line: int, msg: str) -> err {
    return errors.new("yaml: line " + itoa(line) + ": " + msg)
}

// ysplit turns source text into classified lines.
fn ysplit(src: str) -> []YLine {
    out := mkslice(YLine, 0)
    pos := 0
    num := 1
    // pos < len: a trailing "\n" must not spawn a phantom empty line —
    // pblock_scalar counts blanks as keep-chomped content.
    for pos < len(src) {
        eol := pos
        for eol < len(src) && byteat(src, eol) != 10 {
            eol = eol + 1
        }
        raw := substr(src, pos, eol)
        if len(raw) > 0 && byteat(raw, len(raw) - 1) == 13 {
            raw = substr(raw, 0, len(raw) - 1)
        }
        pos = eol + 1
        ind := 0
        for ind < len(raw) && byteat(raw, ind) == 32 {
            ind = ind + 1
        }
        l := YLine{indent: ind, text: substr(raw, ind, len(raw)), num: num, blank: false, comment: false}
        if len(l.text) == 0 {
            l.blank = true
        } else if byteat(l.text, 0) == 35 {
            l.comment = true
        }
        out = push(out, l)
        num = num + 1
    }
    return out
}

// next_content skips blank and comment lines — comments are only
// content inside block scalars, which read raw lines directly.
fn next_content(ls: []YLine, i: int) -> int {
    for i < len(ls) && (ls[i].blank || ls[i].comment) {
        i = i + 1
    }
    return i
}

fn is_seq_mark(t: str) -> bool {
    return len(t) > 0 && byteat(t, 0) == 45 && (len(t) == 1 || byteat(t, 1) == 32)
}

// map_colon returns the byte index of the map ":" — outside
// quotes and either at end of line or followed by a space.
fn map_colon(t: str) -> int {
    sq := false
    dq := false
    i := 0
    for i < len(t) {
        c := byteat(t, i)
        if sq {
            if c == 39 {
                sq = false
            }
        } else if dq {
            if c == 34 {
                dq = false
            } else if c == 92 {
                i = i + 1
            }
        } else {
            if c == 39 {
                sq = true
            } else if c == 34 {
                dq = true
            } else if c == 58 {
                if i + 1 >= len(t) || byteat(t, i + 1) == 32 {
                    return i
                }
            }
        }
        i = i + 1
    }
    return -1
}

fn trim_sp(s: str) -> str {
    lo := 0
    for lo < len(s) && byteat(s, lo) == 32 {
        lo = lo + 1
    }
    hi := len(s)
    for hi > lo && byteat(s, hi - 1) == 32 {
        hi = hi - 1
    }
    return substr(s, lo, hi)
}

fn rtrim_sp(s: str) -> str {
    hi := len(s)
    for hi > 0 && byteat(s, hi - 1) == 32 {
        hi = hi - 1
    }
    return substr(s, 0, hi)
}

fn chr(c: int) -> str {
    b := mkslice(byte, 1)
    b[0] = c
    return b as str
}

// bcat appends s to a byte accumulator — amortized O(1) per byte so
// scalar decode/emit stays linear on large block text (str +=
// re-copies the whole string each step).
fn bcat(b: []byte, s: str) -> []byte {
    sb := s as []byte
    i := 0
    for i < len(sb) {
        b = push(b, sb[i])
        i = i + 1
    }
    return b
}

// pscalar parses an inline scalar: quoted or plain (comment-cut).
fn pscalar(t: str, line: int) -> [str, err] {
    s := trim_sp(t)
    if len(s) == 0 {
        return "", nil
    }
    c0 := byteat(s, 0)
    if c0 == 34 { // "
        out := mkslice(byte, 0)
        i := 1
        for i < len(s) {
            c := byteat(s, i)
            if c == 34 {
                return out as str, nil
            }
            if c == 92 && i + 1 < len(s) {
                e := byteat(s, i + 1)
                if e == 110 {
                    out = push(out, 10)
                } else if e == 116 {
                    out = push(out, 9)
                } else if e == 114 {
                    out = push(out, 13)
                } else if e == 34 || e == 92 {
                    out = push(out, e)
                } else {
                    return "", yerr(line, "unsupported escape in double-quoted scalar")
                }
                i = i + 2
            } else {
                out = push(out, c)
                i = i + 1
            }
        }
        return "", yerr(line, "unterminated double-quoted scalar")
    }
    if c0 == 39 { // '
        out := mkslice(byte, 0)
        i := 1
        for i < len(s) {
            c := byteat(s, i)
            if c == 39 {
                if i + 1 < len(s) && byteat(s, i + 1) == 39 {
                    out = push(out, 39)
                    i = i + 2
                } else {
                    return out as str, nil
                }
            } else {
                out = push(out, c)
                i = i + 1
            }
        }
        return "", yerr(line, "unterminated single-quoted scalar")
    }
    // out-of-subset value starts → corpus-shaped parse errors
    if c0 == 38 || c0 == 42 || c0 == 33 || c0 == 91 || c0 == 123 || c0 == 124 || c0 == 62 {
        return "", yerr(line, "unsupported YAML construct")
    }
    // plain: cut at " #", trim right
    idx := find(s, " #")
    if idx >= 0 {
        s = substr(s, 0, idx)
    }
    return rtrim_sp(s), nil
}

// block_style decodes "|", ">", with optional "-"/"+" chomping.
fn block_style(rest: str) -> BSt {
    bad := BSt{ok: false, style: 0, chomp: 0}
    t := trim_sp(rest)
    if len(t) == 0 {
        return bad
    }
    c := byteat(t, 0)
    style := -1
    if c == 124 {
        style = 0
    } else if c == 62 {
        style = 1
    } else {
        return bad
    }
    chomp := 0
    if len(t) > 1 {
        c1 := byteat(t, 1)
        if c1 == 45 {
            chomp = 1
        } else if c1 == 43 {
            chomp = 2
        } else if c1 != 32 {
            return bad
        }
    }
    return BSt{ok: true, style: style, chomp: chomp}
}

// empty_flow_kind recognizes a "{}" or "[]" token optionally followed
// by a trailing " #comment" — returns the container kind (1 map,
// 2 seq), or 0 when the text isn't an empty flow container.
fn empty_flow_kind(rest: str) -> int {
    if len(rest) < 2 {
        return 0
    }
    kind := 0
    if byteat(rest, 0) == 123 && byteat(rest, 1) == 125 {
        kind = 1
    } else if byteat(rest, 0) == 91 && byteat(rest, 1) == 93 {
        kind = 2
    }
    if kind == 0 {
        return 0
    }
    tail := trim_sp(substr(rest, 2, len(rest)))
    if len(tail) == 0 || byteat(tail, 0) == 35 {
        return kind
    }
    return 0
}

// pblock_scalar consumes lines deeper than base (plus blanks) into
// a `|` or `>` scalar; cur.pos starts at the first candidate line
// and ends after the scalar's last line.
fn pblock_scalar(ls: []YLine, cur: mut PCur, base: int, style: int, chomp: int) -> [str, err] {
    ents := mkslice(str, 0)
    cind := -1
    j := cur.pos
    for j < len(ls) {
        l := ls[j]
        if l.blank {
            ents = push(ents, "")
            j = j + 1
        } else if l.indent > base {
            if cind < 0 || l.indent < cind {
                cind = l.indent
            }
            ents = push(ents, l.text)
            j = j + 1
        } else {
            break
        }
    }
    if cind < 0 {
        cind = base + 1
    }
    // re-indent: keep (line.indent - cind) leading spaces
    j = cur.pos
    k := 0
    for k < len(ents) {
        l := ls[j]
        if !l.blank {
            pad := ""
            d := 0
            for d < l.indent - cind {
                pad = pad + " "
                d = d + 1
            }
            ents[k] = pad + ents[k]
        }
        j = j + 1
        k = k + 1
    }
    out := ""
    if style == 0 {
        x := 0
        for x < len(ents) {
            if x > 0 {
                out = out + "\n"
            }
            out = out + ents[x]
            x = x + 1
        }
    } else {
        x := 0
        for x < len(ents) {
            e := ents[x]
            if len(e) == 0 {
                out = out + "\n"
            } else {
                out = out + e
                if x + 1 < len(ents) && len(ents[x + 1]) > 0 {
                    out = out + " "
                }
            }
            x = x + 1
        }
    }
    if chomp == 1 {
        for len(out) > 0 && byteat(out, len(out) - 1) == 10 {
            out = substr(out, 0, len(out) - 1)
        }
    } else if chomp == 0 {
        for len(out) > 0 && byteat(out, len(out) - 1) == 10 {
            out = substr(out, 0, len(out) - 1)
        }
        if len(out) > 0 {
            out = out + "\n"
        }
    } else {
        out = out + "\n"
    }
    cur.pos = j
    return out, nil
}

// parse: whole document → root node (empty input → empty map).
fn parse(src: str) -> [own YNode, err] {
    ls := ysplit(src)
    cur := new(PCur{pos: next_content(ls, 0)})
    root := new(YNode)
    root.kind = 1
    root.line = 1
    if cur.pos >= len(ls) {
        return root, nil
    }
    [n, e] = pnode(ls, cur, ls[cur.pos].indent)
    if e != nil {
        return nil, e
    }
    j := next_content(ls, cur.pos)
    if j < len(ls) {
        return nil, yerr(ls[j].num, "unexpected content")
    }
    return n, nil
}

// pnode parses one block starting at ls[cur.pos] (a content line).
fn pnode(ls: []YLine, cur: mut PCur, indent: int) -> [own YNode, err] {
    i := cur.pos
    l := ls[i]
    if len(l.text) > 0 && byteat(l.text, 0) == 9 {
        return nil, yerr(l.num, "tab in indentation")
    }
    t := l.text
    if is_seq_mark(t) {
        return pseq(ls, cur, indent)
    }
    if map_colon(t) >= 0 {
        return pmap(ls, cur, indent)
    }
    if t == "---" || t == "..." {
        return nil, yerr(l.num, "multi-document streams unsupported")
    }
    ts := rtrim_sp(t)
    fk := empty_flow_kind(ts)
    if fk > 0 {
        n := new(YNode)
        n.kind = fk
        n.line = l.num
        cur.pos = i + 1
        return n, nil
    }
    [v, e] = pscalar(t, l.num)
    if e != nil {
        return nil, e
    }
    n := new(YNode)
    n.kind = 0
    n.s = v
    n.line = l.num
    n.plain = byteat(t, 0) != 34 && byteat(t, 0) != 39
    cur.pos = i + 1
    return n, nil
}

// pmap parses consecutive "key:"/"key: value" lines at `indent`.
fn pmap(ls: []YLine, cur: mut PCur, indent: int) -> [own YNode, err] {
    n := new(YNode)
    n.kind = 1
    n.line = ls[cur.pos].num
    for true {
        j := next_content(ls, cur.pos)
        if j >= len(ls) {
            cur.pos = j
            return n, nil
        }
        l := ls[j]
        if l.indent != indent {
            cur.pos = j
            return n, nil
        }
        mc := map_colon(l.text)
        if mc < 0 {
            cur.pos = j
            return n, nil
        }
        [k, ke] = pscalar(substr(l.text, 0, mc), l.num)
        if ke != nil {
            return nil, ke
        }
        rest := trim_sp(substr(l.text, mc + 1, len(l.text)))
        v := new(YNode)
        v.kind = 0
        v.line = l.num
        if len(rest) == 0 || byteat(rest, 0) == 35 {
            // "key:" or "key: # comment" → deeper block, an
            // indentless "- " seq at the same indent, or empty
            cur.pos = j + 1
            c := next_content(ls, j + 1)
            if c < len(ls) && (ls[c].indent > indent || (ls[c].indent == indent && is_seq_mark(ls[c].text))) {
                cur.pos = c
                [child, ce] = pnode(ls, cur, ls[c].indent)
                if ce != nil {
                    return nil, ce
                }
                v = child
            } else {
                v.s = ""
            }
        } else {
            bs := block_style(rest)
            fk := empty_flow_kind(rest)
            if bs.ok {
                cur.pos = j + 1
                [s, be] = pblock_scalar(ls, cur, indent, bs.style, bs.chomp)
                if be != nil {
                    return nil, be
                }
                v.s = s
            } else if fk > 0 {
                v.kind = fk
                cur.pos = j + 1
            } else {
                [sv, se] = pscalar(rest, l.num)
                if se != nil {
                    return nil, se
                }
                v.s = sv
                v.plain = byteat(rest, 0) != 34 && byteat(rest, 0) != 39
                cur.pos = j + 1
            }
        }
        n.pairs = push(n.pairs, YPair{key: k, val: v})
    }
    return n, nil
}

// pseq parses consecutive "- " items at `indent`. Each item's
// content is re-parsed from a virtual first line at the item's
// content column plus the real deeper lines that belong to it.
fn pseq(ls: []YLine, cur: mut PCur, indent: int) -> [own YNode, err] {
    n := new(YNode)
    n.kind = 2
    n.line = ls[cur.pos].num
    for true {
        j := next_content(ls, cur.pos)
        if j >= len(ls) {
            cur.pos = j
            return n, nil
        }
        l := ls[j]
        if l.indent != indent || !is_seq_mark(l.text) {
            cur.pos = j
            return n, nil
        }
        off := 1
        for off < len(l.text) && byteat(l.text, off) == 32 {
            off = off + 1
        }
        rest := substr(l.text, off, len(l.text))
        ccol := l.indent + off
        // extent: following lines deeper than the seq indent
        k := j + 1
        for k < len(ls) && (ls[k].blank || ls[k].comment || ls[k].indent > indent) {
            k = k + 1
        }
        it := new(YNode)
        it.line = l.num
        if len(rest) == 0 {
            c := next_content(ls, j + 1)
            if c < k && c < len(ls) {
                sub := new(PCur{pos: c})
                [child, ce] = pnode(ls, sub, ls[c].indent)
                if ce != nil {
                    return nil, ce
                }
                it = child
            } else {
                it.kind = 0
                it.s = ""
            }
        } else {
            bs := block_style(rest)
            if bs.ok && map_colon(rest) < 0 {
                sub := new(PCur{pos: j + 1})
                [s, be] = pblock_scalar(ls, sub, indent, bs.style, bs.chomp)
                if be != nil {
                    return nil, be
                }
                it.kind = 0
                it.s = s
            } else {
                // virtual slice: first line at ccol + deeper lines —
                // blanks stay: pblock_scalar reads them as content.
                sub := mkslice(YLine, 0)
                sub = push(sub, YLine{indent: ccol, text: rest, num: l.num, blank: false, comment: false})
                m := j + 1
                for m < k {
                    sub = push(sub, ls[m])
                    m = m + 1
                }
                scur := new(PCur{pos: 0})
                [child, ce] = pnode(sub, scur, ccol)
                if ce != nil {
                    return nil, ce
                }
                lc := next_content(sub, scur.pos)
                if lc < len(sub) {
                    return nil, yerr(sub[lc].num, "unexpected content in sequence item")
                }
                it = child
            }
        }
        n.items = push(n.items, it)
        cur.pos = k
    }
    return n, nil
}

// --- emit ---

fn esc_dq(s: str) -> str {
    out := mkslice(byte, 1)
    out[0] = 34
    i := 0
    for i < len(s) {
        c := byteat(s, i)
        if c == 34 {
            out = bcat(out, "\\\"")
        } else if c == 92 {
            out = bcat(out, "\\\\")
        } else if c == 10 {
            out = bcat(out, "\\n")
        } else if c == 9 {
            out = bcat(out, "\\t")
        } else if c == 13 {
            out = bcat(out, "\\r")
        } else {
            out = push(out, c)
        }
        i = i + 1
    }
    out = push(out, 34)
    return out as str
}

fn looks_bool_null(s: str) -> bool {
    return s == "true" || s == "false" || s == "True" || s == "False" || s == "TRUE" || s == "FALSE" || s == "null" || s == "Null" || s == "NULL" || s == "~"
}

fn looks_num(s: str) -> bool {
    if len(s) == 0 {
        return false
    }
    [_i, e] = strconv.atoi(s)
    if e == nil {
        return true
    }
    [_f, fe] = strconv.parsefloat(s)
    return fe == nil
}

// plain_safe: can this scalar emit unquoted?
fn plain_safe(s: str) -> bool {
    if len(s) == 0 {
        return false
    }
    c0 := byteat(s, 0)
    if c0 == 32 || byteat(s, len(s) - 1) == 32 {
        return false
    }
    if c0 == 45 && (len(s) == 1 || byteat(s, 1) == 32) {
        return false // "- " seq marker
    }
    if c0 == 33 || c0 == 38 || c0 == 42 || c0 == 91 || c0 == 93 || c0 == 123 || c0 == 125 || c0 == 35 || c0 == 124 || c0 == 62 || c0 == 37 || c0 == 64 || c0 == 96 || c0 == 39 || c0 == 34 || c0 == 63 || c0 == 44 {
        return false
    }
    if find(s, " #") >= 0 || find(s, ": ") >= 0 || find(s, "\n") >= 0 {
        return false
    }
    if byteat(s, len(s) - 1) == 58 {
        return false
    }
    if looks_bool_null(s) || looks_num(s) {
        return false
    }
    return true
}

fn ind_str(indent: int) -> str {
    s := ""
    i := 0
    for i < indent {
        s = s + " "
        i = i + 1
    }
    return s
}

fn esc_or_plain(n: ref YNode) -> str {
    if n.plain {
        return n.s
    }
    if n.force_quote || !plain_safe(n.s) {
        return esc_dq(n.s)
    }
    return n.s
}

fn emit_key(k: str) -> str {
    if plain_safe(k) {
        return k
    }
    return esc_dq(k)
}

// empty_flow renders an empty container inline — "" otherwise (a
// block "key:" with no children reparses as a scalar, so empties
// need the flow form to survive a save→load round-trip).
fn empty_flow(n: ref YNode) -> str {
    if n == nil {
        return ""
    }
    if n.kind == 1 && len(n.pairs) == 0 {
        return "{}"
    }
    if n.kind == 2 && len(n.items) == 0 {
        return "[]"
    }
    return ""
}

// block_tag picks the chomping suffix that reloads s verbatim:
// trailing "\n\n"+ keep ("|+"), one trailing "\n" clip ("|"), none
// strip ("|-").
fn block_tag(s: str) -> str {
    if len(s) >= 2 && byteat(s, len(s) - 1) == 10 && byteat(s, len(s) - 2) == 10 {
        return " |+"
    }
    if len(s) > 0 && byteat(s, len(s) - 1) == 10 {
        return " |"
    }
    return " |-"
}

// block_safe reports whether a literal block scalar round-trips s
// exactly. pblock_scalar strips the minimum content indent from every
// non-blank line, so a string whose every line leads with spaces loses
// that margin on reload; all-whitespace lines reload as empty, and a
// "\r" at end-of-line is eaten by ysplit. Those shapes emit as escaped
// double-quoted scalars instead.
fn block_safe(s: str) -> bool {
    lead := 0
    at_sol := true
    ws_only := true
    min_lead := -1
    i := 0
    for i < len(s) {
        c := byteat(s, i)
        if c == 10 {
            if ws_only {
                if lead > 0 {
                    return false
                }
            } else if min_lead < 0 || lead < min_lead {
                min_lead = lead
            }
            lead = 0
            at_sol = true
            ws_only = true
        } else if at_sol && c == 32 {
            lead = lead + 1
        } else {
            at_sol = false
            if c == 13 && (i + 1 >= len(s) || byteat(s, i + 1) == 10) {
                return false
            }
            ws_only = false
        }
        i = i + 1
    }
    if ws_only {
        if lead > 0 {
            return false
        }
    } else if min_lead < 0 || lead < min_lead {
        min_lead = lead
    }
    return min_lead <= 0
}

// emit renders the DOM to YAML text.
fn emit(n: ref YNode) -> str {
    return enode(n, 0)
}

// enode renders a node's YAML at the given indent.
fn enode(n: ref YNode, indent: int) -> str {
    pad := ind_str(indent)
    out := ""
    if n.kind == 1 {
        i := 0
        for i < len(n.pairs) {
            p := n.pairs[i]
            v := p.val
            out = out + pad + emit_key(p.key) + ":"
            if v == nil {
                out = out + "\n"
            } else if v.kind == 0 {
                if find(v.s, "\n") >= 0 && block_safe(v.s) {
                    out = out + block_tag(v.s) + "\n" + emit_block(v.s, indent + 2)
                } else {
                    out = out + " " + esc_or_plain(v) + "\n"
                }
            } else {
                ef := empty_flow(v)
                if len(ef) > 0 {
                    out = out + " " + ef + "\n"
                } else {
                    out = out + "\n" + enode(v, indent + 2)
                }
            }
            i = i + 1
        }
        return out
    }
    if n.kind == 2 {
        i := 0
        for i < len(n.items) {
            it := n.items[i]
            if it == nil {
                out = out + pad + "-\n"
            } else if it.kind == 0 {
                if find(it.s, "\n") >= 0 && block_safe(it.s) {
                    out = out + pad + "- " + block_tag(it.s) + "\n" + emit_block(it.s, indent + 2)
                } else {
                    out = out + pad + "- " + esc_or_plain(it) + "\n"
                }
            } else if it.kind == 1 && len(it.pairs) > 0 {
                // first pair inline after "- "
                p0 := it.pairs[0]
                v0 := p0.val
                out = out + pad + "- " + emit_key(p0.key) + ":"
                if v0 == nil {
                    out = out + "\n"
                } else if v0.kind == 0 {
                    if find(v0.s, "\n") >= 0 && block_safe(v0.s) {
                        out = out + " " + block_tag(v0.s) + "\n" + emit_block(v0.s, indent + 4)
                    } else {
                        out = out + " " + esc_or_plain(v0) + "\n"
                    }
                } else {
                    ef0 := empty_flow(v0)
                    if len(ef0) > 0 {
                        out = out + " " + ef0 + "\n"
                    } else {
                        out = out + "\n" + enode(v0, indent + 4)
                    }
                }
                rest := new(YNode)
                rest.kind = 1
                rest.pairs = it.pairs[1:]
                out = out + enode(rest, indent + 2)
            } else {
                efi := empty_flow(it)
                if len(efi) > 0 {
                    out = out + pad + "- " + efi + "\n"
                } else {
                    out = out + pad + "-\n" + enode(it, indent + 2)
                }
            }
            i = i + 1
        }
        return out
    }
    return out + pad + esc_or_plain(n) + "\n"
}

// emit_block renders a multiline scalar as `|` content at indent.
fn emit_block(s: str, indent: int) -> str {
    pad := ind_str(indent)
    out := ""
    cur := mkslice(byte, 0)
    i := 0
    for i < len(s) {
        c := byteat(s, i)
        if c == 10 {
            out = out + pad + (cur as str) + "\n"
            cur = mkslice(byte, 0)
        } else {
            cur = push(cur, c)
        }
        i = i + 1
    }
    if len(cur) > 0 {
        out = out + pad + (cur as str) + "\n"
    }
    return out
}
