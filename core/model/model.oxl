package model

// Transport-agnostic domain model for outgoing HTTP — corpus:
// docs/corpus/corpus-xh.md (request/response shapes) and
// docs/corpus/corpus-posting.md section 4.15 (status classes, trace).
// Apps never see sockets; transports satisfy core/http.Transport.
import "std/encoding/json"

// Header is one wire header. Requests/responses carry an ordered list
// — repeated names are legal and order is preserved.
struct Header { name: str, value: str }

// KV is a name/value/enabled row — posting headers/params/parts and
// session/config maps all share this shape. enabled=false rows are
// saved but never sent.
struct KV { name: str, value: str, enabled: bool }

// Part is one multipart part (posting schema: name, value|file,
// filename, content_type, enabled — exactly one of value|file).
struct Part {
    name: str,
    value: str,
    file: str,
    filename: str,
    content_type: str,
    enabled: bool,
    is_file: bool,
}

// Body covers the xh Body kinds (request_items.rs ~L190): Json/Form/
// Multipart/Raw/File — Empty is the no-body case upstream tracks
// implicitly. Json carries a parsed tree; Raw carries text bytes.
enum Body {
    Empty,
    Raw { ctype: str, text: str },
    Json { j: own json.Json },
    Form { fields: own []KV },
    Multipart { parts: own []Part },
    FileBody { path: str, ctype: str, filename: str },
}

// Req is one outgoing request. timeout_ms 0 = no timeout (xh --timeout
// default 0 = none); max_redirects applies only when follow is set
// (xh default 10 with --follow).
struct Req {
    method: str,
    url: str,
    headers: []Header,
    body: Body,
    timeout_ms: int,
    follow: bool,
    max_redirects: int,
    httpver: str, // "" or "HTTP/1.1" default; "HTTP/1.0" for --http-version=1.0
    synth: []Header, // synthesized tail (Accept*/Cookie) — wire emits after Content-Length, before Host
    // verify: "" or "yes" → system roots; "no" → accept-all Verifier
    // (IN-0005=B); otherwise a PEM path loaded into x509.Roots.
    verify: str,
    // jar_off disables the transport's in-chain cookie jar (posting's
    // attach_cookies=false); false keeps xh's always-on in-memory jar.
    jar_off: bool,
    // WI-0013 protocol surfaces (spec sem-S1..S5, ADR-0030/0032):
    h2: str, // "" none · "hint" = ALPN h2+http/1.1 · "prior" = h2c on http, ALPN-required h2 on https
    ssl_min: int, // tls version floor (tls.V12/V13); 0 = build default range
    ssl_max: int, // tls version ceiling; 0 = build default range
    cert_pem: str, // client certificate PEM text; "" = none (plan reads files eagerly)
    key_pem: str, // client key PEM text; "" = cert_pem is a combined PEM
    proxies: []str, // verbatim --proxy "PROTO:URL" entries ("" list = use env)
    proxy_env: []str, // captured "NAME=value" env proxy vars (empty when --proxy given)
    no_proxy: str, // NO_PROXY/no_proxy comma list text
    // WI-0017 review fix: proxy_go selects Go httpproxy semantics for
    // the env/no_proxy path (TUI/posting plan_req); false keeps the
    // reqwest/std port the xh CLI feeds. cgi records a raw non-empty
    // REQUEST_METHOD — under proxy_go an http:// hop with a usable
    // HTTP_PROXY env value errors at send time (Go CGI guard).
    proxy_go: bool,
    cgi: bool,
    // opt-in response-body byte cap, enforced while wire bytes accumulate
    // and again after content decoding; zero preserves legacy uncapped
    // behavior. OAuth token endpoints use 1 MiB.
    max_body_bytes: int,
}

// ReqHead is what the wire emitted for one request — kept verbatim
// (CRLF line ends) so the CLI can render --all history exactly.
struct ReqHead { head: str }

// Hop is one redirect-chain exchange before the final response:
// the sent head plus the response that followed it (ADR 0020 —
// xh --all/--history-print print each hop interleaved).
struct Hop {
    req_head: str,
    status: int,
    reason: str,
    version: str,
    headers: []Header,
    body: []byte,
    elapsed_ms: float,
    remote: str,
    url: str, // resolved URL this hop requested (post-Location resolve)
}

// Trace is the per-stage timing posting shows in its Trace tab
// (corpus §4.14: connect, tls handshake, send headers, send body,
// receive headers, receive body, response closed).
struct Trace {
    connect_ms: float,
    tls_ms: float,
    send_headers_ms: float,
    send_body_ms: float,
    recv_headers_ms: float,
    recv_body_ms: float,
    closed_ms: float,
}

// Resp is one received response. body is raw bytes (latin1/UTF-8
// display handling is the printer's concern).
// StreamEvent is one entry in a streaming exchange's log (corpus
// §4.15 Messages log / upstream model.MessageEvent). kind: 0 sent,
// 1 received, 2 info, 3 error. at_ms is unix-ms local observation
// time; event/id carry SSE metadata (empty for other protocols).
struct StreamEvent {
    at_ms: int,
    kind: int,
    title: str,
    body: []byte,
    content_type: str,
    event: str,
    id: str,
}

struct Resp {
    status: int,
    reason: str,
    headers: []Header,
    body: []byte,
    elapsed_ms: float,
    remote: str,
    version: str, // wire version token, e.g. "1.1" from "HTTP/1.1"; "2.0" under h2
    req_head: str, // wire request head that produced this response (CRLF text)
    hops: own []Hop, // redirect-chain exchanges before this response
    trace: own Trace,
    tls_ver: int, // negotiated TLS version (tls.V12/V13); 0 = cleartext
    events: own []StreamEvent, // SSE/stream log; nil for unary responses
    stream_error: str, // interrupted-stream explanation; "" when clean
}

// status_class: <300 success(0), <400 redirect(1), else error(2) —
// posting §4.15 StatusClass; xh check-status exits 3/4/5 on the same
// boundaries.
fn status_class(status: int) -> int {
    if status < 300 {
        return 0
    }
    if status < 400 {
        return 1
    }
    return 2
}
