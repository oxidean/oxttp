package main

// S11 cfg glue tests (plan step 8): apply_settings field map, keymap
// rebinds (table + end-to-end dispatch), environments.json recall/
// remember round-trip, disk history write→load + caps + enabled=false,
// variables edit/add/revert session ops, theme picker enter/escape,
// curl import subsets (data/json/form/auth/flags/errors).

import "std/testing"
import "std/os"
import "std/os/exec"
import "std/strings"
import "std/time"
import "std/errors"
import "github.com/oxidean/oxttp/core/config"
