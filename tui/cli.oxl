package main

// tui/cli — the posting CLI surface (ADR-0036): subcommand
// dispatch for `import|locate|remote|run|version`, each returning
// an Out{code,stdout,stderr} the caller prints (the Run contract
// mirrors cli/exec.oxl so tests assert on fields, not fds).

import "std/os"
import "std/errors"
import "std/io"
import "std/net/tls"
import "std/time"
import "std/encoding/json"
import "std/encoding/base64"
import "std/unicode/utf8"
import "github.com/oxidean/oxttp/core/capture"
import "github.com/oxidean/oxttp/core/collection"
import "github.com/oxidean/oxttp/core/config"
import "github.com/oxidean/oxttp/core/env"
import "github.com/oxidean/oxttp/core/http"
import "github.com/oxidean/oxttp/core/model"
import "github.com/oxidean/oxttp/core/importing"
import "github.com/oxidean/oxttp/core/yaml"
import "github.com/oxidean/oxttp/shared/version"

// stat-style regular-file probe (follows symlinks), matching os.Stat's
// Mode().IsRegular gate in the upstream import command.
extern fn rt_isfilex(path: str) -> int

struct Out { code: int, stdout: str, stderr: str }

fn cli_is_sub(a0: str) -> bool {
    return a0 == "import" || a0 == "locate" || a0 == "remote" || a0 == "run" || a0 == "version" || a0 == "-v" || a0 == "--version"
}

// cli_main runs the subcommand named by argv[1].
fn cli_args() -> []str {
    let a: []str = nil
    i := 1
    for i < os.nargs() {
        a = push(a, os.args(i))
        i = i + 1
    }
    return a
}

fn cli_main() -> Out {
    a0 := os.args(1)
    if a0 == "version" || a0 == "-v" || a0 == "--version" {
        return cli_version()
    }
    if a0 == "locate" {
        return cli_locate()
    }
    if a0 == "remote" {
        return cli_remote()
    }
    if a0 == "import" {
        return cli_import()
    }
    return cli_run()
}

fn cli_version() -> Out {
    return Out{code: 0, stdout: "Posting " + version.get() + "\n", stderr: ""}
}

fn cli_locate() -> Out {
    return cli_locate_args(cli_args())
}

fn cli_locate_args(args: []str) -> Out {
    if len(args) != 2 {
        return Out{code: 2, stdout: "", stderr: "posting locate: usage: posting locate config|collection|themes\n"}
    }
    what := args[1]
    if what == "config" {
        return Out{code: 0, stdout: "Config file:\n" + config.config_file() + "\n", stderr: ""}
    }
    if what == "collection" {
        return Out{code: 0, stdout: "Default collection directory:\n" + config.default_coll_dir() + "\n", stderr: ""}
    }
    if what == "themes" {
        // Upstream paths.ThemeDir honors the configured
        // theme_directory (config.yaml / POSTING_THEME_DIRECTORY).
        cr := config.load("", config.posting_env_pairs())
        return Out{code: 0, stdout: "Themes directory:\n" + config.theme_dir(cr.s) + "\n", stderr: ""}
    }
    return Out{code: 2, stdout: "", stderr: "Unknown thing to locate: \"" + what + "\"\n"}
}

// ---------- remote (ADR-0066: UDS degrade, upstream surface) ----------

// RParse is upstream remoteOptions + parse outcome. err/help mirror
// Go's (opts, error) with flagHelp as a distinct help flag.
struct RParse {
    cmd: str,
    ref: str,
    has_ref: bool,
    curl: str,
    yaml: str,
    inst: str,
    json: bool,
    none: bool,
    envs: []str,
    name: str,
    file: str,
    help: bool,
    err: str,
}

// remote_parse ports cmd/posting/remote.go parseRemoteOptions:
// flags anywhere, `--` ends them, `-` alone is positional, name is
// arg minus ALL leading dashes cut on first '='.
fn remote_parse(args: []str) -> own RParse {
    rp := new(RParse)
    let pos: []str = nil
    i := 1
    for i < len(args) {
        arg := args[i]
        i = i + 1
        if arg == "--" {
            j := i
            for j < len(args) {
                pos = push(pos, args[j])
                j = j + 1
            }
            break
        }
        first := 0
        if len(arg) == 0 || byteat(arg, 0) != 45 || arg == "-" {
            pos = push(pos, arg)
            continue
        }
        // TrimLeft(arg, "-") then Cut on '='
        for first < len(arg) && byteat(arg, first) == 45 {
            first = first + 1
        }
        body := substr(arg, first, len(arg))
        eq := find(body, "=")
        name := body
        value := ""
        has_value := false
        if eq >= 0 {
            name = substr(body, 0, eq)
            value = substr(body, eq + 1, len(body))
            has_value = true
        }
        if name == "h" || name == "help" {
            rp.help = true
            return rp
        }
        if name == "json" || name == "none" {
            if has_value {
                rp.err = "--" + name + " takes no value"
                return rp
            }
            if name == "json" {
                rp.json = true
            } else {
                rp.none = true
            }
            continue
        }
        target := ""
        is_curl := false
        is_yaml := false
        if name == "name" {
            target = "name"
        } else if name == "curl" {
            target = "curl"
            is_curl = true
        } else if name == "yaml" {
            target = "yaml"
            is_yaml = true
        } else if name == "instance" {
            target = "instance"
        } else {
            rp.err = "unknown option " + arg
            return rp
        }
        if !has_value {
            if i >= len(args) {
                rp.err = arg + " needs a value"
                return rp
            }
            value = args[i]
            i = i + 1
        }
        if (is_curl || is_yaml) && trim_space(value) == "" {
            rp.err = "--" + name + " needs a nonempty value"
            return rp
        }
        if target == "name" {
            rp.name = value
        } else if target == "curl" {
            rp.curl = value
        } else if target == "yaml" {
            rp.yaml = value
        } else {
            rp.inst = value
        }
    }
    if len(pos) == 0 {
        rp.err = "no command given"
        return rp
    }
    rp.cmd = pos[0]
    rest := mkslice(str, 0)
    pi := 1
    for pi < len(pos) {
        rest = push(rest, pos[pi])
        pi = pi + 1
    }
    pos = rest
    if rp.cmd == "open" || rp.cmd == "send" {
        if len(pos) > 1 {
            rp.err = "unexpected argument \"" + pos[1] + "\""
            return rp
        }
        if len(pos) == 1 {
            rp.ref = pos[0]
            rp.has_ref = true
        }
        given := 0
        if rp.has_ref {
            given = given + 1
        }
        if len(rp.curl) > 0 {
            given = given + 1
        }
        if len(rp.yaml) > 0 {
            given = given + 1
        }
        if given > 1 {
            rp.err = "give only one of REQUEST, --curl and --yaml"
            return rp
        }
    } else if rp.cmd == "env" {
        rp.envs = pos
        if rp.none && len(pos) > 0 {
            rp.err = "give an environment or --none, not both"
            return rp
        }
    } else if rp.cmd == "save" {
        if len(pos) > 1 {
            rp.err = "unexpected argument \"" + pos[1] + "\""
            return rp
        }
        if len(pos) == 1 {
            rp.file = pos[0]
        }
    } else if rp.cmd == "list" || rp.cmd == "requests" || rp.cmd == "show" || rp.cmd == "response" || rp.cmd == "skill" {
        if len(pos) > 0 {
            rp.err = "unexpected argument \"" + pos[0] + "\""
            return rp
        }
    } else {
        rp.err = "unknown command \"" + rp.cmd + "\""
        return rp
    }
    if (len(rp.curl) > 0 || len(rp.yaml) > 0) && rp.cmd != "open" && rp.cmd != "send" {
        rp.err = "--curl and --yaml are for open and send"
        return rp
    }
    if rp.none && rp.cmd != "env" {
        rp.err = "--none is for env"
        return rp
    }
    if len(rp.name) > 0 && rp.cmd != "save" {
        rp.err = "--name is for save"
        return rp
    }
    return rp
}

fn trim_space(s: str) -> str {
    i := 0
    for i < len(s) && (byteat(s, i) == 32 || byteat(s, i) == 9 || byteat(s, i) == 10 || byteat(s, i) == 13) {
        i = i + 1
    }
    j := len(s)
    for j > i && (byteat(s, j - 1) == 32 || byteat(s, j - 1) == 9 || byteat(s, j - 1) == 10 || byteat(s, j - 1) == 13) {
        j = j - 1
    }
    return substr(s, i, j)
}

fn cli_remote() -> Out {
    return cli_remote_args(cli_args())
}

fn cli_remote_args(args: []str) -> Out {
    rp := remote_parse(args)
    if rp.help {
        return Out{code: 0, stdout: REMOTE_USAGE, stderr: ""}
    }
    if len(rp.err) > 0 {
        return Out{code: 2, stdout: "", stderr: "posting remote: " + rp.err + "\nRun posting remote --help for usage.\n"}
    }
    // skill short-circuits before instance discovery (upstream
    // remoteCommand) — works with no Posting running.
    if rp.cmd == "skill" {
        return Out{code: 0, stdout: REMOTE_SKILL_MD, stderr: ""}
    }
    // UDS unsupported: instance discovery always yields zero
    // instances (ADR-0066).
    os.getenv("POSTING_INSTANCE")
    if rp.cmd == "list" {
        if rp.json {
            return Out{code: 0, stdout: "[]\n", stderr: ""}
        }
        return Out{code: 0, stdout: "", stderr: "No Posting is running.\n"}
    }
    // every remaining command is instance-bound → degrade.
    return Out{code: 1, stdout: "", stderr: "posting remote: no running Posting found (unix sockets unsupported in this build)\n"}
}

fn cli_import() -> Out {
    return cli_import_args(cli_args())
}

fn cli_lower_ascii(s: str) -> str {
    b := mkslice(byte, len(s))
    i := 0
    for i < len(s) {
        c := byteat(s, i)
        if c >= 65 && c <= 90 {
            c = c + 32
        }
        b[i] = c
        i = i + 1
    }
    return b as str
}

fn cli_import_args(args: []str) -> Out {
    i := 1
    typ := ""
    output := ""
    flags := true
    let srcs: []str = nil
    for i < len(args) {
        a := args[i]
        i = i + 1
        if flags && a == "--" {
            flags = false
            continue
        }
        // --type=x / -type=x / -t=x forms (upstream flag splitter).
        if flags && len(a) >= 7 && substr(a, 0, 7) == "--type=" {
            typ = substr(a, 7, len(a))
            continue
        }
        if flags && len(a) >= 6 && substr(a, 0, 6) == "-type=" {
            typ = substr(a, 6, len(a))
            continue
        }
        if flags && len(a) >= 3 && substr(a, 0, 3) == "-t=" {
            typ = substr(a, 3, len(a))
            continue
        }
        // Output forms are consumed here and passed to import_run, which
        // owns the env-only output requirement. Raw args are never rescanned:
        // option-looking text after `--` is a source, not an output override.
        if flags && len(a) >= 9 && substr(a, 0, 9) == "--output=" {
            output = substr(a, 9, len(a))
            continue
        }
        if flags && len(a) >= 8 && substr(a, 0, 8) == "-output=" {
            output = substr(a, 8, len(a))
            continue
        }
        if flags && len(a) >= 3 && substr(a, 0, 3) == "-o=" {
            output = substr(a, 3, len(a))
            continue
        }
        if flags && (a == "-t" || a == "--type" || a == "-type") {
            if i >= len(args) {
                return Out{code: 2, stdout: "", stderr: "posting import: --type needs a value\n"}
            }
            typ = args[i]
            i = i + 1
        } else if flags && (a == "-o" || a == "--output" || a == "-output") {
            if i >= len(args) {
                return Out{code: 2, stdout: "", stderr: "posting import: --output needs a value\n"}
            }
            output = args[i]
            i = i + 1
        } else if flags && (a == "-h" || a == "--help") {
            return Out{code: 0, stdout: "Usage: posting import [options] SOURCE [ENVIRONMENT...]\n\nImport an OpenAPI 3.x specification, Postman v2 collection, Bruno .bru request,\nor Bruno collection directory, with any number of Postman environment exports.\nThe collection format is detected unless --type is given.\n\nCollection variables are written to posting.env, the base environment. Each\nenvironment is written to its own <name>.env, layered on the base. To add\nenvironments to an existing collection, give only environment files and\n--output.\n\nOptions:\n  -t, --type FORMAT    Collection format: openapi, postman, or bruno\n  -o, --output DIR     Destination (default: a named folder in the default collection)\n  -h, --help           Show this help\n\nOptions may appear before or after the files. Existing files are never\noverwritten. Unsupported source features are reported as warnings.\n", stderr: ""}
        } else if flags && len(a) > 0 && byteat(a, 0) == 45 {
            return Out{code: 2, stdout: "", stderr: "posting import: unknown flag " + a + "\n"}
        } else {
            srcs = push(srcs, a)
        }
    }
    typ = cli_lower_ascii(typ)
    if typ != "openapi" && typ != "postman" && typ != "bruno" && typ != "" {
        return Out{code: 2, stdout: "", stderr: "posting import: unknown import type \"" + typ + "\" (choose openapi, postman, or bruno)\n"}
    }
    if len(srcs) == 0 {
        return Out{code: 2, stdout: "", stderr: "posting import: expected a source file or directory\n"}
    }
    return import_run(srcs, typ, output)
}

// ---------- import engine ----------

// imp_diag — upstream importDiagnostic: strconv.Quote minus the
// surrounding quotes (escapes control chars for terminal safety).
fn imp_diag(msg: str) -> str {
    j := json.jstr(msg)
    if j == nil {
        return msg
    }
    q := json.tojson(j)
    if len(q) >= 2 {
        return substr(q, 1, len(q) - 1)
    }
    return msg
}

fn imp_warns(warns: []str) -> str {
    out := ""
    i := 0
    for i < len(warns) {
        out = out + "warning: " + imp_diag(warns[i]) + "\n"
        i = i + 1
    }
    return out
}

// imp_is_postman_env — values array present, item array absent.
fn imp_is_postman_env(data: str) -> bool {
    doc := json.jparse(data)
    if doc == nil || doc.kind != 4 {
        return false
    }
    v := json.jget(doc, "values")
    it := json.jget(doc, "item")
    return v != nil && v.kind == 5 && (it == nil || it.kind != 5)
}

// imp_detect — parseCollection format sniff: .bru → bruno; else JSON
// keys openapi|swagger → openapi, info+item → postman; YAML fallback.
fn imp_detect(src: str, data: str) -> str {
    // cheap suffix check first
    if len(src) >= 4 && substr(src, len(src) - 4, len(src)) == ".bru" {
        return "bruno"
    }
    doc := json.jparse(data)
    if doc != nil && doc.kind == 4 {
        if json.jget(doc, "openapi") != nil || json.jget(doc, "swagger") != nil {
            return "openapi"
        }
        if json.jget(doc, "info") != nil && json.jget(doc, "item") != nil {
            return "postman"
        }
        return ""
    }
    // YAML fallback — top-level map keys only.
    [yn, ye] = yaml.parse(data)
    if ye != nil || yn == nil || yn.kind != 1 {
        return ""
    }
    has_oas := false
    has_info := false
    has_item := false
    i := 0
    for i < len(yn.pairs) {
        k := yn.pairs[i].key
        if k == "openapi" || k == "swagger" {
            has_oas = true
        }
        if k == "info" {
            has_info = true
        }
        if k == "item" {
            has_item = true
        }
        i = i + 1
    }
    if has_oas {
        return "openapi"
    }
    // Postman collections are JSON-only in the parser; do not label a
    // YAML lookalike as Postman and then reject it as malformed JSON.
    return ""
}

struct ImpParseOut { res: own importing.Result, format: str, errmsg: str }

fn imp_parse(src: str, data: str, format: str) -> own ImpParseOut {
    o := new(ImpParseOut)
    fmt := format
    if fmt == "" {
        fmt = imp_detect(src, data)
    }
    if fmt == "" {
        o.errmsg = "cannot detect import format; use --type openapi, postman, or bruno"
        return o
    }
    o.format = fmt
    if fmt == "openapi" {
        [r, e] = importing.oparse(data)
        if e != nil {
            o.errmsg = errors.msg(e)
            return o
        }
        o.res = r
        return o
    }
    if fmt == "postman" {
        [r2, e2] = importing.pparse(data)
        if e2 != nil {
            o.errmsg = errors.msg(e2)
            return o
        }
        o.res = r2
        return o
    }
    [r3, e3] = importing.bparse(data)
    if e3 != nil {
        o.errmsg = errors.msg(e3)
        return o
    }
    o.res = r3
    return o
}

// imp_base — filepath.Base approximation for env naming.
fn imp_base(path: str) -> str {
    i := len(path) - 1
    for i >= 0 {
        if byteat(path, i) == 47 {
            return substr(path, i + 1, len(path))
        }
        i = i - 1
    }
    return path
}

fn imp_trim_suffix(s: str, suf: str) -> str {
    if len(s) >= len(suf) && substr(s, len(s) - len(suf), len(s)) == suf {
        return substr(s, 0, len(s) - len(suf))
    }
    return s
}

// readImports — at most one collection + Postman env exports.
// imp_abspath — filepath.Abs approximation: lexical, no existence
// requirement. os.fullpath is realpath(3)-backed and returns "" for
// paths that do not exist yet — which is exactly the import output
// case, since write creates it. Relative paths join onto cwd.
fn imp_abspath(p: str) -> str {
    if len(p) > 0 && byteat(p, 0) == 47 {
        return p
    }
    cwd := os.fullpath(".")
    if len(cwd) == 0 {
        return p
    }
    return cwd + "/" + p
}

// imp_read_bounded reads at most limit+1 bytes. Unlike os.readfile_,
// the import size cap is enforced before allocating for the whole file;
// an empty result from a failed open remains an error rather than an
// empty source.
fn imp_read_bounded(path: str, limit: int) -> [str, err] {
    [f, fe] = os.open(path)
    if fe != nil {
        return "", fe
    }
    out := mkslice(byte, 0)
    remaining := limit + 1
    bad := false
    errmsg := ""
    for remaining > 0 && !bad {
        want := remaining
        if want > 65536 {
            want = 65536
        }
        buf := mkslice(byte, want)
        [n, re] = f.read(buf)
        if n > 0 {
            bi := 0
            for bi < n {
                out = push(out, buf[bi])
                bi = bi + 1
            }
            remaining = remaining - n
        }
        if re != nil {
            if re == io.eof() {
                break
            }
            errmsg = errors.msg(re)
            bad = true
        }
        if n <= 0 {
            break
        }
    }
    ce := f.close()
    if bad {
        return "", errors.new("read " + path + ": " + errmsg)
    }
    if ce != nil {
        return "", ce
    }
    return out as str, nil
}

fn import_run(sources: []str, format: str, output_opt: str) -> Out {
    coll := new(importing.Result)
    coll.requests = mkslice(importing.ImpRequest, 0)
    coll.variables = mkslice(model.KV, 0)
    coll.envs = mkslice(importing.Env, 0)
    coll.warns = mkslice(str, 0)
    have_coll := false
    coll_src := ""
    coll_fmt := ""
    all_warns := mkslice(str, 0)
    export_envs := mkslice(importing.Env, 0)
    si := 0
    for si < len(sources) {
        src := sources[si]
        si = si + 1
        if os.isdir(src) {
            if format != "" && format != "bruno" {
                return Out{code: 2, stdout: "", stderr: "posting import: " + format + " import requires a file\n"}
            }
            if have_coll {
                return Out{code: 1, stdout: "", stderr: "posting import: expected one collection, but " + coll_src + " and " + src + " are both collections\n"}
            }
            have_coll = true
            coll_src = src
            [cres, cerr] = importing.bl_load(src)
            if cerr != nil {
                return Out{code: 1, stdout: "", stderr: "posting import: " + imp_diag(errors.msg(cerr)) + "\n"}
            }
            coll = cres
            coll_fmt = "bruno"
            continue
        }
        if !os.exists(src) {
            return Out{code: 1, stdout: "", stderr: "posting import: " + imp_diag(src) + ": no such file\n"}
        }
        if rt_isfilex(src) == 0 {
            return Out{code: 1, stdout: "", stderr: "posting import: source must be a regular file or Bruno directory\n"}
        }
        [data, drerr] = imp_read_bounded(src, 33554432)
        if drerr != nil {
            return Out{code: 1, stdout: "", stderr: "posting import: " + imp_diag(src) + ": " + imp_diag(errors.msg(drerr)) + "\n"}
        }
        if len(data) > 33554432 {
            return Out{code: 1, stdout: "", stderr: "posting import: " + imp_diag(src) + ": source exceeds the 32 MiB import limit\n"}
        }
        if imp_is_postman_env(data) {
            eo := importing.pparse_env(data)
            if len(eo.err) > 0 {
                return Out{code: 1, stdout: "", stderr: "posting import: " + src + ": " + imp_diag(eo.err) + "\n"}
            }
            if len(eo.err) == 0 && eo.env != nil {
                ev := importing.Env{name: eo.env.name, variables: eo.env.variables}
                if ev.name == "" {
                    ev.name = imp_trim_suffix(imp_trim_suffix(imp_base(src), ".json"), ".postman_environment")
                }
                export_envs = push(export_envs, ev)
            }
            all_warns = append_kv_warns(all_warns, eo.warns)
            continue
        }
        if have_coll {
            return Out{code: 1, stdout: "", stderr: "posting import: expected one collection, but " + coll_src + " and " + src + " are both collections; other arguments must be Postman environment exports\n"}
        }
        have_coll = true
        coll_src = src
        po := imp_parse(src, data, format)
        if len(po.errmsg) > 0 {
            return Out{code: 1, stdout: "", stderr: "posting import: " + imp_diag(po.errmsg) + "\n"}
        }
        coll = po.res
        coll_fmt = po.format
        if po.format == "bruno" && len(coll.requests) == 1 {
            bn := imp_trim_suffix(imp_base(src), ".bru")
            coll.requests[0].file = bn + ".posting.yaml"
        }
    }
    // Environment exports are independent of the collection source order:
    // loading a later collection must not discard an export seen earlier.
    ei := 0
    for ei < len(export_envs) {
        coll.envs = push(coll.envs, export_envs[ei])
        ei = ei + 1
    }
    // merge env-export warnings into result warnings
    i := 0
    for i < len(all_warns) {
        coll.warns = push(coll.warns, all_warns[i])
        i = i + 1
    }
    output := output_opt
    if coll_fmt == "" && len(sources) > 0 && output == "" {
        return Out{code: 2, stdout: "", stderr: "posting import: importing only environments requires --output DIR, the collection to add them to\n"}
    }
    if coll_fmt != "" && len(coll.requests) == 0 {
        return Out{code: 1, stdout: "", stderr: "posting import: source contains no importable HTTP requests\n" + imp_warns(append_kv_warns(coll.warns, mkslice(str, 0)))}
    }
    if output == "" {
        output = config.default_coll_dir() + "/" + importing.directory_name(coll.name)
    }
    output = imp_abspath(output)
    [written, werr] = importing.write(coll, output)
    if werr != nil {
        return Out{code: 1, stdout: "", stderr: "posting import: " + imp_diag(errors.msg(werr)) + "\n"}
    }
    warns := append_kv_warns(coll.warns, written.warns)
    wtext := imp_warns(warns)
    if coll_fmt == "" {
        out := "Imported " + itoa(len(coll.envs)) + " environment(s) into \"" + output + "\".\n"
        return Out{code: 0, stdout: out + imp_envs_line(output, written.envs), stderr: wtext}
    }
    out := "Imported " + itoa(len(written.files)) + " " + coll_fmt + " request(s) into \"" + output + "\".\n"
    return Out{code: 0, stdout: out + imp_envs_line(output, written.envs), stderr: wtext}
}

fn append_kv_warns(a: []str, b: []str) -> []str {
    i := 0
    for i < len(b) {
        a = push(a, b[i])
        i = i + 1
    }
    return a
}

// imp_envs_line — printImportedEnvironments: env files + Open with hint.
fn imp_envs_line(output: str, envs: []importing.WEnv) -> str {
    if len(envs) == 0 {
        return "Open with: posting -c " + imp_quote(output) + "\n"
    }
    files := ""
    selected := ""
    base_file := ""
    i := 0
    for i < len(envs) {
        f := imp_diag(envs[i].file)
        if envs[i].base {
            f = f + " (base)"
            if envs[i].file != "posting.env" {
                base_file = envs[i].file
            }
        } else if selected == "" {
            selected = envs[i].name
        }
        if i > 0 {
            files = files + ", "
        }
        files = files + f
        i = i + 1
    }
    if selected == "" {
        selected = envs[0].name
    }
    base_arg := ""
    if len(base_file) > 0 {
        base_arg = " --env " + imp_quote(base_file)
    }
    return "Environments: " + files + "\nOpen with: posting -c " + imp_quote(output) + base_arg + " --env " + imp_quote(selected) + "\n"
}

fn imp_rep(s: str, old: str, repl: str) -> str {
    out := ""
    pos := 0
    done := false
    for !done {
        i := find(substr(s, pos, len(s)), old)
        if i < 0 {
            done = true
        } else {
            gi := pos + i
            out = out + substr(s, pos, gi) + repl
            pos = gi + len(old)
        }
    }
    return out + substr(s, pos, len(s))
}

// imp_quote — curl.Quote approximation: single-quote when needed.
fn imp_quote(s: str) -> str {
    // POSIX-shell single-quote encoding. Keep only the conventional
    // portable bareword characters unquoted; metacharacters such as &,
    // ;, |, <, >, $, `, (), and glob characters must not reach a copied
    // shell command. Empty strings need explicit quotes too.
    need := len(s) == 0
    i := 0
    for i < len(s) {
        c := byteat(s, i)
        safe := (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57)
        safe = safe || c == 95 || c == 45 || c == 46 || c == 47 || c == 58 || c == 61 || c == 64 || c == 43 || c == 44 || c == 37
        if !safe {
            need = true
        }
        i = i + 1
    }
    if !need {
        return s
    }
    return "'" + imp_rep(s, "'", "'\\''") + "'"
}

// ---------- run ----------

struct RunOpts {
    coll: str,
    target: str,
    envs: []str,
    fail_fast: bool,
    json: bool,
    cfg_file: str, // test seam — "" = default config resolution
}

struct RunRep {
    code: int,
    lines: []str,   // per-request PASS/FAIL/SKIP + summary (or json)
    err: str,       // run-level error text
    stderr: str,    // non-fatal warnings (use_host_environment etc.)
    passed: int,
    failed: int,
    skipped: int,
    json: bool,
}

// run_usage — upstream cmd/posting/run.go runUsage verbatim.
fn run_usage() -> str {
    return "Usage: posting run [options] PATH\n" +
        "       posting run --collection DIR [PATH] [options]\n" +
        "\n" +
        "Run saved requests for agents and scripts without a running Posting instance.\n" +
        "PATH is a .posting.yaml file or a directory, searched recursively. Requests\n" +
        "run one at a time in lexical file-path order, not the sidebar's method/name order.\n" +
        "Use numbered filenames to order dependent requests. Cookies and response\n" +
        "captures carry forward during this run only. No history is written.\n" +
        "\n" +
        "Options:\n" +
        "  -c, --collection DIR  Collection root for uploads, proto files and environments.\n" +
        "                       PATH is relative to DIR; omit PATH to run all of DIR.\n" +
        "                       Without -c, the root is PATH if it's a directory, or\n" +
        "                       the request file's parent directory.\n" +
        "  -e, --env NAME|FILE   Environment in the collection root, or a file path\n" +
        "                       relative to the working directory. Repeat to layer.\n" +
        "                       Default: posting.env + posting.local.env in the root.\n" +
        "                       The UI's remembered environment is never used.\n" +
        "  --fail-fast          Stop after the first failed request\n" +
        "  --json               Print one JSON report, including response bodies\n" +
        "  -h, --help           Show this help\n" +
        "\n" +
        "Options may appear before or after PATH. Text output gives a result per\n" +
        "request and a summary; --json includes results, passed, failed and skipped.\n" +
        "Use --json to inspect response bodies and headers, including error responses.\n" +
        "These may contain secrets. This command doesn't evaluate custom assertions.\n" +
        "\n" +
        "Exit codes: 0 = all passed; 1 = a run/load error or failed request;\n" +
        "2 = invalid arguments. HTTP 4xx/5xx, GraphQL errors, non-OK gRPC statuses,\n" +
        "transport errors and failed captures fail the run. HTTP redirects aren't\n" +
        "failures. Empty collections and requests with legacy Python scripts are\n" +
        "rejected. Malformed request files abort the run before anything is sent.\n" +
        "\n" +
        "Examples:\n" +
        "  posting run api/health.posting.yaml --json\n" +
        "  posting run api --env dev --json > results.json\n" +
        "  posting run -c api users/get.posting.yaml --env staging\n" +
        "  posting run -c api --fail-fast\n"
}

// run_parse — upstream parseRunOptions: same flag grammar as remote
// (TrimLeft '-' + Cut '='), per-name rules, positional rules verbatim.
struct RunParse { o: own RunOpts, help: bool, err: str }

fn run_parse() -> own RunParse {
    return run_parse_args(cli_args())
}

fn run_parse_args(args: []str) -> own RunParse {
    rp := new(RunParse)
    rp.o = new(RunOpts)
    let pos: []str = nil
    i := 1
    for i < len(args) {
        arg := args[i]
        i = i + 1
        if arg == "--" {
            j := i
            for j < len(args) {
                pos = push(pos, args[j])
                j = j + 1
            }
            break
        }
        if len(arg) == 0 || byteat(arg, 0) != 45 || arg == "-" {
            pos = push(pos, arg)
            continue
        }
        first := 0
        for first < len(arg) && byteat(arg, first) == 45 {
            first = first + 1
        }
        body := substr(arg, first, len(arg))
        eq := find(body, "=")
        name := body
        value := ""
        has_value := false
        if eq >= 0 {
            name = substr(body, 0, eq)
            value = substr(body, eq + 1, len(body))
            has_value = true
        }
        if name == "h" || name == "help" {
            rp.help = true
            return rp
        }
        if name == "json" || name == "fail-fast" {
            if has_value {
                rp.err = "--" + name + " takes no value"
                return rp
            }
            if name == "json" {
                rp.o.json = true
            } else {
                rp.o.fail_fast = true
            }
            continue
        }
        if name != "c" && name != "collection" && name != "e" && name != "env" {
            rp.err = "unknown option " + arg
            return rp
        }
        if !has_value {
            if i >= len(args) {
                rp.err = arg + " needs a value"
                return rp
            }
            value = args[i]
            i = i + 1
        }
        if trim_space(value) == "" {
            rp.err = "--" + name + " needs a nonempty value"
            return rp
        }
        if name == "c" || name == "collection" {
            rp.o.coll = value
        } else {
            rp.o.envs = push(rp.o.envs, value)
        }
    }
    if len(pos) > 1 {
        rp.err = "expected one request file or directory"
        return rp
    }
    if len(pos) == 0 {
        if len(rp.o.coll) == 0 {
            rp.err = "give a request file, directory, or --collection DIR"
            return rp
        }
        rp.o.target = "."
    } else {
        rp.o.target = pos[0]
        if trim_space(rp.o.target) == "" {
            rp.err = "request path must not be empty"
            return rp
        }
    }
    return rp
}

fn cli_run() -> Out {
    rp := run_parse()
    if rp.help {
        return Out{code: 0, stdout: run_usage(), stderr: ""}
    }
    if len(rp.err) > 0 {
        return Out{code: 2, stdout: "", stderr: "posting run: " + rp.err + "\nRun posting run --help for usage.\n"}
    }
    rep := run_exec(rp.o, http.H1{})
    se := rep.stderr
    if len(rep.err) > 0 {
        se = se + "posting run: " + rep.err + "\n"
        // upstream fail(): the report still prints — text summary or
        // the --json doc carrying "error".
        if len(rep.lines) == 0 {
            rep.lines = run_report_lines(rep)
        }
    }
    return Out{code: rep.code, stdout: join(rep.lines), stderr: se}
}

// run_report_lines — printRunReport's output for a report that ended
// early (load/env error): the counts accumulated so far plus err in
// the JSON doc's "error" field.
fn run_report_lines(rep: ref RunRep) -> []str {
    let out: []str = nil
    if rep.json {
        out = push(out, "{\"results\":[],\"passed\":" + itoa(rep.passed) + ",\"failed\":" + itoa(rep.failed) + ",\"skipped\":" + itoa(rep.skipped) + ",\"error\":" + jesc(rep.err) + "}\n")
    } else {
        out = push(out, itoa(rep.passed) + " passed, " + itoa(rep.failed) + " failed, " + itoa(rep.skipped) + " skipped\n")
    }
    return out
}

fn join(lines: []str) -> str {
    let out = ""
    i := 0
    for i < len(lines) {
        out = out + lines[i]
        i = i + 1
    }
    return out
}

// run_env resolves -e names/files into an EnvSet over the env search
// dirs (corpus §5.1: CWD → collection dir → config dir). Base files
// (posting.env, posting.local.env) layer per dir in dir order; each
// -e then composes IN CLI ORDER — a named env resolves first-dir-
// wins via env_files_named, a file path parses verbatim. File-path
// -e values therefore interleave with named ones exactly as passed
// (upstream composes --env in arg order).
struct RunEnv { es: own env.EnvSet, err: str }

fn run_env(dirs: []str, envs: []str) -> own RunEnv {
    re := new(RunEnv)
    fl := env_file_list(dirs, envs)
    if len(fl.err) > 0 {
        re.err = fl.err
        return re
    }
    es := new(env.EnvSet)
    i := 0
    for i < len(fl.files) {
        w := env_load_file(es, fl.files[i], basename(fl.files[i]))
        if len(w) > 0 {
            re.err = w
            return re
        }
        i = i + 1
    }
    re.es = es
    return re
}

// dir_name — parent dir of a path ("." when none, "/" at root).
fn dir_name(p: str) -> str {
    i := len(p) - 1
    for i > 0 && byteat(p, i) != 47 {
        i = i - 1
    }
    if byteat(p, i) == 47 {
        if i == 0 {
            return "/"
        }
        return substr(p, 0, i)
    }
    return "."
}

// run_collect gathers runnable requests under target — dir → scan
// (any malformed node aborts the run before sending, upstream
// run.go), file → single .posting.yaml. Returns rel-path-sorted
// node indexes via an owned copy list (CollNodes can't be copied
// out of the scan struct, so callers re-derive per node).
fn run_exec(o: ref RunOpts, t: http.Transport) -> own RunRep {
    rep := new(RunRep)
    rep.code = 0
    rep.lines = nil
    rep.json = o.json
    target := o.target
    // upstream loadRunRequests: relative PATH joins -c; everything is
    // made absolute before stat.
    if len(o.coll) > 0 && !is_abs2(target) {
        target = o.coll + "/" + target
    }
    if !is_abs2(target) {
        // Lexical absolutization keeps the missing path in diagnostics;
        // os.fullpath is realpath-backed and returns empty for absent files.
        target = imp_abspath(target)
    }
    if !os.exists(target) {
        rep.err = "stat " + target + ": no such file or directory"
        rep.code = 1
        return rep
    }
    // collection root: -c wins (abs'd against CWD); else the target
    // dir itself or a single file's parent (upstream run.go).
    root := o.coll
    if len(root) == 0 {
        if os.isdir(target) {
            root = target
        } else {
            root = dir_name(target)
        }
    }
    if !is_abs2(root) {
        root = imp_abspath(root)
    }
    if !os.isdir(root) {
        rep.err = "collection " + root + " is not a directory"
        rep.code = 1
        return rep
    }
    coll_dir := root
    // settings: warnings are fatal unattended (upstream run.go).
    cr := config.load(o.cfg_file, config.posting_env_pairs())
    if len(cr.warns) > 0 {
        rep.err = join(cr.warns)
        rep.code = 1
        return rep
    }
    // use_host_environment can't merge host vars headlessly — warn
    // on stderr like the TUI's toast (spec §run env).
    if cr.s.use_host_environment {
        rep.stderr = rep.stderr + "posting run: warning: use_host_environment is set but host environment variables are not merged in this build\n"
    }
    // WI-0017 (ADR-0045): ssl.password can't be honored — oxl 0.26.0
    // rejects encrypted PEM; warn once per run, not per request.
    if len(cr.s.ssl_password) > 0 && len(cr.s.ssl_certificate_path) > 0 {
        rep.stderr = rep.stderr + "posting run: warning: ssl.password is set but encrypted private keys are unsupported in this build\n"
    }
    // env stack (ADR-0067): no -e → the ROOT's posting.env+
    // posting.local.env only; any -e suppresses the implicit base and
    // resolves names in the root, file specs against the CWD.
    cwd := os.fullpath(".")
    let efiles: []str = nil
    if len(o.envs) == 0 {
        efiles = env_stack_base(root)
    } else {
        ndirs := mkslice(str, 0)
        ndirs = push(ndirs, root)
        fl := env_file_list_probe(cwd, ndirs, o.envs, true)
        if len(fl.err) > 0 {
            rep.err = fl.err
            rep.code = 1
            return rep
        }
        efiles = fl.files
    }
    es := new(env.EnvSet)
    ei := 0
    for ei < len(efiles) {
        w := env_load_file(es, efiles[ei], basename(efiles[ei]))
        if len(w) > 0 {
            rep.err = w
            rep.code = 1
            return rep
        }
        ei = ei + 1
    }
    // settingsInEnvironmentFiles (upstream main.go): POSTING_*-prefixed
    // names in env files warn on stderr — they're not settings.
    si := 0
    for si < len(efiles) {
        w := env_posting_names_warn(efiles[si])
        if len(w) > 0 {
            rep.stderr = rep.stderr + "posting run: " + w + "\n"
        }
        si = si + 1
    }
    // select
    sc := new(collection.CollScan)
    single := !os.isdir(target)
    if single {
        if len(target) < 13 || substr(target, len(target) - 13, len(target)) != ".posting.yaml" {
            rep.err = "request file must end in .posting.yaml"
            rep.code = 1
            return rep
        }
        [preq, perr] = collection.load_file(target)
        if perr != nil {
            rep.err = target + ": " + errors.msg(perr)
            rep.code = 1
            return rep
        }
        sc.nodes = push(sc.nodes, collection.CollNode{path: target, rel: rel_to_root(root, target), depth: 0, is_dir: false, req: preq, err: ""})
    } else {
        sc = collection.scan(target)
    }
    // malformed abort — upstream refuses to run any file when one
    // fails to load.
    i := 0
    for i < len(sc.nodes) {
        n := sc.nodes[i]
        i = i + 1
        // upstream reports request.File relative to the collection
        // ROOT (which may be an ancestor of the scan target).
        rrel := rel_to_root(root, n.path)
        if len(n.err) > 0 {
            rep.err = rrel + ": " + n.err
            rep.code = 1
            return rep
        }
        if n.is_dir {
            continue
        }
        // ADR-0038: scripts and empty urls abort before any send —
        // the whole selection validates first (upstream run.go).
        if len(n.req.url) == 0 {
            rep.err = rrel + ": request has no URL"
            rep.code = 1
            return rep
        }
        if n.req.scripts != nil && (len(n.req.scripts.setup) > 0 || len(n.req.scripts.on_request) > 0 || len(n.req.scripts.on_response) > 0) {
            rep.err = rrel + ": Posting 3 doesn't run Python scripts; remove or replace its scripts before running headlessly"
            rep.code = 1
            return rep
        }
    }
    // count runnable
    total := 0
    i = 0
    for i < len(sc.nodes) {
        if !sc.nodes[i].is_dir {
            total = total + 1
        }
        i = i + 1
    }
    if total == 0 {
        rep.err = "no request files found in " + target
        rep.code = 1
        return rep
    }
    // display/ordering paths are relative to the collection ROOT,
    // not the scan target (upstream sets req.File = Rel(root, file)).
    let drel: []str = nil
    i = 0
    for i < len(sc.nodes) {
        drel = push(drel, rel_to_root(root, sc.nodes[i].path))
        i = i + 1
    }
    // corpus ordering is load-bearing: requests run sorted by
    // collection-relative path, not scan (DFS) order.
    ord := mkslice(int, 0)
    i = 0
    for i < len(sc.nodes) {
        if !sc.nodes[i].is_dir {
            ord = push(ord, i)
        }
        i = i + 1
    }
    oi2 := 1
    for oi2 < len(ord) {
        v := ord[oi2]
        sj := oi2 - 1
        for sj >= 0 && str_lt(drel[v], drel[ord[sj]]) {
            ord[sj + 1] = ord[sj]
            sj = sj - 1
        }
        ord[sj + 1] = v
        oi2 = oi2 + 1
    }
    // loop — captures accumulate into a run-scoped session layer
    // (upstream run.go: model.Merge(variables, captureLayer) per
    // request; last write wins on name collisions).
    let jar: []JarEnt = nil
    let capvars: []model.KV = nil
    sess_li := -1

    passed := 0
    failed := 0
    skipped := 0
    let jresults = ""
    first_j := true
    oi := 0
    stop := false
    for oi < len(ord) {
        ni := ord[oi]
        n := sc.nodes[ni]
        nrel := drel[ni]
        oi = oi + 1
        if stop {
            skipped = skipped + 1
            rep.lines = push(rep.lines, "SKIPPED " + nrel + "\n")
            jresults = jappend(jresults, first_j, "{\"file\":" + jesc(nrel) + ",\"name\":" + jesc(n.req.name) + ",\"outcome\":\"skipped\"}")
            first_j = false
            continue
        }
        [u0, ue0] = collection.subst_url(n.req.url, es)
        let jlist: []str = nil
        if ue0 == nil {
            u0 = scheme_norm(u0)
            jlist = jar_for_list(jar, url_origin(u0))
        }
        sp := collection.plan_req(n.req, es, jlist, coll_dir)
        if len(sp.err) > 0 {
            rep.lines = push(rep.lines, "FAILED " + nrel + ": " + sp.err + "\n")
            failed = failed + 1
            jresults = jappend(jresults, first_j, "{\"file\":" + jesc(nrel) + ",\"name\":" + jesc(n.req.name) + ",\"outcome\":\"failed\",\"error\":" + jesc(sp.err) + "}")
            first_j = false
            if o.fail_fast { skipped = len(ord) - oi; break }
            continue
        }
        // plan_req leaves verify "" (on) or "no" — never "yes";
        // ca_bundle applies whenever the request verifies (same
        // gate as coll.oxl's send path).
        if len(cr.s.ssl_ca_bundle) > 0 && sp.req.verify != "no" {
            sp.req.verify = cr.s.ssl_ca_bundle
        }
        // ssl.certificate_path/key_file carry the client identity —
        // a configured file that can't be read fails the request
        // rather than silently sending without it.
        cert_err := ""
        if len(cr.s.ssl_certificate_path) > 0 {
            if !os.exists(cr.s.ssl_certificate_path) {
                cert_err = "ssl.certificate_path: file not found"
            } else {
                sp.req.cert_pem = os.readfile_(cr.s.ssl_certificate_path)
                if len(sp.req.cert_pem) == 0 {
                    cert_err = "ssl.certificate_path: file unreadable or empty"
                }
                if len(cert_err) == 0 && len(cr.s.ssl_key_file) > 0 {
                    if !os.exists(cr.s.ssl_key_file) {
                        cert_err = "ssl.key_file: file not found"
                    } else {
                        sp.req.key_pem = os.readfile_(cr.s.ssl_key_file)
                        if len(sp.req.key_pem) == 0 {
                            cert_err = "ssl.key_file: file unreadable or empty"
                        }
                    }
                }
            }
        }
        if len(cert_err) > 0 {
            rep.lines = push(rep.lines, "FAILED " + nrel + ": " + cert_err + "\n")
            failed = failed + 1
            jresults = jappend(jresults, first_j, "{\"file\":" + jesc(nrel) + ",\"name\":" + jesc(n.req.name) + ",\"outcome\":\"failed\",\"error\":" + jesc(cert_err) + "}")
            first_j = false
            if o.fail_fast { skipped = len(ord) - oi; break }
            continue
        }
        [resp, se] = t.send(sp.req)
        rts := time.unix_ms()
        if se != nil {
            msg := errors.msg(se)
            rep.lines = push(rep.lines, "FAILED " + nrel + ": " + msg + "\n")
            failed = failed + 1
            jresults = jappend(jresults, first_j, "{\"file\":" + jesc(nrel) + ",\"name\":" + jesc(n.req.name) + ",\"outcome\":\"failed\",\"error\":" + jesc(msg) + "}")
            first_j = false
            if o.fail_fast { skipped = len(ord) - oi; break }
            continue
        }
        // carry cookies for this run only (upstream run.go).
        jar = jar_collect(jar, url_origin(sp.req.url), resp)
        // WI-0017 (ADR-0045): client certs are TLS1.3-only — a 1.2
        // negotiation presents an empty certificate_list; warn like
        // the interactive toast (CLI W2 parity).
        if len(sp.req.cert_pem) > 0 && resp.tls_ver == tls.V12 {
            rep.stderr = rep.stderr + "posting run: warning: " + n.rel + ": client certificate was not presented (TLS 1.2 sends an empty certificate list in this build)\n"
        }
        if model.status_class(resp.status) == 2 {
            // upstream runRequest: Error = TrimSpace(Code+" "+Text)
            // and the response still rides along in the report.
            serr := trim_space(itoa(resp.status) + " " + resp.reason)
            rep.lines = push(rep.lines, "FAILED " + nrel + ": " + serr + "\n")
            failed = failed + 1
            jresults = jappend(jresults, first_j, "{\"file\":" + jesc(nrel) + ",\"name\":" + jesc(n.req.name) + ",\"outcome\":\"failed\",\"error\":" + jesc(serr) + ",\"response\":" + resp_json(sp.req, resp, rts) + "}")
            first_j = false
            if o.fail_fast { skipped = len(ord) - oi; break }
            continue
        }
        // captures run only after a passing status (upstream
        // runRequest: Error/Warning class returns before
        // CaptureValues); failure fails the request, success
        // feeds later requests via the session layer.
        [cvals, ce] = capture.capture_values(n.req.captures, resp.body)
        if ce != nil {
            cmsg := errors.msg(ce)
            rep.lines = push(rep.lines, "FAILED " + nrel + ": " + cmsg + "\n")
            failed = failed + 1
            jresults = jappend(jresults, first_j, "{\"file\":" + jesc(nrel) + ",\"name\":" + jesc(n.req.name) + ",\"outcome\":\"failed\",\"error\":" + jesc(cmsg) + ",\"response\":" + resp_json(sp.req, resp, rts) + "}")
            first_j = false
            if o.fail_fast { skipped = len(ord) - oi; break }
            continue
        }
        ci := 0
        for ci < len(cvals) {
            capvars = capvar_set(capvars, cvals[ci])
            ci = ci + 1
        }
        if len(cvals) > 0 {
            if sess_li < 0 {
                es.layers = push(es.layers, env.EnvLayer{name: "session", source: "session", vars: capvars})
                sess_li = len(es.layers) - 1
            } else {
                es.layers[sess_li].vars = capvars
            }
        }
        rep.lines = push(rep.lines, "PASSED " + nrel + ": " + itoa(resp.status) + " " + resp.reason + " (" + ftoa(resp.elapsed_ms) + " ms)\n")
        passed = passed + 1
        jresults = jappend(jresults, first_j, "{\"file\":" + jesc(nrel) + ",\"name\":" + jesc(n.req.name) + ",\"outcome\":\"passed\",\"response\":" + resp_json(sp.req, resp, rts) + "}")
        first_j = false
    }
    rep.passed = passed
    rep.failed = failed
    rep.skipped = skipped
    if o.json {
        rep.lines = nil
        rep.lines = push(rep.lines, "{\"results\":[" + jresults + "],\"passed\":" + itoa(passed) + ",\"failed\":" + itoa(failed) + ",\"skipped\":" + itoa(skipped) + "}\n")
    } else {
        rep.lines = push(rep.lines, itoa(passed) + " passed, " + itoa(failed) + " failed, " + itoa(skipped) + " skipped\n")
    }
    if failed > 0 {
        rep.code = 1
    }
    return rep
}

// ---------- run helpers ----------

// clean_path_lex — lexical slash-path cleanup for report comparisons:
// duplicate slashes and `.` segments vanish, `..` pops one prior segment
// without touching the filesystem.
fn clean_path_lex(p: str) -> str {
    abs := len(p) > 0 && byteat(p, 0) == 47
    parts := mkslice(str, 0)
    start := 0
    i := 0
    for i <= len(p) {
        if i == len(p) || byteat(p, i) == 47 {
            part := substr(p, start, i)
            start = i + 1
            if len(part) == 0 || part == "." {
                i = i + 1
                continue
            }
            if part == ".." {
                if len(parts) > 0 {
                    parts = parts[:len(parts) - 1]
                }
                i = i + 1
                continue
            }
            parts = push(parts, part)
        }
        i = i + 1
    }
    out := ""
    if abs {
        out = "/"
    }
    j := 0
    for j < len(parts) {
        if j > 0 {
            out = out + "/"
        }
        out = out + parts[j]
        j = j + 1
    }
    if len(out) == 0 {
        if abs {
            return "/"
        }
        return "."
    }
    return out
}

// rel_to_root — filepath.Rel(root, path) for the run report's file
// field: path under root → slash-relative; else the path unchanged.
fn rel_to_root(root: str, path: str) -> str {
    pre := clean_path_lex(root)
    path = clean_path_lex(path)
    if pre == "/" {
        if len(path) > 1 && byteat(path, 0) == 47 {
            return substr(path, 1, len(path))
        }
        if path == "/" {
            return "."
        }
        return path
    }
    if len(pre) > 1 && byteat(pre, len(pre) - 1) == 47 {
        pre = substr(pre, 0, len(pre) - 1)
    }
    if len(path) > len(pre) + 1 && substr(path, 0, len(pre) + 1) == pre + "/" {
        return substr(path, len(pre) + 1, len(path))
    }
    return path
}

// env_posting_names_warn — settingsInEnvironmentFiles (upstream
// main.go): POSTING_*-prefixed names in one env file produce
// "<base> sets <names>, but settings aren't read from environment
// files. Set them in config.yaml or your shell instead."
fn env_posting_names_warn(path: str) -> str {
    if !os.exists(path) {
        return ""
    }
    text := os.readfile_(path)
    prior := new(env.EnvSet)
    [dp, perr] = env.parse_dotenv(text, prior)
    if perr != nil {
        return ""
    }
    names := mkslice(str, 0)
    i := 0
    for i < len(dp.vars) {
        nm := dp.vars[i].name
        if len(nm) >= 8 {
// case-insensitive POSTING_ prefix (upstream ToUpper)
            up := upper_ascii(nm)
            if substr(up, 0, 8) == "POSTING_" {
                names = push(names, nm)
            }
        }
        i = i + 1
    }
    if len(names) == 0 {
        return ""
    }
    return basename(path) + " sets " + str_join(names, ", ") + ", but settings aren't read from environment files. Set them in config.yaml or your shell instead."
}

fn is_abs2(p: str) -> bool {
    return len(p) > 0 && byteat(p, 0) == 47
}

fn base_name(p: str) -> str {
    i := len(p) - 1
    for i > 0 && byteat(p, i) != 47 {
        i = i - 1
    }
    if byteat(p, i) == 47 {
        i = i + 1
    }
    return substr(p, i, len(p))
}

fn scheme_norm(u: str) -> str {
    if find(u, "://") < 0 {
        if len(u) > 1 && substr(u, 0, 2) == "//" {
            return "http:" + u
        }
        return "http://" + u
    }
    return u
}

fn jesc(s: str) -> str {
    return json.tojson(json.jstr(s))
}

fn jappend(acc: str, first: bool, item: str) -> str {
    if first {
        return acc + item
    }
    return acc + "," + item
}

fn resp_json(req: ref model.Req, resp: model.Resp, rts: int) -> str {
    let h = ""
    ct := ""
    i := 0
    for i < len(resp.headers) {
        if i > 0 {
            h = h + ","
        }
        h = h + "{\"name\":" + jesc(resp.headers[i].name) + ",\"value\":" + jesc(resp.headers[i].value) + "}"
        if len(ct) == 0 && lower_ascii(resp.headers[i].name) == "content-type" {
            ct = resp.headers[i].value
        }
        i = i + 1
    }
    // remote.Response-shaped fields (spec §run --json): reason, proto,
    // contentType, receivedAt (unix ms — deviation 14).
    extra := ",\"reason\":" + jesc(resp.reason)
    if len(resp.version) > 0 {
        extra = extra + ",\"proto\":" + jesc("HTTP/" + resp.version)
    }
    if len(ct) > 0 {
        extra = extra + ",\"contentType\":" + jesc(ct)
    }
    extra = extra + ",\"receivedAt\":" + itoa(rts)
    head := "{\"method\":" + jesc(req.method) + ",\"url\":" + jesc(req.url) + ",\"status\":" + jesc(itoa(resp.status) + " " + resp.reason) + ",\"statusCode\":" + itoa(resp.status) + extra + ",\"headers\":[" + h + "],"
    tail := "\"size\":" + itoa(len(resp.body)) + ",\"elapsedMs\":" + ftoa(resp.elapsed_ms) + "}"
    if !is_utf8(resp.body) {
        return head + "\"bodyBase64\":" + jesc(base64.encode(resp.body)) + "," + tail
    }
    return head + "\"body\":" + jesc(resp.body as str) + "," + tail
}

fn is_utf8(b: []byte) -> bool {
    // upstream checks utf8.Valid — invalid bodies go out base64 so the
    // --json document stays well-formed.
    return utf8.valid(b as str)
}

fn jar_for_list(jar: []JarEnt, origin: str) -> []str {
    let out: []str = nil
    i := 0
    for i < len(jar) {
        if jar[i].origin == origin {
            out = push(out, jar[i].nv)
        }
        i = i + 1
    }
    return out
}

// jar_collect stores Set-Cookie name=value pairs under the
// response origin — the run-scoped jar (upstream carries cookies
// through the run only).
fn jar_collect(jar: []JarEnt, origin: str, resp: model.Resp) -> []JarEnt {
    i := 0
    for i < len(resp.headers) {
        h := resp.headers[i]
        i = i + 1
        if lower_ascii(h.name) != "set-cookie" {
            continue
        }
        nv := h.value
        sc := find(nv, ";")
        if sc >= 0 {
            nv = substr(nv, 0, sc)
        }
        ts := 0
        for ts < len(nv) && (byteat(nv, ts) == 32 || byteat(nv, ts) == 9) {
            ts = ts + 1
        }
        nv = substr(nv, ts, len(nv))
        if len(nv) == 0 {
            continue
        }
        nm := nv
        eq := find(nv, "=")
        if eq > 0 {
            nm = substr(nv, 0, eq)
        }
        j := 0
        replaced := false
        for j < len(jar) {
            e2 := jar[j].nv
            eq2 := find(e2, "=")
            cn := e2
            if eq2 > 0 {
                cn = substr(e2, 0, eq2)
            }
            if jar[j].origin == origin && cn == nm {
                jar[j].nv = nv
                replaced = true
            }
            j = j + 1
        }
        if !replaced {
            jar = push(jar, JarEnt{origin: origin, nv: nv})
        }
    }
    return jar
}

// capvar_set upserts a captured value into the run-scoped session
// layer — same name replaces (upstream maps.Copy order).
fn capvar_set(vars: []model.KV, kv: model.KV) -> []model.KV {
    i := 0
    for i < len(vars) {
        if vars[i].name == kv.name {
            vars[i].value = kv.value
            vars[i].enabled = true
            return vars
        }
        i = i + 1
    }
    return push(vars, kv)
}
