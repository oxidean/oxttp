package main

// tui/cli — the posting CLI surface (ADR-0036): subcommand
// dispatch for `import|locate|remote|run|version`, each returning
// an Out{code,stdout,stderr} the caller prints (the Run contract
// mirrors cli/exec.oxl so tests assert on fields, not fds).

import "std/os"
import "std/errors"
import "std/time"
import "std/encoding/json"
import "std/encoding/base64"
import "std/unicode/utf8"
import "github.com/oxidean/oxttp/core/collection"
import "github.com/oxidean/oxttp/core/config"
import "github.com/oxidean/oxttp/core/env"
import "github.com/oxidean/oxttp/core/http"
import "github.com/oxidean/oxttp/core/model"
import "github.com/oxidean/oxttp/shared/version"

struct Out { code: int, stdout: str, stderr: str }

fn cli_is_sub(a0: str) -> bool {
    return a0 == "import" || a0 == "locate" || a0 == "remote" || a0 == "run" || a0 == "version" || a0 == "-v" || a0 == "--version"
}

// cli_main runs the subcommand named by argv[1].
fn cli_args() -> []str {
    let a: []str = nil
    i := 1
    for i < os.nargs() {
        a = push(a, os.args(i))
        i = i + 1
    }
    return a
}

fn cli_main() -> Out {
    a0 := os.args(1)
    if a0 == "version" || a0 == "-v" || a0 == "--version" {
        return cli_version()
    }
    if a0 == "locate" {
        return cli_locate()
    }
    if a0 == "remote" {
        return cli_remote()
    }
    if a0 == "import" {
        return cli_import()
    }
    return cli_run()
}

fn cli_version() -> Out {
    return Out{code: 0, stdout: "Posting " + version.get() + "\n", stderr: ""}
}

fn cli_locate() -> Out {
    return cli_locate_args(cli_args())
}

fn cli_locate_args(args: []str) -> Out {
    if len(args) != 2 {
        return Out{code: 2, stdout: "", stderr: "posting locate: usage: posting locate config|collection|themes\n"}
    }
    what := args[1]
    if what == "config" {
        return Out{code: 0, stdout: "Config file:\n" + config.config_file() + "\n", stderr: ""}
    }
    if what == "collection" {
        return Out{code: 0, stdout: "Default collection directory:\n" + config.default_coll_dir() + "\n", stderr: ""}
    }
    if what == "themes" {
        // Upstream paths.ThemeDir honors the configured
        // theme_directory (config.yaml / POSTING_THEME_DIRECTORY).
        cr := config.load("", config.posting_env_pairs())
        return Out{code: 0, stdout: "Themes directory:\n" + config.theme_dir(cr.s) + "\n", stderr: ""}
    }
    return Out{code: 2, stdout: "", stderr: "Unknown thing to locate: \"" + what + "\"\n"}
}

let SKILL_MD = "---\nname: posting-remote\ndescription: Drive a running Posting instance over its control socket.\n---\n\n# posting remote\n\nposting remote list            - list running instances\nposting remote send <file>     - send a request in the TUI\nposting remote new <file>      - open a request in a new tab\nposting remote env <name>      - switch environment\nposting remote focus <target>  - focus a widget\n"

fn cli_remote() -> Out {
    return cli_remote_args(cli_args())
}

fn cli_remote_args(args: []str) -> Out {
    i := 1
    cmd := ""
    json_out := false
    for i < len(args) {
        a := args[i]
        i = i + 1
        if a == "--help" || a == "-h" {
            return Out{code: 0, stdout: "usage: posting remote [--instance NAME] <command>\n  list  send  new  env  focus  skill\n", stderr: ""}
        }
        if a == "--json" {
            json_out = true
            continue
        }
        // --instance NAME / --instance=NAME and POSTING_INSTANCE are
        // parsed-and-ignored (unix-socket degrade — spec §remote).
        if a == "--instance" {
            if i < len(args) {
                i = i + 1
            }
            continue
        }
        if len(a) >= 11 && substr(a, 0, 11) == "--instance=" {
            continue
        }
        if len(cmd) == 0 && len(a) > 0 && byteat(a, 0) != 45 {
            cmd = a
        }
    }
    os.getenv("POSTING_INSTANCE")
    if cmd == "list" {
        if json_out {
            return Out{code: 0, stdout: "[]\n", stderr: ""}
        }
        return Out{code: 0, stdout: "PID\tVERSION\tCOLLECTION\tCWD\tSOCKET\nno running Posting found\n", stderr: ""}
    }
    if cmd == "skill" {
        return Out{code: 0, stdout: SKILL_MD, stderr: ""}
    }
    // every instance-bound command degrades the same way — corpus
    // §1.5: list, requests, show, open, send, response, env, save
    // (+ new/focus) all need the socket; only list/skill work headless.
    if cmd == "requests" || cmd == "show" || cmd == "open" || cmd == "send" || cmd == "response" || cmd == "env" || cmd == "save" || cmd == "new" || cmd == "focus" {
        return Out{code: 1, stdout: "", stderr: "no running Posting found (unix sockets unsupported in this build)\n"}
    }
    if len(cmd) == 0 {
        return Out{code: 2, stdout: "", stderr: "posting remote: a command is required\n"}
    }
    return Out{code: 2, stdout: "", stderr: "usage: posting remote [--instance NAME] <command>\n  list  requests  show  open  send  response  env  save  new  focus  skill\n"}
}

fn cli_import() -> Out {
    return cli_import_args(cli_args())
}

fn cli_import_args(args: []str) -> Out {
    i := 1
    typ := "openapi"
    let srcs: []str = nil
    for i < len(args) {
        a := args[i]
        i = i + 1
        // --type=x / --output=x forms (upstream flag splitter).
        if len(a) >= 7 && substr(a, 0, 7) == "--type=" {
            typ = substr(a, 7, len(a))
            continue
        }
        if len(a) >= 9 && substr(a, 0, 9) == "--output=" {
            continue
        }
        if len(a) >= 3 && substr(a, 0, 3) == "-t=" {
            typ = substr(a, 3, len(a))
            continue
        }
        if len(a) >= 3 && substr(a, 0, 3) == "-o=" {
            continue
        }
        if a == "-t" || a == "--type" {
            if i >= len(args) {
                return Out{code: 2, stdout: "", stderr: "posting import: --type needs a value\n"}
            }
            typ = args[i]
            i = i + 1
        } else if a == "-o" || a == "--output" {
            if i >= len(args) {
                return Out{code: 2, stdout: "", stderr: "posting import: --output needs a value\n"}
            }
            i = i + 1
        } else if a == "-h" || a == "--help" {
            return Out{code: 0, stdout: "usage: posting import [-t openapi|postman|bruno] [-o DIR] SOURCE...\n", stderr: ""}
        } else if len(a) > 0 && byteat(a, 0) == 45 {
            return Out{code: 2, stdout: "", stderr: "posting import: unknown flag " + a + "\n"}
        } else {
            srcs = push(srcs, a)
        }
    }
    if typ != "openapi" && typ != "postman" && typ != "bruno" {
        return Out{code: 2, stdout: "", stderr: "posting import: unknown type " + typ + "\n"}
    }
    if len(srcs) == 0 {
        return Out{code: 2, stdout: "", stderr: "posting import: no input files\n"}
    }
    return Out{code: 1, stdout: "", stderr: "posting import: " + typ + " import lands M4 in this build\n"}
}

// ---------- run ----------

struct RunOpts {
    coll: str,
    target: str,
    envs: []str,
    fail_fast: bool,
    json: bool,
}

struct RunRep {
    code: int,
    lines: []str,   // per-request PASS/FAIL/SKIP + summary (or json)
    err: str,       // run-level error text
    stderr: str,    // non-fatal warnings (use_host_environment etc.)
}

fn run_usage() -> str {
    return "usage: posting run [flags] TARGET\n  -c, --collection DIR   collection root\n  -e, --env NAME|FILE    environment (repeatable)\n      --fail-fast        stop on first failure\n      --json             emit JSON report\n  -h, --help             this help\n"
}

// run_parse — run.go flag surface: values via next arg or --x=v,
// flags-after-positional ok, `--` ends flags.
struct RunParse { o: own RunOpts, code: int }

fn run_parse() -> own RunParse {
    return run_parse_args(cli_args())
}

fn run_parse_args(args: []str) -> own RunParse {
    rp := new(RunParse)
    rp.o = new(RunOpts)
    i := 1
    end := false
    for i < len(args) {
        a := args[i]
        i = i + 1
        if a == "--" && !end {
            end = true
            continue
        }
        if !end && len(a) > 0 && byteat(a, 0) == 45 {
            v := ""
            has_v := false
            eq := find(a, "=")
            if eq >= 0 {
                v = substr(a, eq + 1, len(a))
                a = substr(a, 0, eq)
                has_v = true
            }
            if a == "-c" || a == "--collection" {
                if !has_v {
                    if i >= len(args) {
                        rp.code = 2
                        return rp
                    }
                    v = args[i]
                    i = i + 1
                }
                rp.o.coll = v
            } else if a == "-e" || a == "--env" {
                if !has_v {
                    if i >= len(args) {
                        rp.code = 2
                        return rp
                    }
                    v = args[i]
                    i = i + 1
                }
                rp.o.envs = push(rp.o.envs, v)
            } else if a == "--fail-fast" {
                rp.o.fail_fast = true
            } else if a == "--json" {
                rp.o.json = true
            } else if a == "-h" || a == "--help" {
                rp.code = -1
                return rp
            } else {
                rp.code = 2
                return rp
            }
        } else {
            if len(rp.o.target) > 0 {
                rp.code = 2
                return rp
            }
            rp.o.target = a
        }
    }
    rp.code = 0
    return rp
}

fn cli_run() -> Out {
    rp := run_parse()
    if rp.code == -1 {
        return Out{code: 0, stdout: run_usage(), stderr: ""}
    }
    if rp.code != 0 || len(rp.o.target) == 0 {
        return Out{code: 2, stdout: "", stderr: "posting run: bad arguments\nRun posting run --help for usage.\n"}
    }
    rep := run_exec(rp.o, http.H1{})
    se := rep.stderr
    if len(rep.err) > 0 {
        se = se + "posting run: " + rep.err + "\n"
    }
    return Out{code: rep.code, stdout: join(rep.lines), stderr: se}
}

fn join(lines: []str) -> str {
    let out = ""
    i := 0
    for i < len(lines) {
        out = out + lines[i]
        i = i + 1
    }
    return out
}

// run_env resolves -e names/files into an EnvSet over the env search
// dirs (corpus §5.1: CWD → collection dir → config dir). Base files
// (posting.env, posting.local.env) layer per dir in dir order; each
// -e then composes IN CLI ORDER — a named env resolves first-dir-
// wins via env_files_named, a file path parses verbatim. File-path
// -e values therefore interleave with named ones exactly as passed
// (upstream composes --env in arg order).
struct RunEnv { es: own env.EnvSet, err: str }

fn run_env(dirs: []str, envs: []str) -> own RunEnv {
    re := new(RunEnv)
    fl := env_file_list(dirs, envs)
    if len(fl.err) > 0 {
        re.err = fl.err
        return re
    }
    es := new(env.EnvSet)
    i := 0
    for i < len(fl.files) {
        w := env_load_file(es, fl.files[i], basename(fl.files[i]))
        if len(w) > 0 {
            re.err = w
            return re
        }
        i = i + 1
    }
    re.es = es
    return re
}

// dir_name — parent dir of a path ("." when none, "/" at root).
fn dir_name(p: str) -> str {
    i := len(p) - 1
    for i > 0 && byteat(p, i) != 47 {
        i = i - 1
    }
    if byteat(p, i) == 47 {
        if i == 0 {
            return "/"
        }
        return substr(p, 0, i)
    }
    return "."
}

// run_collect gathers runnable requests under target — dir → scan
// (any malformed node aborts the run before sending, upstream
// run.go), file → single .posting.yaml. Returns rel-path-sorted
// node indexes via an owned copy list (CollNodes can't be copied
// out of the scan struct, so callers re-derive per node).
fn run_exec(o: ref RunOpts, t: http.Transport) -> own RunRep {
    rep := new(RunRep)
    rep.code = 0
    rep.lines = nil
    target := o.target
    if !is_abs2(target) {
        // relative target joins the -c collection root; without -c
        // it resolves against CWD.
        if len(o.coll) > 0 {
            target = o.coll + "/" + target
        } else {
            target = os.fullpath(target)
        }
    }
    if !os.exists(target) {
        rep.err = "no such file or directory: " + o.target
        rep.code = 1
        return rep
    }
    // collection dir: -c wins; else the target dir itself (a dir
    // target IS the collection) or a single file's parent. Env
    // files and collection-relative paths resolve against it —
    // never bare CWD (upstream run.go).
    coll_dir := o.coll
    if len(coll_dir) == 0 {
        if os.isdir(target) {
            coll_dir = target
        } else {
            coll_dir = dir_name(target)
        }
    }
    // env search dirs (corpus §5.1): CWD → collection → config dir.
    cand := mkslice(str, 0)
    cand = push(cand, os.fullpath("."))
    cand = push(cand, os.fullpath(coll_dir))
    cand = push(cand, config.config_dir())
    let edirs: []str = nil
    di := 0
    for di < len(cand) {
        seen := false
        dj := 0
        for dj < len(edirs) {
            if edirs[dj] == cand[di] {
                seen = true
            }
            dj = dj + 1
        }
        if !seen {
            edirs = push(edirs, cand[di])
        }
        di = di + 1
    }
    // settings: warnings are fatal unattended (upstream run.go).
    cr := config.load("", config.posting_env_pairs())
    if len(cr.warns) > 0 {
        rep.err = join(cr.warns)
        rep.code = 1
        return rep
    }
    // use_host_environment can't merge host vars headlessly — warn
    // on stderr like the TUI's toast (spec §run env).
    if cr.s.use_host_environment {
        rep.stderr = rep.stderr + "posting run: warning: use_host_environment is set but host environment variables are not merged in this build\n"
    }
    re := run_env(edirs, o.envs)
    if len(re.err) > 0 {
        rep.err = re.err
        rep.code = 1
        return rep
    }
    es := re.es
    // select
    sc := new(collection.CollScan)
    single := !os.isdir(target)
    if single {
        if len(target) < 13 || substr(target, len(target) - 13, len(target)) != ".posting.yaml" {
            rep.err = "not a .posting.yaml file: " + o.target
            rep.code = 1
            return rep
        }
        [preq, perr] = collection.load_file(target)
        if perr != nil {
            rep.err = errors.msg(perr)
            rep.code = 1
            return rep
        }
        sc.nodes = push(sc.nodes, collection.CollNode{path: target, rel: base_name(target), depth: 0, is_dir: false, req: preq, err: ""})
    } else {
        sc = collection.scan(target)
    }
    // malformed abort — upstream refuses to run any file when one
    // fails to load.
    i := 0
    for i < len(sc.nodes) {
        n := sc.nodes[i]
        i = i + 1
        if len(n.err) > 0 {
            rep.err = n.rel + ": " + n.err
            rep.code = 1
            return rep
        }
        if n.is_dir {
            continue
        }
        // ADR-0038: scripts and empty urls abort before any send —
        // the whole selection validates first (upstream run.go).
        if len(n.req.url) == 0 {
            rep.err = n.rel + ": request has no URL"
            rep.code = 1
            return rep
        }
        if n.req.scripts != nil && (len(n.req.scripts.setup) > 0 || len(n.req.scripts.on_request) > 0 || len(n.req.scripts.on_response) > 0) {
            rep.err = n.rel + ": Posting 3 doesn't run Python scripts; remove or replace its scripts before running headlessly"
            rep.code = 1
            return rep
        }
    }
    // count runnable
    total := 0
    i = 0
    for i < len(sc.nodes) {
        if !sc.nodes[i].is_dir {
            total = total + 1
        }
        i = i + 1
    }
    if total == 0 {
        rep.err = "no request files found in " + o.target
        rep.code = 1
        return rep
    }
    // corpus ordering is load-bearing: requests run sorted by
    // collection-relative path, not scan (DFS) order.
    ord := mkslice(int, 0)
    i = 0
    for i < len(sc.nodes) {
        if !sc.nodes[i].is_dir {
            ord = push(ord, i)
        }
        i = i + 1
    }
    si := 1
    for si < len(ord) {
        v := ord[si]
        sj := si - 1
        for sj >= 0 && str_lt(sc.nodes[v].rel, sc.nodes[ord[sj]].rel) {
            ord[sj + 1] = ord[sj]
            sj = sj - 1
        }
        ord[sj + 1] = v
        si = si + 1
    }
    // loop
    let jar: []JarEnt = nil
    passed := 0
    failed := 0
    skipped := 0
    let jresults = ""
    first_j := true
    oi := 0
    stop := false
    for oi < len(ord) {
        n := sc.nodes[ord[oi]]
        oi = oi + 1
        if stop {
            skipped = skipped + 1
            rep.lines = push(rep.lines, "SKIPPED " + n.rel + "\n")
            jresults = jappend(jresults, first_j, "{\"file\":" + jesc(n.rel) + ",\"name\":" + jesc(n.req.name) + ",\"outcome\":\"skipped\"}")
            first_j = false
            continue
        }
        if len(n.req.captures) > 0 {
            rep.lines = push(rep.lines, "FAILED " + n.rel + ": captures unsupported in this build — lands M4\n")
            failed = failed + 1
            if o.fail_fast { stop = true }
            jresults = jappend(jresults, first_j, "{\"file\":" + jesc(n.rel) + ",\"name\":" + jesc(n.req.name) + ",\"outcome\":\"failed\",\"error\":\"captures unsupported in this build\"}")
            first_j = false
            continue
        }
        [u0, ue0] = collection.subst_url(n.req.url, es)
        let jlist: []str = nil
        if ue0 == nil {
            u0 = scheme_norm(u0)
            jlist = jar_for_list(jar, url_origin(u0))
        }
        sp := collection.plan_req(n.req, es, jlist, coll_dir)
        if len(sp.err) > 0 {
            rep.lines = push(rep.lines, "FAILED " + n.rel + ": " + sp.err + "\n")
            failed = failed + 1
            if o.fail_fast { stop = true }
            jresults = jappend(jresults, first_j, "{\"file\":" + jesc(n.rel) + ",\"name\":" + jesc(n.req.name) + ",\"outcome\":\"failed\",\"error\":" + jesc(sp.err) + "}")
            first_j = false
            continue
        }
        // plan_req leaves verify "" (on) or "no" — never "yes";
        // ca_bundle applies whenever the request verifies (same
        // gate as coll.oxl's send path).
        if len(cr.s.ssl_ca_bundle) > 0 && sp.req.verify != "no" {
            sp.req.verify = cr.s.ssl_ca_bundle
        }
        // ssl.certificate_path/key_file carry the client identity —
        // a configured file that can't be read fails the request
        // rather than silently sending without it.
        cert_err := ""
        if len(cr.s.ssl_certificate_path) > 0 {
            if !os.exists(cr.s.ssl_certificate_path) {
                cert_err = "ssl.certificate_path: file not found"
            } else {
                sp.req.cert_pem = os.readfile_(cr.s.ssl_certificate_path)
                if len(cr.s.ssl_key_file) > 0 {
                    if !os.exists(cr.s.ssl_key_file) {
                        cert_err = "ssl.key_file: file not found"
                    } else {
                        sp.req.key_pem = os.readfile_(cr.s.ssl_key_file)
                    }
                }
            }
        }
        if len(cert_err) > 0 {
            rep.lines = push(rep.lines, "FAILED " + n.rel + ": " + cert_err + "\n")
            failed = failed + 1
            if o.fail_fast { stop = true }
            jresults = jappend(jresults, first_j, "{\"file\":" + jesc(n.rel) + ",\"name\":" + jesc(n.req.name) + ",\"outcome\":\"failed\",\"error\":" + jesc(cert_err) + "}")
            first_j = false
            continue
        }
        [resp, se] = t.send(sp.req)
        rts := time.unix_ms()
        if se != nil {
            msg := errors.msg(se)
            rep.lines = push(rep.lines, "FAILED " + n.rel + ": " + msg + "\n")
            failed = failed + 1
            if o.fail_fast { stop = true }
            jresults = jappend(jresults, first_j, "{\"file\":" + jesc(n.rel) + ",\"name\":" + jesc(n.req.name) + ",\"outcome\":\"failed\",\"error\":" + jesc(msg) + "}")
            first_j = false
            continue
        }
        // carry cookies for this run only (upstream run.go).
        jar = jar_collect(jar, url_origin(sp.req.url), resp)
        if model.status_class(resp.status) == 2 {
            rep.lines = push(rep.lines, "FAILED " + n.rel + ": " + itoa(resp.status) + " " + resp.reason + "\n")
            failed = failed + 1
            if o.fail_fast { stop = true }
            jresults = jappend(jresults, first_j, "{\"file\":" + jesc(n.rel) + ",\"name\":" + jesc(n.req.name) + ",\"outcome\":\"failed\",\"response\":" + resp_json(sp.req, resp, rts) + "}")
            first_j = false
            continue
        }
        rep.lines = push(rep.lines, "PASSED " + n.rel + ": " + itoa(resp.status) + " " + resp.reason + " (" + ftoa(resp.elapsed_ms) + " ms)\n")
        passed = passed + 1
        jresults = jappend(jresults, first_j, "{\"file\":" + jesc(n.rel) + ",\"name\":" + jesc(n.req.name) + ",\"outcome\":\"passed\",\"response\":" + resp_json(sp.req, resp, rts) + "}")
        first_j = false
    }
    if o.json {
        rep.lines = nil
        rep.lines = push(rep.lines, "{\"results\":[" + jresults + "],\"passed\":" + itoa(passed) + ",\"failed\":" + itoa(failed) + ",\"skipped\":" + itoa(skipped) + "}\n")
    } else {
        rep.lines = push(rep.lines, itoa(passed) + " passed, " + itoa(failed) + " failed, " + itoa(skipped) + " skipped\n")
    }
    if failed > 0 {
        rep.code = 1
    }
    return rep
}

// ---------- run helpers ----------

fn is_abs2(p: str) -> bool {
    return len(p) > 0 && byteat(p, 0) == 47
}

fn base_name(p: str) -> str {
    i := len(p) - 1
    for i > 0 && byteat(p, i) != 47 {
        i = i - 1
    }
    if byteat(p, i) == 47 {
        i = i + 1
    }
    return substr(p, i, len(p))
}

fn scheme_norm(u: str) -> str {
    if find(u, "://") < 0 {
        if len(u) > 1 && substr(u, 0, 2) == "//" {
            return "http:" + u
        }
        return "http://" + u
    }
    return u
}

fn jesc(s: str) -> str {
    return json.tojson(json.jstr(s))
}

fn jappend(acc: str, first: bool, item: str) -> str {
    if first {
        return acc + item
    }
    return acc + "," + item
}

fn resp_json(req: ref model.Req, resp: model.Resp, rts: int) -> str {
    let h = ""
    ct := ""
    i := 0
    for i < len(resp.headers) {
        if i > 0 {
            h = h + ","
        }
        h = h + "{\"name\":" + jesc(resp.headers[i].name) + ",\"value\":" + jesc(resp.headers[i].value) + "}"
        if len(ct) == 0 && lower_ascii(resp.headers[i].name) == "content-type" {
            ct = resp.headers[i].value
        }
        i = i + 1
    }
    // remote.Response-shaped fields (spec §run --json): reason, proto,
    // contentType, receivedAt (unix ms — deviation 14).
    extra := ",\"reason\":" + jesc(resp.reason)
    if len(resp.version) > 0 {
        extra = extra + ",\"proto\":" + jesc("HTTP/" + resp.version)
    }
    if len(ct) > 0 {
        extra = extra + ",\"contentType\":" + jesc(ct)
    }
    extra = extra + ",\"receivedAt\":" + itoa(rts)
    head := "{\"method\":" + jesc(req.method) + ",\"url\":" + jesc(req.url) + ",\"status\":" + jesc(itoa(resp.status) + " " + resp.reason) + ",\"statusCode\":" + itoa(resp.status) + extra + ",\"headers\":[" + h + "],"
    tail := "\"size\":" + itoa(len(resp.body)) + ",\"elapsedMs\":" + ftoa(resp.elapsed_ms) + "}"
    if !is_utf8(resp.body) {
        return head + "\"bodyBase64\":" + jesc(base64.encode(resp.body)) + "," + tail
    }
    return head + "\"body\":" + jesc(resp.body as str) + "," + tail
}

fn is_utf8(b: []byte) -> bool {
    // upstream checks utf8.Valid — invalid bodies go out base64 so the
    // --json document stays well-formed.
    return utf8.valid(b as str)
}

fn jar_for_list(jar: []JarEnt, origin: str) -> []str {
    let out: []str = nil
    i := 0
    for i < len(jar) {
        if jar[i].origin == origin {
            out = push(out, jar[i].nv)
        }
        i = i + 1
    }
    return out
}

// jar_collect stores Set-Cookie name=value pairs under the
// response origin — the run-scoped jar (upstream carries cookies
// through the run only).
fn jar_collect(jar: []JarEnt, origin: str, resp: model.Resp) -> []JarEnt {
    i := 0
    for i < len(resp.headers) {
        h := resp.headers[i]
        i = i + 1
        if lower_ascii(h.name) != "set-cookie" {
            continue
        }
        nv := h.value
        sc := find(nv, ";")
        if sc >= 0 {
            nv = substr(nv, 0, sc)
        }
        ts := 0
        for ts < len(nv) && (byteat(nv, ts) == 32 || byteat(nv, ts) == 9) {
            ts = ts + 1
        }
        nv = substr(nv, ts, len(nv))
        if len(nv) == 0 {
            continue
        }
        nm := nv
        eq := find(nv, "=")
        if eq > 0 {
            nm = substr(nv, 0, eq)
        }
        j := 0
        replaced := false
        for j < len(jar) {
            e2 := jar[j].nv
            eq2 := find(e2, "=")
            cn := e2
            if eq2 > 0 {
                cn = substr(e2, 0, eq2)
            }
            if jar[j].origin == origin && cn == nm {
                jar[j].nv = nv
                replaced = true
            }
            j = j + 1
        }
        if !replaced {
            jar = push(jar, JarEnt{origin: origin, nv: nv})
        }
    }
    return jar
}
