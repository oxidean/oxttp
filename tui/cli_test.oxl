package main

// tui/cli_test — subcommand surface: parse/exit-code/output
// contracts, run_exec over the fake transport.

import "std/testing"
import "std/os"
import "std/time"
import "std/net/tls"
import "github.com/oxidean/oxttp/core/model"

fn test_cli_version() {
    r := cli_version()
    testing.expect(r.code == 0, "code")
    testing.expect(find(r.stdout, "Posting ") == 0, "banner")
}

fn test_cli_locate() {
    let a: []str = nil
    a = push(a, "locate")
    a = push(a, "config")
    r := cli_locate_args(a)
    testing.expect(r.code == 0, "code")
    testing.expect(find(r.stdout, "Config file:") == 0, "label")
    a = push(a, "extra")
    r = cli_locate_args(a)
    testing.expect(r.code == 2, "too many args")
    let b: []str = nil
    b = push(b, "locate")
    b = push(b, "bogus")
    r = cli_locate_args(b)
    testing.expect(r.code == 2, "unknown target")
    testing.expect(find(r.stderr, "Unknown thing to locate") >= 0, "err text")
}

fn test_cli_remote() {
    let a: []str = nil
    a = push(a, "remote")
    a = push(a, "list")
    r := cli_remote_args(a)
    testing.expect(r.code == 0, "list code")
    testing.expect(find(r.stderr, "No Posting is running.") >= 0, "list text on stderr")
    a[1] = "skill"
    r = cli_remote_args(a)
    testing.expect(r.code == 0, "skill code")
    testing.expect(find(r.stdout, "using-posting") >= 0, "skill emits md")
    testing.expect(find(r.stdout, "posting remote send") >= 0, "skill body")
    a[1] = "send"
    r = cli_remote_args(a)
    testing.expect(r.code == 1, "send degrade")
    testing.expect(find(r.stderr, "unix sockets") >= 0, "send err")
    a[1] = "--help"
    r = cli_remote_args(a)
    testing.expect(r.code == 0, "help")
}

fn test_cli_remote_instance_and_json() {
    let a: []str = nil
    a = push(a, "remote")
    a = push(a, "--instance")
    a = push(a, "foo")
    a = push(a, "list")
    r := cli_remote_args(a)
    testing.expect(r.code == 0, "--instance consumed, list runs")
    testing.expect(find(r.stderr, "No Posting is running.") >= 0, "list text")
    // = form
    a = nil
    a = push(a, "remote")
    a = push(a, "--instance=bar")
    a = push(a, "list")
    r = cli_remote_args(a)
    testing.expect(r.code == 0, "--instance= form")
    // list --json → [] → 0
    a = nil
    a = push(a, "remote")
    a = push(a, "list")
    a = push(a, "--json")
    r = cli_remote_args(a)
    testing.expect(r.code == 0, "list --json code")
    testing.expect_streq(r.stdout, "[]\n", "list --json body")
    // unknown command → posting remote: unknown command + usage hint → 2
    a = nil
    a = push(a, "remote")
    a = push(a, "bogus")
    r = cli_remote_args(a)
    testing.expect(r.code == 2, "unknown cmd usage")
    testing.expect(find(r.stderr, "unknown command") >= 0, "err text")
    testing.expect(find(r.stderr, "--help for usage") >= 0, "usage hint")
    // removed commands new/focus are unknown too
    a = nil
    a = push(a, "remote")
    a = push(a, "new")
    r = cli_remote_args(a)
    testing.expect(r.code == 2, "new removed")
    // strict flag errors
    a = nil
    a = push(a, "remote")
    a = push(a, "send")
    a = push(a, "--bogus")
    r = cli_remote_args(a)
    testing.expect(r.code == 2, "unknown option")
    testing.expect(find(r.stderr, "unknown option --bogus") >= 0, "option text")
    // cross-flag: --curl on list
    a = nil
    a = push(a, "remote")
    a = push(a, "list")
    a = push(a, "--curl")
    a = push(a, "x")
    r = cli_remote_args(a)
    testing.expect(r.code == 2, "curl on list")
    testing.expect(find(r.stderr, "--curl and --yaml are for open and send") >= 0, "cross flag")
    // no command at all
    a = nil
    a = push(a, "remote")
    r = cli_remote_args(a)
    testing.expect(r.code == 2, "no command")
    testing.expect(find(r.stderr, "no command given") >= 0, "no command text")
}

fn test_cli_import() {
    root := os.temp_dir() + "/oxttp-cli-import-" + itoa(time.unix_ms())
    os.mkdir_all(root)
    let a: []str = nil
    a = push(a, "import")
    a = push(a, "-t")
    a = push(a, "postman")
    a = push(a, root + "/missing-file.json")
    r := cli_import_args(a)
    testing.expect(r.code == 1, "missing source errors")
    testing.expect(find(r.stderr, "no such file") >= 0, "missing source text")
    a[2] = "bogus"
    r = cli_import_args(a)
    testing.expect(r.code == 2, "bad type")
    testing.expect(find(r.stderr, "unknown import type \"bogus\" (choose openapi, postman, or bruno)") >= 0, "bad type text")
    // non-regular sources are rejected before opening
    a = nil
    a = push(a, "import")
    a = push(a, "/dev/null")
    r = cli_import_args(a)
    testing.expect(r.code == 1, "device source rejected")
    testing.expect(find(r.stderr, "source must be a regular file or Bruno directory") >= 0, "regular file text")
    // help is the upstream multi-line usage
    a = nil
    a = push(a, "import")
    a = push(a, "--help")
    r = cli_import_args(a)
    testing.expect(r.code == 0, "help exits zero")
    testing.expect(find(r.stdout, "Usage: posting import [options] SOURCE [ENVIRONMENT...]") == 0, "help usage")
    testing.expect(find(r.stdout, "Existing files are never") >= 0, "help body")
    // zero sources → usage 2
    a = nil
    a = push(a, "import")
    a = push(a, "-t")
    a = push(a, "postman")
    r = cli_import_args(a)
    testing.expect(r.code == 2, "no sources usage")
    testing.expect(find(r.stderr, "expected a source file or directory") >= 0, "no sources text")
    // --type=x / --output=x forms parse and wire the real engine.
    src := root + "/import.postman.json"
    outdir := root + "/out"
    os.writefile_(src, "{\"info\":{\"name\":\"CLI Import\",\"schema\":\"https://schema.getpostman.com/json/collection/v2.1.0/collection.json\"},\"item\":[{\"name\":\"Get\",\"request\":{\"method\":\"GET\",\"url\":\"https://example.test\"}}]}")
    a = nil
    a = push(a, "import")
    a = push(a, "--type=postman")
    a = push(a, "--output=" + outdir)
    a = push(a, src)
    r = cli_import_args(a)
    testing.expect(r.code == 0, "import success")
    testing.expect(find(r.stdout, "Imported 1 postman request(s)") >= 0, "success text")
    testing.expect(find(r.stdout, outdir) >= 0, "output path text")
    // No --type: detect the Postman envelope from info+item.
    a = nil
    a = push(a, "import")
    a = push(a, "--output=" + outdir + "-detect")
    a = push(a, src)
    r = cli_import_args(a)
    testing.expect(r.code == 0, "detect import success")
    testing.expect(find(r.stdout, "Imported 1 postman request(s)") >= 0, "detect success text")
    // Single-dash long forms parse, and type matching is case-insensitive.
    a = nil
    a = push(a, "import")
    a = push(a, "-type=POSTMAN")
    a = push(a, "-output=" + outdir + "-single")
    a = push(a, src)
    r = cli_import_args(a)
    testing.expect(r.code == 0, "single-dash import success")
    // Postman environment exports may accompany a collection, but an
    // env-only import must name the output collection explicitly.
    envsrc := root + "/import.postman_environment.json"
    os.writefile_(envsrc, "{\"name\":\"dev\",\"values\":[{\"key\":\"TOKEN\",\"value\":\"abc\",\"enabled\":true}]}")
    a = nil
    a = push(a, "import")
    a = push(a, envsrc)
    r = cli_import_args(a)
    testing.expect(r.code == 2, "env-only without output")
    testing.expect(find(r.stderr, "importing only environments requires --output DIR") >= 0, "env-only error text")
    a = nil
    a = push(a, "import")
    a = push(a, "--output=" + outdir + "-env")
    a = push(a, envsrc)
    r = cli_import_args(a)
    testing.expect(r.code == 0, "env-only with output")
    testing.expect(find(r.stdout, "Imported 1 environment(s)") >= 0, "env-only success text")
    os.remove_all(root)
}


fn test_cli_import_env_before_collection_and_bruno_name() {
    root := os.temp_dir() + "/oxttp-cli-review-" + itoa(time.unix_ms())
    os.mkdir_all(root)
    collsrc := root + "/collection.json"
    envsrc := root + "/dev.postman_environment.json"
    outdir := root + "/out"
    os.writefile_(collsrc, "{\"info\":{\"name\":\"CLI Import\",\"schema\":\"https://schema.getpostman.com/json/collection/v2.1.0/collection.json\"},\"item\":[{\"name\":\"Get\",\"request\":{\"method\":\"GET\",\"url\":\"https://example.test\"}}]}")
    os.writefile_(envsrc, "{\"name\":\"dev\",\"values\":[{\"key\":\"TOKEN\",\"value\":\"abc\",\"enabled\":true}]}")
    let a: []str = nil
    a = push(a, "import")
    a = push(a, "--output=" + outdir)
    a = push(a, envsrc)
    a = push(a, collsrc)
    r := cli_import_args(a)
    testing.expect(r.code == 0, "env-before-collection import: " + r.stderr)
    testing.expect(os.exists(outdir + "/dev.env"), "environment retained after collection")
    // Standalone Bruno files use the source basename for the output file,
    // while meta.name remains only the display name.
    brusrc := root + "/status.bru"
    brudir := root + "/bruno-out"
    os.writefile_(brusrc, "meta {\n  name: Health check\n  type: http\n}\nget {\n  url: https://example.test\n}\n")
    a = nil
    a = push(a, "import")
    a = push(a, "--output=" + brudir)
    a = push(a, brusrc)
    r = cli_import_args(a)
    testing.expect(r.code == 0, "bruno import: " + r.stderr)
    testing.expect(os.exists(brudir + "/status.posting.yaml"), "source basename output")
    testing.expect(!os.exists(brudir + "/Health check.posting.yaml"), "display name not file name")
    os.remove_all(root)
}

fn test_cli_import_output_comes_from_first_parse() {
    // Output options before `--` are consumed as flags even when an
    // option-looking source follows `--`; import_run must not rescan raw
    // args and accidentally reinterpret that source as an output option.
    root := os.temp_dir() + "/oxttp-cli-outparse-" + itoa(time.unix_ms())
    os.mkdir_all(root)
    collsrc := root + "/collection.json"
    outdir := root + "/wanted"
    os.writefile_(collsrc, "{\"info\":{\"name\":\"CLI Import\"},\"item\":[{\"name\":\"Get\",\"request\":{\"method\":\"GET\",\"url\":\"https://example.test\"}}]}")
    let a: []str = nil
    a = push(a, "import")
    a = push(a, "-o")
    a = push(a, outdir)
    a = push(a, collsrc)
    r := cli_import_args(a)
    testing.expect(r.code == 0, "first-parse output used: " + r.stderr)
    testing.expect(os.exists(outdir + "/Get.posting.yaml"), "request in wanted output")
    os.remove_all(root)
}

fn test_cli_report_path_quote_and_missing_target_regressions() {
    testing.expect_streq(rel_to_root("/tmp/api/.", "/tmp/api/get.posting.yaml"), "get.posting.yaml", "normalized report path")
    testing.expect_streq(rel_to_root("/tmp/api", "/tmp/apisibling/get.posting.yaml"), "/tmp/apisibling/get.posting.yaml", "sibling not relative")
    testing.expect_streq(imp_quote("qa&dev"), "'qa&dev'", "shell metachar quoted")
    testing.expect_streq(imp_quote(""), "''", "empty shell arg quoted")
    o := new(RunOpts)
    o.coll = "/tmp/definitely-missing-oxttp-coll"
    o.target = "missing.posting.yaml"
    fx := FakeSend{resp: fake_resp(200, "text/plain", "hi", nil), fail: "", expect_path: ""}
    rep := run_exec(o, fx)
    testing.expect(rep.code == 1, "missing target fails")
    testing.expect(find(rep.err, "missing.posting.yaml") >= 0, "missing path retained: " + rep.err)
}

fn test_run_parse() {
    let a: []str = nil
    a = push(a, "run")
    a = push(a, "-c")
    a = push(a, "/coll")
    a = push(a, "-e")
    a = push(a, "dev")
    a = push(a, "--fail-fast")
    a = push(a, "--json")
    a = push(a, "requests/")
    rp := run_parse_args(a)
    testing.expect(len(rp.err) == 0 && !rp.help, "parse ok")
    testing.expect_streq(rp.o.coll, "/coll", "coll")
    testing.expect(len(rp.o.envs) == 1, "envs")
    testing.expect_streq(rp.o.target, "requests/", "target")
    testing.expect(rp.o.fail_fast, "ff")
    testing.expect(rp.o.json, "json")
    // --x=v form + flag after positional
    a = nil
    a = push(a, "run")
    a = push(a, "req.yaml")
    a = push(a, "--collection=/c")
    a = push(a, "--env=prod")
    rp = run_parse_args(a)
    testing.expect(len(rp.err) == 0, "parse2 ok")
    testing.expect_streq(rp.o.coll, "/c", "coll2")
    testing.expect_streq(rp.o.envs[0], "prod", "env2")
    // two positionals → error
    a = push(a, "extra")
    rp = run_parse_args(a)
    testing.expect_streq(rp.err, "expected one request file or directory", "two positional")
    // help
    a = nil
    a = push(a, "run")
    a = push(a, "-h")
    rp = run_parse_args(a)
    testing.expect(rp.help, "help flag")
    // missing value
    a = nil
    a = push(a, "run")
    a = push(a, "-c")
    rp = run_parse_args(a)
    testing.expect_streq(rp.err, "-c needs a value", "missing val")
    // -c alone → target "."
    a = nil
    a = push(a, "run")
    a = push(a, "-c")
    a = push(a, "/coll")
    rp = run_parse_args(a)
    testing.expect(len(rp.err) == 0, "c alone ok")
    testing.expect_streq(rp.o.target, ".", "c alone target")
    // no target, no -c → error
    a = nil
    a = push(a, "run")
    rp = run_parse_args(a)
    testing.expect_streq(rp.err, "give a request file, directory, or --collection DIR", "no target")
    // unknown option keeps original arg
    a = nil
    a = push(a, "run")
    a = push(a, "--bogus")
    rp = run_parse_args(a)
    testing.expect_streq(rp.err, "unknown option --bogus", "unknown opt")
    // --json=x rejected
    a = nil
    a = push(a, "run")
    a = push(a, "t.posting.yaml")
    a = push(a, "--json=yes")
    rp = run_parse_args(a)
    testing.expect_streq(rp.err, "--json takes no value", "json value")
}

fn test_run_env_file_layers() {
    dir := "/tmp/oxttp-runenv-test"
    os.mkdir_all(dir)
    os.writefile_(dir + "/dev.env", "A=named\n")
    f := dir + "/prod.env"
    os.writefile_(f, "B=file\nA=filewins\n")
    let envs: []str = nil
    envs = push(envs, "dev")
    envs = push(envs, f)
    let dirs: []str = nil
    dirs = push(dirs, dir)
    re := run_env(dirs, envs)
    testing.expect(len(re.err) == 0, "err: " + re.err)
    lr := re.es.lookup("B")
    testing.expect(lr.ok, "file var present")
    testing.expect_streq(lr.value, "file", "file value")
    lr2 := re.es.lookup("A")
    testing.expect(lr2.ok, "named var resolves")
    testing.expect_streq(lr2.value, "filewins", "file layer wins over named")
    os.remove_all(dir)
}

// stage_run builds a scratch collection with one good + one
// script-carrying request and runs run_exec over a fake transport.
fn test_run_exec() {
    dir := "/tmp/oxttp-run-test"
    os.mkdir_all(dir)
    os.writefile_(dir + "/ok.posting.yaml", "name: ok\nmethod: GET\nurl: http://x.test/a\n")
    os.writefile_(dir + "/scripted.posting.yaml", "name: sc\nmethod: GET\nurl: http://x.test/b\nscripts:\n  setup: print(1)\n")
    o := new(RunOpts)
    o.coll = dir
    o.target = dir
    fx := FakeSend{resp: fake_resp(200, "text/plain", "hi", nil), fail: "", expect_path: ""}
    rep := run_exec(o, fx)
    // ADR-0038: a scripted request aborts the whole run BEFORE any
    // send — the valid request never reaches the transport.
    testing.expect(rep.code == 1, "abort code")
    testing.expect(find(rep.err, "scripted.posting.yaml") >= 0, "err names file")
    testing.expect(find(rep.err, "Python scripts") >= 0, "err names scripts")
    testing.expect_eq(len(rep.lines), 0, "nothing ran")
    // an empty-url request aborts the same way
    os.remove(dir + "/scripted.posting.yaml")
    os.writefile_(dir + "/nourl.posting.yaml", "name: nu\nmethod: GET\nurl: \"\"\n")
    rep = run_exec(o, fx)
    testing.expect(rep.code == 1, "empty-url abort code")
    testing.expect(find(rep.err, "request has no URL") >= 0, "empty-url err")
    testing.expect_eq(len(rep.lines), 0, "nothing sent")
    // a fully valid collection runs every request
    os.remove(dir + "/nourl.posting.yaml")
    os.writefile_(dir + "/ok2.posting.yaml", "name: ok2\nmethod: GET\nurl: http://x.test/b\n")
    rep = run_exec(o, fx)
    testing.expect(len(rep.err) == 0, "err: " + rep.err)
    testing.expect(rep.code == 0, "clean run passes")
    testing.expect(len(rep.lines) == 3, "2 req + summary")
    testing.expect(find(rep.lines[2], "2 passed") >= 0, "summary")
    // fail-fast + json on a clean run
    o.fail_fast = true
    o.json = true
    rep = run_exec(o, fx)
    testing.expect(find(rep.lines[0], "\"results\"") >= 0, "json head")
    testing.expect(find(rep.lines[0], "\"passed\":2") >= 0, "json passed")
    // single-file non-.posting.yaml rejects
    os.writefile_(dir + "/not.txt", "x")
    o.target = dir + "/not.txt"
    rep = run_exec(o, fx)
    testing.expect(rep.code == 1, "non yaml")
    testing.expect(find(rep.err, ".posting.yaml") >= 0, "err")
}

// run ordering: requests execute sorted by collection-relative path,
// not scan (DFS) order — a top-level "a" must precede "z/b" even
// though the dir walk emits z's subtree first.
fn test_run_exec_orders_by_rel() {
    dir := "/tmp/oxttp-run-order"
    os.remove_all(dir)
    os.mkdir_all(dir + "/z")
    os.writefile_(dir + "/a.posting.yaml", "name: a\nmethod: GET\nurl: http://x.test/a\n")
    os.writefile_(dir + "/z/b.posting.yaml", "name: b\nmethod: GET\nurl: http://x.test/b\n")
    o := new(RunOpts)
    o.target = dir
    fx := FakeSend{resp: fake_resp(200, "text/plain", "hi", nil), fail: "", expect_path: ""}
    rep := run_exec(o, fx)
    testing.expect(len(rep.err) == 0, "err: " + rep.err)
    testing.expect(rep.code == 0, "clean run")
    testing.expect(len(rep.lines) == 3, "2 req + summary")
    testing.expect(find(rep.lines[0], "PASSED a.posting.yaml") == 0, "a first")
    testing.expect(find(rep.lines[1], "PASSED z/b.posting.yaml") == 0, "z/b second")
    os.remove_all(dir)
}

fn test_run_exec_fail_fast_shape() {
    dir := "/tmp/oxttp-run-ff"
    os.remove_all(dir)
    os.mkdir_all(dir)
    os.writefile_(dir + "/01.bad.posting.yaml", "name: bad\nmethod: GET\nurl: http://x.test/a\ncaptures:\n  NOPE: $.missing\n")
    os.writefile_(dir + "/02.good.posting.yaml", "name: good\nmethod: GET\nurl: http://x.test/b\n")
    o := new(RunOpts)
    o.target = dir
    o.fail_fast = true
    fx := FakeSend{resp: fake_resp(200, "application/json", "{}", nil), fail: "", expect_path: ""}
    rep := run_exec(o, fx)
    testing.expect(rep.code == 1, "failed run")
    testing.expect_eq(len(rep.lines), 2, "failure plus summary only")
    testing.expect(find(rep.lines[0], "FAILED 01.bad.posting.yaml") == 0, "failure line")
    testing.expect(find(rep.lines[1], "0 passed, 1 failed, 1 skipped") >= 0, "numeric skipped summary")
    joined := str_join(rep.lines, "")
    testing.expect(find(joined, "SKIPPED") < 0, "no per-request skipped lines")
    o.json = true
    rep = run_exec(o, fx)
    testing.expect_eq(len(rep.lines), 1, "json report line")
    testing.expect(find(rep.lines[0], "\"outcome\":\"failed\"") >= 0, "failed result present")
    testing.expect(find(rep.lines[0], "\"outcome\":\"skipped\"") < 0, "no skipped result object")
    testing.expect(find(rep.lines[0], "\"skipped\":1") >= 0, "json skipped count")
    os.remove_all(dir)
}

fn test_is_utf8_and_resp_json_binary() {
    good := "plain ascii body"
    testing.expect(is_utf8(good as []byte), "ascii is utf8")
    bad := mkslice(byte, 4)
    bad[0] = 102
    bad[1] = 254
    bad[2] = 255
    bad[3] = 0
    testing.expect(!is_utf8(bad), "binary without valid utf8 rejected")
    // resp_json emits bodyBase64 + the remote.Response fields
    r := fake_resp(200, "text/plain", "", nil)
    r.body = bad
    rq := new(model.Req)
    rq.method = "GET"
    rq.url = "http://x.test/"
    j := resp_json(rq, r, 1700000000000)
    testing.expect(find(j, "\"bodyBase64\"") >= 0, "base64 body")
    testing.expect(find(j, "\"contentType\":\"text/plain\"") >= 0, "contentType")
    testing.expect(find(j, "\"reason\":\"OK\"") >= 0, "reason")
    testing.expect(find(j, "\"proto\":\"HTTP/1.1\"") >= 0, "proto")
    testing.expect(find(j, "\"receivedAt\":1700000000000") >= 0, "receivedAt")
}

// captures feed later requests in the same run via the session
// layer (upstream run.go model.Merge per request); a failed capture
// fails that request; invalid captures reject the file at load.
fn test_run_exec_captures() {
    dir := "/tmp/oxttp-run-cap"
    os.remove_all(dir)
    os.mkdir_all(dir)
    os.writefile_(dir + "/01.get.posting.yaml",
        "name: get\nmethod: GET\nurl: http://x.test/a\ncaptures:\n  TOKEN: $.token\n")
    os.writefile_(dir + "/02.use.posting.yaml",
        "name: use\nmethod: GET\nurl: http://x.test/use/$TOKEN\n")
    o := new(RunOpts)
    o.target = dir
    fx := FakeSend{resp: fake_resp(200, "application/json", "{\"token\":\"sekrit\"}", nil), fail: "", expect_path: "/use/sekrit"}
    rep := run_exec(o, fx)
    testing.expect(len(rep.err) == 0, "err: " + rep.err)
    testing.expect(rep.code == 0, "clean run: " + rep.err + " / " + rep.lines[len(rep.lines) - 2])
    testing.expect(len(rep.lines) == 3, "2 req + summary")
    testing.expect(find(rep.lines[1], "PASSED") == 0, "second req passed — $TOKEN resolved")
    // a capture that matches nothing fails the request
    os.remove_all(dir)
    os.mkdir_all(dir)
    os.writefile_(dir + "/01.bad.posting.yaml",
        "name: bad\nmethod: GET\nurl: http://x.test/a\ncaptures:\n  NOPE: $.missing\n")
    rep = run_exec(o, fx)
    testing.expect(rep.code == 1, "capture failure exits 1")
    testing.expect(find(rep.lines[0], "FAILED") == 0, "failed line")
    testing.expect(find(rep.lines[0], "matched 0 values") >= 0, "err text")
    // invalid capture (bad var name) rejects the file before any send
    os.remove_all(dir)
    os.mkdir_all(dir)
    os.writefile_(dir + "/01.badname.posting.yaml",
        "name: bad\nmethod: GET\nurl: http://x.test/a\ncaptures:\n  1BAD: $.x\n")
    rep = run_exec(o, fx)
    testing.expect(rep.code == 1, "invalid capture aborts")
    testing.expect(len(rep.lines) == 0, "nothing ran")
    os.remove_all(dir)
}


fn test_run_empty_client_cert_aborts() {
    // WI-0017 review: a configured cert/key that exists but reads
    // empty must fail before send — pairing empty PEM is a transport
    // error, so the headless path rejects it like the TUI.
    dir := "/tmp/oxttp-run-empty-cert"
    os.remove_all(dir)
    os.mkdir_all(dir)
    cert := dir + "/cert.pem"
    key := dir + "/key.pem"
    os.writefile_(cert, "")
    os.writefile_(key, "key")
    cfg := dir + "/config.yaml"
    os.writefile_(cfg, "ssl:\n  certificate_path: " + cert + "\n  key_file: " + key + "\n")
    os.writefile_(dir + "/ok.posting.yaml", "name: ok\nmethod: GET\nurl: https://x.test/a\n")
    o := new(RunOpts)
    o.coll = dir
    o.target = dir
    o.cfg_file = cfg
    fx := FakeSend{resp: fake_resp(200, "text/plain", "hi", nil), fail: "", expect_path: ""}
    rep := run_exec(o, fx)
    testing.expect(rep.code == 1, "empty cert fails the run")
    testing.expect(len(rep.err) > 0 || find(join(rep.lines), "unreadable or empty") >= 0, "failure names unreadable/empty")
    os.writefile_(cert, "pem")
    os.writefile_(key, "")
    rep = run_exec(o, fx)
    testing.expect(rep.code == 1, "empty key fails the run")
    os.remove_all(dir)
}

fn test_run_ssl_password_and_tls12_warn() {
    // WI-0017 (ADR-0045): ssl.password warns once on stderr; a client
    // cert meeting TLS1.2 warns per request — both via the cfg_file
    // seam (config.load's first arg).
    dir := "/tmp/oxttp-run-ssl"
    os.remove_all(dir)
    os.mkdir_all(dir)
    cert := dir + "/cert.pem"
    os.writefile_(cert, "pem")
    cfg := dir + "/config.yaml"
    os.writefile_(cfg, "ssl:\n  certificate_path: " + cert + "\n  password: secret\n")
    os.writefile_(dir + "/ok.posting.yaml", "name: ok\nmethod: GET\nurl: https://x.test/a\n")
    o := new(RunOpts)
    o.coll = dir
    o.target = dir
    o.cfg_file = cfg
    r := fake_resp(200, "text/plain", "hi", nil)
    r.tls_ver = tls.V12
    fx := FakeSend{resp: r, fail: "", expect_path: ""}
    rep := run_exec(o, fx)
    testing.expect(rep.code == 0, "run passes: " + rep.err)
    testing.expect(find(rep.stderr, "encrypted private keys are unsupported") >= 0, "password warning on stderr")
    testing.expect(find(rep.stderr, "empty certificate list") >= 0, "tls12 cert warning on stderr")
    // password without a configured cert → no warning
    os.writefile_(cfg, "ssl:\n  password: secret\n")
    rep = run_exec(o, fx)
    testing.expect(find(rep.stderr, "encrypted private keys") < 0, "no cert → no password warning")
    os.remove_all(dir)
}
