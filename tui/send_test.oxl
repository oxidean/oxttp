package main

// S10.4 send path: draft → plan_req → ESend → exec_send → response
// install (body/JSON re-indent, headers, cookies, trace, title meta),
// jar update, send_failed, and session history (cap 100, newest-first,
// open-as-sent, remove). exec_send_t takes the Transport port so a
// fake can stand in for H1 — no sockets in tests.

import "std/errors"
import "std/os"
import "std/net/tls"
import "std/testing"
import "github.com/oxidean/oxttp/core/collection"
import "github.com/oxidean/oxttp/core/model"
import "github.com/oxidean/oxttp/core/term"

// FakeSend implements core/http.Transport — returns a staged Resp or
// a staged error, never a socket.
struct FakeSend {
    resp: model.Resp,
    fail: str,
    expect_path: str,
}

fn (f FakeSend) send(req: ref model.Req) -> [model.Resp, err] {
    if len(f.fail) > 0 {
        return f.resp, errors.new(f.fail)
    }
    if len(f.expect_path) > 0 && find(req.url, "/use/") >= 0 && find(req.url, f.expect_path) < 0 {
        return f.resp, errors.new("expected path missing: " + req.url)
    }
    return f.resp, nil
}

// fake_resp builds a response with a full trace; hops stays whatever
// the caller passes (nil exercises the no-redirect path).
fn fake_resp(status: int, ct: str, body: str, hops: own []model.Hop) -> model.Resp {
    hs := mkslice(model.Header, 0)
    if len(ct) > 0 {
        hs = push(hs, model.Header{name: "Content-Type", value: ct})
    }
    tr := new(model.Trace)
    tr.connect_ms = 3.0
    tr.tls_ms = 1.5
    tr.send_headers_ms = 0.5
    tr.send_body_ms = 0.25
    tr.recv_headers_ms = 8.0
    tr.recv_body_ms = 2.0
    tr.closed_ms = 0.1
    return model.Resp{status: status, reason: "OK", headers: hs,
        body: body as []byte, elapsed_ms: 14.0, remote: "127.0.0.1:9",
        version: "1.1", req_head: "", hops: hops, trace: tr, tls_ver: 0}
}

// stage_send arms a.pending/a.pending_preq the way begin_send leaves
// them, without re-running the planner.
fn stage_send(a: mut App, url: str) {
    a.url.text = url
    a.pending_preq = draft_to_request(a)
    a.pending_name = "staged"
    a.pending = new(model.Req)
    a.pending.method = "GET"
    a.pending.url = url
}

fn test_begin_send_plan_err() {
    a := new_app()
    // empty url → plan error toast, no send staged
    fx := begin_send(a)
    testing.expect_eq(fx, ENone, "plan err does not send")
    testing.expect_eq(len(a.toasts), 1, "error toast")
    testing.expect_eq(a.toasts[0].level, 2, "send errors are error toasts")
    testing.expect(a.pending == nil, "no pending req")
    // kind degrades through plan_req (graphql/grpc/ws sends are M4)
    a2 := new_app()
    a2.kind = KGraphql
    a2.url.text = "http://x"
    fx2 := begin_send(a2)
    testing.expect_eq(fx2, ENone, "kind send degrades")
    testing.expect(str_contains(a2.toasts[0].msg, "M4"), "kind toast names M4")
}

fn test_begin_send_ok() {
    a := new_app()
    a.url.text = "example.com/users"
    fx := begin_send(a)
    testing.expect_eq(fx, ESend, "planned send returns ESend")
    testing.expect(a.pending != nil, "pending staged")
    testing.expect_streq(a.pending.url, "http://example.com/users", "scheme-less → http")
    testing.expect_streq(a.pending_name, "Untitled request", "pending name = tab title")
}

fn test_begin_send_url_substitution() {
    scratch_coll()
    a := new_app()
    a.coll_dir = COLL_SCRATCH
    // implicit env base loads from the launch cwd only — the test
    // "launches" inside the collection so posting.env applies
    a.cwd = COLL_SCRATCH
    a.data_dir = DATA_SCRATCH
    load_collection(a)
    a.url.text = "$BASE/users"
    fx := begin_send(a)
    testing.expect_eq(fx, ESend, "substituted send plans")
    testing.expect_streq(a.pending.url, "http://example.test/users", "$BASE resolved into url")
    // unresolved in-url is a plan error
    a2 := new_app()
    a2.coll_dir = COLL_SCRATCH
    a2.cwd = COLL_SCRATCH
    a2.data_dir = DATA_SCRATCH
    load_collection(a2)
    a2.url.text = "$MISSING/x"
    fx2 := begin_send(a2)
    testing.expect_eq(fx2, ENone, "unresolved var fails the plan")
    testing.expect(str_contains(a2.toasts[len(a2.toasts)-1].msg, "MISSING"), "names the var")
}

fn test_begin_send_proxy_wiring() {
    // WI-0017 (ADR-0044): options.proxy_url wires into req.proxies
    // ("all:"-scoped) instead of warning-and-directing; env proxy
    // capture may add proxy_env entries but never warns.
    a := new_app()
    pr := new(collection.PRequest)
    pr.url = "http://x"
    pr.options = new(collection.POptions{follow_redirects: true, verify_ssl: true,
        attach_cookies: true, substitute_body_variables: true,
        proxy_url: "http://proxy:8888", timeout: 5.0, set_mask: 16})
    a.pending_preq = pr
    a.url.text = "http://x"
    fx := begin_send_preq(a)
    testing.expect_eq(fx, ESend, "proxy send still plans")
    testing.expect_eq(len(a.pending.proxies), 1, "one proxies entry")
    testing.expect_streq(a.pending.proxies[0], "all:http://proxy:8888", "all-wrapped")
    i := 0
    for i < len(a.toasts) {
        testing.expect(!str_contains(a.toasts[i].msg, "proxy unsupported"), "no proxy-unsupported warn")
        i = i + 1
    }
}

fn test_exec_send_installs_response() {
    a := new_app()
    stage_send(a, "http://x/users")
    hs := mkslice(model.Hop, 0)
    r := fake_resp(200, "application/json", "{\"a\":1}", new(hs))
    r.headers = push(r.headers, model.Header{name: "Set-Cookie", value: "sid=abc; Path=/"})
    f := FakeSend{resp: r, fail: "", expect_path: ""}
    exec_send_t(a, f)
    testing.expect(a.pending == nil, "pending consumed")
    // body: JSON content-type re-indents 2sp
    testing.expect_eq(len(a.resp_view.lines), 3, "pretty body lines")
    testing.expect_streq(a.resp_view.lines[1], "  \"a\": 1", "2sp indent")
    // headers + cookies rows
    testing.expect_eq(len(a.resp_hdr_rows), 2, "header rows")
    testing.expect_streq(a.resp_hdr_rows[0], "Content-Type: application/json", "hdr row text")
    testing.expect_eq(len(a.resp_ck_rows), 1, "cookie row")
    testing.expect_streq(a.resp_ck_rows[0], "sid=abc; Path=/", "cookie row text")
    // trace: 7 stage rows, no hops line when the chain is empty
    testing.expect_eq(len(a.resp_tr_rows), 7, "7 stage rows")
    testing.expect(str_contains(a.resp_tr_rows[0], "connect"), "connect row")
    // title meta + status class + sizes
    testing.expect_streq(a.resp_title, "response · 200 OK · 7 B · 14 ms", "title meta")
    testing.expect_eq(a.resp_class, 0, "2xx class")
    testing.expect_eq(a.resp_size, 7, "body size")
    // jar picked up the set-cookie (attach_cookies default true)
    testing.expect_eq(len(a.jar), 1, "jar updated")
    testing.expect_streq(a.jar[0].nv, "sid=abc", "jar holds n=v")
    testing.expect_streq(a.jar[0].origin, "http://x", "jar origin scoped")
    // history appended
    testing.expect_eq(len(a.history), 1, "history entry")
    testing.expect_eq(a.history[0].status, 200, "entry status")
    testing.expect(len(a.history[0].req_yaml) > 0, "entry keeps request yaml")
}

fn test_install_resp_hops_and_nojson() {
    a := new_app()
    stage_send(a, "http://x")
    hops := mkslice(model.Hop, 0)
    hops = push(hops, model.Hop{req_head: "GET /a HTTP/1.1", status: 301,
        reason: "Moved", version: "1.1", headers: nil, body: nil,
        elapsed_ms: 2.0, remote: "127.0.0.1:9", url: "http://x/a"})
    r := fake_resp(200, "text/plain", "plain body stays", new(hops))
    install_resp(a, r, "http://x")
    testing.expect_eq(len(a.resp_tr_rows), 8, "stage rows + hops line")
    testing.expect(str_contains(a.resp_tr_rows[7], "hops: 1"), "hops row last")
    // non-JSON content stays verbatim
    testing.expect_streq(a.resp_view.lines[0], "plain body stays", "verbatim body")
    // a nil hops own is legal — install must not touch len() on it
    a2 := new_app()
    stage_send(a2, "http://x")
    r2 := fake_resp(204, "", "", nil)
    r2.reason = "No Content"
    install_resp(a2, r2, "http://x")
    testing.expect_eq(len(a2.resp_tr_rows), 7, "nil hops: stage rows only")
    testing.expect_eq(len(a2.resp_ck_rows), 0, "no cookies")
}

fn test_exec_send_error_installs() {
    a := new_app()
    stage_send(a, "http://x")
    f := FakeSend{resp: fake_resp(0, "", "", nil), fail: "dial tcp: refused", expect_path: ""}
    exec_send_t(a, f)
    testing.expect_eq(len(a.resp_view.lines), 1, "error text installed")
    testing.expect(str_contains(a.resp_view.lines[0], "request failed"), "failed prefix")
    testing.expect(str_contains(a.resp_view.lines[0], "refused"), "err text")
    testing.expect_streq(a.resp_title, "response · error", "error title")
    testing.expect_eq(a.resp_class, 2, "error class")
    testing.expect_eq(len(a.history), 0, "errors skip history")
    testing.expect_eq(len(a.jar), 0, "jar untouched")
    testing.expect_eq(a.toasts[len(a.toasts)-1].level, 2, "error toast")
}

fn test_history_cap_newest_first() {
    a := new_app()
    stage_send(a, "http://x")
    i := 0
    for i < 105 {
        he := HistEnt{id: 0, persisted: false, title: "t" + itoa(i), method: "GET", url: "http://x/" + itoa(i),
            status: 200, reason: "OK", elapsed_ms: 1.0, size: 1,
            req_yaml: "url: http://x\n", resp_text: "b",
            resp_hdr_rows: nil, resp_ck_rows: nil, resp_tr_rows: nil}
        a.history = push(a.history, he)
        if len(a.history) > 100 {
            a.history = a.history[len(a.history) - 100:]
        }
        i = i + 1
    }
    testing.expect_eq(len(a.history), 100, "cap 100")
    // newest-first through the modal list: index 0 = most recent
    testing.expect_streq(a.history[len(a.history)-1].url, "http://x/104", "newest kept")
    testing.expect_streq(a.history[0].url, "http://x/5", "oldest dropped")
}

fn test_history_open_and_delete() {
    scratch_coll()
    a := new_app()
    a.coll_dir = COLL_SCRATCH
    a.data_dir = DATA_SCRATCH
    load_collection(a)
    stage_send(a, "http://x/one")
    r := fake_resp(200, "application/json", "{\"k\":2}", new(mkslice(model.Hop, 0)))
    f := FakeSend{resp: r, fail: "", expect_path: ""}
    exec_send_t(a, f)
    stage_send(a, "http://x/two")
    r2 := fake_resp(404, "text/plain", "nope", new(mkslice(model.Hop, 0)))
    r2.reason = "Not Found"
    f2 := FakeSend{resp: r2, fail: "", expect_path: ""}
    exec_send_t(a, f2)
    testing.expect_eq(len(a.history), 2, "two entries")
    // MHistory lists newest-first: sel 0 opens the LAST pushed entry
    push_modal(a, MHistory)
    a.hist.sel = 0
    hist_open(a)
    testing.expect_eq(len(a.tabs), 2, "open pushes a preview tab")
    nt := a.tabs[len(a.tabs)-1]
    testing.expect(nt.preview, "history tab is preview")
    testing.expect_streq(nt.draft.url.text, "http://x/two", "as-sent url restored")
    testing.expect_streq(nt.draft.resp_title, "response · 404 Not Found · 4 B · 14 ms", "stored title")
    testing.expect(len(nt.draft.resp_view.lines) >= 1, "stored body installed")
    // backspace removes the selected (newest) entry
    push_modal(a, MHistory)
    a.hist.sel = 0
    hist_delete(a)
    testing.expect_eq(len(a.history), 1, "entry removed")
    testing.expect_streq(a.history[0].url, "http://x/one", "oldest survives")
}

fn test_send_failed_via_dispatch() {
    // ctrl+j on an empty draft toasts the plan error, never returns
    // ESend — the dispatch path a real keypress takes.
    a := new_app()
    fx := dispatch(a, kev("j", true, false, false))
    testing.expect_eq(fx, ENone, "dispatch surfaces no ESend")
    testing.expect_eq(len(a.toasts), 1, "plan err toast")
}

fn test_history_nav_via_dispatch() {
    // Up/Down/Home/End inside MHistory move the entry cursor —
    // exercise the real key path (dispatch → hist_action → rows_*).
    a := new_app()
    i := 0
    for i < 3 {
        a.history = push(a.history, HistEnt{id: 0, persisted: false, title: "t" + itoa(i), method: "GET",
            url: "http://x/" + itoa(i), status: 200, reason: "OK", elapsed_ms: 1.0,
            size: 1, req_yaml: "url: http://x\n", resp_text: "b",
            resp_hdr_rows: nil, resp_ck_rows: nil, resp_tr_rows: nil})
        i = i + 1
    }
    push_modal(a, MHistory)
    testing.expect_eq(a.hist.sel, 0, "sel starts newest")
    dispatch(a, knamed(term.KeyDown))
    testing.expect_eq(a.hist.sel, 1, "down moves")
    dispatch(a, knamed(term.KeyEnd))
    testing.expect_eq(a.hist.sel, 2, "end jumps last")
    dispatch(a, knamed(term.KeyHome))
    testing.expect_eq(a.hist.sel, 0, "home jumps first")
}

fn test_jar_origin_scoping() {
    // jar entries attach only to the origin that set them —
    // a.test's cookie must not ride a b.test request.
    a := new_app()
    a.jar = push(a.jar, JarEnt{origin: "http://a.test", nv: "sa=1"})
    a.jar = push(a.jar, JarEnt{origin: "http://b.test", nv: "sb=2"})
    a.url.text = "http://a.test/x"
    fx := begin_send(a)
    testing.expect_eq(fx, ESend, "send plans")
    cookies := ""
    i := 0
    for i < len(a.pending.headers) {
        if a.pending.headers[i].name == "Cookie" {
            cookies = a.pending.headers[i].value
        }
        i = i + 1
    }
    testing.expect_streq(cookies, "sa=1", "only same-origin cookie sent")
    // a response set-cookie lands under the response's origin
    stage_send(a, "http://b.test/y")
    r := fake_resp(200, "", "", nil)
    r.headers = push(r.headers, model.Header{name: "Set-Cookie", value: "sc=3; Path=/"})
    f := FakeSend{resp: r, fail: "", expect_path: ""}
    exec_send_t(a, f)
    testing.expect_eq(len(a.jar), 3, "new cookie appended")
    testing.expect_streq(a.jar[2].origin, "http://b.test", "stored under b.test")
    // and a b.test send now carries sb + sc, not sa
    a2 := new_app()
    a2.jar = a.jar
    a2.url.text = "b.test/z"
    fx2 := begin_send(a2)
    testing.expect_eq(fx2, ESend, "send2 plans")
    cookies2 := ""
    i = 0
    for i < len(a2.pending.headers) {
        if a2.pending.headers[i].name == "Cookie" {
            cookies2 = a2.pending.headers[i].value
        }
        i = i + 1
    }
    testing.expect_streq(cookies2, "sb=2; sc=3", "b.test cookies join")
}

fn test_begin_send_missing_client_cert() {
    // a configured ssl.certificate_path that is absent aborts the
    // send — same rejection the headless --cert plan applies; the
    // request must not go out without its client identity.
    a := new_app()
    a.url.text = "https://x"
    a.ssl_cert = "/nonexistent-client-cert.pem"
    fx := begin_send(a)
    testing.expect_eq(fx, ENone, "missing cert aborts the send")
    testing.expect(a.pending == nil, "nothing staged")
    testing.expect_eq(a.toasts[len(a.toasts)-1].level, 2, "error toast")
    // a configured key that is absent aborts too
    scratch_coll()
    cert := COLL_SCRATCH + "/cert.pem"
    os.writefile_(cert, "pem")
    a2 := new_app()
    a2.url.text = "https://x"
    a2.ssl_cert = cert
    a2.ssl_key = COLL_SCRATCH + "/missing-key.pem"
    fx2 := begin_send(a2)
    testing.expect_eq(fx2, ENone, "missing key aborts the send")
    testing.expect(a2.pending == nil, "nothing staged")
    // a readable pair still sends with the identity loaded
    key := COLL_SCRATCH + "/key.pem"
    os.writefile_(key, "key")
    a2.ssl_key = key
    fx3 := begin_send(a2)
    testing.expect_eq(fx3, ESend, "valid identity still sends")
    testing.expect_streq(a2.pending.cert_pem, "pem", "cert pem loaded")
    testing.expect_streq(a2.pending.key_pem, "key", "key pem loaded")
    // an existing-but-empty cert or key aborts too — pairing empty
    // PEM text errors in the transport and the send must fail fast.
    os.writefile_(cert, "")
    a3 := new_app()
    a3.url.text = "https://x"
    a3.ssl_cert = cert
    a3.ssl_key = key
    fx4 := begin_send(a3)
    testing.expect_eq(fx4, ENone, "empty cert aborts the send")
    testing.expect(a3.pending == nil, "empty cert stages nothing")
    os.writefile_(cert, "pem")
    os.writefile_(key, "")
    fx5 := begin_send(a3)
    testing.expect_eq(fx5, ENone, "empty key aborts the send")
    testing.expect(a3.pending == nil, "empty key stages nothing")
}

fn test_ssl_password_degrade_toast() {
    // WI-0017 (ADR-0045): ssl.password can't be honored — the toast
    // names the build limitation, never promises a future WI.
    scratch_coll()
    cert := COLL_SCRATCH + "/cert.pem"
    os.writefile_(cert, "pem")
    a := new_app()
    a.url.text = "https://x"
    a.ssl_cert = cert
    a.ssl_pass = "hunter2"
    fx := begin_send(a)
    testing.expect_eq(fx, ESend, "password degrade does not block")
    found := false
    i := 0
    for i < len(a.toasts) {
        if str_contains(a.toasts[i].msg, "encrypted private keys unsupported") {
            found = true
            testing.expect(!str_contains(a.toasts[i].msg, "lands with"), "no future-WI promise")
        }
        i = i + 1
    }
    testing.expect(found, "ssl.password degrade toast")
}

fn test_exec_send_tls12_cert_warn() {
    // WI-0017 (ADR-0045): a configured client cert meeting a TLS1.2
    // negotiation sends an empty certificate_list — warn like CLI W2.
    a := new_app()
    stage_send(a, "https://x")
    a.pending.cert_pem = "pem"
    r := fake_resp(200, "text/plain", "ok", new(mkslice(model.Hop, 0)))
    r.tls_ver = tls.V12
    f := FakeSend{resp: r, fail: "", expect_path: ""}
    exec_send_t(a, f)
    found := false
    i := 0
    for i < len(a.toasts) {
        if str_contains(a.toasts[i].msg, "empty certificate list") {
            found = true
            testing.expect_eq(a.toasts[i].level, 1, "cert warning is info level")
        }
        i = i + 1
    }
    testing.expect(found, "TLS1.2 cert warning toasted")
    // TLS1.3 negotiation → silent
    a2 := new_app()
    stage_send(a2, "https://x")
    a2.pending.cert_pem = "pem"
    r2 := fake_resp(200, "text/plain", "ok", new(mkslice(model.Hop, 0)))
    r2.tls_ver = tls.V13
    exec_send_t(a2, FakeSend{resp: r2, fail: "", expect_path: ""})
    i = 0
    for i < len(a2.toasts) {
        testing.expect(!str_contains(a2.toasts[i].msg, "certificate list"), "V13 silent")
        i = i + 1
    }
    // cleartext → silent
    a3 := new_app()
    stage_send(a3, "http://x")
    a3.pending.cert_pem = "pem"
    r3 := fake_resp(200, "text/plain", "ok", new(mkslice(model.Hop, 0)))
    r3.tls_ver = 0
    exec_send_t(a3, FakeSend{resp: r3, fail: "", expect_path: ""})
    i = 0
    for i < len(a3.toasts) {
        testing.expect(!str_contains(a3.toasts[i].msg, "certificate list"), "cleartext silent")
        i = i + 1
    }
    // TLS1.2 without a configured cert → silent
    a4 := new_app()
    stage_send(a4, "https://x")
    r4 := fake_resp(200, "text/plain", "ok", new(mkslice(model.Hop, 0)))
    r4.tls_ver = tls.V12
    exec_send_t(a4, FakeSend{resp: r4, fail: "", expect_path: ""})
    i = 0
    for i < len(a4.toasts) {
        testing.expect(!str_contains(a4.toasts[i].msg, "certificate list"), "no-cert silent")
        i = i + 1
    }
}

fn test_exec_send_captures_publish() {
    a := new_app()
    stage_send(a, "http://x/users")
    a.pending_preq.captures = push(a.pending_preq.captures,
        model.KV{name: "UID", value: "$.data.id", enabled: true})
    r := fake_resp(200, "application/json", "{\"data\":{\"id\":\"u-42\"}}", nil)
    f := FakeSend{resp: r, fail: "", expect_path: ""}
    exec_send_t(a, f)
    lr := a.env.lookup("UID")
    testing.expect(lr.ok, "capture published to env")
    testing.expect_streq(lr.value, "u-42", "captured value")
    found := false
    i := 0
    for i < len(a.session_vars) {
        if a.session_vars[i].name == "UID" {
            found = true
            testing.expect_streq(a.session_vars[i].value, "u-42", "session var")
        }
        i = i + 1
    }
    testing.expect(found, "session_vars row")
}

fn test_exec_send_captures_failure() {
    a := new_app()
    stage_send(a, "http://x/users")
    a.pending_preq.captures = push(a.pending_preq.captures,
        model.KV{name: "UID", value: "$.missing", enabled: true})
    r := fake_resp(200, "application/json", "{\"data\":{\"id\":\"u-42\"}}", nil)
    f := FakeSend{resp: r, fail: "", expect_path: ""}
    exec_send_t(a, f)
    // warning toast, nothing published — response still installs
    found := false
    i := 0
    for i < len(a.toasts) {
        if a.toasts[i].level == 0 && str_contains(a.toasts[i].msg, "Couldn't capture response") {
            found = true
        }
        i = i + 1
    }
    testing.expect(found, "capture warning toast")
    testing.expect_eq(len(a.session_vars), 0, "no session vars")
    testing.expect_eq(a.resp_class, 0, "response still installed")
}

fn test_exec_send_captures_all_or_nothing() {
    a := new_app()
    stage_send(a, "http://x/users")
    a.pending_preq.captures = push(a.pending_preq.captures,
        model.KV{name: "GOOD", value: "$.data.id", enabled: true})
    a.pending_preq.captures = push(a.pending_preq.captures,
        model.KV{name: "BAD", value: "$.nope", enabled: true})
    r := fake_resp(200, "application/json", "{\"data\":{\"id\":\"u-42\"}}", nil)
    f := FakeSend{resp: r, fail: "", expect_path: ""}
    exec_send_t(a, f)
    testing.expect_eq(len(a.session_vars), 0, "partial capture not published")
}


fn test_exec_send_captures_publish_non_2xx() {
    a := new_app()
    stage_send(a, "http://x/users")
    a.pending_preq.captures = push(a.pending_preq.captures,
        model.KV{name: "UID", value: "$.data.id", enabled: true})
    r := fake_resp(500, "application/json", "{\"data\":{\"id\":\"u-500\"}}", nil)
    f := FakeSend{resp: r, fail: "", expect_path: ""}
    exec_send_t(a, f)
    lr := a.env.lookup("UID")
    testing.expect(lr.ok, "capture published on error status")
    testing.expect_streq(lr.value, "u-500", "non-2xx captured value")
}

fn test_exec_send_captures_non_json_body() {
    a := new_app()
    stage_send(a, "http://x/users")
    a.pending_preq.captures = push(a.pending_preq.captures,
        model.KV{name: "UID", value: "$.data.id", enabled: true})
    r := fake_resp(200, "text/plain", "not json", nil)
    f := FakeSend{resp: r, fail: "", expect_path: ""}
    exec_send_t(a, f)
    found := false
    i := 0
    for i < len(a.toasts) {
        if a.toasts[i].level == 0 && str_contains(a.toasts[i].msg, "Couldn't capture response") {
            found = true
        }
        i = i + 1
    }
    testing.expect(found, "non-json capture failure toast")
    testing.expect_eq(len(a.session_vars), 0, "non-json publishes nothing")
}

fn test_exec_send_captures_transport_failure() {
    a := new_app()
    stage_send(a, "http://x/users")
    a.pending_preq.captures = push(a.pending_preq.captures,
        model.KV{name: "UID", value: "$.data.id", enabled: true})
    f := FakeSend{resp: fake_resp(200, "application/json", "{\"data\":{\"id\":\"u-42\"}}", nil), fail: "boom", expect_path: ""}
    exec_send_t(a, f)
    testing.expect_eq(len(a.session_vars), 0, "transport failure publishes nothing")
}

// WI-0022 S8 — OAuth execution is staged after planning and before the
// resource transport send. One fake transport serves both endpoints so the
// test proves ordering, exact bearer injection, failure suppression, Forget,
// and secret sanitization without sockets.
struct FakeOAuthTransport {
    token_hits: shared,
    resource_hits: shared,
    fail_token: bool,
}

fn oauth_fake_resp(body: str) -> model.Resp {
    hs := mkslice(model.Header, 0)
    hs = push(hs, model.Header{name: "Content-Type", value: "application/json"})
    return model.Resp{status: 200, reason: "OK", headers: hs,
        body: body as []byte, elapsed_ms: 1.0, remote: "127.0.0.1:9",
        version: "1.1", req_head: "", hops: nil, trace: nil, tls_ver: 0}
}

fn (f FakeOAuthTransport) send(req: ref model.Req) -> [model.Resp, err] {
    if find(req.url, "/token") >= 0 {
        sadd(f.token_hits, 1)
        if f.fail_token {
            return oauth_fake_resp(""), errors.new("dial secret-token-material")
        }
        return oauth_fake_resp("{\"access_token\":\"oauth-access\",\"token_type\":\"Bearer\",\"expires_in\":3600}"), nil
    }
    sadd(f.resource_hits, 1)
    auths := 0
    i := 0
    for i < len(req.headers) {
        if ascii_eq(req.headers[i].name, "Authorization") {
            auths = auths + 1
            testing.expect_streq(req.headers[i].value, "Bearer oauth-access", "exact bearer wire header")
        }
        i = i + 1
    }
    testing.expect_eq(auths, 1, "exactly one authorization header")
    return fake_resp(200, "text/plain", "ok", nil), nil
}

fn oauth_preq() -> own collection.PRequest {
    pr := new(collection.PRequest)
    pr.method = "GET"
    pr.url = "https://api.example.test/data"
    pr.headers = push(pr.headers, model.KV{name: "Authorization", value: "Bearer stale", enabled: true})
    pr.headers = push(pr.headers, model.KV{name: "Authorization", value: "Bearer disabled", enabled: false})
    pr.auth = new(collection.PAuth)
    pr.auth.type = "oauth2"
    pr.auth.oauth2 = new(collection.POAuth2)
    pr.auth.oauth2.grant_type = "client_credentials"
    pr.auth.oauth2.token_url = "https://issuer.example.test/token"
    pr.auth.oauth2.client_id = "cid"
    pr.auth.oauth2.client_secret = "sec"
    pr.auth.oauth2.scope = "read"
    return pr
}

fn test_oauth_send_success_injects_one_bearer() {
    a := new_app()
    a.pending_preq = oauth_preq()
    fx := begin_send_preq(a)
    testing.expect_eq(fx, ESend, "oauth request plans")
    testing.expect(a.pending_oauth != nil, "oauth plan staged")
    tr := FakeOAuthTransport{token_hits: mkshared(0), resource_hits: mkshared(0), fail_token: false}
    exec_send_t(a, tr)
    testing.expect_eq(sget(tr.token_hits), 1, "token endpoint hit once")
    testing.expect_eq(sget(tr.resource_hits), 1, "resource sent once")
    testing.expect_streq(a.resp_body, "ok", "resource response installed")
    testing.expect(len(a.oauth_status) > 0, "safe oauth status visible")
    saw_mem := false
    i := 0
    for i < len(a.toasts) {
        if str_contains(a.toasts[i].msg, "session only") {
            saw_mem = true
        }
        i = i + 1
    }
    testing.expect(saw_mem, "memory-only warning toasted")
    // saved/draft YAML carries no runtime token
    testing.expect(!str_contains(a.history[0].req_yaml, "oauth-access"), "history yaml has no token")

    a.pending_preq = oauth_preq()
    fx_reuse := begin_send_preq(a)
    testing.expect_eq(fx_reuse, ESend, "second oauth request plans")
    exec_send_t(a, tr)
    testing.expect_eq(sget(tr.token_hits), 1, "second send reuses session token")
    testing.expect_eq(sget(tr.resource_hits), 2, "second resource send occurs")
}

fn test_oauth_failure_prevents_resource_and_sanitizes() {
    a := new_app()
    a.pending_preq = oauth_preq()
    fx := begin_send_preq(a)
    testing.expect_eq(fx, ESend, "oauth request plans")
    tr := FakeOAuthTransport{token_hits: mkshared(0), resource_hits: mkshared(0), fail_token: true}
    exec_send_t(a, tr)
    testing.expect_eq(sget(tr.token_hits), 1, "token endpoint attempted")
    testing.expect_eq(sget(tr.resource_hits), 0, "resource not sent after oauth failure")
    testing.expect(!str_contains(a.resp_view.lines[0], "secret-token-material"), "raw transport detail suppressed")
    testing.expect_eq(len(a.history), 0, "oauth failure is not history")
}

fn test_forget_oauth_token_palette_behavior() {
    a := new_app()
    a.pending_preq = oauth_preq()
    fx := begin_send_preq(a)
    testing.expect_eq(fx, ESend, "oauth request plans")
    tr := FakeOAuthTransport{token_hits: mkshared(0), resource_hits: mkshared(0), fail_token: false}
    exec_send_t(a, tr)
    testing.expect_eq(len(a.oauth_mgr.entries), 1, "session token cached")
    // forget plans from the live draft; stage the same draft fields used by
    // oauth_preq for this focused fixture.
    a.url.text = "https://api.example.test/data"
    a.preq = oauth_preq()
    oauth_seed(a, a.preq)
    fx2 := forget_oauth(a)
    testing.expect_eq(fx2, ENone, "forget consumes no effect")
    testing.expect_eq(len(a.oauth_mgr.entries), 0, "exact session token forgotten")
    items := palette_filtered(a)
    saw_forget := false
    saw_fake_signin := false
    i := 0
    for i < len(items) {
        if items[i].name == "Forget OAuth token" {
            saw_forget = true
        }
        if items[i].name == "OAuth sign-in" {
            saw_fake_signin = true
        }
        i = i + 1
    }
    testing.expect(saw_forget, "oauth palette has real forget row")
    testing.expect(!saw_fake_signin, "fake OAuth sign-in row removed")

    plain := new_app()
    plain_items := palette_filtered(plain)
    saw_plain_forget := false
    pi := 0
    for pi < len(plain_items) {
        if plain_items[pi].action == "forget-oauth" {
            saw_plain_forget = true
        }
        pi = pi + 1
    }
    testing.expect(!saw_plain_forget, "forget row hidden for non-oauth drafts")
}
