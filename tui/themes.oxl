package main

// S11 themes — corpus §2.2 theme pipeline: the 37-entry builtin
// catalog (terma v0.27.0 names + hex, registry order verbatim),
// user-theme YAML decode + directory scan, theme/gradient picker
// row builders. Theme slots hold ANSI-8 ids quantized from hex
// at load; the hex table below stays byte-verbatim for audit.

import "std/os"

import "std/errors"

import "github.com/oxidean/oxttp/core/yaml"

// ---------- hex → ansi ----------

fn hex_digit(c: int) -> int {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    if c >= 65 && c <= 70 {
        return c - 55
    }
    return -1
}

// hex_pair decodes the 2 hex digits at h[i..i+2] — callers must
// have run theme_colour_ok first (digits are validated there).
fn hex_pair(h: str, i: int) -> int {
    return hex_digit(byteat(h, i)) * 16 + hex_digit(byteat(h, i + 1))
}

// the 8 standard xterm colours, spec palette verbatim:
// 0 #000000 1 #CD0000 2 #00CD00 3 #CDCD00
// 4 #0000EE 5 #CD00CD 6 #00CDCD 7 #E5E5E5
fn pal_chan(i: int, c: int) -> int {
    // c: 0 r, 1 g, 2 b
    if i == 0 {
        return 0
    }
    if i == 1 {
        if c == 0 { return 205 }
        return 0
    }
    if i == 2 {
        if c == 1 { return 205 }
        return 0
    }
    if i == 3 {
        if c == 2 { return 0 }
        return 205
    }
    if i == 4 {
        if c == 2 { return 238 }
        return 0
    }
    if i == 5 {
        if c == 1 { return 0 }
        return 205
    }
    if i == 6 {
        if c == 0 { return 0 }
        return 205
    }
    return 229
}

// quantize maps a hex colour to the nearest of the 8 standard
// xterm ids by squared RGB distance. "#rgb"/"#rrggbb"/"#rrggbbaa"
// (alpha ignored — deviation). Invalid → -1.
fn quantize(h: str) -> int {
    if !theme_colour_ok(h) {
        return -1
    }
    r := 0
    g := 0
    b := 0
    if len(h) == 4 {
        r = hex_digit(byteat(h, 1)) * 17
        g = hex_digit(byteat(h, 2)) * 17
        b = hex_digit(byteat(h, 3)) * 17
    } else {
        r = hex_pair(h, 1)
        g = hex_pair(h, 3)
        b = hex_pair(h, 5)
    }
    best := 0
    bestd := 2147483647
    i := 0
    for i < 8 {
        dr := r - pal_chan(i, 0)
        dg := g - pal_chan(i, 1)
        db := b - pal_chan(i, 2)
        d := dr * dr + dg * dg + db * db
        if d < bestd {
            bestd = d
            best = i
        }
        i = i + 1
    }
    return best
}

// ---------- builtin catalog (terma v0.27.0 registry order) ----------

