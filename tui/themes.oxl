}

fn quant_theme(h: ThemeHex) -> Theme {
    return Theme{name: h.name, is_light: h.is_light,
        primary: quantize(h.primary), secondary: quantize(h.secondary),
        accent: quantize(h.accent), warning: quantize(h.warning),
        error: quantize(h.error), success: quantize(h.success),
        text: quantize(h.text)}
}

// builtin_themes — all 37 entries quantized, registry order.
fn builtin_themes() -> []Theme {
    hs := theme_hexes()
    let out: []Theme = nil
    i := 0
    for i < len(hs) {
        out = push(out, quant_theme(hs[i]))
        i = i + 1
    }
    return out
}

// theme_index finds a theme by name in a slice → -1 when absent.
fn theme_index(ts: []Theme, name: str) -> int {
    i := 0
    for i < len(ts) {
        if ts[i].name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

// theme_alias — upstream name-compat table verbatim:
// "" / "posting" / "textual-dark" → galaxy;
// catppuccin-{mocha,macchiato,frappe} → catppuccin;
// "textual-light" → catppuccin-latte.
fn theme_alias(name: str) -> str {
    if name == "" || name == "posting" || name == "textual-dark" {
        return "galaxy"
    }
    if name == "catppuccin-mocha" || name == "catppuccin-macchiato" || name == "catppuccin-frappe" {
        return "catppuccin"
    }
    if name == "textual-light" {
        return "catppuccin-latte"
    }
    return name
}

// ---------- user themes ----------

fn cerr(s: str) -> err {
    return errors.new(s)
}

// yaml scalars: kind 0 scalar, 1 map, 2 list (core/yaml).
fn ym_idx(n: ref yaml.YNode, key: str) -> int {
    if n == nil || n.kind != 1 {
        return -1
    }
    i := 0
    for i < len(n.pairs) {
        if n.pairs[i].key == key {
            return i
        }
        i = i + 1
    }
    return -1
}

fn yscal(n: ref yaml.YNode, key: str) -> str {
    i := ym_idx(n, key)
    if i < 0 || n.pairs[i].val.kind != 0 {
        return ""
    }
    return n.pairs[i].val.s
}

fn yhas(n: ref yaml.YNode, key: str) -> bool {
    return ym_idx(n, key) >= 0
}

// theme_colour_ok — upstream hexColour regex verbatim:
// ^#([0-9a-fA-F]{3}|{6}|{8})$.
fn theme_colour_ok(v: str) -> bool {
    n := len(v)
    if n != 4 && n != 7 && n != 9 {
        return false
    }
    if byteat(v, 0) != 35 {
        return false
    }
    i := 1
    for i < n {
        if hex_digit(byteat(v, i)) < 0 {
            return false
        }
        i = i + 1
    }
    return true
}

// theme_colour_err — "<field> colour "<v>" isn't a hex colour
// like #1e88e5" (upstream text verbatim).
fn theme_colour_err(field: str, v: str) -> err {
    return cerr(field + " colour \"" + v + "\" isn't a hex colour like #1e88e5")
}


fn name_blank(s: str) -> bool {
    i := 0
    for i < len(s) {
        c := byteat(s, i)
        if c != 32 && c != 9 && c != 10 && c != 13 {
            return false
        }
        i = i + 1
    }
    return true
}

// parse_user_theme decodes one user theme file (upstream
// themes.Parse): required name + primary; each present colour
// must match the hex regex; `dark` optional bool, unset → dark.
fn parse_user_theme(text: str) -> [own UserTheme, err] {
    u := new(UserTheme)
    [root, pe] = yaml.parse(text)
    if pe != nil {
        return u, pe
    }
    if root == nil || root.kind != 1 {
        return u, cerr("config must be a mapping")
    }
    u.name = yscal(root, "name")
    u.primary = yscal(root, "primary")
    u.secondary = yscal(root, "secondary")
    u.accent = yscal(root, "accent")
    u.background = yscal(root, "background")
    u.surface = yscal(root, "surface")
    u.panel = yscal(root, "panel")
    u.warning = yscal(root, "warning")
    u.error = yscal(root, "error")
    u.success = yscal(root, "success")
    u.text = yscal(root, "text")
    u.foreground = yscal(root, "foreground")
    if yhas(root, "dark") {
        dv := yscal(root, "dark")
        if dv == "true" {
            u.dark = true
            u.dark_set = true
        } else if dv == "false" {
            u.dark = false
            u.dark_set = true
        } else {
            return u, cerr("dark must be a bool")
        }
    }
    if name_blank(u.name) {
        return u, cerr("the theme has no name")
    }
    if len(u.primary) == 0 {
        return u, cerr("the theme has no primary colour")
    }
    // upstream iterates Colours() (map order is unstable there) —
    // we check in declaration order; same set, same error shape.
    if len(u.primary) > 0 && !theme_colour_ok(u.primary) { return u, theme_colour_err("primary", u.primary) }
    if len(u.secondary) > 0 && !theme_colour_ok(u.secondary) { return u, theme_colour_err("secondary", u.secondary) }
    if len(u.accent) > 0 && !theme_colour_ok(u.accent) { return u, theme_colour_err("accent", u.accent) }
    if len(u.background) > 0 && !theme_colour_ok(u.background) { return u, theme_colour_err("background", u.background) }
    if len(u.surface) > 0 && !theme_colour_ok(u.surface) { return u, theme_colour_err("surface", u.surface) }
    if len(u.panel) > 0 && !theme_colour_ok(u.panel) { return u, theme_colour_err("panel", u.panel) }
    if len(u.warning) > 0 && !theme_colour_ok(u.warning) { return u, theme_colour_err("warning", u.warning) }
    if len(u.error) > 0 && !theme_colour_ok(u.error) { return u, theme_colour_err("error", u.error) }
    if len(u.success) > 0 && !theme_colour_ok(u.success) { return u, theme_colour_err("success", u.success) }
    if len(u.text) > 0 && !theme_colour_ok(u.text) { return u, theme_colour_err("text", u.text) }
    if len(u.foreground) > 0 && !theme_colour_ok(u.foreground) { return u, theme_colour_err("foreground", u.foreground) }
    return u, nil
}

// build_user_theme — registerUserThemes verbatim: base = galaxy
// (dark) or catppuccin-latte (light); set fields override.
// foreground applies first, text second (text wins, like upstream
// option order). background/surface/panel have no ANSI-8 slot —
// validated but not carried (deviation recorded).
fn build_user_theme(u: ref UserTheme) -> Theme {
    bs := builtin_themes()
    bi := theme_index(bs, "galaxy")
    light := u.dark_set && !u.dark
    if light {
        bi = theme_index(bs, "catppuccin-latte")
    }
    t := bs[bi]
    t.name = u.name
    t.is_light = light
    if len(u.primary) > 0 { t.primary = quantize(u.primary) }
    if len(u.secondary) > 0 { t.secondary = quantize(u.secondary) }
    if len(u.accent) > 0 { t.accent = quantize(u.accent) }
    if len(u.warning) > 0 { t.warning = quantize(u.warning) }
    if len(u.error) > 0 { t.error = quantize(u.error) }
    if len(u.success) > 0 { t.success = quantize(u.success) }
    if len(u.foreground) > 0 { t.text = quantize(u.foreground) }
    if len(u.text) > 0 { t.text = quantize(u.text) }
    return t
}

// scan_user_themes — upstream themes.LoadDir: missing dir →
// empty; *.yaml|*.yml only, subdirs skipped; parse errors push
// "Couldn't load theme <file>: <err>" (the main.go wrap baked in
// — startup toasts take these strings verbatim); themes sorted
// by name.
fn scan_user_themes(dir: str) -> ThemeScan {
    sc := ThemeScan{themes: nil, problems: nil}
    if len(dir) == 0 || !os.isdir(dir) {
        return sc
    }
    names := os.ls(dir)
    i := 0
    for i < len(names) {
        n := names[i]
        i = i + 1
        is_yaml := false
        if len(n) > 5 && substr(n, len(n) - 5, len(n)) == ".yaml" {
            is_yaml = true
        }
        if len(n) > 4 && substr(n, len(n) - 4, len(n)) == ".yml" {
            is_yaml = true
        }
        if !is_yaml || os.isdir(dir + "/" + n) {
            continue
        }
        text := os.readfile_(dir + "/" + n)
        [u, e] = parse_user_theme(text)
        if e != nil {
            sc.problems = push(sc.problems, "Couldn't load theme " + n + ": " + errors.msg(e))
            continue
        }
        sc.themes = push(sc.themes, build_user_theme(u))
    }
    // sort by theme name (insertion — file count is small)
    i = 1
    for i < len(sc.themes) {
        j := i
        for j > 0 && str_lt(sc.themes[j].name, sc.themes[j - 1].name) {
            tmp := sc.themes[j - 1]
            sc.themes[j - 1] = sc.themes[j]
            sc.themes[j] = tmp
            j = j - 1
        }
        i = i + 1
    }
    return sc
}

fn str_lt(a: str, b: str) -> bool {
    n := len(a)
    if len(b) < n {
        n = len(b)
    }
    i := 0
    for i < n {
        ca := byteat(a, i)
        cb := byteat(b, i)
        if ca != cb {
            return ca < cb
        }
        i = i + 1
    }
    return len(a) < len(b)
}

// ---------- picker rows ----------
// theme_rows/gradient_rows build the modal lists. Sections are
// label rows ("── Yours ──" style markers are embedded as text;
// the modal renders rows verbatim and cursor skips headers).

fn theme_rows(a: ref App) -> []str {
    let rows: []str = nil
    nb := 0
    if a.st != nil && a.st.load_builtin_themes {
        nb = 1
    } else if a.st == nil {
        nb = 1
    }
    if len(a.user_themes) > 0 {
        rows = push(rows, "─ Yours ─")
        i := 0
        for i < len(a.user_themes) {
            rows = push(rows, a.user_themes[i].name)
            i = i + 1
        }
    }
    if nb == 1 {
        bs := builtin_themes()
        rows = push(rows, "─ Dark ─")
        i := 0
        for i < len(bs) {
            if !bs[i].is_light {
                rows = push(rows, bs[i].name)
            }
            i = i + 1
        }
        rows = push(rows, "─ Light ─")
        i = 0
        for i < len(bs) {
            if bs[i].is_light {
                rows = push(rows, bs[i].name)
            }
            i = i + 1
        }
    }
    return rows
}

fn gradient_rows(a: ref App) -> []str {
    rows := mkslice(str, 0)
    rows = push(rows, "theme")
    rows = push(rows, "off")
    i := 0
    for i < len(a.user_themes) {
        rows = push(rows, a.user_themes[i].name)
        i = i + 1
    }
    nb := true
    if a.st != nil && !a.st.load_builtin_themes {
        nb = false
    }
    if nb {
        bs := builtin_themes()
        i = 0
        for i < len(bs) {
            rows = push(rows, bs[i].name)
            i = i + 1
        }
    }
    return rows
}

// theme_lookup resolves a name across user themes first (same-name
// user theme replaces the builtin row), then builtins.
fn theme_lookup(a: ref App, name: str) -> [Theme, err] {
    i := theme_index(a.user_themes, name)
    if i >= 0 {
        return a.user_themes[i], nil
    }
    bs := builtin_themes()
    i = theme_index(bs, name)
    if i >= 0 {
        return bs[i], nil
    }
    return Theme{name: "", is_light: false, primary: -1, secondary: -1,
        accent: -1, warning: -1, error: -1, success: -1, text: -1},
        errors.new("unknown theme " + name)
}

// ---------- nerd fonts ----------

// use_nerd_fonts — upstream Settings.UseNerdFonts verbatim:
// set → that value; else true when TERM_PROGRAM≈ghostty
// (EqualFold) | TERM=xterm-ghostty | GHOSTTY_RESOURCES_DIR set
// (empty counts upstream; os.getenv can't see it — deviation).
fn use_nerd_fonts(mode: int, term_program: str, term: str, ghostty_dir: str) -> bool {
    if mode == 1 {
        return true
    }
    if mode == 0 {
        return false
    }
    if str_equalfold(term_program, "ghostty") || term == "xterm-ghostty" {
        return true
    }
    return len(ghostty_dir) > 0
}

fn str_equalfold(a: str, b: str) -> bool {
    return lower_ascii(a) == lower_ascii(b)
}
