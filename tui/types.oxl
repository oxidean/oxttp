package main

// All struct + const declarations live in types.oxl — the C backend
// emits value-typed struct fields in file order, so embedding types
// must be declared before embedders (App embeds every widget type).
// Order here is the dependency order.

import "github.com/oxidean/oxttp/core/collection"
import "github.com/oxidean/oxttp/core/config"
import "github.com/oxidean/oxttp/core/env"
import "github.com/oxidean/oxttp/core/model"

struct LineEdit {
    text: str,
    cur: int,
    sel_anchor: int,
    undo_text: str,
    undo_cur: int,
    has_undo: bool,
    redo_text: str,
    redo_cur: int,
    has_redo: bool,
}

struct ListCur {
    sel: int,
    count: int,
    anchor: int, // -1 = no extended selection
    top: int,    // scroll offset
}

struct TabStrip {
    sel: int,
    count: int,
}

struct KVRow {
    name: str,
    value: str,
    enabled: bool,
}

struct KVTable {
    rows: []KVRow,
    cur: int,
    col: int,       // 0 name, 1 value
    editing: bool,
    edit: LineEdit,
}

struct TreeNode {
    name: str,
    depth: int,
    is_dir: bool,
    open: bool,
    stub: bool, // placeholder rows render dimmed
    path: str,  // fs path — collection file/folder, "" for stub rows
    kind: str,  // request kind (graphql/grpc/websocket) for badges
    err: str,   // malformed-file error text (corpus placeholder rows)
}

struct Tree {
    nodes: []TreeNode,
    cur: int,
    anchor: int,
    filter: str,
}

struct TextView {
    lines: []str,
    cx: int,
    cy: int,
    top: int,
    anchor_x: int, // -1 = no visual selection
    anchor_y: int,
    search: str,
    search_hits: []int, // line indices
    search_idx: int,
}

struct Toast {
    level: int, // 0 info, 1 success, 2 error
    msg: str,
}

// RDraft is one open request editor's full snapshot — corpus §4.5/§8.6:
// every open tab is an INDEPENDENT request draft (url, method/kind,
// headers/query/path tables, body, and its response buffer).
// S10 adds the backing file path, the decoded request (read-only
// auth/options panes render it; sends merge live fields over it), and
// per-response-tab row sets.
struct RDraft {
    url: LineEdit,
    method: str,
    kind: int,
    req_tab: int,
    resp_tab: int,
    body_ct: int,
    headers: KVTable,
    query_kv: KVTable,
    path_kv: KVTable,
    body: TextView,
    resp_view: TextView,
    resp_rows: ListCur,
    resp_body: str,  // received body text (resp_view may re-indent it)
    resp_hdr_rows: []str,
    resp_ck_rows: []str,
    resp_tr_rows: []str,
    resp_title: str,
    resp_class: int, // status_class for title color; -1 = no response
    path: str,       // backing .posting.yaml — "" = unsaved
    auth_text: str,  // read-only Auth pane render
    opts_text: str,  // read-only Options pane render
    info_text: str,  // Info pane render (description et al.)
    preq: own collection.PRequest,
    resp_size: int,
    elapsed_ms: float,
}

// HistEnt is one in-memory history record (corpus §5.3 — S10 keeps
// history session-only, cap 100, deviation listed in spec).
struct HistEnt {
    id: int,
    persisted: bool,   // entry exists in the disk file — delete may touch it
    title: str,
    method: str,
    url: str,
    status: int,
    reason: str,
    elapsed_ms: float,
    size: int,
    req_yaml: str,      // marshaled request-as-drafted — re-decodes on open
    resp_text: str,
    resp_hdr_rows: []str,
    resp_ck_rows: []str,
    resp_tr_rows: []str,
}

struct RTab {
    title: str,
    preview: bool,
    draft: RDraft,
}

struct PItem {
    name: str,
    action: str,
    degrade: str, // non-empty → toast this instead of running action
}

// JarEnt is one jar cookie: "name=value" scoped to the origin that
// set it — sends attach only entries matching the request origin.
struct JarEnt {
    origin: str,
    nv: str,
}

// Theme is a resolved app theme (corpus §2.2): slots hold ANSI-8
// ids quantized from the catalog/user hex at load.
struct Theme {
    name: str,
    is_light: bool,
    primary: int,
    secondary: int,
    accent: int,
    warning: int,
    error: int,
    success: int,
    text: int,
}

// ThemeHex carries the upstream terma hex strings verbatim — the
// builtin table is auditable against the registry; builtin_themes
// quantizes each row into Theme slots.
struct ThemeHex {
    name: str,
    is_light: bool,
    primary: str,
    secondary: str,
    accent: str,
    warning: str,
    error: str,
    success: str,
    text: str,
}

// ThemeScan is scan_user_themes' result: parsed themes plus the
// per-file problem strings (upstream main.go wraps each into a
// startup toast).
struct ThemeScan {
    themes: []Theme,
    problems: []str,
}

// UserTheme is the posting-2 user theme file shape — colours stay
// strings until validated+quantized; dark unset → dark.
struct UserTheme {
    name: str,
    dark: bool,
    dark_set: bool,
    primary: str,
    secondary: str,
    accent: str,
    background: str,
    surface: str,
    panel: str,
    warning: str,
    error: str,
    success: str,
    text: str,
    foreground: str,
}

struct App {
    focus: int,
    modals: []int,
    quit: bool,
    want_shot: bool,

    url: LineEdit,
    method: str,
    kind: int,
    method_sel: int, // cursor inside method menu

    req_tab: int,
    resp_tab: int,
    tabs: []RTab,
    cur_tab: int,

    sidebar_on: bool,
    sidebar_pos: int, // 0 left 1 right
    layout: int,      // 0 vertical 1 horizontal
    expanded: int,    // 0 none 1 request 2 response

    coll: Tree,
    coll_search: LineEdit,
    coll_searching: bool,
    coll_dir: str,
    env_name: str,
    env_active: []str,
    env_named_only: bool, // picker/remembered picks resolve names, never files
    env_names: []str,
    env: own env.EnvSet,
    session_vars: []model.KV,
    jar: []JarEnt,
    history: []HistEnt,
    pending: own model.Req,
    pending_preq: own collection.PRequest,
    pending_name: str,
    sending: bool,
    var_rows: []str,
    vars: ListCur,
    vars_filter: LineEdit,
    vars_filtering: bool,
    vars_reveal: bool,
    hist: ListCur,

    headers: KVTable,
    query_kv: KVTable,
    path_kv: KVTable,
    body: TextView,      // editable-ish area is simplified to view+append
    body_edit: bool,
    body_ct: int,        // 0 json 1 text 2 xml 3 html
    resp_view: TextView,
    resp_rows: ListCur,
    resp_body: str,      // received body text — save-response writes this
    resp_hdr_rows: []str,
    resp_ck_rows: []str,
    resp_tr_rows: []str,
    resp_title: str,
    resp_class: int,
    path: str,           // live draft backing file (mirrors RDraft.path)
    auth_text: str,
    opts_text: str,
    info_text: str,
    preq: own collection.PRequest,
    resp_size: int,
    elapsed_ms: float,
    confirm_arg: str,
    pal_query: LineEdit,
    pal_sel: int,
    tabsearch: ListCur,
    save_name: LineEdit,
    save_file: LineEdit,
    save_folder: LineEdit,
    save_desc: LineEdit,
    save_field: int,
    confirm_msg: str,
    confirm_action: str,

    toasts: []Toast,
    hinted_vars: bool,  // '$' suggestion degrade shown once

    // --- S11 config-driven state (corpus §2.2 apply site) ---
    st: own config.Settings, // loaded settings (nil until apply_settings)
    cwd: str,             // env/search root — os cwd at launch; tests override
    cfg_dir: str,         // config dir seam ("" → config.config_dir())
    data_dir: str,        // data dir seam ("" → config.data_dir())
    env_recalled: bool,   // remembered env applied at first load
    exit_code: int,       // -h/-v/bad-flag exit paths (-1 = run the TUI)
    exit_text: str,
    theme: Theme,         // resolved theme (ansi slots)
    theme_name: str,      // configured name after alias resolve
    gradient: int,        // 0 = theme, 1 = off, 2 = named
    gradient_name: str,
    user_themes: []Theme,
    th_sel: int,          // cursor in theme/gradient pickers
    th_snap: Theme,       // escape-restore snapshot (preview mode)
    th_snap_name: str,
    th_snap_grad: int,
    th_snap_gname: str,
    theme_preview: bool,  // command_palette.theme_preview
    env_files: []str,     // active env file stack (switcher/memory)
    hist_disk: bool,      // history.enabled
    nerd_icons: bool,     // resolved nerd_fonts
    blink: bool,          // text_input.blinking_cursor
    heading_on: bool,
    heading_host: bool,
    heading_ver: bool,
    heading_hostname: str,
    url_preview_on: bool, // url_bar.show_value_preview
    url_mask_secrets: bool, // url_bar secrets-in-preview gate
    focus_open: str,      // focus.on_request_open
    focus_resp: str,      // focus.on_response
    focus_start: str,     // focus.on_startup
    resp_prettify: bool,  // response.prettify_json
    resp_size_time: bool, // response.show_size_and_time
    ssl_ca: str,
    ssl_cert: str,
    ssl_key: str,
    ssl_pass: str,
    editor: str,
    fileman: str,
    pager: str,
    pager_json: str,
    curl_args: str,       // curl_export_extra_args
    reb_specs: []str,     // config keymap: canonical key spec → action
    reb_actions: []str,
    curl_in: LineEdit,    // import-curl modal input
    sresp_in: LineEdit,   // save-response modal input
    var_edit: LineEdit,   // variables-edit modal input
    var_edit_name: str,   // edit-mode row name; "" = add-mode NAME=VALUE
    vsug_on: bool,        // $-suggestion list live under the url bar
    vsug_sel: int,
    vsug_pos: int,        // url byte index of the activating '$'
    ext_cmd: str,         // pending external command (EExt effect)
    ext_file: str,        // staged per-op temp file; removed after the run
    ext_edit: bool,       // editor op — file loads back into ext_tab's body
    ext_tab: int,         // originating tab for the write-back (-1 none)
    env_flagged: bool,    // a -e/--env was given on the command line

    // hit-test rects cached from last render (mouse dispatch)
    r_sidebar_x: int, r_sidebar_w: int,
    r_sidebar_y: int, r_sidebar_h: int,
    r_url_y: int, r_url_h: int,
    r_req_x: int, r_req_y: int, r_req_w: int, r_req_h: int,
    r_resp_x: int, r_resp_y: int, r_resp_w: int, r_resp_h: int,
    r_main_x: int, r_main_w: int,
}

// Focus targets (corpus focus.* config maps onto these).
let FSidebar = 0
let FUrl = 1
let FMethod = 2
let FReqTabs = 3
let FReqPane = 4
let FRespTabs = 5
let FRespPane = 6

// Request kinds — tab sets switch per §4.1.
let KHttp = 0
let KGraphql = 1
let KGrpc = 2
let KWs = 3

// Modal frame kinds (§4.12 overlay stack + jump/method/search states).
let MNone = 0
let MPalette = 1
let MHelp = 2
let MVariables = 3
let MConfirm = 4
let MSaveReq = 5
let MSearchTabs = 6
let MHistory = 7
let MMethodMenu = 8
let MJump = 9
let MEnvSwitch = 10
let MTheme = 11
let MGradient = 12
let MCurl = 13
let MSaveResp = 14
let MVarEdit = 15

// dispatch effects returned to the loop.
let ENone = 0
let EQuit = 1
let ESend = 2
let EExt = 3 // run a.ext_cmd outside the alt screen (editor/pager/tools)


// RTab is one open request-editor tab (new-request/close-tab/next-tab).

// Palette item — §4.13 contents; action runs via global/degrade paths.


