package main

// Render — layout rects + region renderers (spec §Render/layout).
// Draws into the term.Screen cell buffer; hit-test rects are cached
// on App so dispatch_mouse can resolve clicks without re-layout.
//
// Rows: 0 header · 1..3 URL bar (method cell + url + preview) ·
// 4..h-2 body (sidebar + main split) · h-1 footer. Toasts stack
// above the footer; modals paint a centered overlay last.

import "std/os"

import "std/errors"

import "github.com/oxidean/oxttp/core/term"

// palette ids (8-color SGR): 1 red, 2 green, 3 yellow, 4 blue,
// 5 magenta, 6 cyan, 7 white — attrs from term.Attr*.

// rune_at decodes the codepoint of the glyph at byte offset i —
// called only after term.glyph_len validated the sequence.
fn rune_at(s: str, i: int) -> int {
    c := byteat(s, i)
    if c < 128 {
        return c
    }
    if c < 224 {
        return (c - 192) * 64 + byteat(s, i + 1) - 128
    }
    if c < 240 {
        return (c - 224) * 4096 + (byteat(s, i + 1) - 128) * 64 + byteat(s, i + 2) - 128
    }
    return (c - 240) * 262144 + (byteat(s, i + 1) - 128) * 4096 + (byteat(s, i + 2) - 128) * 64 + byteat(s, i + 3) - 128
}

// glyph_cols — display width in cells of the glyph at s[i] (gl
// bytes): 1 for narrow/invalid, 2 for the standard wcwidth wide
// ranges (decimal literals; hex in comments).
fn glyph_cols(s: str, i: int, gl: int) -> int {
    if gl <= 1 {
        return 1
    }
    cp := rune_at(s, i)
    if cp >= 4352 && cp <= 4447 { // 0x1100..0x115F
        return 2
    }
    if cp == 9001 || cp == 9002 { // 0x2329/0x232A
        return 2
    }
    if cp >= 11904 && cp <= 42191 && cp != 12351 { // 0x2E80..0xA4CF !0x303F
        return 2
    }
    if cp >= 44032 && cp <= 55203 { // 0xAC00..0xD7A3
        return 2
    }
    if cp >= 63744 && cp <= 64255 { // 0xF900..0xFAFF
        return 2
    }
    if cp >= 65072 && cp <= 65135 { // 0xFE30..0xFE6F
        return 2
    }
    if cp >= 65280 && cp <= 65376 { // 0xFF00..0xFF60
        return 2
    }
    if cp >= 65504 && cp <= 65510 { // 0xFFE0..0xFFE6
        return 2
    }
    if cp >= 127744 && cp <= 129791 { // 0x1F300..0x1FAFF emoji
        return 2
    }
    if cp >= 131072 && cp <= 262141 { // 0x20000..0x3FFFD
        return 2
    }
    return 1
}

// str_cols — total display columns of s (sum of glyph widths).
fn str_cols(s: str) -> int {
    n := 0
    i := 0
    for i < len(s) {
        gl := term.glyph_len(s, i)
        n = n + glyph_cols(s, i, gl)
        i = i + gl
    }
    return n
}

// put_str_max writes s clipped to `max` display columns, iterating
// GLYPHS never bytes: multibyte chars land whole in cells, and a
// 2-column glyph that doesn't fit is dropped — never half-drawn.
fn put_str_max(scr: mut term.AnsiScreen, x: int, y: int, s: str, max: int, fg: int, attr: int) {
    i := 0
    cx := x
    end := x + max
    for i < len(s) && cx < end {
        gl := term.glyph_len(s, i)
        w := glyph_cols(s, i, gl)
        if cx + w > end {
            return
        }
        scr.set_cell(cx, y, substr(s, i, i + gl), fg, -1, attr)
        if w == 2 {
            scr.set_wide_cont(cx + 1, y)
        }
        cx = cx + w
        i = i + gl
    }
}

fn put_str(scr: mut term.AnsiScreen, x: int, y: int, s: str, fg: int, attr: int) {
    put_str_max(scr, x, y, s, scr.cols - x, fg, attr)
}

fn fill_row(scr: mut term.AnsiScreen, x: int, y: int, w: int, ch: str, fg: int, attr: int) {
    i := 0
    for i < w {
        scr.set_cell(x + i, y, ch, fg, -1, attr)
        i = i + 1
    }
}

// draw_pane draws an ascii frame + title; focused panes get a bold
// title in the theme's primary colour (pc), idle panes a dim one.
fn draw_pane(scr: mut term.AnsiScreen, x: int, y: int, w: int, h: int, title: str, focused: bool, pc: int) {
    if w < 3 || h < 3 {
        return
    }
    ta := term.AttrDim
    tf := 7
    if focused {
        ta = term.AttrBold
        tf = pc
    }
    i := 0
    for i < w {
        scr.set_cell(x + i, y, "-", 7, -1, ta)
        scr.set_cell(x + i, y + h - 1, "-", 7, -1, ta)
        i = i + 1
    }
    j := 0
    for j < h {
        scr.set_cell(x, y + j, "|", 7, -1, ta)
        scr.set_cell(x + w - 1, y + j, "|", 7, -1, ta)
        j = j + 1
    }
    scr.set_cell(x, y, "+", 7, -1, ta)
    scr.set_cell(x + w - 1, y, "+", 7, -1, ta)
    scr.set_cell(x, y + h - 1, "+", 7, -1, ta)
    scr.set_cell(x + w - 1, y + h - 1, "+", 7, -1, ta)
    if len(title) > 0 {
        put_str_max(scr, x + 2, y, " " + title + " ", w - 4, tf, ta)
    }
}

fn render_header(a: ref App, scr: mut term.AnsiScreen, ver: str) {
    env := a.env_name
    if len(env) == 0 {
        env = "(none)"
    }
    // heading.*: visible gates the row; hostname text replaces the
    // composition wholesale; show_version/show_host trim the pieces.
    s := " oxttp-tui"
    if a.heading_ver {
        s = s + " " + ver
    }
    s = s + " · env " + env
    if len(a.heading_hostname) > 0 {
        s = s + " · " + a.heading_hostname
    } else if a.heading_host {
        host := os.getenv("HOSTNAME")
        user := os.getenv("USER")
        if len(user) > 0 && len(host) > 0 {
            s = s + " · " + user + "@" + host
        }
    }
    put_str(scr, 0, 0, s, a.theme.secondary, term.AttrBold)
}

fn render_url_bar(a: mut App, scr: mut term.AnsiScreen, cols: int) {
    // method cell (clickable → method menu), then the url line-edit,
    // then a dim preview row (verbatim until vars land S10).
    mw := 10
    // the field h-scrolls to keep the insertion point visible: off is
    // the byte offset the window starts at — walk back from cur until
    // one more glyph would push the cursor past the field's last
    // column (avail-1 leaves the cursor its own cell).
    avail := cols - mw - 3
    off := 0
    vis := 0
    j := a.url.cur
    for j > 0 {
        g0 := glyph_start(a.url.text, j - 1)
        w2 := str_cols(substr(a.url.text, g0, j))
        if vis + w2 > avail - 1 {
            break
        }
        vis = vis + w2
        off = g0
        j = g0
    }
    put_str_max(scr, 1, 1, "[" + a.method + "]", mw - 1, a.theme.accent, term.AttrBold)
    put_str_max(scr, mw + 2, 1, substr(a.url.text, off, len(a.url.text)), avail, 7, 0)
    // url_bar.show_value_preview=false hides the substituted preview.
    if a.url_preview_on {
        prev := url_preview(a)
        put_str_max(scr, 2, 2, "→ " + prev, cols - 4, 7, term.AttrDim)
    }
    fill_row(scr, 0, 3, cols, "-", 7, term.AttrDim)
    // $-suggestions float under the bar while the list is live.
    if a.vsug_on {
        ns := vsug_names(a)
        i := 0
        for i < len(ns) && i < 5 {
            a2 := 0
            if i == a.vsug_sel {
                a2 = term.AttrReverse
            }
            put_str_max(scr, mw + 2, 3 + i, " " + ns[i] + " ", 24, a.theme.accent, a2)
            i = i + 1
        }
    }
    // text_input.blinking_cursor=false hides the cursor (no blink
    // pulse — static-on otherwise, deviation).
    if a.focus == FUrl && a.blink {
        cx := mw + 2 + vis
        if cx >= cols {
            cx = cols - 1
        }
        scr.cursor(cx, 1, true)
    }
}

fn render_tabstrip(scr: mut term.AnsiScreen, x: int, y: int, w: int, names: []str, sel: int, focused: bool) {
    cx := x + 1
    i := 0
    for i < len(names) {
        n := names[i]
        a := 0
        f := 7
        if i == sel {
            a = term.AttrReverse
            if focused {
                a = term.AttrReverse + term.AttrBold
            }
        } else {
            a = term.AttrDim
        }
        put_str_max(scr, cx, y, " " + n + " ", x + w - 1 - cx, f, a)
        cx = cx + len(n) + 2
        if cx >= x + w - 1 {
            return
        }
        i = i + 1
    }
}

fn render_kv(scr: mut term.AnsiScreen, t: KVTable, x: int, y: int, w: int, h: int, focused: bool) {
    put_str(scr, x + 1, y, " [x] name           value", 7, term.AttrBold + term.AttrUnderline)
    // scroll so the selected row stays inside the window — toggle and
    // delete act on cur even when it sits past the last drawn row.
    visible := h - 1
    top := 0
    if t.cur >= visible {
        top = t.cur - visible + 1
    }
    i := top
    for i < len(t.rows) && i < top + visible {
        r := t.rows[i]
        mark := "[ ]"
        if r.enabled {
            mark = "[x]"
        }
        line := " " + mark + " " + r.name
        for len(line) < 20 {
            line = line + " "
        }
        line = line + r.value
        a := 0
        if focused && i == t.cur {
            a = term.AttrReverse
        }
        put_str_max(scr, x + 1, y + 1 + (i - top), line, w - 2, 7, a)
        i = i + 1
    }
}

fn render_sidebar(a: mut App, scr: mut term.AnsiScreen, x: int, y: int, w: int, h: int) {
    draw_pane(scr, x, y, w, h, "collection", a.focus == FSidebar, a.theme.primary)
    put_str_max(scr, x + 2, y + 1, a.env_name, w - 4, 3, 0)
    vis := a.coll.visible()
    i := 0
    vi := 0
    for vi < len(vis) && i < h - 3 {
        n := a.coll.nodes[vis[vi]]
        pad := ""
        d := 0
        for d < n.depth {
            pad = pad + "  "
            d = d + 1
        }
        glyph := "· "
        if n.is_dir {
            if n.open {
                glyph = "▾ "
            } else {
                glyph = "▸ "
            }
        }
        // nerd_fonts resolves icon slots on the sidebar glyphs only
        // (deviation 15): folder/file get nerd glyphs, the ASCII
        // fallback is the triangle set above.
        if a.nerd_icons {
            if n.is_dir {
                if n.open {
                    glyph = " "
                } else {
                    glyph = " "
                }
            } else {
                glyph = " "
            }
        }
        a2 := 0
        f := 7
        if n.stub {
            a2 = term.AttrDim
        }
        if a.focus == FSidebar && vis[vi] == a.coll.cur {
            a2 = a2 | term.AttrReverse
        }
        put_str_max(scr, x + 1, y + 2 + i, pad + glyph + n.name, w - 2, f, a2)
        i = i + 1
        vi = vi + 1
    }
    if a.coll_searching {
        put_str_max(scr, x + 1, y + h - 2, "/" + a.coll_search.text, w - 2, 3, 0)
    }
    // sidebar_gradient: off = nothing; else a right-edge ramp in the
    // gradient theme's primary — top cells lit, bottom dim (the
    // ANSI-8 "gradient" is a dim-ramp approximation, deviation 3).
    if a.gradient != 1 && w > 6 && h > 4 {
        gc := a.theme.primary
        if a.gradient == 2 {
            [gt, ge] = theme_lookup(a, a.gradient_name)
            if ge == nil {
                gc = gt.primary
            }
        }
        i = 0
        for i < h - 2 {
            ga := 0
            if i > (h - 2) / 2 {
                ga = term.AttrDim
            }
            scr.set_cell(x + w - 2, y + 1 + i, "┃", gc, -1, ga)
            i = i + 1
        }
    }
}

fn render_req_pane(a: mut App, scr: mut term.AnsiScreen, x: int, y: int, w: int, h: int) {
    focused := a.focus == FReqPane || a.focus == FReqTabs
    title := "request"
    names := req_tabs(a.kind)
    cur := names[a.req_tab]
    draw_pane(scr, x, y, w, h, title + " · " + cur, focused, a.theme.primary)
    render_tabstrip(scr, x, y + 1, w, names, a.req_tab, a.focus == FReqTabs)
    cy := y + 2
    ch := h - 3
    if cur == "Headers" {
        render_kv(scr, a.headers, x, cy, w, ch, a.focus == FReqPane)
    } else if cur == "Query" {
        render_kv(scr, a.query_kv, x, cy, w, ch, a.focus == FReqPane)
    } else if cur == "Path" {
        render_kv(scr, a.path_kv, x, cy, w, ch, a.focus == FReqPane)
    } else if cur == "Body" {
        render_body(a, scr, x, cy, w, ch)
    } else {
        txt := ""
        if cur == "Auth" {
            txt = a.auth_text
        } else if cur == "Info" {
            txt = a.info_text
        } else if cur == "Options" {
            txt = a.opts_text
        }
        if len(txt) == 0 {
            put_str_max(scr, x + 2, cy + 1, "(empty " + cur + ")", w - 4, 7, term.AttrDim)
        } else {
            put_text_lines(scr, txt, x, cy, w, ch)
        }
    }
}

// put_text_lines draws a \n-separated text block inside a pane.
fn put_text_lines(scr: mut term.AnsiScreen, txt: str, x: int, y: int, w: int, h: int) {
    row := 0
    start := 0
    i := 0
    for i <= len(txt) && row < h {
        if i == len(txt) || byteat(txt, i) == 10 {
            put_str_max(scr, x + 1, y + row, substr(txt, start, i), w - 2, 7, 0)
            row = row + 1
            start = i + 1
        }
        i = i + 1
    }
}

fn render_body(a: mut App, scr: mut term.AnsiScreen, x: int, y: int, w: int, h: int) {
    i := 0
    for i < h && a.body.top + i < len(a.body.lines) {
        ln := a.body.lines[a.body.top + i]
        put_str_max(scr, x + 1, y + i, itoa(a.body.top + i + 1) + " " + ln, w - 2, 7, 0)
        i = i + 1
    }
    if a.focus == FReqPane && a.body_edit && len(a.body.lines) > 0 && a.body.cy < len(a.body.lines) {
        ln := a.body.lines[a.body.cy]
        c0 := a.body.cx
        if c0 > len(ln) {
            c0 = len(ln)
        }
        // rows paint as "N <text>" — the cursor sits past the same
        // line-number prefix, not over it (digits are narrow, so
        // len == display cols).
        pre := itoa(a.body.cy + 1) + " "
        scr.cursor(x + 1 + len(pre) + str_cols(substr(ln, 0, c0)), y + a.body.cy - a.body.top, true)
    }
}

fn render_resp_pane(a: mut App, scr: mut term.AnsiScreen, x: int, y: int, w: int, h: int) {
    focused := a.focus == FRespPane || a.focus == FRespTabs
    title := a.resp_title
    if a.sending {
        title = "response · sending…"
    }
    if len(title) == 0 {
        title = "response"
    }
    draw_pane(scr, x, y, w, h, title, focused, a.theme.primary)
    // status class tints the title: green 2xx, yellow 3xx, red else
    if !a.sending && a.resp_class >= 0 {
        tf := 2
        if a.resp_class == 1 {
            tf = 3
        } else if a.resp_class == 2 {
            tf = 1
        }
        put_str_max(scr, x + 2, y, " " + title + " ", w - 4, tf, term.AttrBold)
    }
    render_tabstrip(scr, x, y + 1, w, resp_tabs(), a.resp_tab, a.focus == FRespTabs)
    rts := resp_tabs()
    cur := "Body"
    if a.resp_tab < len(rts) {
        cur = rts[a.resp_tab]
    }
    if cur != "Body" {
        // Headers/Cookies/Trace: selection rows
        rows := resp_rows_active(a)
        top := 0
        if a.resp_rows.sel >= h - 3 {
            top = a.resp_rows.sel - (h - 3) + 1
        }
        i := 0
        for i < h - 3 && top + i < len(rows) {
            a2 := 0
            if focused && top + i == a.resp_rows.sel {
                a2 = term.AttrReverse
            }
            put_str_max(scr, x + 1, y + 2 + i, rows[top + i], w - 2, 7, a2)
            i = i + 1
        }
        if len(rows) == 0 {
            put_str_max(scr, x + 2, y + 3, "(empty " + cur + ")", w - 4, 7, term.AttrDim)
        }
        return
    }
    i := 0
    for i < h - 3 && a.resp_view.top + i < len(a.resp_view.lines) {
        ln := a.resp_view.lines[a.resp_view.top + i]
        a2 := 0
        if focused && a.resp_view.top + i == a.resp_view.cy {
            a2 = term.AttrReverse
        }
        put_str_max(scr, x + 1, y + 2 + i, ln, w - 2, 7, a2)
        i = i + 1
    }
    if len(a.resp_view.lines) == 0 {
        put_str_max(scr, x + 2, y + 3, "(no response yet)", w - 4, 7, term.AttrDim)
    }
}

fn render_footer(a: ref App, scr: mut term.AnsiScreen, cols: int, rows: int) {
    hints := " ^c quit · ^p palette · f1 help · ^h sidebar"
    if len(a.modals) > 0 {
        hints = " esc close"
    }
    put_str(scr, 0, rows - 1, hints, 7, term.AttrDim)
    f := "focus: " + focus_name(a.focus)
    put_str(scr, cols - len(f) - 1, rows - 1, f, 7, term.AttrDim)
}

fn focus_name(f: int) -> str {
    if f == FSidebar {
        return "collection"
    }
    if f == FUrl {
        return "url"
    }
    if f == FMethod {
        return "method"
    }
    if f == FReqTabs {
        return "request tabs"
    }
    if f == FReqPane {
        return "request"
    }
    if f == FRespTabs {
        return "response tabs"
    }
    if f == FRespPane {
        return "response"
    }
    return "?"
}

fn render_toasts(a: ref App, scr: mut term.AnsiScreen, cols: int, rows: int) {
    i := 0
    for i < len(a.toasts) && i < 4 {
        t := a.toasts[len(a.toasts) - 1 - i]
        f := 4
        if t.level == 1 {
            f = 2
        } else if t.level == 2 {
            f = 1
        }
        put_str_max(scr, 1, rows - 2 - i, t.msg, cols - 2, f, term.AttrBold)
        i = i + 1
    }
}

// draw_modal paints a centered overlay box and returns its rect.
fn draw_modal(scr: mut term.AnsiScreen, cols: int, rows: int, w: int, h: int, title: str) -> []int {
    if w > cols - 4 {
        w = cols - 4
    }
    if h > rows - 4 {
        h = rows - 4
    }
    x := (cols - w) / 2
    y := (rows - h) / 2
    // clear + shadow row
    j := 0
    for j < h {
        fill_row(scr, x, y + j, w, " ", 7, 0)
        j = j + 1
    }
    draw_pane(scr, x, y, w, h, title, true, 7)
    r := mkslice(int, 4)
    r[0] = x
    r[1] = y
    r[2] = w
    r[3] = h
    return r
}

fn render_modal(a: mut App, scr: mut term.AnsiScreen, cols: int, rows: int) {
    m := top_modal(a)
    if m == MNone {
        return
    }
    if m == MHelp {
        r := draw_modal(scr, cols, rows, 56, 18, "help")
        put_str(scr, r[0] + 2, r[1] + 2, "global keys:", 6, term.AttrBold)
        gs := global_bindings(a)
        i := 0
        for i < len(gs) && i < 12 {
            b := gs[i]
            put_str_max(scr, r[0] + 3, r[1] + 3 + i, pat_str(b.pat) + "  " + b.action, r[2] - 6, 7, 0)
            i = i + 1
        }
        return
    }
    if m == MPalette {
        r := draw_modal(scr, cols, rows, 56, 16, "palette")
        put_str_max(scr, r[0] + 2, r[1] + 2, "> " + a.pal_query.text, r[2] - 4, 7, 0)
        items := palette_filtered(a)
        // scroll the visible window to keep pal_sel on screen — Enter
        // still resolves the absolute index into items.
        vis := r[3] - 5
        if vis < 1 {
            vis = 1
        }
        off := 0
        if a.pal_sel >= vis {
            off = a.pal_sel - vis + 1
        }
        i := 0
        for off + i < len(items) && i < vis {
            p := items[off + i]
            a2 := 0
            if off + i == a.pal_sel {
                a2 = term.AttrReverse
            }
            put_str_max(scr, r[0] + 2, r[1] + 4 + i, p.name, r[2] - 4, 7, a2)
            i = i + 1
        }
        return
    }
    if m == MVariables {
        r := draw_modal(scr, cols, rows, 56, 16, "variables")
        put_str(scr, r[0] + 2, r[1] + 2, "env vars · ctrl+r reveal (" + btoa(a.vars_reveal) + ")", 6, 0)
        if a.vars_filtering {
            put_str_max(scr, r[0] + 2, r[1] + 3, "/" + a.vars_filter.text, r[2] - 4, 3, 0)
        }
        fq := lower_ascii(a.vars_filter.text)
        y0 := r[1] + 4
        if a.vars_filtering {
            y0 = y0 + 1
        }
        row := 0
        i := 0
        for i < len(a.var_rows) && y0 + row < r[1] + r[3] - 1 {
            rr := a.var_rows[i]
            if len(fq) > 0 && !str_contains(lower_ascii(rr), fq) {
                i = i + 1
            } else {
                a2 := 0
                if i == a.vars.sel {
                    a2 = term.AttrReverse
                }
                put_str_max(scr, r[0] + 3, y0 + row, rr, r[2] - 6, 7, a2)
                row = row + 1
                i = i + 1
            }
        }
        if len(a.var_rows) == 0 {
            put_str(scr, r[0] + 3, y0, "(no variables)", 7, term.AttrDim)
        }
        return
    }
    if m == MMethodMenu {
        r := draw_modal(scr, cols, rows, 24, 14, "method")
        ns := method_names()
        i := 0
        for i < len(ns) && i < r[3] - 3 {
            a2 := 0
            if i == a.method_sel {
                a2 = term.AttrReverse
            }
            put_str_max(scr, r[0] + 2, r[1] + 2 + i, ns[i], r[2] - 4, 7, a2)
            i = i + 1
        }
        return
    }
    if m == MConfirm {
        r := draw_modal(scr, cols, rows, 50, 7, "confirm")
        put_str_max(scr, r[0] + 2, r[1] + 2, a.confirm_msg, r[2] - 4, 3, 0)
        put_str(scr, r[0] + 2, r[1] + 4, "enter = yes · escape = no", 7, term.AttrDim)
        return
    }
    if m == MSaveReq {
        r := draw_modal(scr, cols, rows, 56, 12, "save request")
        put_str(scr, r[0] + 2, r[1] + 2, "name    " + a.save_name.text, 7, 0)
        put_str(scr, r[0] + 2, r[1] + 3, "file    " + a.save_file.text, 7, 0)
        put_str(scr, r[0] + 2, r[1] + 4, "folder  " + a.save_folder.text, 7, 0)
        put_str(scr, r[0] + 2, r[1] + 5, "desc    " + a.save_desc.text, 7, 0)
        return
    }
    if m == MSearchTabs {
        r := draw_modal(scr, cols, rows, 40, 10, "tabs")
        i := 0
        for i < len(a.tabs) && i < r[3] - 4 {
            a2 := 0
            if i == a.tabsearch.sel {
                a2 = term.AttrReverse
            }
            put_str_max(scr, r[0] + 2, r[1] + 2 + i, a.tabs[i].title, r[2] - 4, 7, a2)
            i = i + 1
        }
        return
    }
    if m == MHistory {
        r := draw_modal(scr, cols, rows, 60, 14, "history")
        if len(a.history) == 0 {
            put_str(scr, r[0] + 2, r[1] + 2, "(empty — send a request)", 7, term.AttrDim)
            return
        }
        top := 0
        if a.hist.sel >= r[3] - 4 {
            top = a.hist.sel - (r[3] - 4) + 1
        }
        i := 0
        for i < r[3] - 4 && top + i < len(a.history) {
            he := a.history[len(a.history) - 1 - (top + i)]
            line := he.method + " " + he.url + " · " + itoa(he.status)
            a2 := 0
            if top + i == a.hist.sel {
                a2 = term.AttrReverse
            }
            put_str_max(scr, r[0] + 2, r[1] + 2 + i, line, r[2] - 4, 7, a2)
            i = i + 1
        }
        return
    }
    if m == MJump {
        put_str(scr, 2, rows - 2, "jump: s sidebar · u url · m method · q request · w response", 3, term.AttrBold)
        return
    }
    if m == MTheme || m == MGradient {
        rows2 := th_rows(a, m)
        h := 4 + len(rows2)
        if h > 20 {
            h = 20
        }
        ttl := "theme"
        if m == MGradient {
            ttl = "sidebar gradient"
        }
        r := draw_modal(scr, cols, rows, 44, h, ttl)
        vis := r[3] - 3
        if vis < 1 {
            vis = 1
        }
        off := 0
        if a.th_sel >= off + vis {
            off = a.th_sel - vis + 1
        }
        i := 0
        for i < vis && off + i < len(rows2) {
            rr := rows2[off + i]
            a2 := 0
            f := 7
            if theme_row_is_header(rr) {
                a2 = term.AttrDim
                f = a.theme.secondary
            }
            if off + i == a.th_sel {
                a2 = a2 | term.AttrReverse
            }
            put_str_max(scr, r[0] + 2, r[1] + 2 + i, rr, r[2] - 4, f, a2)
            i = i + 1
        }
        return
    }
    if m == MCurl {
        r := draw_modal(scr, cols, rows, 60, 7, "import curl")
        put_str_max(scr, r[0] + 2, r[1] + 2, "> " + a.curl_in.text, r[2] - 4, 7, 0)
        put_str(scr, r[0] + 2, r[1] + 4, "enter imports · escape closes", 7, term.AttrDim)
        return
    }
    if m == MSaveResp {
        r := draw_modal(scr, cols, rows, 44, 7, "save response")
        put_str_max(scr, r[0] + 2, r[1] + 2, "file  " + a.sresp_in.text, r[2] - 4, 7, 0)
        put_str(scr, r[0] + 2, r[1] + 4, "enter writes · exists → error", 7, term.AttrDim)
        return
    }
    if m == MVarEdit {
        ttl := "set variable"
        if len(a.var_edit_name) == 0 {
            ttl = "add variable (NAME=VALUE)"
        }
        r := draw_modal(scr, cols, rows, 44, 7, ttl)
        lbl := "value "
        if len(a.var_edit_name) == 0 {
            lbl = "pair  "
        }
        put_str_max(scr, r[0] + 2, r[1] + 2, lbl + a.var_edit.text, r[2] - 4, 7, 0)
        return
    }
    if m == MEnvSwitch {
        h := 4 + len(a.env_names)
        if h > 14 {
            h = 14
        }
        r := draw_modal(scr, cols, rows, 40, h, "environment")
        a2 := 0
        if a.vars.sel == 0 {
            a2 = term.AttrReverse
        }
        put_str_max(scr, r[0] + 2, r[1] + 2, "(none)", r[2] - 4, 7, a2)
        i := 0
        for i < len(a.env_names) && i < r[3] - 3 {
            a2 = 0
            if i + 1 == a.vars.sel {
                a2 = term.AttrReverse
            }
            put_str_max(scr, r[0] + 2, r[1] + 3 + i, a.env_names[i], r[2] - 4, 7, a2)
            i = i + 1
        }
        return
    }
}

fn btoa(b: bool) -> str {
    if b {
        return "on"
    }
    return "off"
}

// render draws the whole shell and caches hit rects on the app.
fn render(a: mut App, scr: mut term.AnsiScreen, ver: str) {
    // reset every cell first — deleted chars / closed modals must not
    // leave stale glyphs behind in the persistent buffer.
    scr.clear()
    sz := scr.size()
    cols := sz.cols
    rows := sz.rows
    render_header(a, scr, ver)
    render_url_bar(a, scr, cols)
    by := 4
    bh := rows - 2 - by
    if bh < 3 {
        bh = 3
    }
    // sidebar
    sw := 0
    sx := 0
    if a.sidebar_on {
        sw = cols / 4
        if sw > 24 {
            sw = 24
        }
        if sw < 10 {
            sw = 10
        }
        sx = 0
        if a.sidebar_pos == 1 {
            sx = cols - sw
        }
    }
    a.r_sidebar_x = sx
    a.r_sidebar_w = sw
    a.r_sidebar_y = by
    a.r_sidebar_h = bh
    a.r_main_x = sw
    a.r_main_w = cols - sw
    if a.sidebar_pos == 1 {
        a.r_main_x = 0
    }
    if a.sidebar_on {
        render_sidebar(a, scr, sx, by, sw, bh)
    }
    // main split
    mx := a.r_main_x
    mw := a.r_main_w
    a.r_req_x = mx
    a.r_req_y = by
    a.r_req_w = mw
    a.r_req_h = bh
    a.r_resp_x = mx
    a.r_resp_y = by
    a.r_resp_w = mw
    a.r_resp_h = bh
    a.r_url_y = 1
    a.r_url_h = 2
    if a.expanded == 1 {
        render_req_pane(a, scr, mx, by, mw, bh)
        a.r_resp_h = 0
    } else if a.expanded == 2 {
        render_resp_pane(a, scr, mx, by, mw, bh)
        a.r_req_h = 0
    } else if a.layout == 0 {
        // vertical: request over response
        rh := bh / 2
        if bh - rh > rh {
            rh = bh - rh
        }
        render_req_pane(a, scr, mx, by, mw, rh)
        render_resp_pane(a, scr, mx, by + rh, mw, bh - rh)
        a.r_req_h = rh
        a.r_resp_y = by + rh
        a.r_resp_h = bh - rh
    } else {
        // horizontal: side by side
        rw := mw / 2
        render_req_pane(a, scr, mx, by, rw, bh)
        render_resp_pane(a, scr, mx + rw, by, mw - rw, bh)
        a.r_req_w = rw
        a.r_resp_x = mx + rw
        a.r_resp_w = mw - rw
    }
    render_toasts(a, scr, cols, rows)
    render_footer(a, scr, cols, rows)
    render_modal(a, scr, cols, rows)
    if a.focus != FUrl && !(a.focus == FReqPane && a.body_edit) {
        scr.cursor(0, 0, false)
    }
}

// screen_text flattens the cell buffer to plain text with trailing
// blanks trimmed — the ctrl+shift+s text-screenshot content (corpus
// §1.6: "text screenshot to CWD").
fn screen_text(scr: ref term.AnsiScreen) -> str {
    out := ""
    y := 0
    for y < scr.rows {
        row := ""
        x := 0
        for x < scr.cols {
            row = row + scr.chs[y * scr.cols + x]
            x = x + 1
        }
        n := len(row)
        for n > 0 && byteat(row, n - 1) == 32 {
            n = n - 1
        }
        out = out + substr(row, 0, n)
        if y < scr.rows - 1 {
            out = out + "\n"
        }
        y = y + 1
    }
    return out
}

// write_screenshot writes the current frame's text to path; err on
// any open/write/close failure so the UI can toast honestly.
fn write_screenshot(scr: ref term.AnsiScreen, path: str) -> err {
    n := os.writefile_(path, screen_text(scr))
    if n < 0 {
        return errors.new("write " + path + ": errno " + itoa(-n))
    }
    return nil
}

// pat_str renders a KeyPat back to a corpus-style spec for the help
// overlay listing.
fn pat_str(p: KeyPat) -> str {
    s := ""
    if p.ctrl {
        s = s + "ctrl+"
    }
    if p.alt {
        s = s + "alt+"
    }
    if p.shift {
        s = s + "shift+"
    }
    if p.meta {
        s = s + "meta+"
    }
    if p.sup {
        s = s + "super+"
    }
    if p.code >= 0 {
        s = s + code_name(p.code)
    } else {
        s = s + p.ch
    }
    return s
}

fn code_name(c: int) -> str {
    if c == term.KeyEnter {
        return "enter"
    }
    if c == term.KeyTab {
        return "tab"
    }
    if c == term.KeySpace {
        return "space"
    }
    if c == term.KeyBackspace {
        return "backspace"
    }
    if c == term.KeyDelete {
        return "delete"
    }
    if c == term.KeyInsert {
        return "insert"
    }
    if c == term.KeyEscape {
        return "escape"
    }
    if c == term.KeyUp {
        return "up"
    }
    if c == term.KeyDown {
        return "down"
    }
    if c == term.KeyLeft {
        return "left"
    }
    if c == term.KeyRight {
        return "right"
    }
    if c == term.KeyHome {
        return "home"
    }
    if c == term.KeyEnd {
        return "end"
    }
    if c == term.KeyPgUp {
        return "pageup"
    }
    if c == term.KeyPgDown {
        return "pagedown"
    }
    if c >= term.KeyF1 {
        return "f" + itoa(c - term.KeyF1 + 1)
    }
    return "key" + itoa(c)
}
