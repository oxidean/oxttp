package main

// oxttp-tui — drop-in Posting-compatible terminal HTTP client.
// Surface contract: docs/corpus/corpus-posting.md.
//
// S9: full app shell on core/term — open_session enters raw +
// alt-screen + SGR mouse + kitty-u; the loop feeds stdin through the
// input decoder into layered keymap dispatch, then renders the shell
// (header / url bar / sidebar / request / response / footer) and
// presents. SIGINT or the quit action exits; SIGWINCH rebuilds.

import "std/os"

import "std/errors"

import "std/time"

import "github.com/oxidean/oxttp/core/term"

import "github.com/oxidean/oxttp/shared/version"

fn main() {
    ver := version.get()
    [sess, e] = term.open_session()
    if e != nil {
        // Non-tty (CI / pipes): keep the one-line banner.
        println("oxttp-tui " + ver)
        return
    }
    defer sess.close()
    a := new_app()
    parse_argv(a)
    if a.quit {
        // -h/--help/-v/--version — the banner is the whole output.
        println("oxttp-tui " + ver)
        return
    }
    load_collection(a)
    dec := term.new_decoder()
    stdin := os.stdin()
    buf := mkslice(byte, 256)
    render(a, sess.scr, ver)
    pe := sess.scr.present()
    if pe != nil {
        return
    }
    for !a.quit {
        if sess.interrupted() {
            break
        }
        if sess.resized() {
            render(a, sess.scr, ver)
            rpe := sess.scr.present()
            if rpe != nil {
                break
            }
        }
        [n, re] = stdin.read(buf)
        if n > 0 {
            evs := dec.feed(buf[0:n])
            i := 0
            for i < len(evs) {
                fx := dispatch(a, evs[i])
                if fx == EQuit {
                    a.quit = true
                }
                if fx == ESend {
                    // paint a "Sending…" frame before the send blocks —
                    // exec_send installs the response or the error text.
                    a.sending = true
                    render(a, sess.scr, ver)
                    spe := sess.scr.present()
                    if spe == nil {
                        exec_send(a)
                    }
                    a.sending = false
                }
                i = i + 1
            }
            render(a, sess.scr, ver)
            pe2 := sess.scr.present()
            if pe2 != nil {
                break
            }
            // consume a queued text-screenshot (corpus §1.6): write the
            // just-presented frame, toast only on the outcome.
            if a.want_shot {
                a.want_shot = false
                we := write_screenshot(sess.scr, "posting-screenshot.txt")
                if we != nil {
                    a.toast(2, "screenshot failed: " + errors.msg(we))
                } else {
                    a.toast(1, "screenshot → posting-screenshot.txt")
                }
            }
        }
        if re != nil && n <= 0 {
            break
        }
        if n <= 0 {
            time.sleep_ms(10)
        }
    }
}
