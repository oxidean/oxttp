package main

// oxttp-tui — drop-in Posting-compatible terminal HTTP client.
// Surface contract: docs/corpus/corpus-posting.md. S8: real raw-mode
// session via core/term (std/os/term + signal). Screens/keybindings
// land in S9+.
import "std/os"

import "std/time"

import "github.com/oxidean/oxttp/core/term"

import "github.com/oxidean/oxttp/shared/version"

fn write_banner(scr: mut term.AnsiScreen, ver: str) {
    msg := "oxttp-tui " + ver + "  (q / Ctrl-C to quit)"
    i := 0
    for i < len(msg) {
        scr.set_cell(i, 0, substr(msg, i, i + 1), 6, -1, term.AttrBold)
        i = i + 1
    }
    hint := "S8 term driver · Posting screens arrive in S9"
    j := 0
    for j < len(hint) {
        scr.set_cell(j, 2, substr(hint, j, j + 1), 7, -1, 0)
        j = j + 1
    }
    scr.cursor(0, 4, true)
}

fn main() {
    ver := version.get()
    [sess, e] = term.open_session()
    if e != nil {
        // Non-tty (CI / pipes): keep the old one-line banner.
        println("oxttp-tui " + ver)
        return
    }
    defer sess.close()
    write_banner(sess.scr, ver)
    pe := sess.scr.present()
    if pe != nil {
        return
    }
    // Poll loop: SIGINT, resize, or 'q' / Ctrl-C byte on stdin.
    stdin := os.stdin()
    buf := mkslice(byte, 64)
    for true {
        if sess.interrupted() {
            break
        }
        if sess.resized() {
            write_banner(sess.scr, ver)
            pe2 := sess.scr.present()
            if pe2 != nil {
                break
            }
        }
        [n, re] = stdin.read(buf)
        if n > 0 {
            k := 0
            for k < n {
                c := buf[k]
                // 'q' / 'Q' / Ctrl-C (3)
                if c == 113 || c == 81 || c == 3 {
                    return
                }
                k = k + 1
            }
        }
        if re != nil && n <= 0 {
            break
        }
        if n <= 0 {
            time.sleep_ms(50)
        }
    }
}
