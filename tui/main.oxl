package main

// oxttp-tui — drop-in Posting-compatible terminal HTTP client.
// Surface contract: docs/corpus/corpus-posting.md.
//
// S9: full app shell on core/term — open_session enters raw +
// alt-screen + SGR mouse + kitty-u; the loop feeds stdin through the
// input decoder into layered keymap dispatch, then renders the shell
// (header / url bar / sidebar / request / response / footer) and
// presents. SIGINT or the quit action exits; SIGWINCH rebuilds.
// S11: flag exits (-h / bad flag) before the session opens; config +
// POSTING_* env load with upstream warns; EExt suspends the session
// for f3/f4 externals.

import "std/os"

import "std/errors"

import "std/time"

import "github.com/oxidean/oxttp/core/config"

import "github.com/oxidean/oxttp/core/term"

import "github.com/oxidean/oxttp/shared/version"

fn emit_file(f: os.File, s: str) {
    b := mkslice(byte, len(s))
    i := 0
    for i < len(s) {
        b[i] = byteat(s, i)
        i = i + 1
    }
    [n, we] = f.write(b)
    if we != nil || n < len(b) {
        os.quit(1)
    }
}

fn main() {
    ver := version.get()
    // Subcommands run headless — dispatch before any session open
    // (corpus §1.1: import|locate|remote|run|version).
    if os.nargs() > 1 && cli_is_sub(os.args(1)) {
        r := cli_main()
        if len(r.stdout) > 0 {
            emit_file(os.stdout(), r.stdout)
        }
        if len(r.stderr) > 0 {
            emit_file(os.stderr(), r.stderr)
        }
        os.quit(r.code)
    }
    a := new_app()
    parse_argv(a)
    if a.exit_code >= 0 {
        // -h → usage on stdout (0); bad flag → usage on stderr (2).
        if a.exit_code == 0 {
            emit_file(os.stdout(), a.exit_text)
        } else {
            emit_file(os.stderr(), a.exit_text)
        }
        os.quit(a.exit_code)
    }
    [sess, e] = term.open_session()
    if e != nil {
        // Non-tty (CI / pipes): keep the one-line banner.
        println("oxttp-tui " + ver)
        return
    }
    defer sess.close()
    // config.yaml + POSTING_* env → settings; upstream warns surface as
    // startup toasts on the first painted frame.
    lr := config.load("", config.posting_env_pairs())
    apply_settings(a, lr.s)
    wi := 0
    for wi < len(lr.warns) {
        a.toast(2, lr.warns[wi])
        wi = wi + 1
    }
    load_collection(a)
    dec := term.new_decoder()
    stdin := os.stdin()
    buf := mkslice(byte, 256)
    render(a, sess.scr, ver)
    pe := sess.scr.present()
    if pe != nil {
        return
    }
    for !a.quit {
        if sess.interrupted() {
            break
        }
        if sess.resized() {
            render(a, sess.scr, ver)
            rpe := sess.scr.present()
            if rpe != nil {
                break
            }
        }
        [n, re] = stdin.read(buf)
        if n > 0 {
            evs := dec.feed(buf[0:n])
            i := 0
            for i < len(evs) {
                fx := dispatch(a, evs[i])
                if fx == EQuit {
                    a.quit = true
                }
                if fx == ESend {
                    // paint a "Sending…" frame before the send blocks —
                    // exec_send installs the response or the error text.
                    // A failed present must not swallow the send: the
                    // response still installs (and jars/history record)
                    // for the next successful frame.
                    a.sending = true
                    render(a, sess.scr, ver)
                    sess.scr.present()
                    exec_send(a)
                    a.sending = false
                }
                if fx == EExt {
                    // f3/f4 external pager/editor: suspend → sh -c →
                    // resume; run_ext toasts non-zero exits.
                    run_ext(a, sess)
                }
                i = i + 1
            }
            render(a, sess.scr, ver)
            pe2 := sess.scr.present()
            if pe2 != nil {
                break
            }
            // consume a queued text-screenshot (corpus §1.6): write the
            // just-presented frame, toast only on the outcome.
            if a.want_shot {
                a.want_shot = false
                we := write_screenshot(sess.scr, "posting-screenshot.txt")
                if we != nil {
                    a.toast(2, "screenshot failed: " + errors.msg(we))
                } else {
                    a.toast(1, "screenshot → posting-screenshot.txt")
                }
            }
        }
        if re != nil && n <= 0 {
            break
        }
        if n <= 0 {
            time.sleep_ms(10)
        }
    }
}
