package main

// S5 request execution (WI-0006): the populated Intent becomes a
// model.Req, the h1 transport sends it, and this printer emits the
// xh-shaped stdout/stderr/exit surface. Semantics are pinned by
// artifacts/spec.md (sem-A..R) — header merge order, body kinds,
// print pipeline, degrade routing live partly here and partly in
// sem's step-10 routing table.
import "std/os"

import "std/time"

import "std/strconv"

import "std/errors"

import "std/encoding/json"

import "std/encoding/base64"

import "std/crypto/md5"

import "std/net/url"

import "std/net/tls"

import "github.com/oxidean/oxttp/core/model"

import "github.com/oxidean/oxttp/core/item"

import "github.com/oxidean/oxttp/core/http"

import "github.com/oxidean/oxttp/shared/version"

// Run is what a request produces — mirroring Out's contract.
struct Run { code: int, stdout: str, stderr: str }

fn elwr(s: str) -> str {
    b := s as []byte
    out := mkslice(byte, len(s))
    i := 0
    for i < len(s) {
        c := b[i]
        if c >= 65 && c <= 90 {
            c = c + 32
        }
        out[i] = c
        i = i + 1
    }
    return out as str
}

// --- ordered header list with freed-slot reuse (http::HeaderMap
// semantics): unset frees a slot the next new-name insert reuses.

fn hfind(hs: []model.Header, name: str) -> int {
    ln := elwr(name)
    i := 0
    for i < len(hs) {
        if len(hs[i].name) > 0 && elwr(hs[i].name) == ln {
            return i
        }
        i = i + 1
    }
    return -1
}

fn hhas(hs: []model.Header, name: str) -> bool {
    return hfind(hs, name) >= 0
}

// hput applies replace_headers semantics: first item occurrence for
// a name replaces all existing values at that position; repeats
// append. Dead slots (name=="") get reused first (HeaderMap index
// reuse — verified against real xh unset+insert ordering).
fn hput(hs: []model.Header, name: str, value: str) -> []model.Header {
    seen := hfind(hs, name)
    if seen >= 0 {
        hs[seen].value = value
        // drop sibling duplicates of the replaced name
        i := seen + 1
        ln := elwr(name)
        for i < len(hs) {
            if len(hs[i].name) > 0 && elwr(hs[i].name) == ln {
                hs[i].name = ""
            }
            i = i + 1
        }
        return hs
    }
    // reuse a freed slot else append
    i := 0
    for i < len(hs) {
        if len(hs[i].name) == 0 {
            hs[i] = model.Header{name: name, value: value}
            return hs
        }
        i = i + 1
    }
    return push(hs, model.Header{name: name, value: value})
}

// happend appends unconditionally (repeat headers like A:1 A:2).
fn happend(hs: []model.Header, name: str, value: str) -> []model.Header {
    i := 0
    for i < len(hs) {
        if len(hs[i].name) == 0 {
            hs[i] = model.Header{name: name, value: value}
            return hs
        }
        i = i + 1
    }
    return push(hs, model.Header{name: name, value: value})
}

// hunset removes every occurrence of name, freeing slots.
// hunset swap-removes every occurrence of name — HeaderMap::remove
// semantics verified against real xh: the LAST live entry fills each
// freed slot (`A:1 A:2 B; User-Agent:` renders B at index 1).
fn hunset(hs: []model.Header, name: str) -> []model.Header {
    ln := elwr(name)
    out := hs
    for true {
        idx := -1
        i := 0
        for i < len(out) {
            if elwr(out[i].name) == ln {
                idx = i
                break
            }
            i = i + 1
        }
        if idx < 0 {
            return out
        }
        // swap-remove: last element fills the hole
        out[idx] = out[len(out) - 1]
        out = out[:len(out) - 1]
    }
    return out
}

fn hunset_at(hs: []model.Header, idx: int) -> []model.Header {
    hs[idx] = hs[len(hs) - 1]
    return hs[:len(hs) - 1]
}

fn insert_at(hs: []model.Header, idx: int, h: model.Header) -> []model.Header {
    out := push(hs, h) // grows by one; then shift down to idx
    i := len(out) - 1
    for i > idx {
        out[i] = out[i - 1]
        i = i - 1
    }
    out[idx] = h
    return out
}

fn hget(hs: []model.Header, name: str) -> str {
    i := hfind(hs, name)
    if i < 0 {
        return ""
    }
    return hs[i].value
}

// htitle renders the display header lines in order, skipping dead
// slots. `title` applies HTTP/1.x title-casing (h2/h3 heads keep
// lowercase names); values get the latin1+UTF-8-annotation display.
fn htitle(hs: []model.Header, title: int, f: ref Fmt) -> str {
    out := ""
    i := 0
    for i < len(hs) {
        h := hs[i]
        i = i + 1
        if len(h.name) == 0 {
            continue
        }
        nm := h.name
        if title != 0 {
            nm = titlecase(nm)
        } else {
            nm = elwr(nm)
        }
        // headers.rs::print_headers element order: name → header_name,
        // ":" → header_colon, " " → default, value → header_value
        // (latin1 → error + UTF-8 annotation), "\n" → default.
        out = out + sgr_wrap("header_name", nm, f) + sgr_wrap("header_colon", ":", f) + sgr_plain(" ", f) + hdr_value_out(h.value, f) + sgr_plain("\n", f)
    }
    return out
}

fn titlecase(s: str) -> str {
    b := s as []byte
    out := mkslice(byte, len(s))
    up := 1
    i := 0
    for i < len(s) {
        c := b[i]
        if c == 45 {
            up = 1
        } else if up == 1 && c >= 97 && c <= 122 {
            c = c - 32
            up = 0
        } else {
            up = 0
        }
        out[i] = c
        i = i + 1
    }
    return out as str
}

// --- session (cookie-jar-lite per ADR 0023)

struct Sess {
    path: str,
    headers: []model.Header, // saved headers (lowercase names)
    cookies: []str,          // "name=value" jar rows
    auth_type: str,
    auth_raw: str,
    ok: int, // 0 no file · 1 loaded · -1 malformed
}

// session_path: value containing '/' is literal; else
// <cfg>/sessions/<host>[_<port>]/<name>.json.
fn session_path(i: ref Intent, env: []str) -> [str, err] {
    name := i.session
    if find(name, "/") >= 0 {
        return name, nil
    }
    [u, ue] = url.parse(i.url)
    if ue != nil {
        return "", ue
    }
    host := u.hostname()
    if len(host) == 0 || host == "." || host == ".." {
        return "", errors.new("couldn't extract host from url")
    }
    if len(u.port()) > 0 {
        host = host + "_" + u.port()
    }
    [cd, ce] = config_dir(env)
    if ce != nil {
        return "", ce
    }
    return cd + "/sessions/" + host + "/" + name + ".json", nil
}

fn session_load(path: str) -> own Sess {
    s := new(Sess)
    s.path = path
    s.ok = 0
    if len(path) == 0 || !os.exists(path) {
        return s
    }
    raw := os.readfile_(path)
    if len(raw) == 0 {
        s.ok = -1
        return s
    }
    j := json.jparse(raw)
    if j == nil || j.kind != 4 {
        s.ok = -1
        return s
    }
    a := json.jget(j, "auth")
    if a != nil {
        s.auth_type = jget_s(a, "type")
        s.auth_raw = jget_s(a, "raw_auth")
    }
    ck := json.jget(j, "cookies")
    if ck != nil && ck.kind == 5 {
        m := ck.child
        for m != nil {
            nm := jget_s(m, "name")
            vl := jget_s(m, "value")
            if len(nm) > 0 {
                s.cookies = push(s.cookies, nm + "=" + vl)
            }
            m = m.next
        }
    }
    hd := json.jget(j, "headers")
    if hd != nil && hd.kind == 5 {
        m2 := hd.child
        for m2 != nil {
            nm2 := jget_s(m2, "name")
            vl2 := jget_s(m2, "value")
            if len(nm2) > 0 {
                s.headers = push(s.headers, model.Header{name: nm2, value: vl2})
            }
            m2 = m2.next
        }
    }
    s.ok = 1
    return s
}

// session_save persists the jar + headers (save_headers exclusions:
// cookie/content-*/if-* per upstream save_headers).
fn session_save(path: str, auth_type: str, auth_raw: str, cookies: []str, hs: []model.Header) -> err {
    dir := ""
    k := len(path) - 1
    for k >= 0 {
        if byteat(path, k) == 47 {
            dir = substr(path, 0, k)
            break
        }
        k = k - 1
    }
    if len(dir) > 0 {
        me := os.mkdir_all(dir)
        if me != nil {
            return me
        }
    }
    out := "{\n    \"__meta__\": {\n        \"about\": \"oxttp session file\",\n        \"xh\": \"" + version.get() + "\"\n    },\n"
    out = out + "    \"auth\": {\n        \"type\": \"" + auth_type + "\",\n        \"raw_auth\": \"" + auth_raw + "\"\n    },\n"
    out = out + "    \"cookies\": ["
    i := 0
    first := 1
    for i < len(cookies) {
        c := cookies[i]
        i = i + 1
        eq := find(c, "=")
        if eq <= 0 {
            continue
        }
        if first == 0 {
            out = out + ","
        }
        first = 0
        out = out + "\n        {\n            \"name\": \"" + substr(c, 0, eq) + "\",\n            \"value\": \"" + substr(c, eq + 1, len(c)) + "\"\n        }"
    }
    out = out + "\n    ],\n    \"headers\": ["
    i = 0
    first = 1
    for i < len(hs) {
        h := hs[i]
        i = i + 1
        ln := elwr(h.name)
        if len(h.name) == 0 || ln == "cookie" || find(ln, "content-") == 0 || find(ln, "if-") == 0 {
            continue
        }
        if first == 0 {
            out = out + ","
        }
        first = 0
        out = out + "\n        {\n            \"name\": \"" + ln + "\",\n            \"value\": \"" + h.value + "\"\n        }"
    }
    out = out + "\n    ]\n}\n"
    // oxl ≥0.23: writefile_ returns bytes written on success; <0 errno.
    if os.writefile_(path, out) < 0 {
        return errors.new("couldn't write session file " + path)
    }
    return nil
}

// --- netrc (spec sem-D4 → S6: EntryState port, ADR-0042)

// uni_ws reports Rust char::is_whitespace (Unicode White_Space
// property) for a decoded codepoint — shared by the netrc word
// splitter and the curl quoter.
fn uni_ws(cp: int) -> int {
    if cp >= 9 && cp <= 13 || cp == 32 {
        return 1
    }
    if cp == 133 || cp == 160 || cp == 5760 {
        return 1
    }
    if cp >= 8192 && cp <= 8202 {
        return 1
    }
    if cp == 8232 || cp == 8233 || cp == 8239 || cp == 8287 || cp == 12288 {
        return 1
    }
    return 0
}

// u8_dec decodes the UTF-8 sequence at byte i of s → [codepoint,
// byte-len]. Malformed → [lead-byte, 1] (raw passthrough).
fn u8_dec(s: str, i: int) -> []int {
    out := mkslice(int, 2)
    c := byteat(s, i)
    out[0] = c
    out[1] = 1
    if c < 128 {
        return out
    }
    need := 0
    cp := 0
    if c >= 194 && c <= 223 {
        need = 1
        cp = c - 192
    } else if c >= 224 && c <= 239 {
        need = 2
        cp = c - 224
    } else if c >= 240 && c <= 244 {
        need = 3
        cp = c - 240
    } else {
        return out
    }
    j := 0
    for j < need {
        j = j + 1
        if i + j >= len(s) {
            return out
        }
        b := byteat(s, i + j)
        if b < 128 || b > 191 {
            return out
        }
        cp = cp * 64 + (b - 128)
    }
    if need == 1 && cp < 128 || need == 2 && cp < 2048 || need == 3 && cp < 65536 {
        return out
    }
    if cp >= 55296 && cp <= 57343 || cp > 1114111 {
        return out
    }
    out[0] = cp
    out[1] = need + 1
    return out
}

// nrc_ipnum parses one WHATWG IPv4 part: 0x hex, leading-0 octal,
// else decimal. [value, ok].
fn nrc_ipnum(p: str) -> []int {
    out := mkslice(int, 2)
    if len(p) == 0 {
        return out
    }
    rad := 10
    st := 0
    if len(p) > 2 && byteat(p, 0) == 48 && (byteat(p, 1) == 120 || byteat(p, 1) == 88) {
        rad = 16
        st = 2
    } else if len(p) > 1 && byteat(p, 0) == 48 {
        rad = 8
        st = 1
    }
    v := 0
    i := st
    for i < len(p) {
        c := byteat(p, i)
        i = i + 1
        d := -1
        if c >= 48 && c <= 57 {
            d = c - 48
        } else if rad == 16 && c >= 97 && c <= 102 {
            d = c - 87
        } else if rad == 16 && c >= 65 && c <= 70 {
            d = c - 55
        }
        if d < 0 || d >= rad {
            return out
        }
        v = v * rad + d
    }
    out[0] = v
    out[1] = 1
    return out
}

// nrc_ipv4 → [u32-as-int, ok] for WHATWG 1-4 part IPv4 strings
// (16843009 == 1.1.1.1); non-numeric → not-IPv4 → domain.
fn nrc_ipv4(h: str) -> []int {
    out := mkslice(int, 2)
    vals := mkslice(int, 0)
    seg := 0
    i := 0
    for i <= len(h) {
        if i == len(h) || byteat(h, i) == 46 {
            vr := nrc_ipnum(substr(h, seg, i))
            ok := vr[1]
            v := vr[0]
            if ok == 0 {
                return out
            }
            vals = push(vals, v)
            seg = i + 1
        }
        i = i + 1
    }
    np := len(vals)
    if np < 1 || np > 4 {
        return out
    }
    j := 0
    for j < np - 1 {
        if vals[j] > 255 {
            return out
        }
        j = j + 1
    }
    lim := 1
    j = 0
    for j < 5 - np {
        lim = lim * 256
        j = j + 1
    }
    if vals[np - 1] >= lim {
        return out
    }
    ip := vals[np - 1]
    j = 0
    for j < np - 1 {
        m := 1
        k := 0
        for k < 3 - j {
            m = m * 256
            k = k + 1
        }
        ip = ip + vals[j] * m
        j = j + 1
    }
    out[0] = ip
    out[1] = 1
    return out
}

// nrc_host canonicalizes a host token for equality (url::Host parse
// analog): strip one trailing dot, ASCII-casefold, IPv4-int expand.
// Non-ASCII stays literal (documented deviation — no IDNA codec).
fn nrc_host(s: str) -> str {
    h := s
    if len(h) > 1 && byteat(h, len(h) - 1) == 46 {
        h = substr(h, 0, len(h) - 1)
    }
    h = elwr(h)
    ipr := nrc_ipv4(h)
    ok := ipr[1]
    ip := ipr[0]
    if ok != 0 {
        return "4:" + itoa(ip)
    }
    return "d:" + h
}

// nrc_lines splits text into lines (drops \n; \r stays as ws).
fn nrc_lines(s: str) -> own []str {
    out := mkslice(str, 0)
    st := 0
    i := 0
    for i < len(s) {
        if byteat(s, i) == 10 {
            out = push(out, substr(s, st, i))
            st = i + 1
        }
        i = i + 1
    }
    out = push(out, substr(s, st, len(s)))
    return new(out)
}

// nrc_trim strips Unicode whitespace at both ends (str::trim).
fn nrc_trim(s: str) -> str {
    a := 0
    b := len(s)
    for a < b {
        cr := u8_dec(s, a)
        cp := cr[0]
        n := cr[1]
        if uni_ws(cp) == 0 {
            break
        }
        a = a + n
    }
    for b > a {
        i := b - 1
        // back up over a full UTF-8 sequence
        for i > a && byteat(s, i) >= 128 && byteat(s, i) <= 191 {
            i = i - 1
        }
        cr2 := u8_dec(s, i)
        cp := cr2[0]
        if uni_ws(cp) == 0 {
            break
        }
        b = i
    }
    return substr(s, a, b)
}

// NParser is the upstream netrc.rs Parser: line-wise word reader +
// EntryState {Wrong,Correct,Default} + finish_entry collection.
struct NParser {
    lines: own []str,
    li: int,
    pos: int,
    host: str,
    state: int, // 0 Wrong · 1 Correct · 2 Default
    login: str,
    has_login: int,
    password: str,
    has_pass: int,
    account: str,
    has_acct: int,
    suppress: int,
    d_login: str,
    d_has_login: int,
    d_pass: str,
    d_set: int,
    e_login: str,
    e_has_login: int,
    e_pass: str,
    e_set: int,
}

// nrc_word reads the next whitespace-separated token, advancing
// lines at EOL; "" at EOF (words are never empty).
fn nrc_word(p: ref NParser) -> str {
    for true {
        if p.li >= len(p.lines) {
            return ""
        }
        buf := p.lines[p.li]
        if p.pos >= len(buf) {
            p.li = p.li + 1
            p.pos = 0
            continue
        }
        cr := u8_dec(buf, p.pos)
        cp := cr[0]
        n := cr[1]
        if uni_ws(cp) != 0 {
            p.pos = p.pos + n
            continue
        }
        st := p.pos
        for p.pos < len(buf) {
            cr2 := u8_dec(buf, p.pos)
            c2 := cr2[0]
            n2 := cr2[1]
            if uni_ws(c2) != 0 {
                break
            }
            p.pos = p.pos + n2
        }
        return substr(buf, st, p.pos)
    }
    return ""
}

// nrc_arg consumes the next word; returns it only when the parser is
// inside a relevant entry (upstream Parser::arg).
fn nrc_arg(p: ref NParser) -> str {
    st := p.state
    w := nrc_word(p)
    if st != 0 {
        return w
    }
    return ""
}

// nrc_advance moves to the next line (upstream advance_line).
fn nrc_advance(p: ref NParser) {
    p.li = p.li + 1
    p.pos = 0
}

// nrc_finish ends the current entry (upstream finish_entry): an entry
// exists iff a password was gathered; login falls back to account.
// Correct → e_*, Default → d_*; state resets to Wrong either way.
fn nrc_finish(p: ref NParser) {
    lg := p.login
    hlg := p.has_login
    ac := p.account
    hac := p.has_acct
    pw := p.password
    hpw := p.has_pass
    st := p.state
    p.state = 0
    p.login = ""
    p.has_login = 0
    p.account = ""
    p.has_acct = 0
    p.password = ""
    p.has_pass = 0
    if hpw == 0 {
        return
    }
    el := lg
    ehl := hlg
    if ehl == 0 {
        el = ac
        ehl = hac
    }
    if st == 1 {
        p.e_login = el
        p.e_has_login = ehl
        p.e_pass = pw
        p.e_set = 1
    } else if st == 2 {
        p.d_login = el
        p.d_has_login = ehl
        p.d_pass = pw
        p.d_set = 1
    }
}

fn nrc_parse(p: ref NParser) {
    for true {
        w := nrc_word(p)
        if len(w) == 0 {
            // EOF: upstream calls finish_entry() once more — the
            // trailing entry's credentials land here.
            nrc_finish(p)
            break
        }
        if w == "default" {
            nrc_finish(p)
            p.state = 2
        } else if w == "machine" {
            nrc_finish(p)
            nh := nrc_word(p)
            if len(nh) > 0 {
                if nrc_host(nh) == p.host {
                    p.state = 1
                    p.suppress = 1
                } else {
                    p.state = 0
                }
            }
        } else if w == "login" {
            v := nrc_arg(p)
            if len(v) > 0 {
                p.login = v
                p.has_login = 1
            }
        } else if w == "password" {
            v := nrc_arg(p)
            if len(v) > 0 {
                p.password = v
                p.has_pass = 1
            }
        } else if w == "account" {
            v := nrc_arg(p)
            if len(v) > 0 {
                p.account = v
                p.has_acct = 1
            }
        } else if w == "macdef" {
            nrc_finish(p)
            nrc_word(p) // macro name — discarded
            nrc_advance(p)
            for p.li < len(p.lines) && len(nrc_trim(p.lines[p.li])) > 0 {
                nrc_advance(p)
            }
        } else if byteat(w, 0) == 35 {
            // word-initial '#' → comment: skip rest of line (a '#' in
            // value position is a literal — OCTOTHORPE_IN_VALUE).
            nrc_advance(p)
        } else {
            // unknown word ends the entry (no crash).
            nrc_finish(p)
        }
        if p.e_set != 0 {
            return
        }
    }
}

fn netrc_auth(i: ref Intent, env: []str) -> str {
    if i.ignore_netrc != 0 {
        return ""
    }
    path := env_get(env, "NETRC")
    if len(path) == 0 {
        home := env_get(env, "HOME")
        if len(home) == 0 {
            return ""
        }
        if os.exists(home + "/.netrc") {
            path = home + "/.netrc"
        } else if os.exists(home + "/_netrc") {
            path = home + "/_netrc"
        } else {
            return ""
        }
    }
    if !os.exists(path) {
        return ""
    }
    raw := os.readfile_(path)
    // upstream DecodeReaderBytesBuilder: UTF-16 BOM decodes, else
    // lossy UTF-8 — decode_bounded's ""-sniff does exactly this.
    text := decode_bounded(raw as []byte, "")
    [u, ue] = url.parse(i.url)
    if ue != nil {
        return ""
    }
    p := new(NParser)
    p.lines = nrc_lines(text)
    p.host = nrc_host(u.hostname())
    nrc_parse(p)
    if p.e_set != 0 {
        if p.e_has_login == 0 && i.auth_type != "bearer" {
            return ""
        }
        return "B" + charat(1) + p.e_login + charat(1) + p.e_pass
    }
    if p.suppress != 0 {
        return ""
    }
    if p.d_set != 0 {
        if p.d_has_login == 0 && i.auth_type != "bearer" {
            return ""
        }
        return "B" + charat(1) + p.d_login + charat(1) + p.d_pass
    }
    return ""
}

fn env_get(env: []str, name: str) -> str {
    [v, e] = env_lookup(env, name)
    if e != nil {
        return ""
    }
    return v
}

fn charat(c: int) -> str {
    b := mkslice(byte, 1)
    b[0] = c
    return b as str
}

// --- digest auth (§D3): send without Authorization; on 401 +
// WWW-Authenticate: Digest compute the MD5 response and resend
// once. XH_TEST_DIGEST_AUTH_CNONCE pins cnonce for fixtures.

// dig_params parses "realm=\"r\", nonce=\"n\"" into "k\x01v" rows —
// quote-aware comma split (qop lists contain commas).
fn dig_params(s: str) -> []str {
    let out: []str = nil
    i := 0
    n := len(s)
    for i < n {
        for i < n && (byteat(s, i) == 32 || byteat(s, i) == 44 || byteat(s, i) == 9) {
            i = i + 1
        }
        k0 := i
        for i < n && byteat(s, i) != 61 && byteat(s, i) != 44 {
            i = i + 1
        }
        if i >= n || byteat(s, i) != 61 {
            return out
        }
        k := trim_ows(elwr(substr(s, k0, i)))
        i = i + 1
        v := ""
        if i < n && byteat(s, i) == 34 {
            i = i + 1
            v0 := i
            for i < n && byteat(s, i) != 34 {
                i = i + 1
            }
            v = substr(s, v0, i)
            if i < n {
                i = i + 1
            }
        } else {
            v0 := i
            for i < n && byteat(s, i) != 44 {
                i = i + 1
            }
            v = trim_ows(substr(s, v0, i))
        }
        out = push(out, k + charat(1) + v)
    }
    return out
}

fn dig_get(params: []str, key: str) -> str {
    i := 0
    for i < len(params) {
        sp := find(params[i], charat(1))
        if substr(params[i], 0, sp) == key {
            return substr(params[i], sp + 1, len(params[i]))
        }
        i = i + 1
    }
    return ""
}

// digest_challenge returns the Digest params text when the 401
// carries "WWW-Authenticate: Digest ..." (else "").
fn digest_challenge(hs: []model.Header) -> str {
    i := 0
    for i < len(hs) {
        if elwr(hs[i].name) == "www-authenticate" {
            v := trim_ows(hs[i].value)
            if len(v) > 7 && elwr(substr(v, 0, 6)) == "digest" && byteat(v, 6) == 32 {
                return substr(v, 7, len(v))
            }
        }
        i = i + 1
    }
    return ""
}

// digest_authorization builds the Authorization value or a degrade
// reason (MD5-sess / qop without auth are out of scope per §D3).
fn digest_authorization(p: ref ReqPlan, challenge: str, method: str, uri: str) -> [str, err] {
    params := dig_params(challenge)
    realm := dig_get(params, "realm")
    nonce := dig_get(params, "nonce")
    opaque := dig_get(params, "opaque")
    algo := dig_get(params, "algorithm")
    qopv := dig_get(params, "qop")
    if len(algo) > 0 && elwr(algo) != "md5" {
        return "", errors.new("digest algorithm " + algo + " is unsupported in this build")
    }
    qop := ""
    if len(qopv) > 0 {
        // qop may be a quoted list "auth,auth-int" — take auth only
        qp := dig_splitq(qopv)
        qi := 0
        for qi < len(qp) {
            if elwr(qp[qi]) == "auth" {
                qop = "auth"
            }
            qi = qi + 1
        }
        if len(qop) == 0 {
            return "", errors.new("digest qop " + qopv + " is unsupported in this build")
        }
    }
    cnonce := p.digest_cnonce
    if len(cnonce) == 0 {
        cnonce = md5.hexdigest((itoa(now_ms()) + ":oxttp") as []byte)
    }
    ha1 := md5.hexdigest((p.digest_user + ":" + realm + ":" + p.digest_pass) as []byte)
    ha2 := md5.hexdigest((method + ":" + uri) as []byte)
    resp := ""
    if len(qop) > 0 {
        resp = md5.hexdigest((ha1 + ":" + nonce + ":00000001:" + cnonce + ":auth:" + ha2) as []byte)
    } else {
        resp = md5.hexdigest((ha1 + ":" + nonce + ":" + ha2) as []byte)
    }
    out := "Digest username=\"" + p.digest_user + "\", realm=\"" + realm + "\", nonce=\"" + nonce + "\", uri=\"" + uri + "\", response=\"" + resp + "\""
    if len(opaque) > 0 {
        out = out + ", opaque=\"" + opaque + "\""
    }
    if len(algo) > 0 {
        out = out + ", algorithm=" + algo
    }
    if len(qop) > 0 {
        out = out + ", qop=auth, nc=00000001, cnonce=\"" + cnonce + "\""
    }
    return out, nil
}

// dig_splitq splits a possibly-quoted qop list into tokens.
fn dig_splitq(v: str) -> []str {
    let out: []str = nil
    i := 0
    for i < len(v) {
        i0 := i
        for i < len(v) && byteat(v, i) != 44 {
            i = i + 1
        }
        t := trim_ows(substr(v, i0, i))
        if len(t) > 0 {
            out = push(out, t)
        }
        i = i + 1
    }
    return out
}

// --- body assembly

// ReqPlan carries the built request plus execution metadata.
struct ReqPlan {
    req: own model.Req,
    warn: []str,
    err: str,
    sess: own Sess,
    sess_write: int,
    jar: []str,
    digest_user: str,
    digest_pass: str,
    digest_cnonce: str,
    resume_off: int, // existing -o size when --continue sets Range
}

// mime for bare @file bodies (;type= > suffix > application/json).
fn mime_guess(path: str) -> str {
    dot := rfind(path, ".")
    if dot < 0 {
        return "application/json"
    }
    ext := elwr(substr(path, dot + 1, len(path)))
    if ext == "json" {
        return "application/json"
    }
    if ext == "txt" {
        return "text/plain"
    }
    if ext == "html" || ext == "htm" {
        return "text/html"
    }
    if ext == "xml" {
        return "application/xml"
    }
    if ext == "jpg" || ext == "jpeg" {
        return "image/jpeg"
    }
    if ext == "png" {
        return "image/png"
    }
    if ext == "gif" {
        return "image/gif"
    }
    if ext == "pdf" {
        return "application/pdf"
    }
    return "application/json"
}

fn int_to_f(n: int) -> float {
    f := 0.0
    i := 0
    m := n
    neg := 0
    if m < 0 {
        m = 0 - m
        neg = 1
    }
    for i < m {
        f = f + 1.0
        i = i + 1
    }
    if neg != 0 {
        return 0.0 - f
    }
    return f
}

fn rfind(s: str, sub: str) -> int {
    i := len(s) - len(sub)
    for i >= 0 {
        if substr(s, i, i + len(sub)) == sub {
            return i
        }
        i = i - 1
    }
    return -1
}

// plan builds the model.Req from the Intent per spec sem-A..F.
fn plan(i: ref Intent, env: []str, stdin: str, stdin_tty: int) -> own ReqPlan {
    p := new(ReqPlan)
    p.req = new(model.Req)
    p.sess = new(Sess)
    // session load first (headers/auth/cookies merge below)
    if len(i.session) > 0 {
        [sp, se] = session_path(i, env)
        if se != nil {
            p.err = errors.msg(se)
            return p
        }
        p.sess = session_load(sp)
        if p.sess.ok < 0 {
            p.err = "couldn't load session \"" + sp + "\""
            return p
        }
        p.sess_write = 0
        if i.session_ro == 0 || os.exists(sp) {
            p.sess_write = 1
        }
    }
    // --- stdin body decision (ADR 0022)
    stdin_body := ""
    use_stdin := 0
    // corpus fixture pinning: an EXPLICIT method + empty stdin carries
    // no body (xh emits a bare GET for `xh GET url </dev/null`), while
    // redirected stdin with no explicit method still counts — it forces
    // the default POST and sends CL:0 + json accept/ct.
    if stdin_tty == 0 && i.ignore_stdin == 0 && (len(stdin) > 0 || len(i.method) == 0) {
        body_items := 0
        j := 0
        for j < len(i.ikinds[:]) {
            if i.ikinds[j] >= 5 && i.ikinds[j] <= 9 {
                body_items = 1
            }
            j = j + 1
        }
        if i.body_type == 2 || body_items == 1 {
            if i.body_type == 2 {
                p.err = "Cannot build a multipart request body from stdin"
            } else {
                p.err = "Request body (from stdin) and request data (key=value) cannot be mixed. Pass --ignore-stdin to ignore standard input."
            }
            return p
        }
        if i.has_raw != 0 {
            p.err = "Request body from stdin and --raw cannot be mixed. Pass --ignore-stdin to ignore standard input."
            return p
        }
        use_stdin = 1
        stdin_body = stdin
        // stdin body → POST when no explicit method (upstream decides
        // method AFTER stdin: Body::pick_method)
        if len(i.method) == 0 {
            i.eff_method = "POST"
        }
    }
    // --- headers: fixed slots then merged per spec sem-A
    let hs: []model.Header = nil
    ae := "gzip, deflate"
    if i.download != 0 {
        ae = "identity"
    }
    hs = push(hs, model.Header{name: "Accept-Encoding", value: ae})
    hs = push(hs, model.Header{name: "User-Agent", value: "oxttp/" + version.get()})
    hs = push(hs, model.Header{name: "Connection", value: "close"})
    // body + body-kind headers
    p.req.body = model.Body.Empty
    ct := ""
    accept := ""
    // bare @file body item parses as FormFile with empty key —
    // count those; keyed `field@file` parts are not body files.
    hasfile := 0
    filepath := ""
    filect := ""
    j := 0
    for j < len(i.ikinds[:]) {
        if i.ikinds[j] == 9 {
            [fv, _fe] = item.parse(i.items[j])
            ff := fv as item.Item.FormFile
            if len(ff.key) == 0 {
                hasfile = hasfile + 1
                filepath = ff.file_name
            }
        }
        j = j + 1
    }
    if hasfile > 1 {
        p.err = "Can't read request from multiple files"
        return p
    }
    if hasfile == 1 {
        j = 0
        for j < len(i.ikinds[:]) {
            k := i.ikinds[j]
            if k >= 5 && k <= 8 {
                p.err = "Request body (from a file) and request data (key=value) cannot be mixed."
                return p
            }
            if k == 9 {
                [fv2, _fe2] = item.parse(i.items[j])
                ff2 := fv2 as item.Item.FormFile
                if len(ff2.key) > 0 {
                    p.err = "Request body (from a file) and request data (key=value) cannot be mixed."
                    return p
                }
            }
            j = j + 1
        }
    }
    if use_stdin != 0 {
        p.req.body = model.Body.Raw{ctype: "", text: stdin_body}
        accept = "application/json, */*;q=0.5"
        ct = "application/json"
    } else if len(i.raw) > 0 || i.has_raw != 0 {
        p.req.body = model.Body.Raw{ctype: "", text: i.raw}
        if i.body_type == 1 {
            ct = "application/x-www-form-urlencoded"
        } else {
            accept = "application/json, */*;q=0.5"
            ct = "application/json"
        }
    } else if hasfile == 1 {
        body := os.readfile_(filepath)
        p.req.body = model.Body.Raw{ctype: "", text: body}
        ct = mime_guess(filepath)
    } else if i.body_type == 2 || i.body_type == 1 {
        // form/multipart — collect fields; := items are an error
        let fields: []model.KV = nil
        let parts: []model.Part = nil
        j = 0
        bad := ""
        for j < len(i.items[:]) {
            k := i.ikinds[j]
            s := i.items[j]
            j = j + 1
            if k == 5 || k == 6 {
                [iv, _e] = item.parse(s)
                if iv.kind() == 5 {
                    v := iv as item.Item.DataField
                    if i.body_type == 2 {
                        parts = push(parts, model.Part{name: v.key, value: v.value, file: "", filename: "", content_type: "", enabled: true, is_file: false})
                    } else {
                        fields = push(fields, model.KV{name: v.key, value: v.value, enabled: true})
                    }
                } else if iv.kind() == 6 {
                    v2 := iv as item.Item.DataFieldFromFile
                    fv := os.readfile_(v2.value)
                    if i.body_type == 2 {
                        parts = push(parts, model.Part{name: v2.key, value: fv, file: "", filename: "", content_type: "", enabled: true, is_file: false})
                    } else {
                        fields = push(fields, model.KV{name: v2.key, value: fv, enabled: true})
                    }
                }
            } else if k == 7 || k == 8 {
                bad = "JSON values are not supported in Form fields"
            } else if k == 9 {
                [iv2, _e2] = item.parse(s)
                f := iv2 as item.Item.FormFile
                fname := f.file_name
                if f.has_fname {
                    fname = f.file_name_header
                } else {
                    sl := rfind(fname, "/")
                    if sl >= 0 {
                        fname = substr(fname, sl + 1, len(fname))
                    }
                }
                content := os.readfile_(f.file_name)
                parts = push(parts, model.Part{name: f.key, value: "", file: content, filename: fname, content_type: f.file_type, enabled: true, is_file: true})
            }
        }
        if len(bad) > 0 {
            p.err = bad
            return p
        }
        if i.body_type == 2 || len(parts[:]) > 0 {
            // --form promotes when a file field is present: text
            // fields join as leading parts ahead of file parts
            // (for --multipart they already landed in parts).
            let allparts: []model.Part = nil
            fj := 0
            for fj < len(fields) {
                fl := fields[fj]
                fj = fj + 1
                allparts = push(allparts, model.Part{name: fl.name, value: fl.value, file: "", filename: "", content_type: "", enabled: fl.enabled, is_file: false})
            }
            fj = 0
            for fj < len(parts) {
                allparts = push(allparts, parts[fj])
                fj = fj + 1
            }
            p.req.body = model.Body.Multipart{parts: new(allparts[:])}
            ct = "" // wire render emits multipart boundary CT
        } else {
            p.req.body = model.Body.Form{fields: new(fields[:])}
            ct = "application/x-www-form-urlencoded"
        }
    } else {
        // json kind — flat jadd per spec (nested paths are S6)
        jobj := json.jobj()
        nj := 0
        j = 0
        for j < len(i.items[:]) {
            k := i.ikinds[j]
            s := i.items[j]
            j = j + 1
            if k == 5 {
                [iv, _e] = item.parse(s)
                d := iv as item.Item.DataField
                json.jadd(jobj, d.key, json.jstr(d.value))
                nj = nj + 1
            } else if k == 6 {
                [iv2, _e2] = item.parse(s)
                d2 := iv2 as item.Item.DataFieldFromFile
                json.jadd(jobj, d2.key, json.jstr(os.readfile_(d2.value)))
                nj = nj + 1
            } else if k == 7 {
                [iv3, _e3] = item.parse(s)
                d3 := iv3 as item.Item.JsonField
                json.jadd(jobj, json_key(d3.raw_key), d3.value)
                nj = nj + 1
            } else if k == 8 {
                [iv4, _e4] = item.parse(s)
                d4 := iv4 as item.Item.JsonFieldFromFile
                json.jadd(jobj, json_key(d4.raw_key), json.jparse(os.readfile_(d4.value)))
                nj = nj + 1
            } else if k == 9 {
                p.err = "Can't use file fields in JSON mode (perhaps you meant --form?)"
                return p
            }
        }
        if nj > 0 {
            p.req.body = model.Body.Json{j: jobj}
        } else if i.json_flag != 0 {
            // explicit --json with no data items: headers only
            accept = "application/json, */*;q=0.5"
            ct = "application/json"
        }
        if nj > 0 || i.json_flag != 0 {
            accept = "application/json, */*;q=0.5"
            ct = "application/json"
        }
    }
    if len(accept) > 0 {
        hs = push(hs, model.Header{name: "Accept", value: accept})
    }
    if len(ct) > 0 {
        hs = push(hs, model.Header{name: "Content-Type", value: ct})
    }
    // --- auth (arg > session > netrc)
    auth_line := ""
    if len(i.auth) > 0 {
        at := i.auth_type
        if len(at) == 0 {
            at = "basic"
        }
        if at == "digest" {
            cred := i.auth
            if find(cred, ":") < 0 {
                cred = cred + ":" + prompt_password(i, env)
            }
            colon := find(cred, ":")
            p.digest_user = substr(cred, 0, colon)
            p.digest_pass = substr(cred, colon + 1, len(cred))
            p.digest_cnonce = env_get(env, "XH_TEST_DIGEST_AUTH_CNONCE")
        } else if at == "bearer" {
            auth_line = "Bearer " + i.auth
        } else {
            cred := i.auth
            if find(cred, ":") < 0 {
                cred = cred + ":" + prompt_password(i, env)
            }
            auth_line = "Basic " + base64.encode(cred as []byte)
        }
    } else if len(p.sess.auth_raw) > 0 && p.sess.auth_type == "digest" {
        colon := find(p.sess.auth_raw, ":")
        if colon < 0 {
            colon = len(p.sess.auth_raw)
        }
        p.digest_user = substr(p.sess.auth_raw, 0, colon)
        p.digest_pass = substr(p.sess.auth_raw, colon + 1, len(p.sess.auth_raw))
        p.digest_cnonce = env_get(env, "XH_TEST_DIGEST_AUTH_CNONCE")
    } else if len(p.sess.auth_raw) > 0 {
        auth_line = sess_auth_header(p.sess.auth_type, p.sess.auth_raw)
    } else {
        nc := netrc_auth(i, env)
        if len(nc) > 0 {
            // "B\x01login\x01pass" — basic only this stage
            sp := find(nc, charat(1))
            rest := substr(nc, sp + 1, len(nc))
            sp2 := find(rest, charat(1))
            lg := substr(rest, 0, sp2)
            pw := substr(rest, sp2 + 1, len(rest))
            if i.auth_type == "bearer" {
                auth_line = "Bearer " + pw
            } else if i.auth_type == "digest" {
                p.digest_user = lg
                p.digest_pass = pw
                p.digest_cnonce = env_get(env, "XH_TEST_DIGEST_AUTH_CNONCE")
            } else {
                auth_line = "Basic " + base64.encode((lg + ":" + pw) as []byte)
            }
        }
    }
    if len(auth_line) > 0 {
        hs = push(hs, model.Header{name: "Authorization", value: auth_line})
    }
    // --- merged = session headers then item headers (extend order);
    // each name's values apply to the request via replace+append, and
    // pending unsets swap-remove at the end (http::HeaderMap model).
    let merged: []model.Header = nil
    j = 0
    for j < len(p.sess.headers) {
        h := p.sess.headers[j]
        j = j + 1
        if len(h.name) > 0 {
            merged = push(merged, model.Header{name: h.name, value: h.value})
        }
    }
    let unsets: []str = nil
    qurl := i.url
    qadd := ""
    jar := ""
    j = 0
    for j < len(p.sess.cookies) {
        if len(jar) > 0 {
            jar = jar + "; "
        }
        jar = jar + p.sess.cookies[j]
        j = j + 1
    }
    j = 0
    for j < len(i.items[:]) {
        k := i.ikinds[j]
        s := i.items[j]
        j = j + 1
        if k == 0 || k == 1 {
            [iv, _e] = item.parse(s)
            nm := ""
            val := ""
            if iv.kind() == 0 {
                hh := iv as item.Item.HttpHeader
                nm = hh.key
                val = hh.value
            } else {
                hf := iv as item.Item.HttpHeaderFromFile
                nm = hf.key
                val = trim_ows(os.readfile_(hf.value))
            }
            if elwr(nm) == "cookie" && len(i.session) > 0 {
                if find(jar, val) < 0 {
                    if len(jar) > 0 {
                        jar = jar + "; "
                    }
                    jar = jar + val
                }
                continue
            }
            merged = push(merged, model.Header{name: nm, value: val})
            // a set cancels a pending unset of the same name
            n := 0
            lnm := elwr(nm)
            for n < len(unsets) {
                if unsets[n] == lnm {
                    unsets[n] = ""
                }
                n = n + 1
            }
        } else if k == 2 {
            [iv2, _e2] = item.parse(s)
            hu := iv2 as item.Item.HttpHeaderToUnset
            unsets = push(unsets, elwr(hu.key))
            // unset also drops earlier merged entries of that name
            merged = hunset(merged, hu.key)
        } else if k == 3 || k == 4 {
            [iv3, _e3] = item.parse(s)
            if iv3.kind() == 3 {
                qp := iv3 as item.Item.UrlParam
                qadd = qadd + "&" + url.queryescape(qp.key) + "=" + url.queryescape(qp.value)
            } else {
                qp2 := iv3 as item.Item.UrlParamFromFile
                qadd = qadd + "&" + url.queryescape(qp2.key) + "=" + url.queryescape(os.readfile_(qp2.value))
            }
        }
    }
    // apply merged: first occurrence of a name replaces the request's
    // values at that position; repeats attach right after it.
    let applied: []str = nil
    j = 0
    for j < len(merged) {
        mh := merged[j]
        j = j + 1
        lnm := elwr(mh.name)
        done := 0
        n := 0
        for n < len(applied) {
            if applied[n] == lnm {
                done = 1
            }
            n = n + 1
        }
        if done == 0 {
            // replace all existing values of this name at first slot
            idx := hfind(hs, mh.name)
            if idx >= 0 {
                hs[idx].value = mh.value
                n = idx + 1
                for n < len(hs) {
                    if elwr(hs[n].name) == lnm {
                        hs = hunset_at(hs, n)
                        n = n - 1
                    }
                    n = n + 1
                }
            } else {
                hs = push(hs, model.Header{name: mh.name, value: mh.value})
            }
            applied = push(applied, lnm)
        } else {
            // repeat value: insert right after the last same-name entry
            last := -1
            n = 0
            for n < len(hs) {
                if elwr(hs[n].name) == lnm {
                    last = n
                }
                n = n + 1
            }
            hs = insert_at(hs, last + 1, model.Header{name: mh.name, value: mh.value})
        }
    }
    // pending unsets swap-remove from the request
    j = 0
    for j < len(unsets) {
        if len(unsets[j]) > 0 {
            hs = hunset(hs, unsets[j])
        }
        j = j + 1
    }
    if len(qadd) > 0 {
        if find(qurl, "?") >= 0 {
            qurl = qurl + qadd
        } else {
            qurl = qurl + "?" + substr(qadd, 1, len(qadd))
        }
    }
    // --- synthesized tail (wire: after CL, before Host; display:
    // before CL — corpus §9 wire ordering)
    let synth: []model.Header = nil
    if !hhas(hs, "accept") {
        synth = push(synth, model.Header{name: "Accept", value: "*/*"})
    }
    if len(jar) > 0 {
        if hhas(hs, "cookie") {
            k := hfind(hs, "cookie")
            hs[k].value = hs[k].value + "; " + jar
        } else {
            synth = push(synth, model.Header{name: "Cookie", value: jar})
        }
    }
    p.req.synth = synth
    p.jar = split_semis(jar)
    p.req.method = i.eff_method
    p.req.url = qurl
    p.req.headers = hs
    p.req.timeout_ms = 0
    if i.has_timeout != 0 && i.timeout > 0.0 {
        t := ftoi(i.timeout * 1000.0)
        if t <= 0 {
            t = 1
        }
        p.req.timeout_ms = t
    }
    p.req.follow = (i.follow != 0)
    p.req.max_redirects = i.eff_redirects
    p.req.verify = i.verify
    // WI-0013 sem-S2: --ssl pins the negotiated version range; unset,
    // auto and ssl2.3 all leave 0/0 = build default [V12,V13]
    // (ADR-0032). tls1/1.1 warn+fallback (corpus W-shape, adapted D2).
    if i.ssl == "tls1.2" {
        p.req.ssl_min = tls.V12
        p.req.ssl_max = tls.V12
    } else if i.ssl == "tls1.3" {
        p.req.ssl_min = tls.V13
        p.req.ssl_max = tls.V13
    } else if i.ssl == "tls1" || i.ssl == "tls1.1" {
        p.warn = push(p.warn, "rustls does not support older TLS versions. This build's TLS stack requires TLS >= 1.2 — falling back to TLS 1.2+.")
    }
    // WI-0013 sem-S4: --native-tls warning-degrades on https (single
    // TLS stack — ADR-0031); inert on cleartext.
    if i.native_tls != 0 && url_scheme(i.url) == "https" {
        p.warn = push(p.warn, "--native-tls selects an alternate TLS backend; this build ships one TLS stack (oxl std/net/tls) — using it")
    }
    // WI-0013 sem-S3: --cert/--cert-key read eagerly — upstream loads
    // them at client build, so a missing file errors even on http://
    // or --offline. --curl bypasses client build upstream entirely,
    // so it emits -E verbatim and never touches the files.
    if i.curl == 0 && len(i.cert) > 0 {
        if !os.exists(i.cert) {
            p.err = "cert file not found: " + i.cert
            return p
        }
        p.req.cert_pem = os.readfile_(i.cert)
        if len(i.cert_key) > 0 {
            if !os.exists(i.cert_key) {
                p.err = "cert-key file not found: " + i.cert_key
                return p
            }
            p.req.key_pem = os.readfile_(i.cert_key)
            // an explicitly supplied key file must carry a key —
            // empty content errors rather than silently falling back
            // to the cert PEM (review F1).
            if len(p.req.key_pem) == 0 {
                p.err = "cert-key file is empty: " + i.cert_key
                return p
            }
        }
        // Upstream builds the client (and its identity) eagerly, so a
        // bad PEM errors even on http:// or --offline — same load the
        // transport runs, with the cert-file key fallback.
        kp := p.req.key_pem
        if len(kp) == 0 {
            kp = p.req.cert_pem
        }
        [_, cce] = tls.load_cert_pem(p.req.cert_pem, kp)
        if cce != nil {
            p.err = "couldn't load client certificate: " + errors.msg(cce)
            return p
        }
    }
    if i.http_version == "1.0" {
        p.req.httpver = "HTTP/1.0"
    } else {
        p.req.httpver = "HTTP/1.1"
    }
    // WI-0013 sem-S1: --http-version 2 is an ALPN hint; 2-prior-
    // knowledge forces h2c on http / requires negotiated h2 on https.
    if i.http_version == "2" {
        p.req.h2 = "hint"
    } else if i.http_version == "2-prior-knowledge" {
        p.req.h2 = "prior"
    }
    // WI-0013 sem-S5: --proxy entries + captured env proxies carry to
    // the transport — per-hop resolution (last scheme/all: match
    // wins), NO_PROXY domain match in pick_proxy.
    p.req.proxies = i.proxies[:]
    p.req.proxy_env = i.proxy_env[:]
    p.req.no_proxy = i.no_proxy
    if i.compress_n > 0 {
        p.warn = push(p.warn, "--compress is unsupported in this build; request body sent uncompressed.")
    }
    if i.debug != 0 {
        p.warn = push(p.warn, "--debug logging is unsupported in this build")
    }
    // --continue: when -o exists and has size>0, send Range: bytes=N-
    p.resume_off = 0
    if i.resume != 0 && len(i.output) > 0 && os.exists(i.output) {
        existing := os.readfile_(i.output)
        n := len(existing)
        if n > 0 {
            if hhas(p.req.headers, "range") {
                p.warn = push(p.warn, "--continue can't be used with a 'Range:' header. --continue will be disabled.")
            } else {
                p.req.headers = hput(p.req.headers, "Range", "bytes=" + itoa(n) + "-")
                p.resume_off = n
            }
        }
    }
    // --curl bypasses client build upstream, so transport-side
    // warnings (rustls fallback, native-tls, compress…) never print —
    // only the "Warning: Ignored" lines from curl_ignored land.
    if i.curl != 0 {
        p.warn = nil
    }
    return p
}

fn split_semis(s: str) -> []str {
    let out: []str = nil
    for len(s) > 0 {
        semi := find(s, ";")
        if semi < 0 {
            out = push(out, s)
            break
        }
        out = push(out, substr(s, 0, semi))
        s = substr(s, semi + 1, len(s))
        if len(s) > 0 && byteat(s, 0) == 32 {
            s = substr(s, 1, len(s))
        }
    }
    return out
}

// json_key strips upstream's nested-path syntax into a literal key
// for this stage — `a[b]` stays the literal text (S6 owns nesting).
fn json_key(raw: str) -> str {
    return raw
}

fn trim_ows(s: str) -> str {
    lo := 0
    hi := len(s)
    for lo < hi && (byteat(s, lo) == 32 || byteat(s, lo) == 9) {
        lo = lo + 1
    }
    for hi > lo && (byteat(s, hi - 1) == 32 || byteat(s, hi - 1) == 9) {
        hi = hi - 1
    }
    return substr(s, lo, hi)
}

// trim_hdrfile: upstream header-from-file contents get .trim() — all
// ASCII whitespace including CR/LF, not just OWS.
fn trim_hdrfile(s: str) -> str {
    lo := 0
    hi := len(s)
    for lo < hi {
        c := byteat(s, lo)
        if c == 32 || c == 9 || c == 10 || c == 13 {
            lo = lo + 1
        } else {
            break
        }
    }
    for hi > lo {
        c := byteat(s, hi - 1)
        if c == 32 || c == 9 || c == 10 || c == 13 {
            hi = hi - 1
        } else {
            break
        }
    }
    return substr(s, lo, hi)
}

fn sess_auth_header(t: str, raw: str) -> str {
    if t == "bearer" {
        return "Bearer " + raw
    }
    if len(t) == 0 || t == "basic" {
        return "Basic " + base64.encode(raw as []byte)
    }
    return ""
}

// jget_s fetches a string field's .s ("" when absent/non-str).
fn jget_s(obj: ref json.Json, key: str) -> str {
    v := json.jget(obj, key)
    if v == nil || v.kind != 3 {
        return ""
    }
    return v.s
}

// prompt_password reads a password from /dev/tty (raw echo off is
// S8/termios; the controlling-terminal file is the prompt channel).
fn prompt_password(i: ref Intent, env: []str) -> str {
    [f, e] = os.open("/dev/tty")
    if e != nil {
        return ""
    }
    defer f.close()
    pw := ""
    b := mkslice(byte, 1)
    for true {
        [n, re] = f.read(b)
        if n <= 0 || re != nil || b[0] == 10 {
            break
        }
        if b[0] != 13 {
            pw = pw + b as str
        }
    }
    return pw
}

// --- printer (spec sem-R)

fn canonical_reason(code: int) -> str {
    if code == 200 { return "OK" }
    if code == 201 { return "Created" }
    if code == 202 { return "Accepted" }
    if code == 203 { return "Non-Authoritative Information" }
    if code == 204 { return "No Content" }
    if code == 205 { return "Reset Content" }
    if code == 206 { return "Partial Content" }
    if code == 300 { return "Multiple Choices" }
    if code == 301 { return "Moved Permanently" }
    if code == 302 { return "Found" }
    if code == 303 { return "See Other" }
    if code == 304 { return "Not Modified" }
    if code == 305 { return "Use Proxy" }
    if code == 307 { return "Temporary Redirect" }
    if code == 308 { return "Permanent Redirect" }
    if code == 400 { return "Bad Request" }
    if code == 401 { return "Unauthorized" }
    if code == 402 { return "Payment Required" }
    if code == 403 { return "Forbidden" }
    if code == 404 { return "Not Found" }
    if code == 405 { return "Method Not Allowed" }
    if code == 406 { return "Not Acceptable" }
    if code == 407 { return "Proxy Authentication Required" }
    if code == 408 { return "Request Timeout" }
    if code == 409 { return "Conflict" }
    if code == 410 { return "Gone" }
    if code == 411 { return "Length Required" }
    if code == 412 { return "Precondition Failed" }
    if code == 413 { return "Payload Too Large" }
    if code == 414 { return "URI Too Long" }
    if code == 415 { return "Unsupported Media Type" }
    if code == 416 { return "Range Not Satisfiable" }
    if code == 417 { return "Expectation Failed" }
    if code == 418 { return "I'm a teapot" }
    if code == 421 { return "Misdirected Request" }
    if code == 422 { return "Unprocessable Entity" }
    if code == 423 { return "Locked" }
    if code == 424 { return "Failed Dependency" }
    if code == 425 { return "Too Early" }
    if code == 426 { return "Upgrade Required" }
    if code == 428 { return "Precondition Required" }
    if code == 429 { return "Too Many Requests" }
    if code == 431 { return "Request Header Fields Too Large" }
    if code == 451 { return "Unavailable For Legal Reasons" }
    if code == 500 { return "Internal Server Error" }
    if code == 501 { return "Not Implemented" }
    if code == 502 { return "Bad Gateway" }
    if code == 503 { return "Service Unavailable" }
    if code == 504 { return "Gateway Timeout" }
    if code == 505 { return "HTTP Version Not Supported" }
    if code == 506 { return "Variant Also Negotiates" }
    if code == 507 { return "Insufficient Storage" }
    if code == 508 { return "Loop Detected" }
    if code == 510 { return "Not Extended" }
    if code == 511 { return "Network Authentication Required" }
    return ""
}

fn reason_of(code: int, wire: str) -> str {
    if len(wire) > 0 {
        return wire
    }
    c := canonical_reason(code)
    if len(c) > 0 {
        return c
    }
    return "<unknown status code>"
}

// req_head_render draws the request head exactly as xh prints it:
// status line + title-cased headers + blank line.
fn req_head_render(i: ref Intent, p: ref ReqPlan, f: ref Fmt) -> str {
    [u, _e] = url.parse(p.req.url)
    uri := "/"
    uhost := ""
    scheme := ""
    if _e == nil {
        uri = u.request_uri()
        uhost = u.host
        scheme = u.scheme
    }
    ver := "HTTP/1.1"
    if i.http_version == "1.0" {
        ver = "HTTP/1.0"
    } else if p.req.h2 == "prior" || (p.req.h2 == "hint" && scheme == "https") {
        ver = "HTTP/2.0" // spec D1: h2 modes render the 2.0 token — cleartext hint can't reach h2, keep 1.1
    }
    hs := p.req.headers
    // display synthesis mirrors wire: Accept* / Cookie / CL / Host
    let dh: []model.Header = nil
    k := 0
    for k < len(hs) {
        if len(hs[k].name) > 0 {
            dh = push(dh, hs[k])
        }
        k = k + 1
    }
    // display tail: synth (Accept*/Cookie), then CL, then Host
    k = 0
    for k < len(p.req.synth) {
        dh = push(dh, p.req.synth[k])
        k = k + 1
    }
    if !hhas(dh, "content-length") && p.req.body.kind() != 0 {
        body_len := body_len_of(p.req.body)
        dh = push(dh, model.Header{name: "Content-Length", value: itoa(body_len)})
    }
    if !hhas(dh, "host") {
        dh = push(dh, model.Header{name: "Host", value: uhost})
    }
    if f.headers_sort != 0 {
        let sd: own []model.Header = hsort_copy(dh)
        dh = sd[:]
    }
    // titlecase only for HTTP/1.x heads (upstream headers_fmt).
    // headers.rs::print_request_headers element order under color:
    // method → path(+?query) → HTTP/x.y triple → headers → reset.
    line := ""
    if f.color != 0 {
        ci := find(ver, "/")
        kw := ver
        vn := ""
        if ci >= 0 {
            kw = substr(ver, 0, ci)
            vn = substr(ver, ci + 1, len(ver))
        }
        line = sgr_wrap("method", i.eff_method, f) + sgr_plain(" ", f) + sgr_wrap("path", uri, f) + sgr_plain(" ", f) + sgr_wrap("http_keyword", kw, f) + sgr_wrap("http_separator", "/", f) + sgr_wrap("http_version", vn, f) + sgr_plain("\n", f)
    } else {
        line = i.eff_method + " " + uri + " " + ver + "\n"
    }
    out := line + htitle(dh, booli(ver != "HTTP/2.0"), f)
    if f.color != 0 {
        out = out + "\x1b[0m"
    }
    return out + "\n"
}

fn body_len_of(b: model.Body) -> int {
    [rb, e] = http.RenderBody(b)
    if e != nil {
        return 0
    }
    return len(rb.data)
}

fn render_form_str(fs: []model.KV) -> str {
    out := ""
    i := 0
    for i < len(fs) {
        if i > 0 {
            out = out + "&"
        }
        out = out + url.queryescape(fs[i].name) + "=" + url.queryescape(fs[i].value)
        i = i + 1
    }
    return out
}

// resp_head_render: "HTTP/x.y CODE reason" + headers (sorted +
// title-cased for HTTP/1.x only, latin1/UTF-8-annotated values).
fn resp_head_render(version: str, status: int, reason: str, headers: []model.Header, f: ref Fmt) -> str {
    ver := version
    if len(ver) == 0 {
        ver = "1.1"
    }
    let hh: []model.Header = headers
    if f.headers_sort != 0 {
        let sh: own []model.Header = hsort_copy(headers)
        hh = sh[:]
    }
    t1 := 1
    if len(ver) >= 1 && substr(ver, 0, 1) != "1" {
        t1 = 0
    }
    // headers.rs::print_response_headers element order under color:
    // HTTP/x.y triple → status_code → status_reason → headers → reset.
    line := ""
    if f.color != 0 {
        line = sgr_wrap("http_keyword", "HTTP", f) + sgr_wrap("http_separator", "/", f) + sgr_wrap("http_version", ver, f) + sgr_plain(" ", f) + sgr_wrap("status_code", itoa(status), f) + sgr_plain(" ", f) + sgr_wrap("status_reason", reason_of(status, reason), f) + sgr_plain("\n", f)
    } else {
        line = "HTTP/" + ver + " " + itoa(status) + " " + reason_of(status, reason) + "\n"
    }
    out := line + htitle(hh, t1, f)
    if f.color != 0 {
        out = out + "\x1b[0m"
    }
    return out + "\n"
}

// shquote wraps s in single quotes for a POSIX shell, escaping
// embedded ' as '\''.
fn shquote(s: str) -> str {
    out := "'"
    i := 0
    for i < len(s) {
        if byteat(s, i) == 39 {
            out = out + "'\\''"
        } else {
            out = out + substr(s, i, i + 1)
        }
        i = i + 1
    }
    return out + "'"
}

// curl_ignored appends xh-shaped "Warning: Ignored …" lines for
// flags that affect oxttp output/session but not the curl argv map.
// --- --curl faithful emit (WI-0016 spec S1, ADR-0039) -------------

// curl_esc_cp reports the escape-needed codepoints for the $'…' form:
// C0/C1 controls, U+2028/2029, bidi format/isolate chars (os_display
// requires_escape ∪ is_bidi).
fn curl_esc_cp(cp: int) -> int {
    if cp <= 31 || cp >= 127 && cp <= 159 {
        return 1
    }
    if cp == 8232 || cp == 8233 {
        return 1
    }
    if cp >= 8234 && cp <= 8238 || cp >= 8294 && cp <= 8297 {
        return 1
    }
    return 0
}

// curl_bidi reports the bidi ranges os_display flags for the
// suspicious check (202A-202E, 2066-2069).
fn curl_bidi(cp: int) -> int {
    if cp >= 8234 && cp <= 8238 || cp >= 8294 && cp <= 8297 {
        return 1
    }
    return 0
}

// curl_zw approximates unicode-width's zero-width set for the
// leading-char quote check (combining marks, format chars, tags,
// variation selectors).
fn curl_zw(cp: int) -> int {
    if cp >= 768 && cp <= 879 || cp >= 6832 && cp <= 6911 || cp >= 7616 && cp <= 7679 {
        return 1
    }
    if cp >= 8400 && cp <= 8447 || cp >= 65056 && cp <= 65071 {
        return 1
    }
    if cp == 173 || cp == 847 || cp == 1564 || cp == 4447 || cp == 4448 || cp == 65279 {
        return 1
    }
    if cp >= 5906 && cp <= 5909 || cp >= 11647 && cp <= 11648 || cp == 12644 || cp == 65440 {
        return 1
    }
    if cp >= 8203 && cp <= 8207 || cp >= 8288 && cp <= 8303 || cp >= 65520 && cp <= 65528 {
        return 1
    }
    if cp >= 113824 && cp <= 113827 || cp >= 917504 && cp <= 917631 || cp >= 917760 && cp <= 917999 {
        return 1
    }
    return 0
}

// hexesc renders "\xHH" uppercase-hex.
fn hexesc(c: int) -> str {
    h := "0123456789ABCDEF"
    return "\\x" + charat(byteat(h, c / 16)) + charat(byteat(h, c % 16))
}

// curl_escaped ports write_escaped — the $'…' ANSI-C form used when a
// string carries control/non-printable/bidi bytes or invalid UTF-8.
fn curl_escaped(s: str) -> str {
    out := "$'"
    in_esc := 0
    i := 0
    for i < len(s) {
        c := byteat(s, i)
        if c < 128 {
            if c == 10 {
                out = out + "\\n"
                in_esc = 0
            } else if c == 9 {
                out = out + "\\t"
                in_esc = 0
            } else if c == 13 {
                out = out + "\\r"
                in_esc = 0
            } else if c < 32 || c == 127 {
                out = out + hexesc(c)
                in_esc = 1
            } else if c == 92 || c == 39 {
                out = out + "\\" + charat(c)
                in_esc = 0
            } else {
                if in_esc != 0 && is_hexc(c) {
                    out = out + "'$'"
                }
                out = out + charat(c)
                in_esc = 0
            }
            i = i + 1
            continue
        }
        cr := u8_dec(s, i)
        cp := cr[0]
        n := cr[1]
        if n == 1 {
            out = out + hexesc(c)
            in_esc = 1
            i = i + 1
            continue
        }
        if curl_esc_cp(cp) != 0 {
            j := 0
            for j < n {
                out = out + hexesc(byteat(s, i + j))
                j = j + 1
            }
            in_esc = 1
        } else {
            out = out + substr(s, i, i + n)
            in_esc = 0
        }
        i = i + n
    }
    return out + "'"
}

// curl_spliced ports write_single_escaped: 'chunk' per non-empty
// chunk, \' between them — used when both quote kinds are unsafe.
fn curl_spliced(s: str) -> str {
    out := ""
    st := 0
    i := 0
    for i <= len(s) {
        if i == len(s) || byteat(s, i) == 39 {
            if i > st {
                out = out + "'" + substr(s, st, i) + "'"
            }
            if i < len(s) {
                out = out + "\\'"
            }
            st = i + 1
        }
        i = i + 1
    }
    return out
}

// curl_suspicious ports is_suspicious_bidi: 16-deep stack of
// Formatting (202A/B/D/E) vs Isolate (2066-68); unpaired/overflow → 1.
fn curl_suspicious(s: str) -> int {
    st := mkslice(int, 16)
    pos := 0
    i := 0
    for i < len(s) {
        c := byteat(s, i)
        if c < 128 {
            i = i + 1
            continue
        }
        cr := u8_dec(s, i)
        cp := cr[0]
        n := cr[1]
        i = i + n
        if cp == 8234 || cp == 8235 || cp == 8237 || cp == 8238 {
            if pos >= 16 {
                return 1
            }
            st[pos] = 1
            pos = pos + 1
        } else if cp == 8236 {
            if pos == 0 {
                return 1
            }
            pos = pos - 1
            if st[pos] != 1 {
                return 1
            }
        } else if cp >= 8294 && cp <= 8296 {
            if pos >= 16 {
                return 1
            }
            st[pos] = 2
            pos = pos + 1
        } else if cp == 8297 {
            if pos == 0 {
                return 1
            }
            pos = pos - 1
            if st[pos] != 2 {
                return 1
            }
        }
    }
    if pos != 0 {
        return 1
    }
    return 0
}

// curl_q ports os_display::Quotable::maybe_quote unix rules (spec
// S1.10): quote iff empty ∨ first byte ∈ {~,#,!} ∨ leading
// zero-width ∨ contains |&;<>()$`"'*?[]=^{} space/tab ∨ unicode
// whitespace ∨ U+2800. '…' preferred, "…" when a ' is present,
// '…'\''…' splice when both are unsafe, $'…' for non-printable.
fn curl_q(s: str) -> str {
    single := 1
    double := 1
    req := 0
    if len(s) == 0 {
        req = 1
    } else {
        fr := u8_dec(s, 0)
        fc := fr[0]
        fnb := fr[1]
        if fc == 126 || fc == 35 || fc == 33 {
            req = 1
        }
        if req == 0 && fnb == 1 && fc < 32 {
            req = 1
        }
        if fnb == 1 && fc == 127 {
            req = 1
        }
        if req == 0 && fnb > 1 && curl_zw(fc) != 0 {
            req = 1
        }
    }
    bidi := 0
    i := 0
    for i < len(s) {
        c := byteat(s, i)
        if c < 128 {
            if c == 39 {
                single = 0
            }
            if c == 34 || c == 96 || c == 36 || c == 92 {
                double = 0
            }
            if req == 0 {
                if c == 124 || c == 38 || c == 59 || c == 60 || c == 62 || c == 40 || c == 41 || c == 36 || c == 96 || c == 34 || c == 39 || c == 42 || c == 63 || c == 91 || c == 93 || c == 61 || c == 94 || c == 123 || c == 125 || c == 32 || c == 9 {
                    req = 1
                }
            }
            if c < 32 || c == 127 {
                return curl_escaped(s)
            }
            i = i + 1
            continue
        }
        cr := u8_dec(s, i)
        cp := cr[0]
        n := cr[1]
        if n == 1 {
            return curl_escaped(s)
        }
        if req == 0 && (uni_ws(cp) != 0 || cp == 10240) {
            req = 1
        }
        if curl_bidi(cp) != 0 {
            bidi = 1
        }
        if curl_esc_cp(cp) != 0 {
            return curl_escaped(s)
        }
        i = i + n
    }
    if bidi != 0 && curl_suspicious(s) != 0 {
        return curl_escaped(s)
    }
    if req == 0 {
        return s
    }
    if single != 0 {
        return "'" + s + "'"
    }
    if double != 0 {
        return "\"" + s + "\""
    }
    return curl_spliced(s)
}

// form_urlenc ports serde_urlencoded's key encoding: alnum + *-._
// literal, space → '+', else %XX uppercase.
fn form_urlenc(s: str) -> str {
    h := "0123456789ABCDEF"
    out := ""
    i := 0
    for i < len(s) {
        c := byteat(s, i)
        i = i + 1
        if c >= 97 && c <= 122 || c >= 65 && c <= 90 || c >= 48 && c <= 57 || c == 42 || c == 45 || c == 46 || c == 95 {
            out = out + charat(c)
        } else if c == 32 {
            out = out + "+"
        } else {
            out = out + "%" + charat(byteat(h, c / 16)) + charat(byteat(h, c % 16))
        }
    }
    return out
}

// sdrop_at removes index i of a str slice.
fn sdrop_at(xs: []str, i: int) -> []str {
    out := mkslice(str, 0)
    j := 0
    for j < len(xs) {
        if j != i {
            out = push(out, xs[j])
        }
        j = j + 1
    }
    return out
}

// sdrop removes every xs entry equal to v.
fn sdrop(xs: []str, v: str) -> []str {
    out := mkslice(str, 0)
    j := 0
    for j < len(xs) {
        if xs[j] != v {
            out = push(out, xs[j])
        }
        j = j + 1
    }
    return out
}

// tilde_expand maps `~`/`~/x` → $HOME[/x] (upstream expand_tilde).
fn tilde_expand(path: str, env: []str) -> str {
    if len(path) >= 1 && byteat(path, 0) == 126 && (len(path) == 1 || byteat(path, 1) == 47) {
        h := env_get(env, "HOME")
        if len(h) > 0 {
            return h + substr(path, 1, len(path))
        }
    }
    return path
}

// CurlC is the translate() accumulator: env prefixes render before
// `curl`, warns go to stderr, err aborts the emit (exit 1).
struct CurlC {
    long: int,
    args: []str,
    env: []str,
    warn: []str,
    err: str,
}

fn cc_opt(c: ref CurlC, s: str, l: str) {
    if c.long != 0 {
        c.args = push(c.args, l)
    } else {
        c.args = push(c.args, s)
    }
}

fn cc_arg(c: ref CurlC, a: str) {
    c.args = push(c.args, a)
}

fn cc_env(c: ref CurlC, n: str, v: str) {
    c.env = push(c.env, n + "=" + curl_q(v))
}

fn cc_warn(c: ref CurlC, w: str) {
    c.warn = push(c.warn, w)
}

fn cc_hdr(c: ref CurlC, n: str, v: str) {
    cc_opt(c, "-H", "--header")
    cc_arg(c, n + ": " + v)
}

// curl_pick_method ports RequestItems::pick_method — POST iff the
// request items form a non-empty body (raw/stdin don't count).
fn curl_pick_method(i: ref Intent) -> str {
    if i.body_type == 2 {
        return "POST"
    }
    j := 0
    for j < len(i.ikinds[:]) {
        if i.ikinds[j] >= 5 && i.ikinds[j] <= 9 {
            return "POST"
        }
        j = j + 1
    }
    return "GET"
}

// curl_is_multipart ports RequestItems::is_multipart: --multipart, or
// --form when any FormFile is present.
fn curl_is_multipart(i: ref Intent) -> int {
    if i.body_type == 2 {
        return 1
    }
    if i.body_type == 1 {
        j := 0
        for j < len(i.ikinds[:]) {
            if i.ikinds[j] == 9 {
                return 1
            }
            j = j + 1
        }
    }
    return 0
}

// curl_url ports url_with_query: UrlParam items appended with
// queryescaping (UrlParamFromFile reads propagate as errors).
fn curl_url(i: ref Intent, c: ref CurlC, env: []str) -> str {
    q := ""
    j := 0
    for j < len(i.items[:]) {
        k := i.ikinds[j]
        s := i.items[j]
        j = j + 1
        if k == 3 {
            [iv, _e] = item.parse(s)
            qp := iv as item.Item.UrlParam
            q = q + "&" + url.queryescape(qp.key) + "=" + url.queryescape(qp.value)
        } else if k == 4 {
            [iv2, _e2] = item.parse(s)
            qp2 := iv2 as item.Item.UrlParamFromFile
            fp := tilde_expand(qp2.value, env)
            if !os.exists(fp) {
                c.err = "couldn't read file " + qp2.value
                return ""
            }
            q = q + "&" + url.queryescape(qp2.key) + "=" + url.queryescape(os.readfile_(fp))
        }
    }
    u := i.url
    if len(q) > 0 {
        if find(u, "?") >= 0 {
            u = u + q
        } else {
            u = u + "?" + substr(q, 1, len(q))
        }
    }
    return u
}

// curl_url_port: URL explicit port else 443 https / 80 http
// (url.port_or_known_default for the --resolve emit).
fn curl_url_port(i: ref Intent) -> int {
    [u, e] = url.parse(i.url)
    if e == nil {
        pp := u.port()
        if len(pp) > 0 {
            [n, _ne] = strconv.atoi(pp)
            return n
        }
    }
    if url_scheme(i.url) == "https" {
        return 443
    }
    return 80
}

// curl_translate ports to_curl.rs::translate verbatim: warnings →
// c.warn (bare `Warning:` lines on stderr + blank separator), flags
// in upstream order → c.args, proxy envs → c.env, item headers +
// unsets, auth, payload. c.err carries the propagate-exit-1 errors.
fn curl_translate(i: ref Intent, env: []str) -> own CurlC {
    c := new(CurlC)
    c.long = i.curl_long
    // 1a. ignored-table warnings — upstream order, verbatim
    if i.offline != 0 {
        cc_warn(c, "Ignored --offline")
    }
    if i.body != 0 {
        cc_warn(c, "Ignored -b/--body")
    }
    if i.has_print != 0 {
        cc_warn(c, "Ignored -p/--print")
    }
    if i.has_pretty != 0 {
        cc_warn(c, "Ignored --pretty")
    }
    if len(i.style) > 0 {
        cc_warn(c, "Ignored -s/--style")
    }
    if len(i.m_sig_id) > 0 {
        cc_warn(c, "Ignored --unstable-m-sig-id")
    }
    if len(i.m_sig_key) > 0 {
        cc_warn(c, "Ignored --unstable-m-sig-key")
    }
    if len(i.m_sig_alg) > 0 {
        cc_warn(c, "Ignored --unstable-m-sig-alg")
    }
    if len(i.m_sig_comps[:]) > 0 {
        cc_warn(c, "Ignored --unstable-m-sig-comp")
    }
    if i.compress_n != 0 {
        cc_warn(c, "Ignored -x/--compress")
    }
    if len(i.response_charset) > 0 {
        cc_warn(c, "Ignored --response-charset")
    }
    if len(i.response_mime) > 0 {
        cc_warn(c, "Ignored --response-mime")
    }
    if i.all != 0 {
        cc_warn(c, "Ignored --all")
    }
    if i.has_history != 0 {
        cc_warn(c, "Ignored -P/--history-print")
    }
    if len(i.session) > 0 || i.session_ro != 0 {
        cc_warn(c, "Ignored --session")
    }
    if i.native_tls != 0 {
        cc_warn(c, "Ignored --native-tls")
    }
    // silently ignored: --ignore-stdin, --curl, --curl-long
    // 1b. follow + explicit non-GET method
    if i.follow != 0 && len(i.method) > 0 && i.method != "GET" {
        cc_warn(c, "Using a combination of -X/--request and -L/--location which may cause unintended side effects.")
    }
    // 2. flag block — upstream sequence
    if i.verbose > 0 {
        cc_opt(c, "-v", "--verbose")
    }
    if i.quiet > 0 {
        cc_opt(c, "-s", "--silent")
    }
    if i.debug != 0 {
        cc_arg(c, "--trace")
        cc_arg(c, "-")
    }
    if i.stream == 1 {
        cc_opt(c, "-N", "--no-buffer")
    }
    if i.check_status == 1 {
        cc_opt(c, "-f", "--fail")
    }
    if i.follow != 0 {
        cc_opt(c, "-L", "--location")
    }
    if i.has_maxredirs != 0 {
        cc_arg(c, "--max-redirs")
        cc_arg(c, itoa(i.max_redirects))
    }
    if len(i.output) > 0 {
        cc_opt(c, "-o", "--output")
        cc_arg(c, i.output)
    } else if i.download != 0 {
        cc_opt(c, "-O", "--remote-name")
    }
    if i.resume != 0 {
        cc_opt(c, "-C", "--continue-at")
        cc_arg(c, "-")
    }
    if i.verify == "no" {
        cc_opt(c, "-k", "--insecure")
    } else if len(i.verify) > 0 && i.verify != "yes" {
        cc_arg(c, "--cacert")
        cc_arg(c, i.verify)
    }
    if len(i.cert) > 0 {
        cc_opt(c, "-E", "--cert")
        cc_arg(c, i.cert)
    }
    if len(i.cert_key) > 0 {
        cc_arg(c, "--key")
        cc_arg(c, i.cert_key)
    }
    sv := ""
    if i.ssl == "tls1" {
        sv = "1.0"
    }
    if i.ssl == "tls1.1" {
        sv = "1.1"
    }
    if i.ssl == "tls1.2" {
        sv = "1.2"
    }
    if i.ssl == "tls1.3" {
        sv = "1.3"
    }
    if len(sv) > 0 {
        cc_arg(c, "--tlsv" + sv)
        cc_arg(c, "--tls-max")
        cc_arg(c, sv)
    }
    // proxies → env prefixes (DevD1: all:→all_proxy; DevD2: clearing
    // emits for unset protos + no_proxy when any --proxy present).
    seen_http := 0
    seen_https := 0
    seen_all := 0
    pxi := 0
    for pxi < len(i.proxies[:]) {
        pent := i.proxies[pxi]
        pxi = pxi + 1
        ci := find(pent, ":")
        if ci < 0 {
            continue
        }
        proto := elwr(substr(pent, 0, ci))
        purl := substr(pent, ci + 1, len(pent))
        if proto == "all" {
            seen_all = 1
            cc_env(c, "all_proxy", purl)
        } else if proto == "http" {
            seen_http = 1
            cc_env(c, "http_proxy", purl)
        } else if proto == "https" {
            seen_https = 1
            cc_env(c, "https_proxy", purl)
        }
    }
    if seen_http + seen_https + seen_all > 0 {
        if seen_http == 0 {
            c.env = push(c.env, "http_proxy=")
            c.env = push(c.env, "HTTP_PROXY=")
        }
        if seen_https == 0 {
            c.env = push(c.env, "https_proxy=")
            c.env = push(c.env, "HTTPS_PROXY=")
        }
        if seen_all == 0 {
            c.env = push(c.env, "all_proxy=")
            c.env = push(c.env, "ALL_PROXY=")
        }
        c.env = push(c.env, "no_proxy=")
        c.env = push(c.env, "NO_PROXY=")
    }
    if i.has_timeout != 0 {
        cc_arg(c, "--max-time")
        cc_arg(c, strconv.formatfloat(i.timeout))
    }
    if i.http_version == "1.0" {
        cc_arg(c, "--http1.0")
    }
    if i.http_version == "1.1" {
        cc_arg(c, "--http1.1")
    }
    if i.http_version == "2" {
        cc_arg(c, "--http2")
    }
    if i.http_version == "2-prior-knowledge" {
        cc_arg(c, "--http2-prior-knowledge")
    }
    // h3 IS reachable under --curl (upstream short-circuits before
    // the feature gate): 3-prior → --http3-only.
    if i.http_version == "3-prior-knowledge" {
        cc_arg(c, "--http3-only")
    }
    // method emit — HEAD / OPTIONS / -h / explicit / implicit
    if i.method == "HEAD" {
        cc_opt(c, "-I", "--head")
    } else if i.method == "OPTIONS" {
        cc_opt(c, "-i", "--include")
        cc_opt(c, "-X", "--request")
        cc_arg(c, "OPTIONS")
    } else if i.headers != 0 {
        m := i.method
        if len(m) == 0 {
            m = curl_pick_method(i)
        }
        cc_opt(c, "-I", "--head")
        cc_opt(c, "-X", "--request")
        cc_arg(c, m)
        if m != "GET" {
            cc_warn(c, "-I/--head is incompatible with sending data. Consider omitting -h/--headers.")
        }
    } else if len(i.method) > 0 {
        cc_opt(c, "-X", "--request")
        cc_arg(c, i.method)
    }
    // URL + query items; -g when []{} present
    furl := curl_url(i, c, env)
    if len(c.err) > 0 {
        return c
    }
    if find(furl, "[") >= 0 || find(furl, "]") >= 0 || find(furl, "{") >= 0 || find(furl, "}") >= 0 {
        cc_opt(c, "-g", "--globoff")
    }
    cc_arg(c, furl)
    if i.ipv4 != 0 && i.ipv6 == 0 {
        cc_opt(c, "-4", "--ipv4")
    }
    if i.ipv6 != 0 && i.ipv4 == 0 {
        cc_opt(c, "-6", "--ipv6")
    }
    if len(i.interface) > 0 {
        cc_arg(c, "--interface")
        cc_arg(c, i.interface)
    }
    if len(i.unix_socket) > 0 {
        cc_arg(c, "--unix-socket")
        cc_arg(c, i.unix_socket)
    }
    if len(i.resolves[:]) > 0 {
        port := curl_url_port(i)
        cc_warn(c, "Inferred port number in --resolve from request URL.")
        ri := 0
        for ri < len(i.resolves[:]) {
            rs := i.resolves[ri]
            ri = ri + 1
            ci2 := find(rs, ":")
            if ci2 < 0 {
                continue
            }
            cc_arg(c, "--resolve")
            // upstream parses the addr as IpAddr — brackets around an
            // IPv6 literal are syntax, not part of the emitted value.
            addr := substr(rs, ci2 + 1, len(rs))
            if len(addr) >= 2 && byteat(addr, 0) == 91 && byteat(addr, len(addr) - 1) == 93 {
                addr = substr(addr, 1, len(addr) - 1)
            }
            cc_arg(c, substr(rs, 0, ci2) + ":" + itoa(port) + ":" + addr)
        }
    }
    // item headers (lowercased; unsets cancel/re-emit per upstream
    // headers()): emits keep item order, unsets follow in encounter
    // order.
    let hp_n: []str = nil
    let hp_v: []str = nil
    let hset: []str = nil
    j := 0
    for j < len(i.items[:]) {
        k := i.ikinds[j]
        s := i.items[j]
        j = j + 1
        if k == 0 || k == 1 {
            nm := ""
            vv := ""
            if k == 0 {
                [iv, _e] = item.parse(s)
                h := iv as item.Item.HttpHeader
                nm = elwr(h.key)
                vv = h.value
            } else {
                [iv2, _e2] = item.parse(s)
                h2 := iv2 as item.Item.HttpHeaderFromFile
                nm = elwr(h2.key)
                fp := tilde_expand(h2.value, env)
                if !os.exists(fp) {
                    c.err = "couldn't read header file " + h2.value
                    return c
                }
                vv = trim_hdrfile(os.readfile_(fp))
            }
            hset = sdrop(hset, nm)
            hp_n = push(hp_n, nm)
            hp_v = push(hp_v, vv)
        } else if k == 2 {
            [iv3, _e3] = item.parse(s)
            hu := iv3 as item.Item.HttpHeaderToUnset
            nm2 := elwr(hu.key)
            ni := 0
            for ni < len(hp_n) {
                if hp_n[ni] == nm2 {
                    hp_n = sdrop_at(hp_n, ni)
                    hp_v = sdrop_at(hp_v, ni)
                    ni = ni - 1
                }
                ni = ni + 1
            }
            if !has_str(hset, nm2) {
                hset = push(hset, nm2)
            }
        }
    }
    j = 0
    for j < len(hp_n) {
        if len(hp_v[j]) == 0 {
            cc_opt(c, "-H", "--header")
            cc_arg(c, hp_n[j] + ";")
        } else {
            cc_hdr(c, hp_n[j], hp_v[j])
        }
        j = j + 1
    }
    j = 0
    for j < len(hset) {
        cc_opt(c, "-H", "--header")
        cc_arg(c, hset[j] + ":")
        j = j + 1
    }
    if i.ignore_netrc != 0 {
        cc_arg(c, "--no-netrc")
    }
    if len(i.auth) > 0 {
        at := i.auth_type
        if at == "digest" {
            cc_arg(c, "--digest")
            cc_opt(c, "-u", "--user")
            cc_arg(c, i.auth)
        } else if at == "bearer" {
            cc_arg(c, "--oauth2-bearer")
            cc_arg(c, i.auth)
        } else {
            cc_arg(c, "--basic")
            cc_opt(c, "-u", "--user")
            cc_arg(c, i.auth)
        }
    }
    // payload emitters by body kind (spec S1.8)
    if i.has_raw != 0 {
        if i.body_type == 1 {
            cc_hdr(c, "content-type", "application/x-www-form-urlencoded")
        } else {
            cc_hdr(c, "content-type", "application/json")
            cc_hdr(c, "accept", "application/json, */*;q=0.5")
        }
        cc_opt(c, "-d", "--data")
        cc_arg(c, i.raw)
    } else if curl_is_multipart(i) != 0 {
        j = 0
        for j < len(i.items[:]) {
            k := i.ikinds[j]
            s := i.items[j]
            j = j + 1
            if k == 7 || k == 8 {
                c.err = "JSON values are not supported in multipart fields"
                return c
            }
            if k == 5 {
                [iv, _e] = item.parse(s)
                d := iv as item.Item.DataField
                cc_opt(c, "-F", "--form")
                cc_arg(c, d.key + "=" + d.value)
            } else if k == 6 {
                [iv2, _e2] = item.parse(s)
                d2 := iv2 as item.Item.DataFieldFromFile
                cc_opt(c, "-F", "--form")
                cc_arg(c, d2.key + "=<" + d2.value)
            } else if k == 9 {
                [iv3, _e3] = item.parse(s)
                f := iv3 as item.Item.FormFile
                fv := f.key + "=@" + f.file_name
                if f.has_type {
                    fv = fv + ";type=" + f.file_type
                }
                if f.has_fname {
                    fv = fv + ";filename=" + f.file_name_header
                }
                cc_opt(c, "-F", "--form")
                cc_arg(c, fv)
            }
        }
    } else if i.body_type == 1 {
        // Body::Form → --data-urlencode 'enc(k)=v' per field;
        // empty → forced urlencoded ct header.
        nf := 0
        j = 0
        for j < len(i.items[:]) {
            k := i.ikinds[j]
            s := i.items[j]
            j = j + 1
            if k == 7 || k == 8 {
                c.err = "JSON values are not supported in Form fields"
                return c
            }
            if k == 5 || k == 6 {
                kk := ""
                vv := ""
                if k == 5 {
                    [iv, _e] = item.parse(s)
                    d := iv as item.Item.DataField
                    kk = d.key
                    vv = d.value
                } else {
                    [iv2, _e2] = item.parse(s)
                    d2 := iv2 as item.Item.DataFieldFromFile
                    kk = d2.key
                    fp2 := tilde_expand(d2.value, env)
                    if !os.exists(fp2) {
                        c.err = "couldn't read data file " + d2.value
                        return c
                    }
                    vv = os.readfile_(fp2)
                }
                nf = nf + 1
                cc_arg(c, "--data-urlencode")
                cc_arg(c, form_urlenc(kk) + "=" + vv)
            }
        }
        if nf == 0 {
            cc_hdr(c, "content-type", "application/x-www-form-urlencoded")
        }
    } else {
        // JSON mode — body_from_file when any FormFile is present
        haskeyed := 0
        hasff := 0
        j = 0
        for j < len(i.items[:]) {
            if i.ikinds[j] == 9 {
                [ivf, _ef] = item.parse(i.items[j])
                ff3 := ivf as item.Item.FormFile
                if len(ff3.key) > 0 {
                    haskeyed = 1
                }
                hasff = 1
            }
            j = j + 1
        }
        if haskeyed != 0 {
            c.err = "Can't use file fields in JSON mode (perhaps you meant --form?)"
            return c
        }
        if hasff != 0 {
            fct := ""
            ffname := ""
            nfiles := 0
            j = 0
            for j < len(i.items[:]) {
                k := i.ikinds[j]
                s := i.items[j]
                j = j + 1
                if k >= 5 && k <= 8 {
                    c.err = "Request body (from a file) and request data (key=value) cannot be mixed."
                    return c
                }
                if k == 9 {
                    [ivf2, _ef2] = item.parse(s)
                    ff2 := ivf2 as item.Item.FormFile
                    nfiles = nfiles + 1
                    if nfiles > 1 {
                        c.err = "Can't read request from multiple files"
                        return c
                    }
                    fct = ff2.file_type
                    if len(fct) == 0 {
                        fct = mime_guess(ff2.file_name)
                    }
                    ffname = ff2.file_name
                }
            }
            cc_hdr(c, "content-type", fct)
            cc_arg(c, "--data-binary")
            cc_arg(c, "@" + tilde_expand(ffname, env))
        } else {
            // Body::Json — compact emit preserving insertion order;
            // null body + explicit --json → the two headers only.
            jobj := json.jobj()
            nj := 0
            j = 0
            for j < len(i.items[:]) {
                k := i.ikinds[j]
                s := i.items[j]
                j = j + 1
                if k == 5 {
                    [iv, _e] = item.parse(s)
                    d := iv as item.Item.DataField
                    json.jadd(jobj, d.key, json.jstr(d.value))
                    nj = nj + 1
                } else if k == 6 {
                    [iv2, _e2] = item.parse(s)
                    d2 := iv2 as item.Item.DataFieldFromFile
                    fp3 := tilde_expand(d2.value, env)
                    if !os.exists(fp3) {
                        c.err = "couldn't read data file " + d2.value
                        return c
                    }
                    json.jadd(jobj, d2.key, json.jstr(os.readfile_(fp3)))
                    nj = nj + 1
                } else if k == 7 {
                    [iv3, _e3] = item.parse(s)
                    d3 := iv3 as item.Item.JsonField
                    json.jadd(jobj, json_key(d3.raw_key), d3.value)
                    nj = nj + 1
                } else if k == 8 {
                    [iv4, _e4] = item.parse(s)
                    d4 := iv4 as item.Item.JsonFieldFromFile
                    fp4 := tilde_expand(d4.value, env)
                    if !os.exists(fp4) {
                        c.err = "couldn't read data file " + d4.value
                        return c
                    }
                    json.jadd(jobj, json_key(d4.raw_key), json.jparse(os.readfile_(fp4)))
                    nj = nj + 1
                }
            }
            if nj > 0 {
                cc_hdr(c, "content-type", "application/json")
                cc_hdr(c, "accept", "application/json, */*;q=0.5")
                cc_opt(c, "-d", "--data")
                cc_arg(c, json.tojson(jobj))
            } else if i.json_flag != 0 {
                cc_hdr(c, "content-type", "application/json")
                cc_hdr(c, "accept", "application/json, */*;q=0.5")
            }
        }
    }
    return c
}

// curl_render → the Command Display: "NAME=<q> … curl <q-arg>…".
fn curl_render(c: ref CurlC) -> str {
    out := ""
    j := 0
    for j < len(c.env) {
        out = out + c.env[j] + " "
        j = j + 1
    }
    out = out + "curl"
    j = 0
    for j < len(c.args) {
        out = out + " " + curl_q(c.args[j])
        j = j + 1
    }
    return out
}

// curl_warn_render → bare `Warning: <msg>` lines + one blank
// separator iff any (upstream print_curl_translation).
fn curl_warn_render(c: ref CurlC) -> str {
    out := ""
    j := 0
    for j < len(c.warn) {
        out = out + "Warning: " + c.warn[j] + "\n"
        j = j + 1
    }
    if len(out) > 0 {
        out = out + "\n"
    }
    return out
}

// shquote remains the generic shell-quoter for non-curl paths
// (offline/session); --curl args go through curl_q instead.

fn meta_render(resp: model.Resp) -> str {
    return "Elapsed time: " + fmt5(resp.elapsed_ms / 1000.0) + "s\nRemote address: " + resp.remote + "\n\n"
}

// fmt5 prints a float with 5 decimals (%.5fs upstream).
fn fmt5(f: float) -> str {
    if f < 0.0 {
        f = 0.0
    }
    n := ftoi(f * 100000.0 + 0.5)
    whole := n / 100000
    frac := n - whole * 100000
    fs := itoa(frac + 100000)
    return itoa(whole) + "." + substr(fs, 1, len(fs))
}

// human_bytes mirrors indicatif HumanBytes: int "N B" under 1KiB
// else %.2f KiB/MiB/GiB.
fn human_bytes(n: int) -> str {
    if n < 1024 {
        return itoa(n) + " B"
    }
    units := "KiB"
    v := int_to_f(n) / 1024.0
    if v >= 1024.0 {
        v = v / 1024.0
        units = "MiB"
    }
    if v >= 1024.0 {
        v = v / 1024.0
        units = "GiB"
    }
    c := ftoi(v * 100.0 + 0.5)
    return itoa(c / 100) + "." + substr(itoa(c % 100 + 100), 1, 3) + " " + units
}

// --- the orchestration

fn execute(i: ref Intent, envpairs: []str, stdin: str, stdin_tty: int, out_tty: int) -> own Run {
    r := new(Run)
    prog := i.prog
    // --generate renders the vendored artifact and exits before any
    // request planning (spec S5, ADR-0041).
    if len(i.gen) > 0 {
        r.code = 0
        r.stdout = gen_emit(i.gen, prog, envpairs)
        return r
    }
    // --curl runs upstream translate() FIRST — before plan()'s stdin/
    // cert/session work — so the emit feeds off Intent alone and
    // short-circuits --offline & plan-time errors (spec S1/AC2).
    if i.curl != 0 {
        cc := curl_translate(i, envpairs)
        if len(cc.err) > 0 {
            r.code = 1
            r.stderr = prog + ": error: " + cc.err + "\n"
            return r
        }
        r.code = 0
        r.stdout = curl_render(cc) + "\n"
        r.stderr = curl_warn_render(cc)
        return r
    }
    p := plan(i, envpairs, stdin, stdin_tty)
    f := fmt_of(i, out_tty)
    if len(p.err) > 0 {
        r.code = 1
        r.stderr = prog + ": error: " + p.err + "\n"
        return r
    }
    warn := ""
    wi := 0
    for wi < len(p.warn) {
        if i.quiet < 2 {
            warn = warn + prog + ": warning: " + p.warn[wi] + "\n"
        }
        wi = wi + 1
    }
    ps := i.print_set
    hs := i.hist_set
    out := ""
    if ps.req_h != 0 {
        out = out + req_head_render(i, p, f)
    }
    if ps.req_b != 0 {
        // Body::Empty prints nothing; a zero-length real body prints \n\n
        if p.req.body.kind() != 0 {
            bd := req_body_bytes(p.req.body)
            out = out + req_body_render(bd, f, p.req.headers)
        }
    }
    if i.offline != 0 {
        r.code = 0
        r.stdout = out
        r.stderr = warn
        return r
    }
    t := http.H1{}
    [resp, te] = t.send(p.req)
    if te != nil {
        r.stderr = warn + prog + ": error: " + strip_http(errors.msg(te)) + "\n"
        r.code = 1
        msg := errors.msg(te)
        if find(msg, "timed out") >= 0 {
            r.code = 2
        }
        if find(msg, "Too many redirects") >= 0 {
            r.code = 6
        }
        return r
    }
    // §D3: digest creds — on 401 + Digest challenge, compute the MD5
    // response and resend once (transparent retry: the 401 is not a
    // history hop). Unsupported challenge params error-degrade; no
    // Digest header → the 401 passes through as-is.
    if resp.status == 401 && len(p.digest_user) > 0 {
        ch := digest_challenge(resp.headers)
        if len(ch) > 0 {
            [u2, ue2] = url.parse(p.req.url)
            duri := "/"
            if ue2 == nil {
                duri = u2.request_uri()
                if len(duri) == 0 {
                    duri = "/"
                }
            }
            [az, derr] = digest_authorization(p, ch, p.req.method, duri)
            if derr != nil {
                r.stderr = warn + prog + ": error: " + errors.msg(derr) + "\n"
                r.code = 1
                return r
            }
            p.req.headers = hput(p.req.headers, "Authorization", az)
            [resp2, te2] = t.send(p.req)
            if te2 != nil {
                r.stderr = warn + prog + ": error: " + strip_http(errors.msg(te2)) + "\n"
                r.code = 1
                msg := errors.msg(te2)
                if find(msg, "timed out") >= 0 {
                    r.code = 2
                }
                if find(msg, "Too many redirects") >= 0 {
                    r.code = 6
                }
                return r
            }
            resp = resp2
        }
    }
    // W2 (spec sem-S3): a configured client cert that negotiated
    // TLS 1.2 was not presented — upstream's std caveat is silent;
    // ADR-0006 says say so.
    if len(p.req.cert_pem) > 0 && resp.tls_ver == tls.V12 && i.quiet < 2 {
        warn = warn + prog + ": warning: --cert client certificate was not presented: TLS 1.2 sends an empty certificate list in this build\n"
    }
    // --all / --history-print intermediate hops
    if i.all != 0 {
        k := 0
        for k < len(resp.hops[:]) {
            hp := resp.hops[k]
            k = k + 1
            if hs.res_h != 0 {
                out = out + resp_head_render(hp.version, hp.status, hp.reason, hp.headers, f)
            }
            if hs.res_b != 0 {
                out = out + resp_body_render(hp.body, f, hp.headers, i.response_mime, i.response_charset, i.stream)
                // upstream print_separator() — runs iff response_body
                // is in history_print
                out = out + "\n"
            }
            if hs.res_m != 0 {
                out = out + "Elapsed time: " + fmt5(hp.elapsed_ms / 1000.0) + "s\nRemote address: " + hp.remote + "\n\n"
            }
            // next request head — hop k+1's head, or the final
            // request's head when this was the last hop (verbatim
            // wire text, CRLF→LF)
            if hs.req_h != 0 {
                nh := resp.req_head
                if k < len(resp.hops[:]) {
                    nh = resp.hops[k].req_head
                }
                out = out + crlf_lf(nh)
            }
        }
    }
    code := 0
    // Only oxttp-injected Range (resume_off>0) enables 416-as-success.
    // Manual Range: + --continue disables resume (warn above) and must
    // not treat 416 as complete.
    resumable := p.resume_off > 0
    if i.check_eff != 0 {
        s := resp.status
        if s == 416 && resumable {
            code = 0
        } else if s >= 300 && s <= 399 && i.follow == 0 {
            code = 3
        } else if s >= 400 && s <= 499 {
            code = 4
        } else if s >= 500 && s <= 599 {
            code = 5
        }
    }
    // warning when headers are not printed, or neither -o nor -d
    // (xh: !res_h || (no -o && !download)). Do not warn solely because
    // download==0 when -o already redirected the response.
    if code != 0 && (ps.res_h == 0 || (len(i.output) == 0 && i.download == 0)) {
        if i.quiet < 1 {
            warn = warn + prog + ": warning: HTTP " + itoa(resp.status) + " " + reason_of(resp.status, resp.reason) + "\n"
        }
    }
    if i.download != 0 {
        dest := i.output
        // 416 + oxttp-injected Range: already complete — no rewrite
        if resp.status == 416 && resumable {
            if len(dest) == 0 {
                dest = "<stdout>"
            }
            if i.quiet < 1 {
                warn = warn + "Download \"" + dest + "\" is already complete\n"
            }
            r.stderr = resp_head_render(resp.version, resp.status, resp.reason, resp.headers, f) + warn
            r.code = 0
            session_maybe_save(i, envpairs, p, p.req.headers)
            return r
        }
        if code == 0 {
            if len(dest) == 0 {
                dest = "<stdout>"
            }
            if i.quiet < 1 {
                if resp_cl(resp) >= 0 {
                    warn = warn + "Downloading " + human_bytes(resp_cl(resp)) + " to \"" + dest + "\"\n"
                } else {
                    warn = warn + "Downloading to \"" + dest + "\"\n"
                }
            }
            written := len(resp.body)
            if len(i.output) > 0 {
                payload := resp.body as str
                // 206 Partial Content → append onto existing -o bytes
                if resp.status == 206 && p.resume_off > 0 && os.exists(dest) {
                    payload = os.readfile_(dest) + payload
                    written = len(payload)
                }
                we := os.writefile_(dest, payload)
                if we < 0 {
                    r.code = 1
                    r.stderr = warn + prog + ": error: couldn't write to " + dest + "\n"
                    return r
                }
            } else {
                r.stdout = out + (resp.body as str)
            }
            if i.quiet < 1 {
                warn = warn + "Done. " + human_bytes(written) + " in " + fmt5(resp.elapsed_ms / 1000.0) + "s (" + human_bytes(rate_of(written, resp.elapsed_ms)) + "/s)\n"
            }
            // headers go to stderr in download mode
            r.stderr = resp_head_render(resp.version, resp.status, resp.reason, resp.headers, f) + warn
            r.code = code
            session_maybe_save(i, envpairs, p, p.req.headers)
            return r
        }
        // failed download: warning + no body written
        r.code = code
        r.stderr = warn
        r.stdout = out
        return r
    }
    if ps.res_h != 0 {
        out = out + resp_head_render(resp.version, resp.status, resp.reason, resp.headers, f)
    }
    if ps.res_b != 0 {
        out = out + resp_body_render(resp.body, f, resp.headers, i.response_mime, i.response_charset, i.stream)
    }
    if ps.res_b != 0 && ps.res_m != 0 {
        out = out + "\n"
    }
    if ps.res_m != 0 {
        out = out + "Elapsed time: " + fmt5(resp.elapsed_ms / 1000.0) + "s\nRemote address: " + resp.remote + "\n\n"
    }
    session_maybe_save(i, envpairs, p, p.req.headers)
    if len(i.output) > 0 {
        we := os.writefile_(i.output, out)
        if we < 0 {
            r.code = 1
            r.stderr = warn + prog + ": error: couldn't write to " + i.output + "\n"
            return r
        }
        r.code = code
        r.stderr = warn
        return r
    }
    r.code = code
    r.stdout = out
    r.stderr = warn
    return r
}

fn resp_cl(resp: model.Resp) -> int {
    i := hfind(resp.headers, "content-length")
    if i < 0 {
        return -1
    }
    [n, e] = strconv.atoi(resp.headers[i].value)
    if e != nil {
        return -1
    }
    return n
}

fn rate_of(bytes: int, ms: float) -> int {
    if ms <= 0.0 {
        ms = 0.001
    }
    return ftoi(int_to_f(bytes) / (ms / 1000.0))
}

fn crlf_lf(s: str) -> str {
    b := s as []byte
    out := mkslice(byte, 0)
    i := 0
    for i < len(b) {
        if b[i] == 13 && i + 1 < len(b) && b[i + 1] == 10 {
            out = push(out, 10)
            i = i + 1
        } else {
            out = push(out, b[i])
        }
        i = i + 1
    }
    return out as str
}

// session_maybe_save persists jar+headers when --session is active.
fn session_maybe_save(i: ref Intent, env: []str, p: ref ReqPlan, hs: []model.Header) {
    if p.sess_write == 0 {
        return
    }
    at := ""
    ar := ""
    if len(i.auth) > 0 {
        at = i.auth_type
        if len(at) == 0 {
            at = "basic"
        }
        ar = i.auth
    }
    session_save(p.sess.path, at, ar, p.jar, hs)
}

// strip_http drops the transport's "http: " prefix for CLI display.
fn strip_http(msg: str) -> str {
    if find(msg, "http: ") == 0 {
        return substr(msg, 6, len(msg))
    }
    return msg
}

// req_body_bytes approximates the rendered body for the request
// body print — wire.render_body already ran inside the transport
// for the actual send; here we re-render for display.
fn req_body_bytes(b: model.Body) -> []byte {
    [rb, e] = http.RenderBody(b)
    if e != nil {
        return mkslice(byte, 0)
    }
    return rb.data
}

// --- --generate (spec S5, ADR-0041) --------------------------------

// srepl is a plain string replace-all (golden_test's g_repl lives in
// the _test file — not compiled into the binary).
fn srepl(s: str, a: str, b: str) -> str {
    out := ""
    i := 0
    for i < len(s) {
        if i + len(a) <= len(s) && substr(s, i, i + len(a)) == a {
            out = out + b
            i = i + len(a)
        } else {
            out = out + substr(s, i, i + 1)
            i = i + 1
        }
    }
    return out
}

fn two(n: int) -> str {
    if n < 10 {
        return "0" + itoa(n)
    }
    return itoa(n)
}

// epoch_ymd renders a unix epoch seconds value as YYYY-MM-DD —
// Howard Hinnant's civil-from-days (std/time has no civil API).
fn epoch_ymd(sec: int) -> str {
    z := sec / 86400 + 719468
    era := z / 146097
    doe := z - era * 146097
    yoe := (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    y := yoe + era * 400
    doy := doe - (365 * yoe + yoe / 4 - yoe / 100)
    mp := (5 * doy + 2) / 153
    d := doy - (153 * mp + 2) / 5 + 1
    m := mp
    if mp < 10 {
        m = mp + 3
    } else {
        m = mp - 9
    }
    if m <= 2 {
        y = y + 1
    }
    return itoa(y) + "-" + two(m) + "-" + two(d)
}

// sde_or_now: SOURCE_DATE_EPOCH if parseable, else current epoch
// (upstream SOURCE_DATE_EPOCH ?: today's date for .TH).
fn sde_or_now(envpairs: []str) -> int {
    s := env_get(envpairs, "SOURCE_DATE_EPOCH")
    if len(s) > 0 {
        [n, e] = strconv.atoi(s)
        if e == nil {
            return n
        }
    }
    return time.unix()
}

// gen_bin_sub substitutes the registered command token `xh` → the
// resolved bin name (upstream passes bin_name to clap_complete; the
// vendored scripts are pinned to xh).
fn gen_bin_sub(s: str, prog: str) -> str {
    s = srepl(s, "complete -c xh", "complete -c " + prog)
    s = srepl(s, "complete -F _xh", "complete -F _" + prog)
    s = srepl(s, "_xh()", "_" + prog + "()")
    s = srepl(s, "_xh_", "_" + prog + "_")
    s = srepl(s, "#compdef xh", "#compdef " + prog)
    s = srepl(s, "arg-completer[xh]", "arg-completer[" + prog + "]")
    s = srepl(s, "-CommandName 'xh'", "-CommandName '" + prog + "'")
    s = srepl(s, "export extern \"xh\"", "export extern \"" + prog + "\"")
    s = srepl(s, "export extern xh", "export extern " + prog)
    s = srepl(s, "nu-complete xh", "nu-complete " + prog)
    // bash: complete-registration tail + internal cmd/case literals
    s = srepl(s, "-o default xh", "-o default " + prog)
    s = srepl(s, "cmd=\"xh\"", "cmd=\"" + prog + "\"")
    s = srepl(s, "xh)", prog + ")")
    // zsh: funcstack probe, dispatch call, compdef registration, label
    s = srepl(s, "\"_xh\"", "\"_" + prog + "\"")
    s = srepl(s, "_xh \"$@\"", "_" + prog + " \"$@\"")
    s = srepl(s, "compdef _xh xh", "compdef _" + prog + " " + prog)
    s = srepl(s, "'xh commands'", "'" + prog + " commands'")
    // nushell doc comment names the binary upstream-side too
    s = srepl(s, "# xh is a friendly", "# " + prog + " is a friendly")
    // elvish: command-seed var + lookup key must stay paired
    s = srepl(s, "var command = 'xh'", "var command = '" + prog + "'")
    s = srepl(s, "&'xh'=", "&'" + prog + "'=")
    // powershell: $command seed element + switch dispatch key
    s = srepl(s, "        'xh'\n        for", "        '" + prog + "'\n        for")
    s = srepl(s, "        'xh' {", "        '" + prog + "' {")
    return s
}

// gen_man renders the vendored man doc with .TH date ←
// SOURCE_DATE_EPOCH ?: today and version ← version.get().
fn gen_man(markdown: int, envpairs: []str) -> str {
    doc := gen_doc(markdown)
    doc = srepl(doc, "0.26.3", version.get())
    if markdown == 0 {
        doc = srepl(doc, "2026-10-21", epoch_ymd(sde_or_now(envpairs)))
    }
    return doc
}

// gen_emit renders the vendored artifact for a --generate kind.
fn gen_emit(kind: str, prog: str, envpairs: []str) -> str {
    if kind == "man" {
        return gen_man(0, envpairs)
    }
    if kind == "man-markdown" {
        return gen_man(1, envpairs)
    }
    sh := ""
    if len(kind) > 9 && substr(kind, 0, 9) == "complete-" {
        sh = substr(kind, 9, len(kind))
    }
    return gen_bin_sub(gen_completion(sh), prog)
}
