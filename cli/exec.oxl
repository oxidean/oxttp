package main

// S5 request execution (WI-0006): the populated Intent becomes a
// model.Req, the h1 transport sends it, and this printer emits the
// xh-shaped stdout/stderr/exit surface. Semantics are pinned by
// artifacts/spec.md (sem-A..R) — header merge order, body kinds,
// print pipeline, degrade routing live partly here and partly in
// sem's step-10 routing table.
import "std/os"


import "std/strconv"

import "std/errors"

import "std/encoding/json"

import "std/encoding/base64"

import "std/crypto/md5"

import "std/net/url"

import "std/net/tls"

import "github.com/oxidean/oxttp/core/model"

import "github.com/oxidean/oxttp/core/item"

import "github.com/oxidean/oxttp/core/http"

import "github.com/oxidean/oxttp/shared/version"

// Run is what a request produces — mirroring Out's contract.
struct Run { code: int, stdout: str, stderr: str }

fn elwr(s: str) -> str {
    b := s as []byte
    out := mkslice(byte, len(s))
    i := 0
    for i < len(s) {
        c := b[i]
        if c >= 65 && c <= 90 {
            c = c + 32
        }
        out[i] = c
        i = i + 1
    }
    return out as str
}

// --- ordered header list with freed-slot reuse (http::HeaderMap
// semantics): unset frees a slot the next new-name insert reuses.

fn hfind(hs: []model.Header, name: str) -> int {
    ln := elwr(name)
    i := 0
    for i < len(hs) {
        if len(hs[i].name) > 0 && elwr(hs[i].name) == ln {
            return i
        }
        i = i + 1
    }
    return -1
}

fn hhas(hs: []model.Header, name: str) -> bool {
    return hfind(hs, name) >= 0
}

// hput applies replace_headers semantics: first item occurrence for
// a name replaces all existing values at that position; repeats
// append. Dead slots (name=="") get reused first (HeaderMap index
// reuse — verified against real xh unset+insert ordering).
fn hput(hs: []model.Header, name: str, value: str) -> []model.Header {
    seen := hfind(hs, name)
    if seen >= 0 {
        hs[seen].value = value
        // drop sibling duplicates of the replaced name
        i := seen + 1
        ln := elwr(name)
        for i < len(hs) {
            if len(hs[i].name) > 0 && elwr(hs[i].name) == ln {
                hs[i].name = ""
            }
            i = i + 1
        }
        return hs
    }
    // reuse a freed slot else append
    i := 0
    for i < len(hs) {
        if len(hs[i].name) == 0 {
            hs[i] = model.Header{name: name, value: value}
            return hs
        }
        i = i + 1
    }
    return push(hs, model.Header{name: name, value: value})
}

// happend appends unconditionally (repeat headers like A:1 A:2).
fn happend(hs: []model.Header, name: str, value: str) -> []model.Header {
    i := 0
    for i < len(hs) {
        if len(hs[i].name) == 0 {
            hs[i] = model.Header{name: name, value: value}
            return hs
        }
        i = i + 1
    }
    return push(hs, model.Header{name: name, value: value})
}

// hunset removes every occurrence of name, freeing slots.
// hunset swap-removes every occurrence of name — HeaderMap::remove
// semantics verified against real xh: the LAST live entry fills each
// freed slot (`A:1 A:2 B; User-Agent:` renders B at index 1).
fn hunset(hs: []model.Header, name: str) -> []model.Header {
    ln := elwr(name)
    out := hs
    for true {
        idx := -1
        i := 0
        for i < len(out) {
            if elwr(out[i].name) == ln {
                idx = i
                break
            }
            i = i + 1
        }
        if idx < 0 {
            return out
        }
        // swap-remove: last element fills the hole
        out[idx] = out[len(out) - 1]
        out = out[:len(out) - 1]
    }
    return out
}

fn hunset_at(hs: []model.Header, idx: int) -> []model.Header {
    hs[idx] = hs[len(hs) - 1]
    return hs[:len(hs) - 1]
}

fn insert_at(hs: []model.Header, idx: int, h: model.Header) -> []model.Header {
    out := push(hs, h) // grows by one; then shift down to idx
    i := len(out) - 1
    for i > idx {
        out[i] = out[i - 1]
        i = i - 1
    }
    out[idx] = h
    return out
}

fn hget(hs: []model.Header, name: str) -> str {
    i := hfind(hs, name)
    if i < 0 {
        return ""
    }
    return hs[i].value
}

// htitle renders the display header lines in order, skipping dead
// slots. `title` applies HTTP/1.x title-casing (h2/h3 heads keep
// lowercase names); values get the latin1+UTF-8-annotation display.
fn htitle(hs: []model.Header, title: int, out_tty: int) -> str {
    out := ""
    i := 0
    for i < len(hs) {
        h := hs[i]
        i = i + 1
        if len(h.name) == 0 {
            continue
        }
        nm := h.name
        if title != 0 {
            nm = titlecase(nm)
        } else {
            nm = elwr(nm)
        }
        out = out + nm + ": " + hdr_value_display(h.value, out_tty) + "\n"
    }
    return out
}

fn titlecase(s: str) -> str {
    b := s as []byte
    out := mkslice(byte, len(s))
    up := 1
    i := 0
    for i < len(s) {
        c := b[i]
        if c == 45 {
            up = 1
        } else if up == 1 && c >= 97 && c <= 122 {
            c = c - 32
            up = 0
        } else {
            up = 0
        }
        out[i] = c
        i = i + 1
    }
    return out as str
}

// --- session (cookie-jar-lite per ADR 0023)

struct Sess {
    path: str,
    headers: []model.Header, // saved headers (lowercase names)
    cookies: []str,          // "name=value" jar rows
    auth_type: str,
    auth_raw: str,
    ok: int, // 0 no file · 1 loaded · -1 malformed
}

// session_path: value containing '/' is literal; else
// <cfg>/sessions/<host>[_<port>]/<name>.json.
fn session_path(i: ref Intent, env: []str) -> [str, err] {
    name := i.session
    if find(name, "/") >= 0 {
        return name, nil
    }
    [u, ue] = url.parse(i.url)
    if ue != nil {
        return "", ue
    }
    host := u.hostname()
    if len(host) == 0 || host == "." || host == ".." {
        return "", errors.new("couldn't extract host from url")
    }
    if len(u.port()) > 0 {
        host = host + "_" + u.port()
    }
    [cd, ce] = config_dir(env)
    if ce != nil {
        return "", ce
    }
    return cd + "/sessions/" + host + "/" + name + ".json", nil
}

fn session_load(path: str) -> own Sess {
    s := new(Sess)
    s.path = path
    s.ok = 0
    if len(path) == 0 || !os.exists(path) {
        return s
    }
    raw := os.readfile_(path)
    if len(raw) == 0 {
        s.ok = -1
        return s
    }
    j := json.jparse(raw)
    if j == nil || j.kind != 4 {
        s.ok = -1
        return s
    }
    a := json.jget(j, "auth")
    if a != nil {
        s.auth_type = jget_s(a, "type")
        s.auth_raw = jget_s(a, "raw_auth")
    }
    ck := json.jget(j, "cookies")
    if ck != nil && ck.kind == 5 {
        m := ck.child
        for m != nil {
            nm := jget_s(m, "name")
            vl := jget_s(m, "value")
            if len(nm) > 0 {
                s.cookies = push(s.cookies, nm + "=" + vl)
            }
            m = m.next
        }
    }
    hd := json.jget(j, "headers")
    if hd != nil && hd.kind == 5 {
        m2 := hd.child
        for m2 != nil {
            nm2 := jget_s(m2, "name")
            vl2 := jget_s(m2, "value")
            if len(nm2) > 0 {
                s.headers = push(s.headers, model.Header{name: nm2, value: vl2})
            }
            m2 = m2.next
        }
    }
    s.ok = 1
    return s
}

// session_save persists the jar + headers (save_headers exclusions:
// cookie/content-*/if-* per upstream save_headers).
fn session_save(path: str, auth_type: str, auth_raw: str, cookies: []str, hs: []model.Header) -> err {
    dir := ""
    k := len(path) - 1
    for k >= 0 {
        if byteat(path, k) == 47 {
            dir = substr(path, 0, k)
            break
        }
        k = k - 1
    }
    if len(dir) > 0 {
        me := os.mkdir_all(dir)
        if me != nil {
            return me
        }
    }
    out := "{\n    \"__meta__\": {\n        \"about\": \"oxttp session file\",\n        \"xh\": \"" + version.get() + "\"\n    },\n"
    out = out + "    \"auth\": {\n        \"type\": \"" + auth_type + "\",\n        \"raw_auth\": \"" + auth_raw + "\"\n    },\n"
    out = out + "    \"cookies\": ["
    i := 0
    first := 1
    for i < len(cookies) {
        c := cookies[i]
        i = i + 1
        eq := find(c, "=")
        if eq <= 0 {
            continue
        }
        if first == 0 {
            out = out + ","
        }
        first = 0
        out = out + "\n        {\n            \"name\": \"" + substr(c, 0, eq) + "\",\n            \"value\": \"" + substr(c, eq + 1, len(c)) + "\"\n        }"
    }
    out = out + "\n    ],\n    \"headers\": ["
    i = 0
    first = 1
    for i < len(hs) {
        h := hs[i]
        i = i + 1
        ln := elwr(h.name)
        if len(h.name) == 0 || ln == "cookie" || find(ln, "content-") == 0 || find(ln, "if-") == 0 {
            continue
        }
        if first == 0 {
            out = out + ","
        }
        first = 0
        out = out + "\n        {\n            \"name\": \"" + ln + "\",\n            \"value\": \"" + h.value + "\"\n        }"
    }
    out = out + "\n    ]\n}\n"
    // oxl ≥0.23: writefile_ returns bytes written on success; <0 errno.
    if os.writefile_(path, out) < 0 {
        return errors.new("couldn't write session file " + path)
    }
    return nil
}

// --- netrc (spec sem-D4)

fn netrc_auth(i: ref Intent, env: []str) -> str {
    if i.ignore_netrc != 0 {
        return ""
    }
    path := env_get(env, "NETRC")
    if len(path) == 0 {
        home := env_get(env, "HOME")
        if len(home) == 0 {
            return ""
        }
        if os.exists(home + "/.netrc") {
            path = home + "/.netrc"
        } else if os.exists(home + "/_netrc") {
            path = home + "/_netrc"
        } else {
            return ""
        }
    }
    if !os.exists(path) {
        return ""
    }
    raw := os.readfile_(path)
    [u, ue] = url.parse(i.url)
    if ue != nil {
        return ""
    }
    host := u.hostname()
    words := split_ws(raw)
    j := 0
    indef := 0
    login := ""
    pass := ""
    account := ""
    for j < len(words) {
        w := words[j]
        j = j + 1
        if w == "machine" || w == "default" {
            if indef == 1 && len(login) > 0 && len(pass) > 0 {
                return "B" + charat(1) + login + charat(1) + pass
            }
            mch := 0
            if w == "machine" && j < len(words) {
                mch = booli(words[j] == host)
                j = j + 1
            } else if w == "default" {
                mch = booli(indef == 0)
            }
            indef = mch
            login = ""
            pass = ""
            account = ""
            continue
        }
        if indef == 0 {
            if w == "macdef" {
                j = j + 1
            }
            continue
        }
        if w == "login" && j < len(words) {
            login = words[j]
            j = j + 1
        } else if w == "password" && j < len(words) {
            pass = words[j]
            j = j + 1
        } else if w == "account" && j < len(words) {
            account = words[j]
            j = j + 1
        } else if w == "macdef" {
            // skip to blank line — approximation: stop this entry
            indef = 0
        }
    }
    if indef == 1 && len(pass) > 0 {
        if len(login) == 0 {
            login = account
        }
        if len(login) > 0 {
            return "B" + charat(1) + login + charat(1) + pass
        }
    }
    return ""
}

fn split_ws(s: str) -> []str {
    let out: []str = nil
    i := 0
    n := len(s)
    for i < n {
        c := byteat(s, i)
        if c == 32 || c == 9 || c == 10 || c == 13 {
            i = i + 1
            continue
        }
        if c == 35 { // '#' comment
            for i < n && byteat(s, i) != 10 {
                i = i + 1
            }
            continue
        }
        j := i
        for j < n {
            c2 := byteat(s, j)
            if c2 == 32 || c2 == 9 || c2 == 10 || c2 == 13 {
                break
            }
            j = j + 1
        }
        out = push(out, substr(s, i, j))
        i = j
    }
    return out
}

fn env_get(env: []str, name: str) -> str {
    [v, e] = env_lookup(env, name)
    if e != nil {
        return ""
    }
    return v
}

fn charat(c: int) -> str {
    b := mkslice(byte, 1)
    b[0] = c
    return b as str
}

// --- digest auth (§D3): send without Authorization; on 401 +
// WWW-Authenticate: Digest compute the MD5 response and resend
// once. XH_TEST_DIGEST_AUTH_CNONCE pins cnonce for fixtures.

// dig_params parses "realm=\"r\", nonce=\"n\"" into "k\x01v" rows —
// quote-aware comma split (qop lists contain commas).
fn dig_params(s: str) -> []str {
    let out: []str = nil
    i := 0
    n := len(s)
    for i < n {
        for i < n && (byteat(s, i) == 32 || byteat(s, i) == 44 || byteat(s, i) == 9) {
            i = i + 1
        }
        k0 := i
        for i < n && byteat(s, i) != 61 && byteat(s, i) != 44 {
            i = i + 1
        }
        if i >= n || byteat(s, i) != 61 {
            return out
        }
        k := trim_ows(elwr(substr(s, k0, i)))
        i = i + 1
        v := ""
        if i < n && byteat(s, i) == 34 {
            i = i + 1
            v0 := i
            for i < n && byteat(s, i) != 34 {
                i = i + 1
            }
            v = substr(s, v0, i)
            if i < n {
                i = i + 1
            }
        } else {
            v0 := i
            for i < n && byteat(s, i) != 44 {
                i = i + 1
            }
            v = trim_ows(substr(s, v0, i))
        }
        out = push(out, k + charat(1) + v)
    }
    return out
}

fn dig_get(params: []str, key: str) -> str {
    i := 0
    for i < len(params) {
        sp := find(params[i], charat(1))
        if substr(params[i], 0, sp) == key {
            return substr(params[i], sp + 1, len(params[i]))
        }
        i = i + 1
    }
    return ""
}

// digest_challenge returns the Digest params text when the 401
// carries "WWW-Authenticate: Digest ..." (else "").
fn digest_challenge(hs: []model.Header) -> str {
    i := 0
    for i < len(hs) {
        if elwr(hs[i].name) == "www-authenticate" {
            v := trim_ows(hs[i].value)
            if len(v) > 7 && elwr(substr(v, 0, 6)) == "digest" && byteat(v, 6) == 32 {
                return substr(v, 7, len(v))
            }
        }
        i = i + 1
    }
    return ""
}

// digest_authorization builds the Authorization value or a degrade
// reason (MD5-sess / qop without auth are out of scope per §D3).
fn digest_authorization(p: ref ReqPlan, challenge: str, method: str, uri: str) -> [str, err] {
    params := dig_params(challenge)
    realm := dig_get(params, "realm")
    nonce := dig_get(params, "nonce")
    opaque := dig_get(params, "opaque")
    algo := dig_get(params, "algorithm")
    qopv := dig_get(params, "qop")
    if len(algo) > 0 && elwr(algo) != "md5" {
        return "", errors.new("digest algorithm " + algo + " is unsupported in this build")
    }
    qop := ""
    if len(qopv) > 0 {
        // qop may be a quoted list "auth,auth-int" — take auth only
        qp := dig_splitq(qopv)
        qi := 0
        for qi < len(qp) {
            if elwr(qp[qi]) == "auth" {
                qop = "auth"
            }
            qi = qi + 1
        }
        if len(qop) == 0 {
            return "", errors.new("digest qop " + qopv + " is unsupported in this build")
        }
    }
    cnonce := p.digest_cnonce
    if len(cnonce) == 0 {
        cnonce = md5.hexdigest((itoa(now_ms()) + ":oxttp") as []byte)
    }
    ha1 := md5.hexdigest((p.digest_user + ":" + realm + ":" + p.digest_pass) as []byte)
    ha2 := md5.hexdigest((method + ":" + uri) as []byte)
    resp := ""
    if len(qop) > 0 {
        resp = md5.hexdigest((ha1 + ":" + nonce + ":00000001:" + cnonce + ":auth:" + ha2) as []byte)
    } else {
        resp = md5.hexdigest((ha1 + ":" + nonce + ":" + ha2) as []byte)
    }
    out := "Digest username=\"" + p.digest_user + "\", realm=\"" + realm + "\", nonce=\"" + nonce + "\", uri=\"" + uri + "\", response=\"" + resp + "\""
    if len(opaque) > 0 {
        out = out + ", opaque=\"" + opaque + "\""
    }
    if len(algo) > 0 {
        out = out + ", algorithm=" + algo
    }
    if len(qop) > 0 {
        out = out + ", qop=auth, nc=00000001, cnonce=\"" + cnonce + "\""
    }
    return out, nil
}

// dig_splitq splits a possibly-quoted qop list into tokens.
fn dig_splitq(v: str) -> []str {
    let out: []str = nil
    i := 0
    for i < len(v) {
        i0 := i
        for i < len(v) && byteat(v, i) != 44 {
            i = i + 1
        }
        t := trim_ows(substr(v, i0, i))
        if len(t) > 0 {
            out = push(out, t)
        }
        i = i + 1
    }
    return out
}

// --- body assembly

// ReqPlan carries the built request plus execution metadata.
struct ReqPlan {
    req: own model.Req,
    warn: []str,
    err: str,
    sess: own Sess,
    sess_write: int,
    jar: []str,
    digest_user: str,
    digest_pass: str,
    digest_cnonce: str,
    resume_off: int, // existing -o size when --continue sets Range
}

// mime for bare @file bodies (;type= > suffix > application/json).
fn mime_guess(path: str) -> str {
    dot := rfind(path, ".")
    if dot < 0 {
        return "application/json"
    }
    ext := elwr(substr(path, dot + 1, len(path)))
    if ext == "json" {
        return "application/json"
    }
    if ext == "txt" {
        return "text/plain"
    }
    if ext == "html" || ext == "htm" {
        return "text/html"
    }
    if ext == "xml" {
        return "application/xml"
    }
    if ext == "jpg" || ext == "jpeg" {
        return "image/jpeg"
    }
    if ext == "png" {
        return "image/png"
    }
    if ext == "gif" {
        return "image/gif"
    }
    if ext == "pdf" {
        return "application/pdf"
    }
    return "application/json"
}

fn int_to_f(n: int) -> float {
    f := 0.0
    i := 0
    m := n
    neg := 0
    if m < 0 {
        m = 0 - m
        neg = 1
    }
    for i < m {
        f = f + 1.0
        i = i + 1
    }
    if neg != 0 {
        return 0.0 - f
    }
    return f
}

fn rfind(s: str, sub: str) -> int {
    i := len(s) - len(sub)
    for i >= 0 {
        if substr(s, i, i + len(sub)) == sub {
            return i
        }
        i = i - 1
    }
    return -1
}

// plan builds the model.Req from the Intent per spec sem-A..F.
fn plan(i: ref Intent, env: []str, stdin: str, stdin_tty: int) -> own ReqPlan {
    p := new(ReqPlan)
    p.req = new(model.Req)
    p.sess = new(Sess)
    // session load first (headers/auth/cookies merge below)
    if len(i.session) > 0 {
        [sp, se] = session_path(i, env)
        if se != nil {
            p.err = errors.msg(se)
            return p
        }
        p.sess = session_load(sp)
        if p.sess.ok < 0 {
            p.err = "couldn't load session \"" + sp + "\""
            return p
        }
        p.sess_write = 0
        if i.session_ro == 0 || os.exists(sp) {
            p.sess_write = 1
        }
    }
    // --- stdin body decision (ADR 0022)
    stdin_body := ""
    use_stdin := 0
    // corpus fixture pinning: an EXPLICIT method + empty stdin carries
    // no body (xh emits a bare GET for `xh GET url </dev/null`), while
    // redirected stdin with no explicit method still counts — it forces
    // the default POST and sends CL:0 + json accept/ct.
    if stdin_tty == 0 && i.ignore_stdin == 0 && (len(stdin) > 0 || len(i.method) == 0) {
        body_items := 0
        j := 0
        for j < len(i.ikinds[:]) {
            if i.ikinds[j] >= 5 && i.ikinds[j] <= 9 {
                body_items = 1
            }
            j = j + 1
        }
        if i.body_type == 2 || body_items == 1 {
            if i.body_type == 2 {
                p.err = "Cannot build a multipart request body from stdin"
            } else {
                p.err = "Request body (from stdin) and request data (key=value) cannot be mixed. Pass --ignore-stdin to ignore standard input."
            }
            return p
        }
        if i.has_raw != 0 {
            p.err = "Request body from stdin and --raw cannot be mixed. Pass --ignore-stdin to ignore standard input."
            return p
        }
        use_stdin = 1
        stdin_body = stdin
        // stdin body → POST when no explicit method (upstream decides
        // method AFTER stdin: Body::pick_method)
        if len(i.method) == 0 {
            i.eff_method = "POST"
        }
    }
    // --- headers: fixed slots then merged per spec sem-A
    let hs: []model.Header = nil
    ae := "gzip, deflate"
    if i.download != 0 {
        ae = "identity"
    }
    hs = push(hs, model.Header{name: "Accept-Encoding", value: ae})
    hs = push(hs, model.Header{name: "User-Agent", value: "oxttp/" + version.get()})
    hs = push(hs, model.Header{name: "Connection", value: "close"})
    // body + body-kind headers
    p.req.body = model.Body.Empty
    ct := ""
    accept := ""
    // bare @file body item parses as FormFile with empty key —
    // count those; keyed `field@file` parts are not body files.
    hasfile := 0
    filepath := ""
    filect := ""
    j := 0
    for j < len(i.ikinds[:]) {
        if i.ikinds[j] == 9 {
            [fv, _fe] = item.parse(i.items[j])
            ff := fv as item.Item.FormFile
            if len(ff.key) == 0 {
                hasfile = hasfile + 1
                filepath = ff.file_name
            }
        }
        j = j + 1
    }
    if hasfile > 1 {
        p.err = "Can't read request from multiple files"
        return p
    }
    if hasfile == 1 {
        j = 0
        for j < len(i.ikinds[:]) {
            k := i.ikinds[j]
            if k >= 5 && k <= 8 {
                p.err = "Request body (from a file) and request data (key=value) cannot be mixed."
                return p
            }
            if k == 9 {
                [fv2, _fe2] = item.parse(i.items[j])
                ff2 := fv2 as item.Item.FormFile
                if len(ff2.key) > 0 {
                    p.err = "Request body (from a file) and request data (key=value) cannot be mixed."
                    return p
                }
            }
            j = j + 1
        }
    }
    if use_stdin != 0 {
        p.req.body = model.Body.Raw{ctype: "", text: stdin_body}
        accept = "application/json, */*;q=0.5"
        ct = "application/json"
    } else if len(i.raw) > 0 || i.has_raw != 0 {
        p.req.body = model.Body.Raw{ctype: "", text: i.raw}
        if i.body_type == 1 {
            ct = "application/x-www-form-urlencoded"
        } else {
            accept = "application/json, */*;q=0.5"
            ct = "application/json"
        }
    } else if hasfile == 1 {
        body := os.readfile_(filepath)
        p.req.body = model.Body.Raw{ctype: "", text: body}
        ct = mime_guess(filepath)
    } else if i.body_type == 2 || i.body_type == 1 {
        // form/multipart — collect fields; := items are an error
        let fields: []model.KV = nil
        let parts: []model.Part = nil
        j = 0
        bad := ""
        for j < len(i.items[:]) {
            k := i.ikinds[j]
            s := i.items[j]
            j = j + 1
            if k == 5 || k == 6 {
                [iv, _e] = item.parse(s)
                if iv.kind() == 5 {
                    v := iv as item.Item.DataField
                    if i.body_type == 2 {
                        parts = push(parts, model.Part{name: v.key, value: v.value, file: "", filename: "", content_type: "", enabled: true, is_file: false})
                    } else {
                        fields = push(fields, model.KV{name: v.key, value: v.value, enabled: true})
                    }
                } else if iv.kind() == 6 {
                    v2 := iv as item.Item.DataFieldFromFile
                    fv := os.readfile_(v2.value)
                    if i.body_type == 2 {
                        parts = push(parts, model.Part{name: v2.key, value: fv, file: "", filename: "", content_type: "", enabled: true, is_file: false})
                    } else {
                        fields = push(fields, model.KV{name: v2.key, value: fv, enabled: true})
                    }
                }
            } else if k == 7 || k == 8 {
                bad = "JSON values are not supported in Form fields"
            } else if k == 9 {
                [iv2, _e2] = item.parse(s)
                f := iv2 as item.Item.FormFile
                fname := f.file_name
                if f.has_fname {
                    fname = f.file_name_header
                } else {
                    sl := rfind(fname, "/")
                    if sl >= 0 {
                        fname = substr(fname, sl + 1, len(fname))
                    }
                }
                content := os.readfile_(f.file_name)
                parts = push(parts, model.Part{name: f.key, value: "", file: content, filename: fname, content_type: f.file_type, enabled: true, is_file: true})
            }
        }
        if len(bad) > 0 {
            p.err = bad
            return p
        }
        if i.body_type == 2 || len(parts[:]) > 0 {
            // --form promotes when a file field is present: text
            // fields join as leading parts ahead of file parts
            // (for --multipart they already landed in parts).
            let allparts: []model.Part = nil
            fj := 0
            for fj < len(fields) {
                fl := fields[fj]
                fj = fj + 1
                allparts = push(allparts, model.Part{name: fl.name, value: fl.value, file: "", filename: "", content_type: "", enabled: fl.enabled, is_file: false})
            }
            fj = 0
            for fj < len(parts) {
                allparts = push(allparts, parts[fj])
                fj = fj + 1
            }
            p.req.body = model.Body.Multipart{parts: new(allparts[:])}
            ct = "" // wire render emits multipart boundary CT
        } else {
            p.req.body = model.Body.Form{fields: new(fields[:])}
            ct = "application/x-www-form-urlencoded"
        }
    } else {
        // json kind — flat jadd per spec (nested paths are S6)
        jobj := json.jobj()
        nj := 0
        j = 0
        for j < len(i.items[:]) {
            k := i.ikinds[j]
            s := i.items[j]
            j = j + 1
            if k == 5 {
                [iv, _e] = item.parse(s)
                d := iv as item.Item.DataField
                json.jadd(jobj, d.key, json.jstr(d.value))
                nj = nj + 1
            } else if k == 6 {
                [iv2, _e2] = item.parse(s)
                d2 := iv2 as item.Item.DataFieldFromFile
                json.jadd(jobj, d2.key, json.jstr(os.readfile_(d2.value)))
                nj = nj + 1
            } else if k == 7 {
                [iv3, _e3] = item.parse(s)
                d3 := iv3 as item.Item.JsonField
                json.jadd(jobj, json_key(d3.raw_key), d3.value)
                nj = nj + 1
            } else if k == 8 {
                [iv4, _e4] = item.parse(s)
                d4 := iv4 as item.Item.JsonFieldFromFile
                json.jadd(jobj, json_key(d4.raw_key), json.jparse(os.readfile_(d4.value)))
                nj = nj + 1
            } else if k == 9 {
                p.err = "Can't use file fields in JSON mode (perhaps you meant --form?)"
                return p
            }
        }
        if nj > 0 {
            p.req.body = model.Body.Json{j: jobj}
        } else if i.json_flag != 0 {
            // explicit --json with no data items: headers only
            accept = "application/json, */*;q=0.5"
            ct = "application/json"
        }
        if nj > 0 || i.json_flag != 0 {
            accept = "application/json, */*;q=0.5"
            ct = "application/json"
        }
    }
    if len(accept) > 0 {
        hs = push(hs, model.Header{name: "Accept", value: accept})
    }
    if len(ct) > 0 {
        hs = push(hs, model.Header{name: "Content-Type", value: ct})
    }
    // --- auth (arg > session > netrc)
    auth_line := ""
    if len(i.auth) > 0 {
        at := i.auth_type
        if len(at) == 0 {
            at = "basic"
        }
        if at == "digest" {
            cred := i.auth
            if find(cred, ":") < 0 {
                cred = cred + ":" + prompt_password(i, env)
            }
            colon := find(cred, ":")
            p.digest_user = substr(cred, 0, colon)
            p.digest_pass = substr(cred, colon + 1, len(cred))
            p.digest_cnonce = env_get(env, "XH_TEST_DIGEST_AUTH_CNONCE")
        } else if at == "bearer" {
            auth_line = "Bearer " + i.auth
        } else {
            cred := i.auth
            if find(cred, ":") < 0 {
                cred = cred + ":" + prompt_password(i, env)
            }
            auth_line = "Basic " + base64.encode(cred as []byte)
        }
    } else if len(p.sess.auth_raw) > 0 && p.sess.auth_type == "digest" {
        colon := find(p.sess.auth_raw, ":")
        if colon < 0 {
            colon = len(p.sess.auth_raw)
        }
        p.digest_user = substr(p.sess.auth_raw, 0, colon)
        p.digest_pass = substr(p.sess.auth_raw, colon + 1, len(p.sess.auth_raw))
        p.digest_cnonce = env_get(env, "XH_TEST_DIGEST_AUTH_CNONCE")
    } else if len(p.sess.auth_raw) > 0 {
        auth_line = sess_auth_header(p.sess.auth_type, p.sess.auth_raw)
    } else {
        nc := netrc_auth(i, env)
        if len(nc) > 0 {
            // "B\x01login\x01pass" — basic only this stage
            sp := find(nc, charat(1))
            rest := substr(nc, sp + 1, len(nc))
            sp2 := find(rest, charat(1))
            lg := substr(rest, 0, sp2)
            pw := substr(rest, sp2 + 1, len(rest))
            if i.auth_type == "bearer" {
                auth_line = "Bearer " + pw
            } else if i.auth_type == "digest" {
                p.digest_user = lg
                p.digest_pass = pw
                p.digest_cnonce = env_get(env, "XH_TEST_DIGEST_AUTH_CNONCE")
            } else {
                auth_line = "Basic " + base64.encode((lg + ":" + pw) as []byte)
            }
        }
    }
    if len(auth_line) > 0 {
        hs = push(hs, model.Header{name: "Authorization", value: auth_line})
    }
    // --- merged = session headers then item headers (extend order);
    // each name's values apply to the request via replace+append, and
    // pending unsets swap-remove at the end (http::HeaderMap model).
    let merged: []model.Header = nil
    j = 0
    for j < len(p.sess.headers) {
        h := p.sess.headers[j]
        j = j + 1
        if len(h.name) > 0 {
            merged = push(merged, model.Header{name: h.name, value: h.value})
        }
    }
    let unsets: []str = nil
    qurl := i.url
    qadd := ""
    jar := ""
    j = 0
    for j < len(p.sess.cookies) {
        if len(jar) > 0 {
            jar = jar + "; "
        }
        jar = jar + p.sess.cookies[j]
        j = j + 1
    }
    j = 0
    for j < len(i.items[:]) {
        k := i.ikinds[j]
        s := i.items[j]
        j = j + 1
        if k == 0 || k == 1 {
            [iv, _e] = item.parse(s)
            nm := ""
            val := ""
            if iv.kind() == 0 {
                hh := iv as item.Item.HttpHeader
                nm = hh.key
                val = hh.value
            } else {
                hf := iv as item.Item.HttpHeaderFromFile
                nm = hf.key
                val = trim_ows(os.readfile_(hf.value))
            }
            if elwr(nm) == "cookie" && len(i.session) > 0 {
                if find(jar, val) < 0 {
                    if len(jar) > 0 {
                        jar = jar + "; "
                    }
                    jar = jar + val
                }
                continue
            }
            merged = push(merged, model.Header{name: nm, value: val})
            // a set cancels a pending unset of the same name
            n := 0
            lnm := elwr(nm)
            for n < len(unsets) {
                if unsets[n] == lnm {
                    unsets[n] = ""
                }
                n = n + 1
            }
        } else if k == 2 {
            [iv2, _e2] = item.parse(s)
            hu := iv2 as item.Item.HttpHeaderToUnset
            unsets = push(unsets, elwr(hu.key))
            // unset also drops earlier merged entries of that name
            merged = hunset(merged, hu.key)
        } else if k == 3 || k == 4 {
            [iv3, _e3] = item.parse(s)
            if iv3.kind() == 3 {
                qp := iv3 as item.Item.UrlParam
                qadd = qadd + "&" + url.queryescape(qp.key) + "=" + url.queryescape(qp.value)
            } else {
                qp2 := iv3 as item.Item.UrlParamFromFile
                qadd = qadd + "&" + url.queryescape(qp2.key) + "=" + url.queryescape(os.readfile_(qp2.value))
            }
        }
    }
    // apply merged: first occurrence of a name replaces the request's
    // values at that position; repeats attach right after it.
    let applied: []str = nil
    j = 0
    for j < len(merged) {
        mh := merged[j]
        j = j + 1
        lnm := elwr(mh.name)
        done := 0
        n := 0
        for n < len(applied) {
            if applied[n] == lnm {
                done = 1
            }
            n = n + 1
        }
        if done == 0 {
            // replace all existing values of this name at first slot
            idx := hfind(hs, mh.name)
            if idx >= 0 {
                hs[idx].value = mh.value
                n = idx + 1
                for n < len(hs) {
                    if elwr(hs[n].name) == lnm {
                        hs = hunset_at(hs, n)
                        n = n - 1
                    }
                    n = n + 1
                }
            } else {
                hs = push(hs, model.Header{name: mh.name, value: mh.value})
            }
            applied = push(applied, lnm)
        } else {
            // repeat value: insert right after the last same-name entry
            last := -1
            n = 0
            for n < len(hs) {
                if elwr(hs[n].name) == lnm {
                    last = n
                }
                n = n + 1
            }
            hs = insert_at(hs, last + 1, model.Header{name: mh.name, value: mh.value})
        }
    }
    // pending unsets swap-remove from the request
    j = 0
    for j < len(unsets) {
        if len(unsets[j]) > 0 {
            hs = hunset(hs, unsets[j])
        }
        j = j + 1
    }
    if len(qadd) > 0 {
        if find(qurl, "?") >= 0 {
            qurl = qurl + qadd
        } else {
            qurl = qurl + "?" + substr(qadd, 1, len(qadd))
        }
    }
    // --- synthesized tail (wire: after CL, before Host; display:
    // before CL — corpus §9 wire ordering)
    let synth: []model.Header = nil
    if !hhas(hs, "accept") {
        synth = push(synth, model.Header{name: "Accept", value: "*/*"})
    }
    if len(jar) > 0 {
        if hhas(hs, "cookie") {
            k := hfind(hs, "cookie")
            hs[k].value = hs[k].value + "; " + jar
        } else {
            synth = push(synth, model.Header{name: "Cookie", value: jar})
        }
    }
    p.req.synth = synth
    p.jar = split_semis(jar)
    p.req.method = i.eff_method
    p.req.url = qurl
    p.req.headers = hs
    p.req.timeout_ms = 0
    if i.has_timeout != 0 && i.timeout > 0.0 {
        t := ftoi(i.timeout * 1000.0)
        if t <= 0 {
            t = 1
        }
        p.req.timeout_ms = t
    }
    p.req.follow = (i.follow != 0)
    p.req.max_redirects = i.eff_redirects
    p.req.verify = i.verify
    // WI-0013 sem-S2: --ssl pins the negotiated version range; unset,
    // auto and ssl2.3 all leave 0/0 = build default [V12,V13]
    // (ADR-0032). tls1/1.1 warn+fallback (corpus W-shape, adapted D2).
    if i.ssl == "tls1.2" {
        p.req.ssl_min = tls.V12
        p.req.ssl_max = tls.V12
    } else if i.ssl == "tls1.3" {
        p.req.ssl_min = tls.V13
        p.req.ssl_max = tls.V13
    } else if i.ssl == "tls1" || i.ssl == "tls1.1" {
        p.warn = push(p.warn, "rustls does not support older TLS versions. This build's TLS stack requires TLS >= 1.2 — falling back to TLS 1.2+.")
    }
    // WI-0013 sem-S4: --native-tls warning-degrades on https (single
    // TLS stack — ADR-0031); inert on cleartext.
    if i.native_tls != 0 && url_scheme(i.url) == "https" {
        p.warn = push(p.warn, "--native-tls selects an alternate TLS backend; this build ships one TLS stack (oxl std/net/tls) — using it")
    }
    // WI-0013 sem-S3: --cert/--cert-key read eagerly — upstream loads
    // them at client build, so a missing file errors even on http://
    // or --offline. --curl bypasses client build upstream entirely,
    // so it emits -E verbatim and never touches the files.
    if i.curl == 0 && len(i.cert) > 0 {
        if !os.exists(i.cert) {
            p.err = "cert file not found: " + i.cert
            return p
        }
        p.req.cert_pem = os.readfile_(i.cert)
        if len(i.cert_key) > 0 {
            if !os.exists(i.cert_key) {
                p.err = "cert-key file not found: " + i.cert_key
                return p
            }
            p.req.key_pem = os.readfile_(i.cert_key)
            // an explicitly supplied key file must carry a key —
            // empty content errors rather than silently falling back
            // to the cert PEM (review F1).
            if len(p.req.key_pem) == 0 {
                p.err = "cert-key file is empty: " + i.cert_key
                return p
            }
        }
        // Upstream builds the client (and its identity) eagerly, so a
        // bad PEM errors even on http:// or --offline — same load the
        // transport runs, with the cert-file key fallback.
        kp := p.req.key_pem
        if len(kp) == 0 {
            kp = p.req.cert_pem
        }
        [_, cce] = tls.load_cert_pem(p.req.cert_pem, kp)
        if cce != nil {
            p.err = "couldn't load client certificate: " + errors.msg(cce)
            return p
        }
    }
    if i.http_version == "1.0" {
        p.req.httpver = "HTTP/1.0"
    } else {
        p.req.httpver = "HTTP/1.1"
    }
    // WI-0013 sem-S1: --http-version 2 is an ALPN hint; 2-prior-
    // knowledge forces h2c on http / requires negotiated h2 on https.
    if i.http_version == "2" {
        p.req.h2 = "hint"
    } else if i.http_version == "2-prior-knowledge" {
        p.req.h2 = "prior"
    }
    // WI-0013 sem-S5: --proxy entries + captured env proxies carry to
    // the transport — per-hop resolution (last scheme/all: match
    // wins), NO_PROXY domain match in pick_proxy.
    p.req.proxies = i.proxies[:]
    p.req.proxy_env = i.proxy_env[:]
    p.req.no_proxy = i.no_proxy
    if i.compress_n > 0 {
        p.warn = push(p.warn, "--compress is unsupported in this build; request body sent uncompressed.")
    }
    if i.debug != 0 {
        p.warn = push(p.warn, "--debug logging is unsupported in this build")
    }
    // --continue: when -o exists and has size>0, send Range: bytes=N-
    p.resume_off = 0
    if i.resume != 0 && len(i.output) > 0 && os.exists(i.output) {
        existing := os.readfile_(i.output)
        n := len(existing)
        if n > 0 {
            if hhas(p.req.headers, "range") {
                p.warn = push(p.warn, "--continue can't be used with a 'Range:' header. --continue will be disabled.")
            } else {
                p.req.headers = hput(p.req.headers, "Range", "bytes=" + itoa(n) + "-")
                p.resume_off = n
            }
        }
    }
    // --curl bypasses client build upstream, so transport-side
    // warnings (rustls fallback, native-tls, compress…) never print —
    // only the "Warning: Ignored" lines from curl_ignored land.
    if i.curl != 0 {
        p.warn = nil
    }
    return p
}

fn split_semis(s: str) -> []str {
    let out: []str = nil
    for len(s) > 0 {
        semi := find(s, ";")
        if semi < 0 {
            out = push(out, s)
            break
        }
        out = push(out, substr(s, 0, semi))
        s = substr(s, semi + 1, len(s))
        if len(s) > 0 && byteat(s, 0) == 32 {
            s = substr(s, 1, len(s))
        }
    }
    return out
}

// json_key strips upstream's nested-path syntax into a literal key
// for this stage — `a[b]` stays the literal text (S6 owns nesting).
fn json_key(raw: str) -> str {
    return raw
}

fn trim_ows(s: str) -> str {
    lo := 0
    hi := len(s)
    for lo < hi && (byteat(s, lo) == 32 || byteat(s, lo) == 9) {
        lo = lo + 1
    }
    for hi > lo && (byteat(s, hi - 1) == 32 || byteat(s, hi - 1) == 9) {
        hi = hi - 1
    }
    return substr(s, lo, hi)
}

fn sess_auth_header(t: str, raw: str) -> str {
    if t == "bearer" {
        return "Bearer " + raw
    }
    if len(t) == 0 || t == "basic" {
        return "Basic " + base64.encode(raw as []byte)
    }
    return ""
}

// jget_s fetches a string field's .s ("" when absent/non-str).
fn jget_s(obj: ref json.Json, key: str) -> str {
    v := json.jget(obj, key)
    if v == nil || v.kind != 3 {
        return ""
    }
    return v.s
}

// prompt_password reads a password from /dev/tty (raw echo off is
// S8/termios; the controlling-terminal file is the prompt channel).
fn prompt_password(i: ref Intent, env: []str) -> str {
    [f, e] = os.open("/dev/tty")
    if e != nil {
        return ""
    }
    defer f.close()
    pw := ""
    b := mkslice(byte, 1)
    for true {
        [n, re] = f.read(b)
        if n <= 0 || re != nil || b[0] == 10 {
            break
        }
        if b[0] != 13 {
            pw = pw + b as str
        }
    }
    return pw
}

// --- printer (spec sem-R)

fn canonical_reason(code: int) -> str {
    if code == 200 { return "OK" }
    if code == 201 { return "Created" }
    if code == 202 { return "Accepted" }
    if code == 203 { return "Non-Authoritative Information" }
    if code == 204 { return "No Content" }
    if code == 205 { return "Reset Content" }
    if code == 206 { return "Partial Content" }
    if code == 300 { return "Multiple Choices" }
    if code == 301 { return "Moved Permanently" }
    if code == 302 { return "Found" }
    if code == 303 { return "See Other" }
    if code == 304 { return "Not Modified" }
    if code == 305 { return "Use Proxy" }
    if code == 307 { return "Temporary Redirect" }
    if code == 308 { return "Permanent Redirect" }
    if code == 400 { return "Bad Request" }
    if code == 401 { return "Unauthorized" }
    if code == 402 { return "Payment Required" }
    if code == 403 { return "Forbidden" }
    if code == 404 { return "Not Found" }
    if code == 405 { return "Method Not Allowed" }
    if code == 406 { return "Not Acceptable" }
    if code == 407 { return "Proxy Authentication Required" }
    if code == 408 { return "Request Timeout" }
    if code == 409 { return "Conflict" }
    if code == 410 { return "Gone" }
    if code == 411 { return "Length Required" }
    if code == 412 { return "Precondition Failed" }
    if code == 413 { return "Payload Too Large" }
    if code == 414 { return "URI Too Long" }
    if code == 415 { return "Unsupported Media Type" }
    if code == 416 { return "Range Not Satisfiable" }
    if code == 417 { return "Expectation Failed" }
    if code == 418 { return "I'm a teapot" }
    if code == 421 { return "Misdirected Request" }
    if code == 422 { return "Unprocessable Entity" }
    if code == 423 { return "Locked" }
    if code == 424 { return "Failed Dependency" }
    if code == 425 { return "Too Early" }
    if code == 426 { return "Upgrade Required" }
    if code == 428 { return "Precondition Required" }
    if code == 429 { return "Too Many Requests" }
    if code == 431 { return "Request Header Fields Too Large" }
    if code == 451 { return "Unavailable For Legal Reasons" }
    if code == 500 { return "Internal Server Error" }
    if code == 501 { return "Not Implemented" }
    if code == 502 { return "Bad Gateway" }
    if code == 503 { return "Service Unavailable" }
    if code == 504 { return "Gateway Timeout" }
    if code == 505 { return "HTTP Version Not Supported" }
    if code == 506 { return "Variant Also Negotiates" }
    if code == 507 { return "Insufficient Storage" }
    if code == 508 { return "Loop Detected" }
    if code == 510 { return "Not Extended" }
    if code == 511 { return "Network Authentication Required" }
    return ""
}

fn reason_of(code: int, wire: str) -> str {
    if len(wire) > 0 {
        return wire
    }
    c := canonical_reason(code)
    if len(c) > 0 {
        return c
    }
    return "<unknown status code>"
}

// req_head_render draws the request head exactly as xh prints it:
// status line + title-cased headers + blank line.
fn req_head_render(i: ref Intent, p: ref ReqPlan, f: ref Fmt) -> str {
    [u, _e] = url.parse(p.req.url)
    uri := "/"
    uhost := ""
    scheme := ""
    if _e == nil {
        uri = u.request_uri()
        uhost = u.host
        scheme = u.scheme
    }
    ver := "HTTP/1.1"
    if i.http_version == "1.0" {
        ver = "HTTP/1.0"
    } else if p.req.h2 == "prior" || (p.req.h2 == "hint" && scheme == "https") {
        ver = "HTTP/2.0" // spec D1: h2 modes render the 2.0 token — cleartext hint can't reach h2, keep 1.1
    }
    hs := p.req.headers
    // display synthesis mirrors wire: Accept* / Cookie / CL / Host
    let dh: []model.Header = nil
    k := 0
    for k < len(hs) {
        if len(hs[k].name) > 0 {
            dh = push(dh, hs[k])
        }
        k = k + 1
    }
    // display tail: synth (Accept*/Cookie), then CL, then Host
    k = 0
    for k < len(p.req.synth) {
        dh = push(dh, p.req.synth[k])
        k = k + 1
    }
    if !hhas(dh, "content-length") && p.req.body.kind() != 0 {
        body_len := body_len_of(p.req.body)
        dh = push(dh, model.Header{name: "Content-Length", value: itoa(body_len)})
    }
    if !hhas(dh, "host") {
        dh = push(dh, model.Header{name: "Host", value: uhost})
    }
    if f.headers_sort != 0 {
        let sd: own []model.Header = hsort_copy(dh)
        dh = sd[:]
    }
    // titlecase only for HTTP/1.x heads (upstream headers_fmt).
    return i.eff_method + " " + uri + " " + ver + "\n" + htitle(dh, booli(ver != "HTTP/2.0"), f.out_tty) + "\n"
}

fn body_len_of(b: model.Body) -> int {
    [rb, e] = http.RenderBody(b)
    if e != nil {
        return 0
    }
    return len(rb.data)
}

fn render_form_str(fs: []model.KV) -> str {
    out := ""
    i := 0
    for i < len(fs) {
        if i > 0 {
            out = out + "&"
        }
        out = out + url.queryescape(fs[i].name) + "=" + url.queryescape(fs[i].value)
        i = i + 1
    }
    return out
}

// resp_head_render: "HTTP/x.y CODE reason" + headers (sorted +
// title-cased for HTTP/1.x only, latin1/UTF-8-annotated values).
fn resp_head_render(version: str, status: int, reason: str, headers: []model.Header, f: ref Fmt) -> str {
    ver := version
    if len(ver) == 0 {
        ver = "1.1"
    }
    let hh: []model.Header = headers
    if f.headers_sort != 0 {
        let sh: own []model.Header = hsort_copy(headers)
        hh = sh[:]
    }
    t1 := 1
    if len(ver) >= 1 && substr(ver, 0, 1) != "1" {
        t1 = 0
    }
    return "HTTP/" + ver + " " + itoa(status) + " " + reason_of(status, reason) + "\n" + htitle(hh, t1, f.out_tty) + "\n"
}

// shquote wraps s in single quotes for a POSIX shell, escaping
// embedded ' as '\''.
fn shquote(s: str) -> str {
    out := "'"
    i := 0
    for i < len(s) {
        if byteat(s, i) == 39 {
            out = out + "'\\''"
        } else {
            out = out + substr(s, i, i + 1)
        }
        i = i + 1
    }
    return out + "'"
}

// curl_ignored appends xh-shaped "Warning: Ignored …" lines for
// flags that affect oxttp output/session but not the curl argv map.
fn curl_ignored(i: ref Intent) -> str {
    out := ""
    if i.offline != 0 {
        out = out + "Warning: Ignored --offline\n"
    }
    if len(i.session) > 0 {
        out = out + "Warning: Ignored --session\n"
    }
    if len(i.print) > 0 {
        out = out + "Warning: Ignored --print\n"
    }
    if len(i.pretty) > 0 && i.pretty != "none" {
        out = out + "Warning: Ignored --pretty\n"
    }
    if i.download != 0 {
        out = out + "Warning: Ignored --download\n"
    }
    if len(i.resolves[:]) > 0 {
        out = out + "Warning: Ignored --resolve\n"
    }
    if i.compress_n != 0 {
        out = out + "Warning: Ignored --compress\n"
    }
    // WI-0013 P5 (spec sem-S4/S6): --proxy now emits (-x / env
    // prefixes) so its Ignored line is gone; --native-tls joins the
    // corpus §5 ignored list instead.
    if i.native_tls != 0 {
        out = out + "Warning: Ignored --native-tls\n"
    }
    return out
}

// curl_emit translates the planned request into a curl command line
// (corpus §5 subset: follow, method, headers, body, http1.0, -C, -o, URL).
fn curl_emit(i: ref Intent, p: ref ReqPlan) -> str {
    long := i.curl_long
    fl_loc := "-L"
    fl_x := "-X"
    fl_h := "-H"
    fl_d := "-d"
    fl_c := "-C"
    fl_o := "-o"
    fl_e := "-E"
    if long != 0 {
        fl_loc = "--location"
        fl_x = "--request"
        fl_h = "--header"
        fl_d = "--data"
        fl_c = "--continue-at"
        fl_o = "--output"
        fl_e = "--cert"
    }
    // WI-0013 P5 (spec sem-S6): --proxy entries become env prefixes
    // prepended to the line — EVERY occurrence emits in CLI order
    // (upstream to_curl does the same; shell-last-wins then matches
    // pick_proxy's last-match selection); all: rides all_proxy
    // (curl's -x would override the scheme-specific envs). When any
    // explicit entries exist, unspecified ambient proxy envs are
    // cleared so the emitted command can't silently inherit a proxy
    // the request bypassed.
    pre := ""
    seen_http := 0
    seen_https := 0
    seen_all := 0
    pxi := 0
    for pxi < len(i.proxies[:]) {
        pent := i.proxies[pxi]
        pxi = pxi + 1
        ci := find(pent, ":")
        if ci < 0 {
            continue
        }
        proto := elwr(substr(pent, 0, ci))
        purl := substr(pent, ci + 1, len(pent))
        if proto == "all" {
            seen_all = 1
            pre = pre + "all_proxy=" + shquote(purl) + " "
        } else if proto == "http" {
            seen_http = 1
            pre = pre + "http_proxy=" + shquote(purl) + " "
        } else if proto == "https" {
            seen_https = 1
            pre = pre + "https_proxy=" + shquote(purl) + " "
        }
    }
    if seen_http + seen_https + seen_all > 0 {
        if seen_http == 0 {
            pre = pre + "http_proxy= HTTP_PROXY= "
        }
        if seen_https == 0 {
            pre = pre + "https_proxy= HTTPS_PROXY= "
        }
        if seen_all == 0 {
            pre = pre + "all_proxy= ALL_PROXY= "
        }
        // explicit --proxy bypasses env consultation entirely — an
        // ambient NO_PROXY would let the emitted curl skip a proxy
        // oxttp itself would have used.
        pre = pre + "no_proxy= NO_PROXY= "
    }
    cmd := pre + "curl"
    if i.follow != 0 {
        cmd = cmd + " " + fl_loc
    }
    if i.http_version == "1.0" {
        cmd = cmd + " --http1.0"
    }
    if i.http_version == "1.1" {
        cmd = cmd + " --http1.1"
    }
    if i.http_version == "2" {
        cmd = cmd + " --http2"
    }
    if i.http_version == "2-prior-knowledge" {
        cmd = cmd + " --http2-prior-knowledge"
    }
    // 3-prior-knowledge maps to --http3-only and IS reachable under
    // --curl: upstream's to_curl short-circuit runs before client
    // build, so the h3 feature-gate defer never sees it (spec sem-S6).
    if i.http_version == "3-prior-knowledge" {
        cmd = cmd + " --http3-only"
    }
    if len(i.cert) > 0 {
        cmd = cmd + " " + fl_e + " " + shquote(i.cert)
    }
    if len(i.cert_key) > 0 {
        cmd = cmd + " --key " + shquote(i.cert_key)
    }
    // --ssl tlsX.Y -> --tlsvX.Y --tls-max X.Y; auto/ssl2.3 silent.
    sslv := ""
    if i.ssl == "tls1" {
        sslv = "1.0"
    }
    if i.ssl == "tls1.1" {
        sslv = "1.1"
    }
    if i.ssl == "tls1.2" {
        sslv = "1.2"
    }
    if i.ssl == "tls1.3" {
        sslv = "1.3"
    }
    if len(sslv) > 0 {
        cmd = cmd + " --tlsv" + sslv + " --tls-max " + sslv
    }
    if p.resume_off > 0 {
        cmd = cmd + " " + fl_c + " -"
    }
    if len(i.output) > 0 {
        cmd = cmd + " " + fl_o + " " + shquote(i.output)
    }
    meth := p.req.method
    if len(meth) == 0 {
        meth = i.eff_method
    }
    has_body := 0
    body_s := ""
    if p.req.body.kind() != 0 {
        bd := req_body_bytes(p.req.body)
        body_s = bd as str
        has_body = 1
    }
    // -X when not GET (curl infers POST from -d, but keep explicit
    // method for non-GET to match corpus --request).
    if meth != "GET" {
        cmd = cmd + " " + fl_x + " " + shquote(meth)
    }
    // headers: request + synth; skip Host (curl derives from URL)
    hi := 0
    for hi < len(p.req.headers) {
        h := p.req.headers[hi]
        hi = hi + 1
        if len(h.name) == 0 {
            continue
        }
        if elwr(h.name) == "host" {
            continue
        }
        cmd = cmd + " " + fl_h + " " + shquote(h.name + ": " + h.value)
    }
    hi = 0
    for hi < len(p.req.synth) {
        h := p.req.synth[hi]
        hi = hi + 1
        if len(h.name) == 0 {
            continue
        }
        if elwr(h.name) == "host" {
            continue
        }
        cmd = cmd + " " + fl_h + " " + shquote(h.name + ": " + h.value)
    }
    if has_body != 0 {
        cmd = cmd + " " + fl_d + " " + shquote(body_s)
    }
    cmd = cmd + " " + shquote(p.req.url)
    return cmd
}

fn meta_render(resp: model.Resp) -> str {
    return "Elapsed time: " + fmt5(resp.elapsed_ms / 1000.0) + "s\nRemote address: " + resp.remote + "\n\n"
}

// fmt5 prints a float with 5 decimals (%.5fs upstream).
fn fmt5(f: float) -> str {
    if f < 0.0 {
        f = 0.0
    }
    n := ftoi(f * 100000.0 + 0.5)
    whole := n / 100000
    frac := n - whole * 100000
    fs := itoa(frac + 100000)
    return itoa(whole) + "." + substr(fs, 1, len(fs))
}

// human_bytes mirrors indicatif HumanBytes: int "N B" under 1KiB
// else %.2f KiB/MiB/GiB.
fn human_bytes(n: int) -> str {
    if n < 1024 {
        return itoa(n) + " B"
    }
    units := "KiB"
    v := int_to_f(n) / 1024.0
    if v >= 1024.0 {
        v = v / 1024.0
        units = "MiB"
    }
    if v >= 1024.0 {
        v = v / 1024.0
        units = "GiB"
    }
    c := ftoi(v * 100.0 + 0.5)
    return itoa(c / 100) + "." + substr(itoa(c % 100 + 100), 1, 3) + " " + units
}

// --- the orchestration

fn execute(i: ref Intent, envpairs: []str, stdin: str, stdin_tty: int, out_tty: int) -> own Run {
    r := new(Run)
    p := plan(i, envpairs, stdin, stdin_tty)
    f := fmt_of(i, out_tty)
    prog := i.prog
    if len(p.err) > 0 {
        r.code = 1
        r.stderr = prog + ": error: " + p.err + "\n"
        return r
    }
    warn := ""
    wi := 0
    for wi < len(p.warn) {
        if i.quiet < 2 {
            warn = warn + prog + ": warning: " + p.warn[wi] + "\n"
        }
        wi = wi + 1
    }
    // --curl: emit a curl command and exit 0 without sending (also
    // short-circuits --offline — offline+curl still prints curl).
    if i.curl != 0 {
        r.code = 0
        r.stdout = curl_emit(i, p) + "\n"
        r.stderr = warn + curl_ignored(i)
        return r
    }
    // colors/all: format-only until style lands (ADR-0006: say so).
    if (i.pretty == "all" || i.pretty == "colors") && i.quiet < 2 {
        warn = warn + prog + ": warning: --pretty " + i.pretty + " colors/style unsupported in this build; formatting only\n"
    }
    ps := i.print_set
    hs := i.hist_set
    out := ""
    if ps.req_h != 0 {
        out = out + req_head_render(i, p, f)
    }
    if ps.req_b != 0 {
        // Body::Empty prints nothing; a zero-length real body prints \n\n
        if p.req.body.kind() != 0 {
            bd := req_body_bytes(p.req.body)
            out = out + req_body_render(bd, f, p.req.headers)
        }
    }
    if i.offline != 0 {
        r.code = 0
        r.stdout = out
        r.stderr = warn
        return r
    }
    t := http.H1{}
    [resp, te] = t.send(p.req)
    if te != nil {
        r.stderr = warn + prog + ": error: " + strip_http(errors.msg(te)) + "\n"
        r.code = 1
        msg := errors.msg(te)
        if find(msg, "timed out") >= 0 {
            r.code = 2
        }
        if find(msg, "Too many redirects") >= 0 {
            r.code = 6
        }
        return r
    }
    // §D3: digest creds — on 401 + Digest challenge, compute the MD5
    // response and resend once (transparent retry: the 401 is not a
    // history hop). Unsupported challenge params error-degrade; no
    // Digest header → the 401 passes through as-is.
    if resp.status == 401 && len(p.digest_user) > 0 {
        ch := digest_challenge(resp.headers)
        if len(ch) > 0 {
            [u2, ue2] = url.parse(p.req.url)
            duri := "/"
            if ue2 == nil {
                duri = u2.request_uri()
                if len(duri) == 0 {
                    duri = "/"
                }
            }
            [az, derr] = digest_authorization(p, ch, p.req.method, duri)
            if derr != nil {
                r.stderr = warn + prog + ": error: " + errors.msg(derr) + "\n"
                r.code = 1
                return r
            }
            p.req.headers = hput(p.req.headers, "Authorization", az)
            [resp2, te2] = t.send(p.req)
            if te2 != nil {
                r.stderr = warn + prog + ": error: " + strip_http(errors.msg(te2)) + "\n"
                r.code = 1
                msg := errors.msg(te2)
                if find(msg, "timed out") >= 0 {
                    r.code = 2
                }
                if find(msg, "Too many redirects") >= 0 {
                    r.code = 6
                }
                return r
            }
            resp = resp2
        }
    }
    // W2 (spec sem-S3): a configured client cert that negotiated
    // TLS 1.2 was not presented — upstream's std caveat is silent;
    // ADR-0006 says say so.
    if len(p.req.cert_pem) > 0 && resp.tls_ver == tls.V12 && i.quiet < 2 {
        warn = warn + prog + ": warning: --cert client certificate was not presented: TLS 1.2 sends an empty certificate list in this build\n"
    }
    // --all / --history-print intermediate hops
    if i.all != 0 {
        k := 0
        for k < len(resp.hops[:]) {
            hp := resp.hops[k]
            k = k + 1
            if hs.res_h != 0 {
                out = out + resp_head_render(hp.version, hp.status, hp.reason, hp.headers, f)
            }
            if hs.res_b != 0 {
                out = out + resp_body_render(hp.body, f, hp.headers, i.response_mime, i.response_charset, i.stream)
                // upstream print_separator() — runs iff response_body
                // is in history_print
                out = out + "\n"
            }
            if hs.res_m != 0 {
                out = out + "Elapsed time: " + fmt5(hp.elapsed_ms / 1000.0) + "s\nRemote address: " + hp.remote + "\n\n"
            }
            // next request head — hop k+1's head, or the final
            // request's head when this was the last hop (verbatim
            // wire text, CRLF→LF)
            if hs.req_h != 0 {
                nh := resp.req_head
                if k < len(resp.hops[:]) {
                    nh = resp.hops[k].req_head
                }
                out = out + crlf_lf(nh)
            }
        }
    }
    code := 0
    // Only oxttp-injected Range (resume_off>0) enables 416-as-success.
    // Manual Range: + --continue disables resume (warn above) and must
    // not treat 416 as complete.
    resumable := p.resume_off > 0
    if i.check_eff != 0 {
        s := resp.status
        if s == 416 && resumable {
            code = 0
        } else if s >= 300 && s <= 399 && i.follow == 0 {
            code = 3
        } else if s >= 400 && s <= 499 {
            code = 4
        } else if s >= 500 && s <= 599 {
            code = 5
        }
    }
    // warning when headers are not printed, or neither -o nor -d
    // (xh: !res_h || (no -o && !download)). Do not warn solely because
    // download==0 when -o already redirected the response.
    if code != 0 && (ps.res_h == 0 || (len(i.output) == 0 && i.download == 0)) {
        if i.quiet < 1 {
            warn = warn + prog + ": warning: HTTP " + itoa(resp.status) + " " + reason_of(resp.status, resp.reason) + "\n"
        }
    }
    if i.download != 0 {
        dest := i.output
        // 416 + oxttp-injected Range: already complete — no rewrite
        if resp.status == 416 && resumable {
            if len(dest) == 0 {
                dest = "<stdout>"
            }
            if i.quiet < 1 {
                warn = warn + "Download \"" + dest + "\" is already complete\n"
            }
            r.stderr = resp_head_render(resp.version, resp.status, resp.reason, resp.headers, f) + warn
            r.code = 0
            session_maybe_save(i, envpairs, p, p.req.headers)
            return r
        }
        if code == 0 {
            if len(dest) == 0 {
                dest = "<stdout>"
            }
            if i.quiet < 1 {
                if resp_cl(resp) >= 0 {
                    warn = warn + "Downloading " + human_bytes(resp_cl(resp)) + " to \"" + dest + "\"\n"
                } else {
                    warn = warn + "Downloading to \"" + dest + "\"\n"
                }
            }
            written := len(resp.body)
            if len(i.output) > 0 {
                payload := resp.body as str
                // 206 Partial Content → append onto existing -o bytes
                if resp.status == 206 && p.resume_off > 0 && os.exists(dest) {
                    payload = os.readfile_(dest) + payload
                    written = len(payload)
                }
                we := os.writefile_(dest, payload)
                if we < 0 {
                    r.code = 1
                    r.stderr = warn + prog + ": error: couldn't write to " + dest + "\n"
                    return r
                }
            } else {
                r.stdout = out + (resp.body as str)
            }
            if i.quiet < 1 {
                warn = warn + "Done. " + human_bytes(written) + " in " + fmt5(resp.elapsed_ms / 1000.0) + "s (" + human_bytes(rate_of(written, resp.elapsed_ms)) + "/s)\n"
            }
            // headers go to stderr in download mode
            r.stderr = resp_head_render(resp.version, resp.status, resp.reason, resp.headers, f) + warn
            r.code = code
            session_maybe_save(i, envpairs, p, p.req.headers)
            return r
        }
        // failed download: warning + no body written
        r.code = code
        r.stderr = warn
        r.stdout = out
        return r
    }
    if ps.res_h != 0 {
        out = out + resp_head_render(resp.version, resp.status, resp.reason, resp.headers, f)
    }
    if ps.res_b != 0 {
        out = out + resp_body_render(resp.body, f, resp.headers, i.response_mime, i.response_charset, i.stream)
    }
    if ps.res_b != 0 && ps.res_m != 0 {
        out = out + "\n"
    }
    if ps.res_m != 0 {
        out = out + "Elapsed time: " + fmt5(resp.elapsed_ms / 1000.0) + "s\nRemote address: " + resp.remote + "\n\n"
    }
    session_maybe_save(i, envpairs, p, p.req.headers)
    if len(i.output) > 0 {
        we := os.writefile_(i.output, out)
        if we < 0 {
            r.code = 1
            r.stderr = warn + prog + ": error: couldn't write to " + i.output + "\n"
            return r
        }
        r.code = code
        r.stderr = warn
        return r
    }
    r.code = code
    r.stdout = out
    r.stderr = warn
    return r
}

fn resp_cl(resp: model.Resp) -> int {
    i := hfind(resp.headers, "content-length")
    if i < 0 {
        return -1
    }
    [n, e] = strconv.atoi(resp.headers[i].value)
    if e != nil {
        return -1
    }
    return n
}

fn rate_of(bytes: int, ms: float) -> int {
    if ms <= 0.0 {
        ms = 0.001
    }
    return ftoi(int_to_f(bytes) / (ms / 1000.0))
}

fn crlf_lf(s: str) -> str {
    b := s as []byte
    out := mkslice(byte, 0)
    i := 0
    for i < len(b) {
        if b[i] == 13 && i + 1 < len(b) && b[i + 1] == 10 {
            out = push(out, 10)
            i = i + 1
        } else {
            out = push(out, b[i])
        }
        i = i + 1
    }
    return out as str
}

// session_maybe_save persists jar+headers when --session is active.
fn session_maybe_save(i: ref Intent, env: []str, p: ref ReqPlan, hs: []model.Header) {
    if p.sess_write == 0 {
        return
    }
    at := ""
    ar := ""
    if len(i.auth) > 0 {
        at = i.auth_type
        if len(at) == 0 {
            at = "basic"
        }
        ar = i.auth
    }
    session_save(p.sess.path, at, ar, p.jar, hs)
}

// strip_http drops the transport's "http: " prefix for CLI display.
fn strip_http(msg: str) -> str {
    if find(msg, "http: ") == 0 {
        return substr(msg, 6, len(msg))
    }
    return msg
}

// req_body_bytes approximates the rendered body for the request
// body print — wire.render_body already ran inside the transport
// for the actual send; here we re-render for display.
fn req_body_bytes(b: model.Body) -> []byte {
    [rb, e] = http.RenderBody(b)
    if e != nil {
        return mkslice(byte, 0)
    }
    return rb.data
}
