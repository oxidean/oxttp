package main

// sem.oxl — the post-clap semantic pass (upstream try_parse_from
// steps 4–10 + run()'s feature gates). resolve() maps a parsed
// Matches to an Out: what the binary would print and its exit code,
// plus the populated Intent (the S5 request-execution seam).
//
// Upstream refs (cli.rs/request_items.rs/main.rs/buffer.rs @ 8b21cc0):
// value parsers validate at token position → we scan m.svals first;
// requires/conflicts already ran inside args.parse.
import "std/strings"

import "std/strconv"

import "std/errors"

import "github.com/oxidean/oxttp/shared/args"

import "github.com/oxidean/oxttp/core/item"

/// Print is the resolved print set (upstream printer::Print).
struct Print {
    req_h: int,
    req_b: int,
    res_h: int,
    res_b: int,
    res_m: int,
}

/// Intent is the fully-resolved request intent — the data S5 needs
/// to build and send the request. Mirrors upstream Cli fields post-
/// process_relations plus the effective getters run() derives.
struct Intent {
    prog: str,
    compat: int,
    https: int,
    method: str,
    url_raw: str,
    url: str,
    eff_method: str,
    items: own []str,
    ikinds: own []int,
    body_type: int, // 0 json · 1 form · 2 multipart
    json_flag: int, // explicit --json (empty-body header case)
    raw: str,
    has_raw: int,
    pretty: str,
    style: str,
    response_charset: str,
    response_mime: str,
    print: str,
    history_print: str,
    print_set: own Print,
    hist_set: own Print,
    verbose: int,
    quiet: int,
    compress_n: int,
    headers: int,
    body: int,
    meta: int,
    offline: int,
    download: int,
    resume: int,
    follow: int,
    all: int,
    ignore_stdin: int,
    ignore_netrc: int,
    curl: int,
    curl_long: int,
    debug: int,
    native_tls: int,
    ipv4: int,
    ipv6: int,
    check_status: int, // resolved tri: 1 on · -1 off · 0 unset
    check_eff: int, // effective: compat + download applied
    stream: int,
    max_redirects: int,
    eff_redirects: int,
    timeout: float,
    has_timeout: int,
    output: str,
    session: str,
    session_ro: int,
    auth_type: str,
    auth: str,
    verify: str,
    cert: str,
    cert_key: str,
    ssl: str,
    http_version: str,
    default_scheme: str,
    interface: str,
    unix_socket: str,
    fmt_opts: own []str, // merged "key=value" in upstream field order
    proxies: own []str,
    resolves: own []str,
    m_sig_id: str,
    m_sig_key: str,
    m_sig_alg: str,
    m_sig_comps: own []str,
    proxy_env: own []str, // captured "NAME=value" when --proxy absent
    no_proxy: str,
    gen: str,
}

/// Out is what the binary does: write stdout/stderr, exit code.
/// intent is always populated (the S5 seam); code 1 = deferred app
/// error, 2 = clap-shaped diag, 0 = help/version output.
struct Out {
    code: int,
    stdout: str,
    stderr: str,
    intent: own Intent,
    exec: int, // S5: intent resolves to a request — main calls execute()
}

fn new_out() -> own Out {
    o := new(Out)
    o.code = 0
    o.stdout = ""
    o.stderr = ""
    o.intent = new(Intent)
    o.intent.print_set = new(Print)
    o.intent.hist_set = new(Print)
    o.intent.items = new(mkslice(str, 0))
    o.intent.ikinds = new(mkslice(int, 0))
    o.intent.fmt_opts = new(mkslice(str, 0))
    o.intent.proxies = new(mkslice(str, 0))
    o.intent.resolves = new(mkslice(str, 0))
    o.intent.m_sig_comps = new(mkslice(str, 0))
    o.intent.proxy_env = new(mkslice(str, 0))
    return o
}

// --- small helpers ------------------------------------------------

// lower folds ASCII A-Z (option/env names are ASCII).
fn lower(s: str) -> str {
    buf := mkbuf(len(s) + 1)
    i := 0
    for i < len(s) {
        c := byteat(s, i)
        if c >= 65 && c <= 90 {
            c = c + 32
        }
        poke8(buf, i, c)
        i = i + 1
    }
    return bufstr(buf, len(s))
}

// is_ascii_alpha reports whether every byte is ASCII A-Z/a-z and
// the string is non-empty (upstream parse_method).
fn is_ascii_alpha(s: str) -> bool {
    if len(s) == 0 {
        return false
    }
    i := 0
    for i < len(s) {
        c := byteat(s, i)
        if !(c >= 65 && c <= 90 || c >= 97 && c <= 122) {
            return false
        }
        i = i + 1
    }
    return true
}

fn is_digc(c: int) -> bool {
    return c >= 48 && c <= 57
}

fn is_hexc(c: int) -> bool {
    return c >= 48 && c <= 57 || c >= 97 && c <= 102 || c >= 65 && c <= 70
}

// count_ch counts occurrences of byte ch in s.
fn count_ch(s: str, ch: int) -> int {
    n := 0
    i := 0
    for i < len(s) {
        if byteat(s, i) == ch {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// trim_ws strips ASCII space/tab at the edges (upstream .trim()).
fn trim_ws(s: str) -> str {
    a := 0
    b := len(s)
    for a < b {
        c := byteat(s, a)
        if c == 32 || c == 9 {
            a = a + 1
        } else {
            break
        }
    }
    for b > a {
        c := byteat(s, b - 1)
        if c == 32 || c == 9 {
            b = b - 1
        } else {
            break
        }
    }
    return substr(s, a, b)
}

// --- the value checks (upstream FromStr/TypedValueParser parsers) -

// chk_timeout → Timeout::from_str. "" = ok.
fn chk_timeout(v: str) -> str {
    [f, e] = strconv.parsefloat(v)
    if e != nil {
        return "Connection timeout is not a valid number"
    }
    if f < 0.0 || (f == 0.0 && len(v) > 0 && byteat(v, 0) == 45) {
        return "Connection timeout is negative"
    }
    if f >= 18446744073709551615.0 {
        return "Connection timeout is too big"
    }
    return ""
}

// chk_print → Print::from_str: every char in "HBhbm".
fn chk_print(v: str) -> str {
    i := 0
    for i < len(v) {
        c := byteat(v, i)
        if c != 72 && c != 66 && c != 104 && c != 98 && c != 109 {
            return "'" + substr(v, i, i + 1) + "' is not a valid value"
        }
        i = i + 1
    }
    return ""
}

// is_uint_str reports strict unsigned-int syntax (no sign, digits).
fn is_uint_str(v: str) -> bool {
    if len(v) == 0 {
        return false
    }
    i := 0
    for i < len(v) {
        if !is_digc(byteat(v, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

// fmt_kind for a format-options key:
// 0 unknown · 1 indent(u64) · 2 bool(true|false) · 3 sort_keys
fn fmt_kind(key: str) -> int {
    if key == "json.sort_keys" {
        return 3
    }
    if key == "json.indent" || key == "xml.indent" {
        return 1
    }
    if key == "json.format" || key == "xml.format" || key == "headers.sort" {
        return 2
    }
    return 0
}

// chk_fmtopts → FormatOptions::from_str on ONE occurrence (values
// merge across occurrences only after each parses).
fn chk_fmtopts(v: str) -> str {
    parts := strings.split(lower(v), ",")
    cur := parts
    for cur != nil {
        el := cur.v
        ci := find(el, ":")
        if ci < 0 {
            return "Format options consist of a key and a value, separated by a \":\"."
        }
        key := substr(el, 0, ci)
        val := substr(el, ci + 1, len(el))
        k := fmt_kind(key)
        if k == 3 {
            return "Unsupported option '" + key + "'"
        }
        if k == 0 {
            return "Unknown option '" + key + "'"
        }
        if k == 1 {
            if !is_uint_str(val) {
                return "Invalid value '" + val + "' in '" + el + "'"
            }
        } else {
            if val != "true" && val != "false" {
                return "Invalid value '" + val + "' in '" + el + "'"
            }
        }
        cur = cur.next
    }
    return ""
}

// has_url_scheme approximates url::Url::try_from's absoluteness:
// ALPHA *( ALPHA / DIGIT / "+" / "-" / "." ) ":" → absolute.
fn has_url_scheme(s: str) -> bool {
    if len(s) == 0 {
        return false
    }
    c := byteat(s, 0)
    if !(c >= 65 && c <= 90 || c >= 97 && c <= 122) {
        return false
    }
    i := 1
    for i < len(s) {
        c = byteat(s, i)
        if c == 58 {
            return true
        }
        if !(c >= 65 && c <= 90 || c >= 97 && c <= 122 || is_digc(c) || c == 43 || c == 45 || c == 46) {
            return false
        }
        i = i + 1
    }
    return false
}

// chk_proxy → Proxy::from_str: split at FIRST colon; the URL half
// validates before the protocol name is checked.
fn chk_proxy(v: str) -> str {
    ci := find(v, ":")
    if ci < 0 {
        return "The value passed to --proxy should be formatted as <PROTOCOL>:<PROXY_URL>"
    }
    proto := substr(v, 0, ci)
    url := substr(v, ci + 1, len(v))
    if find(url, "://") < 0 {
        return "Invalid proxy URL '" + url + "' for protocol '" + proto + "': relative URL without a base"
    }
    p := lower(proto)
    if p != "http" && p != "https" && p != "all" {
        return "Unknown protocol to set a proxy for: " + proto
    }
    return ""
}

// is_ip4 — strict dotted quad.
fn is_ip4(s: str) -> bool {
    parts := 0
    digits := 0
    oct := 0
    i := 0
    for i <= len(s) {
        if i == len(s) || byteat(s, i) == 46 {
            if digits == 0 || oct > 255 {
                return false
            }
            parts = parts + 1
            digits = 0
            oct = 0
        } else {
            c := byteat(s, i)
            if !is_digc(c) {
                return false
            }
            if digits > 0 && oct == 0 {
                return false
            }
            digits = digits + 1
            if digits > 3 {
                return false
            }
            oct = oct * 10 + (c - 48)
        }
        i = i + 1
    }
    return parts == 4
}

// v6group — one IPv6 hextet: 1-4 hex digits.
fn v6group(t: str) -> bool {
    if len(t) == 0 || len(t) > 4 {
        return false
    }
    i := 0
    for i < len(t) {
        if !is_hexc(byteat(t, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

// v6side counts hextets on one side of "::"; tail allows a trailing
// dotted IPv4 (counts as two). -1 = bad.
fn v6side(s: str, tail: bool) -> int {
    if len(s) == 0 {
        return 0
    }
    n := 0
    st := 0
    i := 0
    for i <= len(s) {
        if i == len(s) || byteat(s, i) == 58 {
            t := substr(s, st, i)
            if v6group(t) {
                n = n + 1
            } else if tail && i == len(s) && is_ip4(t) {
                n = n + 2
            } else {
                return -1
            }
            st = i + 1
        }
        i = i + 1
    }
    return n
}

// is_ip6 — IPv6 literal per IpAddr::from_str's accept set: hextets,
// at most one "::", optional trailing dotted IPv4, no %zone.
fn is_ip6(s: str) -> bool {
    di := find(s, "::")
    if di >= 0 {
        if find(substr(s, di + 2, len(s)), "::") >= 0 {
            return false
        }
        left := substr(s, 0, di)
        right := substr(s, di + 2, len(s))
        if len(right) > 0 && byteat(right, 0) == 58 {
            return false
        }
        if len(left) > 0 && byteat(left, len(left) - 1) == 58 {
            return false
        }
        ln := v6side(left, false)
        rn := v6side(right, true)
        if ln < 0 || rn < 0 {
            return false
        }
        return ln + rn < 8
    }
    return v6side(s, true) == 8
}

// is_ipaddr — IpAddr::from_str: v4 or v6.
fn is_ipaddr(s: str) -> bool {
    if find(s, ":") >= 0 {
        return is_ip6(s)
    }
    return is_ip4(s)
}

// chk_resolve → Resolve::from_str.
fn chk_resolve(v: str) -> str {
    if count_ch(v, 58) == 2 {
        return "Value should be formatted as <HOST>:<ADDRESS> (not <HOST>:<PORT>:<ADDRESS>)"
    }
    ci := find(v, ":")
    if ci < 0 {
        return "Value should be formatted as <HOST>:<ADDRESS>"
    }
    addr := substr(v, ci + 1, len(v))
    ok := false
    if len(addr) > 2 && byteat(addr, 0) == 91 && byteat(addr, len(addr) - 1) == 93 {
        ok = is_ip6(substr(addr, 1, len(addr) - 1))
    } else {
        ok = is_ipaddr(addr)
    }
    if !ok {
        return "Invalid address '" + addr + "'"
    }
    return ""
}

// norm_encoding → parse_encoding's normalization: lowercase, drop
// every char not in [a-z0-9_\-:].
fn norm_encoding(v: str) -> str {
    lv := lower(v)
    out := ""
    i := 0
    for i < len(lv) {
        c := byteat(lv, i)
        if is_digc(c) || c >= 97 && c <= 122 || c == 95 || c == 45 || c == 58 {
            out = out + substr(lv, i, i + 1)
        }
        i = i + 1
    }
    return out
}

// --- WHATWG encoding label table ---------------------------------
// Full encodings.json label set grouped by canonical name
// (encoding_rs' Encoding::for_label accept set). Format: repeated
// "label=canon" pairs joined by commas.
let ENC_LABELS = "" +
    "unicode-1-1-utf-8=UTF-8,unicode11utf8=UTF-8,unicode20utf8=UTF-8,utf-8=UTF-8,utf8=UTF-8,x-unicode20utf8=UTF-8," +
    "csunicode=UTF-16LE,iso-10646-ucs-2=UTF-16LE,ucs-2=UTF-16LE,unicode=UTF-16LE,unicodefeff=UTF-16LE,utf-16=UTF-16LE,utf-16le=UTF-16LE," +
    "unicodefffe=UTF-16BE,utf-16be=UTF-16BE," +
    "x-user-defined=x-user-defined," +
    "866=IBM866,cp866=IBM866,csibm866=IBM866,ibm866=IBM866," +
    "csisolatin2=ISO-8859-2,iso-8859-2=ISO-8859-2,iso-ir-101=ISO-8859-2,iso8859-2=ISO-8859-2,iso88592=ISO-8859-2,iso_8859-2=ISO-8859-2,iso_8859-2:1987=ISO-8859-2,l2=ISO-8859-2,latin2=ISO-8859-2," +
    "csisolatin3=ISO-8859-3,iso-8859-3=ISO-8859-3,iso-ir-109=ISO-8859-3,iso8859-3=ISO-8859-3,iso88593=ISO-8859-3,iso_8859-3=ISO-8859-3,iso_8859-3:1988=ISO-8859-3,l3=ISO-8859-3,latin3=ISO-8859-3," +
    "csisolatin4=ISO-8859-4,iso-8859-4=ISO-8859-4,iso-ir-110=ISO-8859-4,iso8859-4=ISO-8859-4,iso88594=ISO-8859-4,iso_8859-4=ISO-8859-4,iso_8859-4:1988=ISO-8859-4,l4=ISO-8859-4,latin4=ISO-8859-4," +
    "csisolatincyrillic=ISO-8859-5,cyrillic=ISO-8859-5,iso-8859-5=ISO-8859-5,iso-ir-144=ISO-8859-5,iso8859-5=ISO-8859-5,iso88595=ISO-8859-5,iso_8859-5=ISO-8859-5,iso_8859-5:1988=ISO-8859-5," +
    "arabic=ISO-8859-6,asmo-708=ISO-8859-6,csiso88596e=ISO-8859-6,csiso88596i=ISO-8859-6,csisolatinarabic=ISO-8859-6,ecma-114=ISO-8859-6,iso-8859-6=ISO-8859-6,iso-8859-6-e=ISO-8859-6,iso-8859-6-i=ISO-8859-6,iso-ir-127=ISO-8859-6,iso8859-6=ISO-8859-6,iso88596=ISO-8859-6,iso_8859-6=ISO-8859-6,iso_8859-6:1987=ISO-8859-6," +
    "csisolatingreek=ISO-8859-7,ecma-118=ISO-8859-7,elot_928=ISO-8859-7,greek=ISO-8859-7,greek8=ISO-8859-7,iso-8859-7=ISO-8859-7,iso-ir-126=ISO-8859-7,iso8859-7=ISO-8859-7,iso88597=ISO-8859-7,iso_8859-7=ISO-8859-7,iso_8859-7:1987=ISO-8859-7,sun_eu_greek=ISO-8859-7," +
    "csiso88598e=ISO-8859-8,csisolatinhebrew=ISO-8859-8,hebrew=ISO-8859-8,iso-8859-8=ISO-8859-8,iso-8859-8-e=ISO-8859-8,iso-ir-138=ISO-8859-8,iso8859-8=ISO-8859-8,iso88598=ISO-8859-8,iso_8859-8=ISO-8859-8,iso_8859-8:1988=ISO-8859-8,visual=ISO-8859-8," +
    "csiso88598i=ISO-8859-8-I,iso-8859-8-i=ISO-8859-8-I,logical=ISO-8859-8-I," +
    "csisolatin6=ISO-8859-10,iso-8859-10=ISO-8859-10,iso-ir-157=ISO-8859-10,iso8859-10=ISO-8859-10,iso885910=ISO-8859-10,l6=ISO-8859-10,latin6=ISO-8859-10," +
    "iso-8859-13=ISO-8859-13,iso8859-13=ISO-8859-13,iso885913=ISO-8859-13," +
    "iso-8859-14=ISO-8859-14,iso8859-14=ISO-8859-14,iso885914=ISO-8859-14," +
    "csisolatin9=ISO-8859-15,iso-8859-15=ISO-8859-15,iso8859-15=ISO-8859-15,iso885915=ISO-8859-15,iso_8859-15=ISO-8859-15,l9=ISO-8859-15," +
    "iso-8859-16=ISO-8859-16," +
    "cskoi8r=KOI8-R,koi=KOI8-R,koi8=KOI8-R,koi8-r=KOI8-R,koi8_r=KOI8-R," +
    "koi8-ru=KOI8-U,koi8-u=KOI8-U," +
    "csmacintosh=macintosh,mac=macintosh,macintosh=macintosh,x-mac-cyrillic=macintosh," +
    "dos-874=windows-874,iso-8859-11=windows-874,iso8859-11=windows-874,iso885911=windows-874,tis-620=windows-874,windows-874=windows-874," +
    "cp1250=windows-1250,windows-1250=windows-1250,x-cp1250=windows-1250," +
    "cp1251=windows-1251,windows-1251=windows-1251,x-cp1251=windows-1251," +
    "ansi_x3.4-1968=windows-1252,ascii=windows-1252,cp1252=windows-1252,cp819=windows-1252,csisolatin1=windows-1252,ibm819=windows-1252,iso-8859-1=windows-1252,iso-ir-100=windows-1252,iso8859-1=windows-1252,iso88591=windows-1252,iso_8859-1=windows-1252,iso_8859-1:1987=windows-1252,l1=windows-1252,latin1=windows-1252,us-ascii=windows-1252,windows-1252=windows-1252,x-cp1252=windows-1252," +
    "cp1253=windows-1253,windows-1253=windows-1253,x-cp1253=windows-1253," +
    "cp1254=windows-1254,csisolatin5=windows-1254,iso-8859-9=windows-1254,iso-ir-148=windows-1254,iso8859-9=windows-1254,iso88599=windows-1254,iso_8859-9=windows-1254,iso_8859-9:1989=windows-1254,l5=windows-1254,latin5=windows-1254,windows-1254=windows-1254,x-cp1254=windows-1254," +
    "cp1255=windows-1255,windows-1255=windows-1255,x-cp1255=windows-1255," +
    "cp1256=windows-1256,windows-1256=windows-1256,x-cp1256=windows-1256," +
    "cp1257=windows-1257,windows-1257=windows-1257,x-cp1257=windows-1257," +
    "cp1258=windows-1258,windows-1258=windows-1258,x-cp1258=windows-1258," +
    "big5=Big5,big5-hkscs=Big5,cn-big5=Big5,csbig5=Big5,x-x-big5=Big5," +
    "cseucpkdfmtjapanese=EUC-JP,euc-jp=EUC-JP,x-euc-jp=EUC-JP," +
    "csiso2022jp=ISO-2022-JP,iso-2022-jp=ISO-2022-JP," +
    "csshiftjis=Shift_JIS,ms932=Shift_JIS,ms_kanji=Shift_JIS,shift-jis=Shift_JIS,shift_jis=Shift_JIS,sjis=Shift_JIS,windows-31j=Shift_JIS,x-sjis=Shift_JIS," +
    "cseuckr=EUC-KR,csksc56011987=EUC-KR,euc-kr=EUC-KR,iso-ir-149=EUC-KR,korean=EUC-KR,ks_c_5601-1987=EUC-KR,ks_c_5601-1989=EUC-KR,ksc5601=EUC-KR,ksc_5601=EUC-KR,windows-949=EUC-KR," +
    "chinese=GBK,csgb2312=GBK,csiso58gb231280=GBK,gb2312=GBK,gb_2312=GBK,gb_2312-80=GBK,gbk=GBK,iso-ir-58=GBK,x-gbk=GBK," +
    "gb18030=gb18030"

// enc_lookup → Encoding::for_label(label) ≈ canonical name or "".
fn enc_lookup(label: str) -> str {
    needle := label + "="
    i := 0
    for i < len(ENC_LABELS) {
        // scan each "label=canon," pair
        j := i
        for j < len(ENC_LABELS) && byteat(ENC_LABELS, j) != 44 {
            j = j + 1
        }
        pair := substr(ENC_LABELS, i, j)
        eq := find(pair, "=")
        if eq > 0 && substr(pair, 0, eq) == label {
            return substr(pair, eq + 1, len(pair))
        }
        i = j + 1
    }
    return ""
}

// rep_chars → Rust's s.replace(&['-', '_'], "") (drop both).
fn rep_chars(s: str, a: int, b: int) -> str {
    out := ""
    i := 0
    for i < len(s) {
        c := byteat(s, i)
        if c != a && c != b {
            out = out + substr(s, i, i + 1)
        }
        i = i + 1
    }
    return out
}

// rep_char → s.replace(from, to) for single chars.
fn rep_char(s: str, from: int, to: int) -> str {
    out := ""
    i := 0
    for i < len(s) {
        c := byteat(s, i)
        if c == from {
            c = to
        }
        out = out + substr(s, i, i + 1)
        i = i + 1
    }
    return out
}

// first_digit — index of first ASCII digit, -1 when none.
fn first_digit(s: str) -> int {
    i := 0
    for i < len(s) {
        if is_digc(byteat(s, i)) {
            return i
        }
        i = i + 1
    }
    return -1
}

// chk_charset → parse_encoding. [canon, err]: err msg carries the
// failure detail.
fn chk_charset(v: str) -> [str, err] {
    n := norm_encoding(v)
    if n == "u8" || n == "utf" {
        return "UTF-8", nil
    }
    if n == "u16" {
        return "UTF-16LE", nil
    }
    c := enc_lookup(n)
    if len(c) == 0 {
        c = enc_lookup(rep_chars(n, 45, 95))
    }
    if len(c) == 0 {
        c = enc_lookup(rep_char(n, 95, 45))
    }
    if len(c) == 0 {
        c = enc_lookup(rep_char(n, 45, 95))
    }
    if len(c) == 0 {
        // digit-split form: drop -/_ then insert "-" before the
        // first digit (gb2312 → gb-2312)
        flat := rep_chars(n, 45, 95)
        di := first_digit(flat)
        if di > 0 {
            c = enc_lookup(substr(flat, 0, di) + "-" + substr(flat, di, len(flat)))
        }
    }
    if len(c) == 0 {
        return "", errors.new(n + " is not a supported encoding, please refer to https://encoding.spec.whatwg.org/#names-and-labels for supported encodings")
    }
    return c, nil
}

// canon_verify → VerifyParser: no|false → no; yes|true → yes;
// else the raw path. Infallible.
fn canon_verify(v: str) -> str {
    lv := lower(v)
    if lv == "no" || lv == "false" {
        return "no"
    }
    if lv == "yes" || lv == "true" {
        return "yes"
    }
    return v
}

// norm_msigcomp → MessageSignatureComponents::from_str on ONE
// occurrence: split on ",", trim each, lowercase up to the first
// ";", keep ";params". Infallible; returns the flattened parts.
fn norm_msigcomp(v: str) -> own []str {
    out := mkslice(str, 0)
    parts := strings.split(v, ",")
    cur := parts
    for cur != nil {
        comp := trim_ws(cur.v)
        si := find(comp, ";")
        if si >= 0 {
            out = push(out, lower(substr(comp, 0, si)) + substr(comp, si, len(comp)))
        } else {
            out = push(out, lower(comp))
        }
        cur = cur.next
    }
    return new(out)
}

// chk_opt runs the corpus value parser for an option ("" when the
// option has none — all KSTR options get the identity).
fn chk_opt(name: str, v: str) -> str {
    if name == "timeout" {
        return chk_timeout(v)
    }
    if name == "print" || name == "history-print" {
        return chk_print(v)
    }
    if name == "format-options" {
        return chk_fmtopts(v)
    }
    if name == "proxy" {
        return chk_proxy(v)
    }
    if name == "resolve" {
        return chk_resolve(v)
    }
    if name == "response-charset" {
        [_, e2] = chk_charset(v)
        if e2 != nil {
            return errors.msg(e2)
        }
        return ""
    }
    return ""
}

// value_checks walks the recorded svals in TABLE order — dead
// occurrences validate too (upstream validates at token position).
// Returns the first failing detail message, "" when all pass.
fn value_checks(m: ref args.Matches) -> str {
    i := 0
    for i < len(m.spec.opts) {
        o := m.spec.opts[i]
        j := 0
        for j < len(m.svals) {
            if m.svals[j].opt == i {
                msg := chk_opt(o.name, m.svals[j].v)
                if len(msg) > 0 {
                    return "invalid value '" + m.svals[j].v + "' for '--" + o.name + " <" + o.metavar + ">': " + msg
                }
            }
            j = j + 1
        }
        i = i + 1
    }
    return ""
}

// --- construct_url (cli.rs L784) ---------------------------------

// has_scheme_pat → the upstream regex `[a-zA-Z0-9]://.+` searched
// (not anchored): an alnum followed by "://" and at least one more
// char anywhere in the string.
fn has_scheme_pat(s: str) -> bool {
    i := 0
    for i + 3 < len(s) {
        c := byteat(s, i)
        if (c >= 65 && c <= 90 || c >= 97 && c <= 122 || is_digc(c)) &&
            byteat(s, i + 1) == 58 && byteat(s, i + 2) == 47 && byteat(s, i + 3) == 47 {
            return true
        }
        i = i + 1
    }
    return false
}

// url_scheme reads a leading `scheme:` — returns "" when the char
// run before the first ':' isn't a valid scheme start.
fn url_scheme(s: str) -> str {
    ci := find(s, ":")
    if ci <= 0 {
        return ""
    }
    c := byteat(s, 0)
    if !(c >= 65 && c <= 90 || c >= 97 && c <= 122) {
        return ""
    }
    i := 1
    for i < ci {
        c = byteat(s, i)
        if !(c >= 65 && c <= 90 || c >= 97 && c <= 122 || is_digc(c) || c == 43 || c == 45 || c == 46) {
            return ""
        }
        i = i + 1
    }
    return lower(substr(s, 0, ci))
}

// parse_rust_url validates + serializes the authority-form URL the
// way the Rust url crate reports it: lowercased scheme, authority
// required here, empty path → "/", Rust ParseError messages.
// [url, err].
fn parse_rust_url(raw: str) -> [str, err] {
    scheme := url_scheme(raw)
    if len(scheme) == 0 {
        return "", errors.new("relative URL without a base")
    }
    rest := substr(raw, find(raw, ":") + 1, len(raw))
    if !strings.startswith(rest, "//") {
        // opaque-path URLs (mailto:…) — upstream accepts them; keep
        // the raw form (corpus never exercises one).
        return raw, nil
    }
    auth_end := len(rest)
    k := 2
    for k < len(rest) {
        c := byteat(rest, k)
        if c == 47 || c == 63 || c == 35 {
            auth_end = k
            break
        }
        k = k + 1
    }
    auth := substr(rest, 2, auth_end)
    tail := substr(rest, auth_end, len(rest))
    // strip userinfo (last '@')
    at := -1
    k = 0
    for k < len(auth) {
        if byteat(auth, k) == 64 {
            at = k
        }
        k = k + 1
    }
    hostport := auth
    userinfo := ""
    if at >= 0 {
        userinfo = substr(auth, 0, at + 1)
        hostport = substr(auth, at + 1, len(auth))
    }
    // host[:port] — bracketed IPv6 first
    port := ""
    if len(hostport) > 0 && byteat(hostport, 0) == 91 {
        cb := find(hostport, "]")
        if cb < 0 {
            return "", errors.new("invalid ipv6 address")
        }
        if !is_ip6(substr(hostport, 1, cb)) {
            return "", errors.new("invalid ipv6 address")
        }
        rest2 := substr(hostport, cb + 1, len(hostport))
        if len(rest2) > 0 {
            if byteat(rest2, 0) != 58 {
                return "", errors.new("invalid port number")
            }
            port = substr(rest2, 1, len(rest2))
        }
    } else {
        n := count_ch(hostport, 58)
        if n == 1 {
            ci := find(hostport, ":")
            port = substr(hostport, ci + 1, len(hostport))
            hostport = substr(hostport, 0, ci)
        } else if n > 1 {
            return "", errors.new("invalid ipv6 address")
        }
    }
    if len(hostport) == 0 {
        return "", errors.new("empty host")
    }
    if len(port) > 0 {
        if !is_uint_str(port) {
            return "", errors.new("invalid port number")
        }
        [pv, pe] = strconv.parseint(port, 10)
        if pe != nil || pv > 65535 {
            return "", errors.new("invalid port number")
        }
    }
    path := tail
    if len(path) == 0 {
        path = "/"
    }
    auth = userinfo + hostport
    if len(port) > 0 {
        auth = auth + ":" + port
    }
    return scheme + "://" + auth + path, nil
}

// construct_url → upstream construct_url: default-scheme prepend,
// "://" paste shorthand, ":" localhost shorthand.
// [url, err].
fn construct_url(raw_url: str, default_scheme: str) -> [str, err] {
    ds := default_scheme
    if len(ds) == 0 {
        ds = "http://"
    }
    if !strings.endswith(ds, "://") {
        ds = ds + "://"
    }
    cand := ""
    if strings.startswith(raw_url, "://") {
        cand = ds + substr(raw_url, 3, len(raw_url))
    } else if strings.startswith(raw_url, ":") {
        cand = ds + "localhost" + raw_url
    } else if !has_scheme_pat(raw_url) {
        cand = ds + raw_url
    } else {
        cand = raw_url
    }
    return parse_rust_url(cand)
}

// --- pretty / print resolution -----------------------------------

// guess_pretty → buffer.rs::guess_pretty under a caller-supplied
// is_terminal (v0.1 has no isatty — main passes 0, yielding "none";
// the tty arm stays for S5).
fn guess_pretty(is_tty: int, envpairs: []str) -> str {
    if is_tty == 0 {
        return "none"
    }
    [nc, nce] = env_lookup(envpairs, "NO_COLOR")
    if nce == nil && len(nc) > 0 {
        return "format"
    }
    [t, te] = env_lookup(envpairs, "TERM")
    if te == nil {
        if t == "dumb" {
            return "format"
        }
        return "all"
    }
    return "format"
}

// print_of_chars parses a validated FORMAT string into a Print set
// (chars already checked by chk_print).
fn print_of_chars(v: str) -> own Print {
    p := new(Print)
    i := 0
    for i < len(v) {
        c := byteat(v, i)
        if c == 72 {
            p.req_h = 1
        } else if c == 66 {
            p.req_b = 1
        } else if c == 104 {
            p.res_h = 1
        } else if c == 98 {
            p.res_b = 1
        } else {
            p.res_m = 1
        }
        i = i + 1
    }
    return p
}

// print_new → Print::new with is_terminal=false (no isatty; the
// `body || !is_terminal` branch therefore always fires once reached).
fn print_new(verbose: int, headers: int, body: int, meta: int, quiet: int, offline: int) -> own Print {
    p := new(Print)
    if verbose > 0 {
        p.req_h = 1
        p.req_b = 1
        p.res_h = 1
        p.res_b = 1
        if verbose > 1 {
            p.res_m = 1
        }
        return p
    }
    if quiet > 0 {
        return p
    }
    if offline != 0 {
        p.req_h = 1
        p.req_b = 1
        return p
    }
    if headers != 0 {
        p.res_h = 1
        return p
    }
    if body != 0 || 1 == 1 {
        // `body || !is_terminal` — is_terminal is always 0 here
        p.res_b = 1
        return p
    }
    if meta != 0 {
        p.res_m = 1
        return p
    }
    p.res_h = 1
    p.res_b = 1
    return p
}

// --- the semantic pass --------------------------------------------

// diag_out renders a clap-shaped exit-2 diagnostic.
fn diag_out(o: ref Out, msg: str, usage: str) {
    o.code = 2
    o.stderr = "error: " + msg + "\n\n" + usage + "\n\nFor more information, try '--help'.\n"
}

// defer_out renders a `{prog}: error: <msg>` exit-1 deferral.
fn defer_out(o: ref Out, prog: str, msg: str) {
    o.code = 1
    o.stderr = prog + ": error: " + msg + "\n"
}

// env_lookup finds "NAME=value" in envpairs → [value, nil] or
// ["", err] (empty value counts as present — matches
// env::var_os().is_some()).
fn env_lookup(pairs: []str, name: str) -> [str, err] {
    i := 0
    for i < len(pairs) {
        eq := find(pairs[i], "=")
        if eq > 0 && substr(pairs[i], 0, eq) == name {
            return substr(pairs[i], eq + 1, len(pairs[i])), nil
        }
        i = i + 1
    }
    return "", errors.new("unset")
}

// msig_present reports whether any m-sig option saw an occurrence
// (upstream checks m_sig_id|key|alg|has_components).
fn msig_present(m: ref args.Matches) -> bool {
    return args.present(m, "unstable-m-sig-id") || args.present(m, "unstable-m-sig-key") ||
        args.present(m, "unstable-m-sig-alg") || args.present(m, "unstable-m-sig-comp")
}

// merge_fmtopts folds the live format-options values last-wins into
// canonical "key=value" strings in upstream field order.
fn merge_fmtopts(m: ref args.Matches) -> own []str {
    vals := args.get_list(m, "format-options")
    ji := ""
    jf := ""
    xi := ""
    xf := ""
    hs := ""
    i := 0
    for i < len(vals) {
        parts := strings.split(lower(vals[i]), ",")
        cur := parts
        for cur != nil {
            ci := find(cur.v, ":")
            if ci >= 0 {
                k := substr(cur.v, 0, ci)
                v := substr(cur.v, ci + 1, len(cur.v))
                if k == "json.indent" {
                    ji = v
                } else if k == "json.format" {
                    jf = v
                } else if k == "xml.indent" {
                    xi = v
                } else if k == "xml.format" {
                    xf = v
                } else if k == "headers.sort" {
                    hs = v
                }
            }
            cur = cur.next
        }
        i = i + 1
    }
    out := mkslice(str, 0)
    if len(ji) > 0 {
        out = push(out, "json.indent=" + ji)
    }
    if len(jf) > 0 {
        out = push(out, "json.format=" + jf)
    }
    if len(xi) > 0 {
        out = push(out, "xml.indent=" + xi)
    }
    if len(xf) > 0 {
        out = push(out, "xml.format=" + xf)
    }
    if len(hs) > 0 {
        out = push(out, "headers.sort=" + hs)
    }
    return new(out)
}

// resolve maps parsed Matches → Out in upstream try_parse_from
// order (spec.md "Semantics"): value checks → generate → help
// literal → method/URL → items → bin-name → relations →
// construct_url → deferral routing.
fn resolve(m: own args.Matches, envpairs: []str) -> own Out {
    o := new_out()
    prog := m.spec.prog
    o.intent.prog = prog
    usg := args.usage_line(m.spec)

    // 2. value checks (upstream's token-time value parsers)
    vmsg := value_checks(m)
    if len(vmsg) > 0 {
        diag_out(o, vmsg, usg)
        return o
    }

    // 3. --generate short-circuits before positional semantics
    if args.present(m, "generate") {
        o.intent.gen = args.get_enum(m, "generate")
        defer_out(o, prog, "--generate is unsupported in this build")
        return o
    }

    // 4. `help` literal → long help + long trailer
    pos0 := args.pos_at(m, 0)
    if pos0 == "help" {
        o.code = 0
        o.stdout = args.help(m.spec, 1) + "\nEach option can be reset with a --no-OPTION argument.\n"
        return o
    }

    // 5. method/URL split
    method := ""
    url_raw := ""
    istart := 1
    if is_ascii_alpha(pos0) {
        method = strings.upper(pos0)
        if args.npos(m) < 2 {
            diag_out(o, "Missing <URL>", usg)
            return o
        }
        url_raw = args.pos_at(m, 1)
        istart = 2
    } else {
        url_raw = pos0
    }
    o.intent.method = method
    o.intent.url_raw = url_raw

    // 6. request items via core/item (S2 grammar)
    j := istart
    for j < args.npos(m) {
        s := args.pos_at(m, j)
        [iv, e] = item.parse(s)
        if e != nil {
            diag_out(o, errors.msg(e), usg)
            return o
        }
        o.intent.items = new(push(o.intent.items[:], s))
        o.intent.ikinds = new(push(o.intent.ikinds[:], iv.kind()))
        j = j + 1
    }

    // 7. bin-name https/compat detection
    if prog == "https" || prog == "xhs" || prog == "xhttps" {
        o.intent.https = 1
    }
    [_, cme] = env_lookup(envpairs, "XH_HTTPIE_COMPAT_MODE")
    if prog == "http" || prog == "https" || cme == nil {
        o.intent.compat = 1
    }

    // 8. process_relations
    o.intent.verbose = args.get_count(m, "verbose")
    o.intent.quiet = args.get_count(m, "quiet")
    o.intent.compress_n = args.get_count(m, "compress")
    o.intent.headers = booli(args.get_flag(m, "headers"))
    o.intent.body = booli(args.get_flag(m, "body"))
    o.intent.meta = booli(args.get_flag(m, "meta"))
    o.intent.debug = booli(args.get_flag(m, "debug"))
    o.intent.all = booli(args.get_flag(m, "all"))
    if o.intent.verbose > 0 {
        o.intent.all = 1
    }
    o.intent.curl = booli(args.get_flag(m, "curl"))
    o.intent.curl_long = booli(args.get_flag(m, "curl-long"))
    if o.intent.curl_long != 0 {
        o.intent.curl = 1
    }
    o.intent.offline = booli(args.get_flag(m, "offline"))
    o.intent.follow = booli(args.get_flag(m, "follow"))
    o.intent.download = booli(args.get_flag(m, "download"))
    o.intent.resume = booli(args.get_flag(m, "continue"))
    o.intent.ignore_stdin = booli(args.get_flag(m, "ignore-stdin"))
    o.intent.ignore_netrc = booli(args.get_flag(m, "ignore-netrc"))
    o.intent.native_tls = booli(args.get_flag(m, "native-tls"))
    o.intent.ipv4 = booli(args.get_flag(m, "ipv4"))
    o.intent.ipv6 = booli(args.get_flag(m, "ipv6"))
    o.intent.stream = args.state(m, "stream")
    o.intent.check_status = args.state(m, "check-status")
    if args.get_flag(m, "https") {
        o.intent.https = 1
    }
    o.intent.default_scheme = args.get_str(m, "default-scheme")
    if o.intent.https != 0 {
        o.intent.default_scheme = "https"
    }
    o.intent.auth_type = args.get_enum(m, "auth-type")
    o.intent.auth = args.get_str(m, "auth")
    if args.present(m, "bearer") {
        o.intent.auth_type = "bearer"
        o.intent.auth = args.get_str(m, "bearer")
    }
    if o.intent.download != 0 {
        o.intent.follow = 1
        o.intent.check_status = 1
    }
    if args.get_flag(m, "multipart") {
        o.intent.body_type = 2
    } else if args.get_flag(m, "form") {
        o.intent.body_type = 1
    } else {
        o.intent.body_type = 0
    }
    o.intent.json_flag = booli(args.get_flag(m, "json"))
    o.intent.has_raw = booli(args.present(m, "raw"))
    o.intent.raw = args.get_str(m, "raw")
    // is_body_empty: multipart or any body item (kinds 5..9)
    body_items := false
    j = 0
    for j < len(o.intent.ikinds) {
        if o.intent.ikinds[j] >= 5 {
            body_items = true
        }
        j = j + 1
    }
    if o.intent.has_raw != 0 && (o.intent.body_type == 2 || body_items) {
        diag_out(o, "Request body (from --raw) and request data (key=value) cannot be mixed.", usg)
        return o
    }
    o.intent.session = args.get_str(m, "session")
    o.intent.session_ro = 0
    if args.present(m, "session-read-only") {
        o.intent.session = args.get_str(m, "session-read-only")
        o.intent.session_ro = 1
    }
    o.intent.check_eff = 0
    if o.intent.check_status == 1 {
        o.intent.check_eff = 1
    } else if o.intent.check_status == 0 {
        if o.intent.compat == 0 {
            o.intent.check_eff = 1
        }
    }
    o.intent.output = args.get_str(m, "output")
    o.intent.max_redirects = args.get_int(m, "max-redirects")
    o.intent.eff_redirects = o.intent.max_redirects
    if o.intent.follow != 0 && args.present(m, "max-redirects") == false {
        o.intent.eff_redirects = 10
    }
    o.intent.has_timeout = booli(args.present(m, "timeout"))
    if o.intent.has_timeout != 0 {
        o.intent.timeout = args.get_float(m, "timeout")
    }
    o.intent.pretty = args.get_enum(m, "pretty")
    o.intent.style = args.get_enum(m, "style")
    [rc, rce] = chk_charset(args.get_str(m, "response-charset"))
    if args.present(m, "response-charset") && rce == nil {
        o.intent.response_charset = rc
    } else if args.present(m, "response-charset") {
        o.intent.response_charset = args.get_str(m, "response-charset")
    }
    o.intent.response_mime = args.get_str(m, "response-mime")
    o.intent.print = args.get_str(m, "print")
    o.intent.history_print = args.get_str(m, "history-print")
    o.intent.fmt_opts = merge_fmtopts(m)
    o.intent.proxies = args.get_list(m, "proxy")
    o.intent.resolves = args.get_list(m, "resolve")
    o.intent.verify = canon_verify(args.get_str(m, "verify"))
    o.intent.cert = args.get_str(m, "cert")
    o.intent.cert_key = args.get_str(m, "cert-key")
    o.intent.ssl = args.get_enum(m, "ssl")
    o.intent.http_version = args.get_enum(m, "http-version")
    o.intent.interface = args.get_str(m, "interface")
    o.intent.unix_socket = args.get_str(m, "unix-socket")
    o.intent.m_sig_id = args.get_str(m, "unstable-m-sig-id")
    o.intent.m_sig_key = args.get_str(m, "unstable-m-sig-key")
    o.intent.m_sig_alg = args.get_enum(m, "unstable-m-sig-alg")
    comps := args.get_list(m, "unstable-m-sig-comp")
    j = 0
    for j < len(comps) {
        flat := norm_msigcomp(comps[j])
        k := 0
        for k < len(flat) {
            o.intent.m_sig_comps = new(push(o.intent.m_sig_comps[:], flat[k]))
            k = k + 1
        }
        j = j + 1
    }
    // proxy env capture (only when --proxy absent) + no_proxy
    if len(o.intent.proxies) == 0 {
        names := "HTTP_PROXY,HTTPS_PROXY,ALL_PROXY,http_proxy,https_proxy,all_proxy"
        cur := strings.split(names, ",")
        for cur != nil {
            [pv, pe] = env_lookup(envpairs, cur.v)
            if pe == nil {
                o.intent.proxy_env = new(push(o.intent.proxy_env[:], cur.v + "=" + pv))
            }
            cur = cur.next
        }
    }
    [np, npe] = env_lookup(envpairs, "NO_PROXY")
    if npe != nil {
        [np2, npe2] = env_lookup(envpairs, "no_proxy")
        if npe2 == nil {
            np = np2
        } else {
            np = ""
        }
    }
    o.intent.no_proxy = np

    // resolved print sets: explicit --print wins; --history-print
    // falls back to the resolved print set
    if args.present(m, "print") {
        o.intent.print_set = print_of_chars(o.intent.print)
    } else {
        o.intent.print_set = print_new(o.intent.verbose, o.intent.headers, o.intent.body, o.intent.meta, o.intent.quiet, o.intent.offline)
    }
    if args.present(m, "history-print") {
        o.intent.hist_set = print_of_chars(o.intent.history_print)
    } else {
        o.intent.hist_set = o.intent.print_set
    }
    // effective method: explicit else Body::pick_method — raw/
    // multipart/body-items are non-empty bodies
    if len(method) > 0 {
        o.intent.eff_method = method
    } else if o.intent.has_raw != 0 || o.intent.body_type == 2 || body_items {
        o.intent.eff_method = "POST"
    } else {
        o.intent.eff_method = "GET"
    }

    // 9. construct_url
    [u, ue] = construct_url(url_raw, o.intent.default_scheme)
    if ue != nil {
        diag_out(o, "Invalid <URL>: " + errors.msg(ue), usg)
        return o
    }
    o.intent.url = u

    // 10. deferral routing (S5+ lands real behavior)
    if msig_present(m) {
        defer_out(o, prog, "This binary was built without message signature support. Enable the `http-message-signatures` feature.")
        return o
    }
    if o.intent.http_version == "3-prior-knowledge" {
        defer_out(o, prog, "This binary was built without support for HTTP/3. Enable the `http3` feature.")
        return o
    }
    scheme := url_scheme(o.intent.url)
    if scheme != "http" {
        // ADR-0015 pins the TLS deferral text for every non-http scheme.
        defer_out(o, prog, scheme + " URLs are unsupported in this build (TLS is not available)")
        return o
    }
    // S5 degrade routing (spec sem-G, ADR 0024): connection-affecting
    // flags error out; display-only flags that upstream processes on
    // pipes error too; --debug degrades to a warning inside execute.
    if o.intent.resume != 0 {
        defer_out(o, prog, "--continue is unsupported in this build")
        return o
    }
    if o.intent.curl != 0 || o.intent.curl_long != 0 {
        defer_out(o, prog, "--curl is unsupported in this build")
        return o
    }
    if o.intent.http_version == "2" || o.intent.http_version == "2-prior-knowledge" {
        defer_out(o, prog, "HTTP/2 requests are unsupported in this build")
        return o
    }
    if len(o.intent.proxies[:]) > 0 || len(o.intent.proxy_env[:]) > 0 {
        defer_out(o, prog, "proxies are unsupported in this build")
        return o
    }
    if len(o.intent.resolves[:]) > 0 {
        defer_out(o, prog, "--resolve is unsupported in this build")
        return o
    }
    if len(o.intent.interface) > 0 {
        defer_out(o, prog, "--interface is unsupported in this build")
        return o
    }
    if o.intent.ipv6 != 0 {
        defer_out(o, prog, "IPv6 is unsupported in this build")
        return o
    }
    if len(o.intent.unix_socket) > 0 {
        defer_out(o, prog, "--unix-socket is unsupported in this build")
        return o
    }
    if len(o.intent.pretty) > 0 && o.intent.pretty != "none" {
        defer_out(o, prog, "--pretty is unsupported in this build")
        return o
    }
    if len(o.intent.fmt_opts[:]) > 0 {
        defer_out(o, prog, "--format-options is unsupported in this build")
        return o
    }
    o.exec = 1
    return o
}

fn booli(b: bool) -> int {
    if b {
        return 1
    }
    return 0
}
